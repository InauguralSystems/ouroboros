# ouroboros CLI: compile an EigenScript source file with the self-hosted
# compiler and run it on the C VM.
#
#   eigenscript ouroboros.eigs <source.eigs>
#
# Output is the program's own output — identical to running it through the C
# eigenscript directly (that is the behavioral parity oracle in test/run.sh).

load_file of "src/frontend.eigs"
load_file of "src/codegen.eigs"

argv is args of null
if (len of argv) < 1:
    print of "usage: eigenscript ouroboros.eigs <source.eigs>"
else:
    if (is_dir of argv[0]) == 1:
        # a DIRECTORY passes file_exists (it is fopen("r"), which opens dirs
        # on Linux) and read_text returns "" -- the oracle dies "cannot read
        # file" rc 1, so refusing here is the match, and is_dir is the
        # discriminator that separates it from a genuinely empty FILE.
        throw of ("ouroboros: cannot read source file '" + (argv[0]) + "' (is a directory)")
    if (file_exists of argv[0]) == 0:
        # Missing/unreadable refuses (oracle rc 1); an EMPTY file is a VALID
        # program the oracle runs to rc 0 silence. The first version of this
        # guard lumped the two -- the exact over-refusal a review round had
        # already adjudicated on the AOT driver -- because read_text returns
        # "" for both and a comment claimed "no existence builtin exists".
        # That premise was FALSE: file_exists was in the runtime all along
        # (missing 0, chmod-000 unreadable 0, empty-readable 1). A LATER round
        # then falsified this comment's own "all edges match" claim: the
        # oracle's real contract is S_ISREG (read_file_util, #314), and
        # file_exists is an fopen probe -- /dev/null, /dev/zero, and fifos
        # with writers pass these guards, read as "" (read_file_util refuses
        # them, collapsing them into the empty-file answer), and ran rc 0
        # where the oracle dies rc 1. RESIDUAL, stated not hidden: without an
        # is_file (S_ISREG) builtin upstream, this driver cannot separate a
        # refused device file from a genuinely empty regular file. build.sh's
        # [ -f ] is the precise test and covers the build path; direct driver
        # callers keep the best-effort guard.
        throw of ("ouroboros: cannot read source file '" + (argv[0]) + "'")
    source is read_text of argv[0]
    ouro_run of source
