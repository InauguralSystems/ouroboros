# ouroboros — a bytecode back-end for EigenScript, written in EigenScript.
#
# Front-end (src/frontend.eigs, vendored from lib/eigen.eigs) → AST; this file
# walks it and emits the C VM's bytecode as data, run via vm_run_bytecode. The
# chunk runs on the real VM, so codegen needs only semantic correctness, not
# byte-identity with compile_ast (F-OURO-2); the oracle is stdout parity.
#
# Compilation context `c` (one per module / function):
#   code, consts, functions  — this chunk's bytecode, pool, nested fn descriptors
#   loops                    — stack of {header, breaks} for break/continue
#   is_function              — 0 at module scope, 1 inside a function
#   locals, local_names, next_slot — local-slot allocation (params + body locals)
#
# Slice 3 adds functions and locals: define, parameters, `return`, local
# variables (slot-allocated), calls with EigenScript's `f of [a,b]` arg-spread
# convention, and recursion. The `local` keyword and the observer opcodes are
# still out of scope (the vendored front-end doesn't parse `local`; observers
# are a later slice).

# --- opcodes (src/vm.h enum order) ---------------------------------------
OP_CONST is 0
OP_NULL is 1
OP_ADD is 4
OP_SUB is 5
OP_MUL is 6
OP_DIV is 7
OP_MOD is 8
OP_BAND is 9
OP_BOR is 10
OP_BXOR is 11
OP_SHL is 12
OP_SHR is 13
OP_NEG is 14
OP_NOT is 15
OP_BNOT is 16
OP_EQ is 17
OP_NE is 18
OP_LT is 19
OP_GT is 20
OP_LE is 21
OP_GE is 22
OP_GET_LOCAL is 23
OP_SET_LOCAL is 24
OP_GET_NAME is 25
OP_SET_NAME is 26
OP_SET_NAME_LOCAL is 27
# Bind in frame->fn_env, skipping intervening loop/scope envs — the C
# compiler's op for function-scope NAME-path locals (captured / interrogated /
# env-bound / `local`-shadow names; emit_assign_for_tos).
OP_SET_FN_NAME_LOCAL is 28
OP_JUMP is 29
OP_JUMP_BACK is 30
OP_JUMP_IF_FALSE is 31
OP_JUMP_IF_FALSE_PEEK is 33
OP_JUMP_IF_TRUE_PEEK is 34
OP_POP is 35
OP_DUP2 is 37
OP_CLOSURE is 38
OP_DICT is 43
OP_INDEX_GET is 44
OP_INDEX_SET is 45
OP_DOT_GET is 46
OP_DOT_SET is 47
OP_SLICE_GET is 80
OP_CALL is 39
OP_RETURN is 40
OP_RETURN_NULL is 41
OP_LIST is 42
OP_LISTCOMP_BEGIN is 66
OP_LISTCOMP_APPEND is 67
OP_ITER_SETUP is 48
OP_ITER_NEXT is 49
OP_TRY_BEGIN is 54
OP_TRY_END is 55
OP_LOOP_ENV_FRESH is 50
OP_LOOP_ENV_END is 51
OP_OBSERVE_ASSIGN is 56
OP_OBSERVE_ASSIGN_LOCAL is 57
OP_INTERROGATE is 58
OP_PREDICATE is 59
OP_INTERROGATE_NAMED is 76
OP_INTERROGATE_NAMED_AT is 77
# `<kw> is x when <N>` (#868, in the v0.39.0 pin) — interrogate at the Nth
# RECORDED assignment; the ordinal is popped from the stack. vm_run_bytecode's
# chunk_arm_temporal (#831) sees this opcode and arms the name's occurrence
# ring itself, so no extra builtin call is needed here.
OP_INTERROGATE_NAMED_WHEN is 93
OP_DEFAULT_PARAM is 78
OP_DESTRUCTURE_UNPACK is 79
# #262 Phase-3 slot model: re-observe a name binding AFTER its SET (the binding
# now exists), so the per-binding Env slot — not the Value object — carries the
# trajectory the predicates/report/interrogatives read. The C compiler emits
# this after every name `is` assignment; on the slot-default runtime it is
# load-bearing — without it a name is never observed (nums are now immediates).
OP_OBSERVE_NAME_POST is 82
OP_LINE is 68
OP_LOOP_STALL_CHECK is 62
OP_LOOP_CAP_CHECK is 63

# Names bound at module scope (assigns + defines). Inside a function, an `is`
# assignment to such a name modifies the module binding (SET_NAME) rather than
# shadowing it with a fresh local — matching compile_ast's resolution.
MODULE_NAMES is {}

# Set to 1 when the program uses `prev` or `... at <line>`, which need runtime
# per-assignment history recording (the C compiler enables it automatically; the
# self-hosted runner enables it via record_history in ouro_run).
USES_HISTORY is [0]

# --- context -------------------------------------------------------------
# name_bound: the pre-scan result (see cg_scan_name_bound) — names that must
# bind by NAME in this function's frame env instead of an anonymous slot,
# because a name-keyed consumer must be able to resolve them: nested closures
# (GET_NAME through the captured env chain), the history/observer opcodes
# (INTERROGATE_NAMED/_AT/_WHEN resolve (env,slot) by name — slot-locals are
# invisible to them), and catch/listcomp bindings (bound by name at runtime).
# Mirrors compiler.c's captured/interrogated/env_bound trio (compile of
# AST_FUNC: scan_for_captures + scan_for_interrogated + scan_for_env_bound).
# param_count: slots below it are parameters (params ARE name-visible in the
# VM's call env, so they may stay slots even when captured/interrogated —
# same as C, where resolve_local wins before the escape checks).
# enclosing: the lexically enclosing compile context (null at module scope) —
# compiler.c's Compiler.enclosing, read by cg_name_in_enclosing (the mirror
# of name_in_enclosing) so a write to an enclosing function's name routes to
# SET_NAME (outward mutation) instead of allocating a fresh local.
define cg_new(is_function) as:
    return {"code": [], "consts": [], "functions": [], "loops": [], "is_function": is_function, "locals": {}, "local_names": [], "next_slot": 0, "name_bound": {}, "param_count": 0, "enclosing": null}

define cg_loop_top(c) as:
    return c.loops[(len of c.loops) - 1]

# Allocate a new local slot for `name`; return its index.
define cg_add_local(c, name) as:
    local slot is c.next_slot
    c.locals[name] is slot
    append of [c.local_names, name]
    c.next_slot is c.next_slot + 1
    return slot

# --- emit primitives -----------------------------------------------------
define cg_emit(c, byte) as:
    append of [c.code, byte]

define cg_emit_u16(c, val) as:
    append of [c.code, val % 256]
    append of [c.code, floor of (val / 256)]

# Little-endian 32-bit operand. OP_LINE's operand widened from 16 to 32 bits
# upstream in v0.33.0 (#630 — line numbers wrapped at 65536), so a 16-bit
# emission leaves the VM reading two bytes of the NEXT instruction as the high
# half of the line number and then resuming misaligned: the chunk runs as
# garbage, silently, at rc=0.
define cg_emit_u32(c, val) as:
    append of [c.code, val % 256]
    append of [c.code, (floor of (val / 256)) % 256]
    append of [c.code, (floor of (val / 65536)) % 256]
    append of [c.code, (floor of (val / 16777216)) % 256]

define cg_const(c, val) as:
    for i in range of (len of c.consts):
        if c.consts[i] == val:
            return i
    append of [c.consts, val]
    return (len of c.consts) - 1

# --- jumps (offsets relative to the byte after the operand) ---------------
define cg_emit_jump(c, op) as:
    cg_emit of [c, op]
    local hole is len of c.code
    cg_emit of [c, 0]
    cg_emit of [c, 0]
    return hole

define cg_patch_jump(c, hole) as:
    local off is (len of c.code) - (hole + 2)
    c.code[hole] is off % 256
    c.code[hole + 1] is floor of (off / 256)

define cg_patch_breaks(c) as:
    local top is cg_loop_top of c
    for i in range of (len of top.breaks):
        cg_patch_jump of [c, top.breaks[i]]
    list_truncate of [c.loops, (len of c.loops) - 1]

define cg_emit_jump_back(c, target) as:
    cg_emit of [c, OP_JUMP_BACK]
    local off is ((len of c.code) + 2) - target
    cg_emit of [c, off % 256]
    cg_emit of [c, floor of (off / 256)]

define cg_binop_code(op) as:
    if op == "+":
        return OP_ADD
    if op == "-":
        return OP_SUB
    if op == "*":
        return OP_MUL
    if op == "/":
        return OP_DIV
    if op == "%":
        return OP_MOD
    if op == "&":
        return OP_BAND
    if op == "|":
        return OP_BOR
    if op == "^":
        return OP_BXOR
    if op == "<<":
        return OP_SHL
    if op == ">>":
        return OP_SHR
    if op == "==":
        return OP_EQ
    if op == "!=":
        return OP_NE
    if op == "<":
        return OP_LT
    if op == ">":
        return OP_GT
    if op == "<=":
        return OP_LE
    if op == ">=":
        return OP_GE
    throw of ("ouroboros: unsupported binary op '" + op + "'")

# Is a loop condition observer-based? (mirrors compile_ast's cond_is_observer_based:
# recurse only through unary/binop structure; a predicate makes it observer-based,
# everything else — names, calls, literals — is opaque and biases toward "plain".)
define cg_cond_observer(node) as:
    local t is node[0]
    if t == "_line":
        return cg_cond_observer of node[2]
    if t == "predicate":
        return 1
    if t == "unary":
        return cg_cond_observer of node[2]
    if t == "binop":
        if (cg_cond_observer of node[2]) == 1:
            return 1
        return cg_cond_observer of node[3]
    return 0

# --- escape pre-scan (mirror of compiler.c's AST_FUNC escape analysis) ----
# cg_collect_refs: every name a subtree references — reads (ident) AND
# binding occurrences (assign targets, for vars, catch names, destructure
# names, nested define names) — mirroring collect_referenced_names. Dot/
# field keys and listcomp vars are NOT names here (C skips them too).
define cg_collect_refs(node, acc) as:
    if (type of node) != "list":
        return null
    if (len of node) == 0:
        return null
    local t is node[0]
    if t == "ident":
        acc[node[1]] is 1
        return null
    if t == "assign":
        acc[node[1]] is 1
        cg_collect_refs of [node[2], acc]
        return null
    if t == "for":
        acc[node[1]] is 1
        cg_collect_refs of [node[2], acc]
        cg_collect_refs of [node[3], acc]
        return null
    if t == "try":
        acc[node[2]] is 1
        cg_collect_refs of [node[1], acc]
        cg_collect_refs of [node[3], acc]
        return null
    if t == "func":
        acc[node[1]] is 1
        cg_collect_refs of [node[3], acc]              # body only, like C
        return null
    if t == "destructure":
        local dn is node[1]
        for i in range of (len of dn):
            acc[dn[i]] is 1
        cg_collect_refs of [node[2], acc]
        return null
    if t == "dot":
        cg_collect_refs of [node[1], acc]              # key is a field, not a name
        return null
    for k in range of (len of node):
        cg_collect_refs of [node[k], acc]
    return null

# cg_scan_name_bound: fill `acc` with the names of THIS function scope that
# must bind by NAME (see cg_new's name_bound comment):
#   - captured: every name a nested define/lambda references, minus that
#     closure's own params (scan_for_captures) — the closure resolves them
#     via GET_NAME through the captured env chain, which cannot see slots;
#   - interrogated: the ident operand of any interrogate node — what/who/
#     when/where/why/how/prev, at/when-qualified or not (scan_for_
#     interrogated adds expr when it is an IDENT, every kind incl. prev) —
#     the NAMED opcodes and the assignment history are name-keyed;
#   - env-bound: catch error names and listcomp vars (scan_for_env_bound) —
#     bound by name at runtime, so a same-named slot would go stale.
# Nested closures are capture points: their whole subtree lands in the
# capture set, so the walk does not descend past them (C's interrogated/
# env_bound scans also stop at function boundaries).
#
# Traversal boundaries differ per class, mirroring the three C scans
# exactly (round 3): scan_for_interrogated does NOT descend into
# AST_LISTCOMP, while scan_for_captures and scan_for_env_bound DO — so an
# interrogate operand inside a listcomp body must NOT name-bind the outer
# variable (the oracle answers null there: `[prev of y for v in xs]` on a
# slot-local y is a real VM behavior we must match — the oracle wins even
# when it looks odd). `no_interr` carries that boundary: 1 once the walk
# has entered a listcomp.
define cg_scan_name_bound(node, acc, no_interr) as:
    if (type of node) != "list":
        return null
    if (len of node) == 0:
        return null
    local t is node[0]
    if t == "func":
        local frefs is {}
        cg_collect_refs of [node[3], frefs]
        frefs[node[1]] is 1                            # the closure's name too
        local fparams is node[2]
        local frn is keys of frefs
        for i in range of (len of frn):
            local isparam is 0
            for j in range of (len of fparams):
                if fparams[j] == frn[i]:
                    isparam is 1
            if isparam == 0:
                acc[frn[i]] is 1
        return null
    if t == "lambda":
        local lrefs is {}
        cg_collect_refs of [node[2], lrefs]
        local lparams is node[1]
        local lrn is keys of lrefs
        for i in range of (len of lrn):
            local isparam is 0
            for j in range of (len of lparams):
                if lparams[j] == lrn[i]:
                    isparam is 1
            if isparam == 0:
                acc[lrn[i]] is 1
        return null
    if t == "interrogate":
        if no_interr == 0:
            local ie is node[2]
            if (type of ie) == "list":
                if ie[0] == "ident":
                    acc[ie[1]] is 1
    if t == "try":
        acc[node[2]] is 1                              # catch error name
    if t == "listcomp":
        # env-bound: the comprehension var; captures and nested listcomp
        # vars are still collected inside, but interrogate operands are NOT
        # (scan_for_interrogated's AST_LISTCOMP case is an explicit no-op).
        acc[node[2]] is 1
        cg_scan_name_bound of [node[1], acc, 1]
        cg_scan_name_bound of [node[3], acc, 1]
        if node[4] != null:
            cg_scan_name_bound of [node[4], acc, 1]
        return null
    for k in range of (len of node):
        cg_scan_name_bound of [node[k], acc, no_interr]
    return null

# Is `name` visible in an ENCLOSING function's scope? Mirror of compiler.c's
# name_in_enclosing: walk c->enclosing, checking each enclosing FUNCTION's
# slot locals (params + slot-allocated body locals) and its name-bound set
# (C checks e->locals, e->captured and e->interrogated; name_bound is our
# union of those plus env_bound — a safe superset, since any name a nested
# scope can reach is captured in the encloser by the pre-scan). The walk
# stops at the module-level context (C's loop condition `e && e->enclosing`
# skips the top compiler; module names are MODULE_NAMES' job).
define cg_name_in_enclosing(c, name) as:
    local e is c.enclosing
    loop while e != null:
        if e.is_function == 1:
            if has_key of [e.locals, name]:
                return 1
            if has_key of [e.name_bound, name]:
                return 1
            e is e.enclosing
        else:
            return 0
    return 0

# --- variable resolution -------------------------------------------------
define cg_load_name(c, name) as:
    if (c.is_function == 1) and (has_key of [c.locals, name]):
        cg_emit of [c, OP_GET_LOCAL]
        cg_emit_u16 of [c, c.locals[name]]
    else:
        cg_emit of [c, OP_GET_NAME]
        cg_emit_u16 of [c, cg_const of [c, name]]

# Store TOS into `name` (value stays on the stack — all SET_* keep TOS). Each
# `is` assignment is preceded by the matching OBSERVE op, which updates the
# observer state (entropy / dH window) on the assigned value and sets it as the
# last observer — the foundation the predicates read. (Slot-based locals use the
# _LOCAL variants; name-based stores use OBSERVE_ASSIGN with the name index.)
#
# Function-scope resolution mirrors compiler.c's emit_assign_for_tos, in its
# exact arbitration order:
#   1. an existing SLOT always wins (params, earlier slot-locals) —
#      resolve_local runs before every escape check in C;
#   2. a pre-scanned NAME-BOUND name (captured / interrogated / env-bound —
#      see cg_scan_name_bound) binds by NAME in the frame env via
#      OP_SET_FN_NAME_LOCAL, so name-keyed consumers (nested closures, the
#      history/observer opcodes, catch/listcomp bindings) can resolve it;
#   3. otherwise compute eligibility like C's local_eligible: a name that is
#      NOT visible in an enclosing function (in_outer, cg_name_in_enclosing)
#      and NOT a module name (in_module) gets a FRESH anonymous slot — this
#      covers `local` too (C: an eligible local_only name slot-allocates);
#   4. ineligible + `local`-marked -> OP_SET_FN_NAME_LOCAL (the explicit
#      shadow; C's `local_only ||` disjunct);
#   5. ineligible plain assign -> OP_SET_NAME: the chain walk mutates the
#      enclosing function's binding (outward-mutable scope model) or the
#      module binding — never a fresh local. Round 3: the in_outer arm was
#      missing, so a nested define writing an enclosing name allocated its
#      own local (silent wrong value; on pre-#99 main the READ side was a
#      loud undefined-variable — the pre-scan alone converted it to silent).
# At module scope C emits SET_NAME_LOCAL for `local`: bind in the CURRENT
# scope, never walk the env chain.
define cg_store_name(c, name, local_only) as:
    if c.is_function == 1:
        if has_key of [c.locals, name]:
            local slot is c.locals[name]
            cg_emit of [c, OP_OBSERVE_ASSIGN_LOCAL]
            cg_emit_u16 of [c, slot]
            cg_emit of [c, OP_SET_LOCAL]
            cg_emit_u16 of [c, slot]
        elif has_key of [c.name_bound, name]:
            local fidx is cg_const of [c, name]
            cg_emit of [c, OP_OBSERVE_ASSIGN]
            cg_emit_u16 of [c, fidx]
            cg_emit of [c, OP_SET_FN_NAME_LOCAL]
            cg_emit_u16 of [c, fidx]
            cg_emit of [c, OP_OBSERVE_NAME_POST]
            cg_emit_u16 of [c, fidx]
        else:
            local in_outer is cg_name_in_enclosing of [c, name]
            local in_module is 0
            if has_key of [MODULE_NAMES, name]:
                in_module is 1
            if (in_outer == 0) and (in_module == 0):
                local nslot is cg_add_local of [c, name]
                cg_emit of [c, OP_OBSERVE_ASSIGN_LOCAL]
                cg_emit_u16 of [c, nslot]
                cg_emit of [c, OP_SET_LOCAL]
                cg_emit_u16 of [c, nslot]
            elif local_only == 1:
                local lfidx is cg_const of [c, name]
                cg_emit of [c, OP_OBSERVE_ASSIGN]
                cg_emit_u16 of [c, lfidx]
                cg_emit of [c, OP_SET_FN_NAME_LOCAL]
                cg_emit_u16 of [c, lfidx]
                cg_emit of [c, OP_OBSERVE_NAME_POST]
                cg_emit_u16 of [c, lfidx]
            else:
                local idx is cg_const of [c, name]
                cg_emit of [c, OP_OBSERVE_ASSIGN]
                cg_emit_u16 of [c, idx]
                cg_emit of [c, OP_SET_NAME]
                cg_emit_u16 of [c, idx]
                cg_emit of [c, OP_OBSERVE_NAME_POST]
                cg_emit_u16 of [c, idx]
    elif local_only == 1:
        local lidx is cg_const of [c, name]
        cg_emit of [c, OP_OBSERVE_ASSIGN]
        cg_emit_u16 of [c, lidx]
        cg_emit of [c, OP_SET_NAME_LOCAL]
        cg_emit_u16 of [c, lidx]
        cg_emit of [c, OP_OBSERVE_NAME_POST]
        cg_emit_u16 of [c, lidx]
    else:
        local midx is cg_const of [c, name]
        cg_emit of [c, OP_OBSERVE_ASSIGN]
        cg_emit_u16 of [c, midx]
        cg_emit of [c, OP_SET_NAME]
        cg_emit_u16 of [c, midx]
        cg_emit of [c, OP_OBSERVE_NAME_POST]
        cg_emit_u16 of [c, midx]

# --- node codegen: leaves exactly one value on the stack ------------------
define cg_node(c, node) as:
    local t is node[0]
    if t == "_line":
        cg_node of [c, node[2]]
        return null
    if t == "num":
        cg_emit of [c, OP_CONST]
        cg_emit_u16 of [c, cg_const of [c, node[1]]]
        return null
    if t == "str":
        cg_emit of [c, OP_CONST]
        cg_emit_u16 of [c, cg_const of [c, node[1]]]
        return null
    if t == "null":
        cg_emit of [c, OP_NULL]
        return null
    if t == "ident":
        cg_load_name of [c, node[1]]
        return null
    if t == "assign":
        cg_node of [c, node[2]]
        # 4th element = local_only marker (`local NAME is e`, #99 item 2).
        local lonly is 0
        if (len of node) >= 4:
            lonly is 1
        cg_store_name of [c, node[1], lonly]
        return null
    if t == "binop":
        local op is node[1]
        if op == "and":
            cg_node of [c, node[2]]
            local ja is cg_emit_jump of [c, OP_JUMP_IF_FALSE_PEEK]
            cg_emit of [c, OP_POP]
            cg_node of [c, node[3]]
            cg_patch_jump of [c, ja]
            return null
        if op == "or":
            cg_node of [c, node[2]]
            local jo is cg_emit_jump of [c, OP_JUMP_IF_TRUE_PEEK]
            cg_emit of [c, OP_POP]
            cg_node of [c, node[3]]
            cg_patch_jump of [c, jo]
            return null
        cg_node of [c, node[2]]
        cg_node of [c, node[3]]
        cg_emit of [c, cg_binop_code of op]
        return null
    if t == "unary":
        cg_node of [c, node[2]]
        if node[1] == "-":
            cg_emit of [c, OP_NEG]
        elif node[1] == "~":
            cg_emit of [c, OP_BNOT]
        else:
            cg_emit of [c, OP_NOT]
        return null
    if t == "call":
        cg_node of [c, node[1]]                       # callee
        local arg is node[2]
        if arg[0] == "_line":
            arg is arg[2]
        # Calling convention (matches compile_node_inner): #405 (v0.27.0) — a
        # bare literal list after `of` is ALWAYS an argument list, at every
        # count (`f of []` zero args, `f of [x]` one arg — x itself, not a
        # 1-element list — `f of [a, b]` two). Any non-list arg is one arg.
        # #355 (v0.24.0): a parenthesized literal list (3rd marker slot)
        # never spreads — it is one argument.
        if (arg[0] == "list") and ((len of arg) == 2):
            local elems is arg[1]
            for i in range of (len of elems):
                cg_node of [c, elems[i]]
            cg_emit of [c, OP_CALL]
            cg_emit_u16 of [c, len of elems]
        else:
            cg_node of [c, arg]
            cg_emit of [c, OP_CALL]
            cg_emit_u16 of [c, 1]
        return null
    if t == "list":
        local elems is node[1]
        for i in range of (len of elems):
            cg_node of [c, elems[i]]
        cg_emit of [c, OP_LIST]
        cg_emit_u16 of [c, len of elems]
        return null
    if t == "dict":
        local pairs is node[1]
        for i in range of (len of pairs):
            cg_node of [c, pairs[i][0]]                # key
            cg_node of [c, pairs[i][1]]                # value
        cg_emit of [c, OP_DICT]
        cg_emit_u16 of [c, len of pairs]
        return null
    if t == "index":
        cg_node of [c, node[1]]                        # target
        cg_node of [c, node[2]]                        # index
        cg_emit of [c, OP_INDEX_GET]
        return null
    if t == "slice":
        cg_node of [c, node[1]]                        # target
        if node[2] == null:                            # start (NULL -> whole)
            cg_emit of [c, OP_NULL]
        else:
            cg_node of [c, node[2]]
        if node[3] == null:                            # end (NULL -> whole)
            cg_emit of [c, OP_NULL]
        else:
            cg_node of [c, node[3]]
        cg_emit of [c, OP_SLICE_GET]
        return null
    if t == "dot":
        cg_node of [c, node[1]]                        # target
        cg_emit of [c, OP_DOT_GET]
        cg_emit_u16 of [c, cg_const of [c, node[2]]]   # field name
        return null
    if t == "index_assign":
        cg_node of [c, node[1]]                        # target
        cg_node of [c, node[2]]                        # index
        if (len of node) >= 5:
            # Compound (`l[i] += e`): target/index evaluated ONCE, mirroring
            # the C compiler's DUP2 → INDEX_GET → expr → binop → INDEX_SET.
            cg_emit of [c, OP_DUP2]
            cg_emit of [c, OP_INDEX_GET]
            cg_node of [c, node[3]]                    # raw rhs
            cg_emit of [c, cg_binop_code of node[4]]
        else:
            cg_node of [c, node[3]]                    # value (kept on stack)
        cg_emit of [c, OP_INDEX_SET]
        return null
    if t == "destructure":
        # ["destructure", [names], rhs] — compile rhs, unpack into N stack
        # slots (element 0 at TOS), then store each name (stores keep TOS)
        # with an OP_POP between names; the last value remains, matching the
        # one-value-per-statement convention (C's AST_LIST_PATTERN_ASSIGN).
        cg_node of [c, node[2]]
        local d_names is node[1]
        cg_emit of [c, OP_DESTRUCTURE_UNPACK]
        cg_emit_u16 of [c, len of d_names]
        for i in range of (len of d_names):
            cg_store_name of [c, d_names[i], 0]        # destructure: local_only=0 (C passes 0)
            if i < ((len of d_names) - 1):
                cg_emit of [c, OP_POP]
        return null
    if t == "dot_assign":
        cg_node of [c, node[1]]                        # target
        cg_node of [c, node[3]]                        # value (kept on stack)
        cg_emit of [c, OP_DOT_SET]
        cg_emit_u16 of [c, cg_const of [c, node[2]]]   # field name
        return null
    if t == "listcomp":
        # ["listcomp", expr, var, iter_expr, filter_or_null]
        cg_emit of [c, OP_LISTCOMP_BEGIN]              # accumulator
        cg_node of [c, node[3]]                        # iterable
        cg_emit of [c, OP_ITER_SETUP]
        local header is len of c.code
        local jn is cg_emit_jump of [c, OP_ITER_NEXT]  # exit when exhausted
        cg_emit of [c, OP_SET_NAME_LOCAL]
        cg_emit_u16 of [c, cg_const of [c, node[2]]]   # bind comprehension var
        cg_emit of [c, OP_POP]
        local jfilt is 0 - 1
        if node[4] != null:
            cg_node of [c, node[4]]                    # filter condition
            jfilt is cg_emit_jump of [c, OP_JUMP_IF_FALSE]
        cg_node of [c, node[1]]                        # element expression
        cg_emit of [c, OP_LISTCOMP_APPEND]
        if jfilt >= 0:
            cg_patch_jump of [c, jfilt]                # filter-false -> re-iterate
        cg_emit_jump_back of [c, header]
        cg_patch_jump of [c, jn]                       # exit
        cg_emit of [c, OP_POP]                         # drop iterator; accumulator remains
        return null
    if t == "predicate":
        # bare observer predicate (converged/stable/improving/...) — reads the
        # last-observed variable's entropy/dH window. kind matches compile_ast.
        cg_emit of [c, OP_PREDICATE]
        cg_emit_u16 of [c, node[1]]
        return null
    if t == "interrogate":
        # ["interrogate", kind, expr, at_expr, when_expr]. kinds: 0 what,
        # 1 who,2 when,3 where,4 why,5 how,6 prev. Opcode selection mirrors
        # compile_ast (AST_INTERROGATE):
        #   when-form on an ident     -> INTERROGATE_NAMED_WHEN [kind][name]
        #   at-form on an ident       -> INTERROGATE_NAMED_AT   [kind][name]
        #   who/when/prev on an ident -> INTERROGATE_NAMED      [kind][name]
        #   otherwise (value-based)   -> INTERROGATE            [kind]
        local kind is node[1]
        local iexpr is node[2]
        local at_expr is node[3]
        local when_expr is null
        if (len of node) >= 5:
            when_expr is node[4]
        local is_ident is (iexpr[0] == "ident")
        if (kind == 6) or (at_expr != null) or (when_expr != null):
            USES_HISTORY[0] is 1                        # prev / at / when need history
        if when_expr != null:
            # #868: `when <n>` addresses an occurrence, which only a named
            # binding has. C makes the non-name operand a loud compile error
            # ("'when <n>' requires a variable name"); mirror it.
            if is_ident == 0:
                throw of "ouroboros: 'when <n>' requires a variable name"
            cg_node of [c, when_expr]                   # push the ordinal
            cg_emit of [c, OP_INTERROGATE_NAMED_WHEN]
            cg_emit_u16 of [c, kind]
            cg_emit_u16 of [c, cg_const of [c, iexpr[1]]]
            return null
        if (at_expr != null) and is_ident:
            cg_node of [c, at_expr]                     # push the line number
            cg_emit of [c, OP_INTERROGATE_NAMED_AT]
            cg_emit_u16 of [c, kind]
            cg_emit_u16 of [c, cg_const of [c, iexpr[1]]]
        else:
            cg_node of [c, iexpr]                       # push the target value
            # who/when/prev AND where/why/how on a known binding read its slot
            # (INTERROGATE_NAMED); only `what` (kind 0) stays value-based. The C
            # compiler routes where/why/how (3/4/5) to NAMED under the slot flag,
            # which is the default — and on the slot runtime the bare form would
            # read the now-empty Value, so NAMED is required for correctness.
            if is_ident and (kind != 0):
                cg_emit of [c, OP_INTERROGATE_NAMED]
                cg_emit_u16 of [c, kind]
                cg_emit_u16 of [c, cg_const of [c, iexpr[1]]]
            else:
                cg_emit of [c, OP_INTERROGATE]
                cg_emit_u16 of [c, kind]
        return null
    if t == "return":
        cg_node of [c, node[1]]
        cg_emit of [c, OP_RETURN]
        return null
    if t == "func":
        cg_func of [c, node]
        return null
    if t == "lambda":
        # ["lambda", [params], body_expr] — anonymous closure left on TOS.
        # Same descriptor shape as cg_func, body = one expression + RETURN.
        # Envelope guard: enclosing-FUNCTION locals are slot-stored
        # (anonymous), so a name-path read inside the closure would silently
        # miss them and return null — refuse loudly instead. Module names and
        # builtins resolve by name through the closure's captured env chain
        # and are fine.
        local lparams is node[1]
        if c.is_function == 1:
            cg_lambda_capture_check of [c, lparams, node[2]]
        local lc is cg_new of 1
        for i in range of (len of lparams):
            cg_add_local of [lc, lparams[i]]
        lc.param_count is len of lparams
        lc.enclosing is c
        cg_node of [lc, node[2]]
        cg_emit of [lc, OP_RETURN]
        local ldesc is [lc.code, lc.consts, lc.functions, len of lparams, "<lambda>", lc.local_names]
        local lidx is len of c.functions
        append of [c.functions, ldesc]
        cg_emit of [c, OP_CLOSURE]
        cg_emit_u16 of [c, lidx]
        return null

    # ---- control flow ----
    if t == "if":
        cg_node of [c, node[1]]
        local jf is cg_emit_jump of [c, OP_JUMP_IF_FALSE]
        cg_block_value of [c, node[2]]
        local je is cg_emit_jump of [c, OP_JUMP]
        cg_patch_jump of [c, jf]
        cg_block_value of [c, node[3]]
        cg_patch_jump of [c, je]
        return null
    if t == "loop":
        local header is len of c.code
        append of [c.loops, {"header": header, "breaks": []}]
        cg_node of [c, node[1]]
        local jf is cg_emit_jump of [c, OP_JUMP_IF_FALSE]
        cg_block_discard of [c, node[2]]
        # Loop-stall classifier (#247, correctness-critical): an observer-based
        # condition (references a predicate) gets OP_LOOP_STALL_CHECK (opt-in
        # auto-halt on convergence); a plain condition gets OP_LOOP_CAP_CHECK
        # (iteration cap only). Encoded in the opcode at compile time.
        local cap_op is OP_LOOP_CAP_CHECK
        if (cg_cond_observer of node[1]) == 1:
            cap_op is OP_LOOP_STALL_CHECK
        local jcap is cg_emit_jump of [c, cap_op]
        cg_emit_jump_back of [c, header]
        cg_patch_jump of [c, jf]
        cg_patch_jump of [c, jcap]
        cg_patch_breaks of c
        cg_emit of [c, OP_NULL]
        return null
    if t == "for":
        cg_node of [c, node[2]]
        cg_emit of [c, OP_ITER_SETUP]
        local header is len of c.code
        append of [c.loops, {"header": header, "breaks": []}]
        local jn is cg_emit_jump of [c, OP_ITER_NEXT]
        cg_emit of [c, OP_LOOP_ENV_FRESH]
        # Bind the loop var. If it already owns a local slot (a parameter or an
        # earlier assignment in this function), write THAT slot — the body reads
        # it via GET_LOCAL, and a SET_NAME_LOCAL would leave the slot stale, so
        # the body never sees the iteration value (silent wrong result).
        if (c.is_function == 1) and (has_key of [c.locals, node[1]]):
            cg_emit of [c, OP_SET_LOCAL]
            cg_emit_u16 of [c, c.locals[node[1]]]
        else:
            cg_emit of [c, OP_SET_NAME_LOCAL]
            cg_emit_u16 of [c, cg_const of [c, node[1]]]
        cg_emit of [c, OP_POP]
        cg_block_discard of [c, node[3]]
        cg_emit of [c, OP_LOOP_ENV_END]
        cg_emit_jump_back of [c, header]
        cg_patch_jump of [c, jn]
        cg_patch_breaks of c
        cg_emit of [c, OP_POP]
        cg_emit of [c, OP_NULL]
        return null
    if t == "try":
        # ["try", try_body, err_name, catch_body]. TRY_BEGIN installs a handler
        # whose offset points at the catch; on throw the VM unwinds the try
        # body's stack and pushes the thrown value. Both paths leave one value.
        local tb is cg_emit_jump of [c, OP_TRY_BEGIN]
        cg_block_value of [c, node[1]]                 # try body -> 1 value
        cg_emit of [c, OP_TRY_END]
        local je is cg_emit_jump of [c, OP_JUMP]       # no-throw: skip the catch
        cg_patch_jump of [c, tb]                        # catch handler starts here
        # Bind the thrown value. If the catch name already owns a local slot
        # (a parameter or an earlier assignment in this function), write THAT
        # slot — reads go via GET_LOCAL, and a SET_NAME_LOCAL would leave the
        # slot stale so the catch body/aftermath read the OLD value (silent
        # wrong result; F-OURO-8's bug class, #99 item 3). Same rule as the
        # `for` loop-var emitter above.
        if (c.is_function == 1) and (has_key of [c.locals, node[2]]):
            cg_emit of [c, OP_SET_LOCAL]
            cg_emit_u16 of [c, c.locals[node[2]]]
        else:
            cg_emit of [c, OP_SET_NAME_LOCAL]
            cg_emit_u16 of [c, cg_const of [c, node[2]]]
        cg_emit of [c, OP_POP]
        cg_block_value of [c, node[3]]                  # catch body -> 1 value
        cg_patch_jump of [c, je]
        return null
    if t == "break":
        local hole is cg_emit_jump of [c, OP_JUMP]
        append of [(cg_loop_top of c).breaks, hole]
        return null
    if t == "continue":
        cg_emit_jump_back of [c, (cg_loop_top of c).header]
        return null

    throw of ("ouroboros: cannot compile node type '" + t + "'")

# Lambda capture guard (see cg_node's "lambda" arm), defensive only: with the
# cg_func escape pre-scan, every enclosing-function name a lambda references
# is name-bound (never slotted), so a lambda capture resolves via GET_NAME
# through the captured env chain. Enclosing PARAMS keep their slots but are
# name-visible in the VM's call env (OP_CALL binds them by name), so reading
# them by name works too. The only unreachable-in-theory hazard left is a
# non-param slot escaping the pre-scan — refuse loudly rather than let a
# GET_NAME miss return silent null.
define cg_lambda_capture_check(c, lparams, node) as:
    if (type of node) != "list":
        return null
    if (len of node) == 0:
        return null
    if node[0] == "ident":
        local nm2 is node[1]
        local isp is 0
        for i in range of (len of lparams):
            if lparams[i] == nm2:
                isp is 1
        if isp == 0:
            if has_key of [c.locals, nm2]:
                if c.locals[nm2] >= c.param_count:
                    throw of ("ouroboros: lambda capturing enclosing function local '" + nm2 + "' is not supported")
        return null
    for k in range of (len of node):
        cg_lambda_capture_check of [c, lparams, node[k]]
    return null

# Compile a function definition: ["func", name, params, body]. Builds a nested
# chunk descriptor, registers it in the parent's functions[], emits OP_CLOSURE,
# and binds the function name.
define cg_func(c, node) as:
    local fname is node[1]
    local params is node[2]
    local body is node[3]
    local fc is cg_new of 1
    # Escape pre-scan (mirror of compile AST_FUNC's scan_for_captures /
    # scan_for_interrogated / scan_for_env_bound): names that must bind by
    # NAME in this function instead of an anonymous slot. Runs before any
    # slot allocation so cg_store_name never slots them. Params are added
    # as slots below regardless — the slot check wins first, same as C's
    # resolve_local-before-escape-checks ordering.
    for i in range of (len of body):
        cg_scan_name_bound of [body[i], fc.name_bound, 0]
    for i in range of (len of params):
        cg_add_local of [fc, params[i]]               # params -> slots 0..P-1
    fc.param_count is len of params
    fc.enclosing is c                                 # lexical chain for in_outer
    # Default-param prologue (mirrors the C compiler): for each param with a
    # default, OP_DEFAULT_PARAM <slot> <skip>; <default expr>; OP_SET_LOCAL;
    # OP_POP. The opcode compares slot vs frame->call_argc — if the caller
    # supplied the arg it skips the default (an explicit null stays null).
    # The descriptor format has no first_default field (the pinned
    # vm_run_bytecode sets it to param_count), but OP_DEFAULT_PARAM reads
    # only call_argc, so the hand-emitted prologue is sufficient.
    local has_defaults is 0
    if (len of node) >= 5:
        local defaults is node[4]
        for i in range of (len of defaults):
            if defaults[i] != null:
                has_defaults is 1
                cg_emit of [fc, OP_DEFAULT_PARAM]
                cg_emit_u16 of [fc, i]
                local dhole is len of fc.code
                cg_emit of [fc, 0]
                cg_emit of [fc, 0]
                cg_node of [fc, defaults[i]]
                cg_emit of [fc, OP_SET_LOCAL]
                cg_emit_u16 of [fc, i]
                cg_emit of [fc, OP_POP]
                cg_patch_jump of [fc, dhole]
    cg_block_discard of [fc, body]                    # body statements discarded
    # Underfed-call slot guarantee: the pinned VM pre-allocates env slots
    # (env_reserve_slots) only when local_count > param_count. Since the
    # v0.23.0 pin (#348) OP_SET_LOCAL on a slot >= env->count RAISES
    # "SET_LOCAL slot N out of range" (it used to silently drop the write) —
    # upstream chose runtime-error over auto-reserve, so this pad is the
    # legitimate reservation mechanism: without it, the defaults prologue in
    # a function with NO body locals would raise on every underfed call.
    # Padding one never-read local slot forces the reserve, so every param
    # slot exists (null) before the prologue runs — the same placeholder
    # state the C compiler's native path produces.
    if (has_defaults == 1) and (fc.next_slot == (len of params)):
        cg_add_local of [fc, "__defaults_pad"]
    cg_emit of [fc, OP_RETURN_NULL]                   # fall-through return
    local desc is [fc.code, fc.consts, fc.functions, len of params, fname, fc.local_names]
    local fn_idx is len of c.functions
    append of [c.functions, desc]
    cg_emit of [c, OP_CLOSURE]
    cg_emit_u16 of [c, fn_idx]
    cg_emit of [c, OP_SET_NAME_LOCAL]                 # bind the name in this scope
    cg_emit_u16 of [c, cg_const of [c, fname]]

# Emit OP_LINE for a statement's source line (drives error messages and the
# `<kw> is x at <line>` temporal query). `s` may be an _line-wrapped statement.
define cg_stmt_line(c, s) as:
    if s[0] == "_line":
        cg_emit of [c, OP_LINE]
        cg_emit_u32 of [c, s[1]]

# A statement list leaving its LAST value (null if empty).
define cg_block_value(c, stmts) as:
    if (len of stmts) == 0:
        cg_emit of [c, OP_NULL]
        return null
    for i in range of (len of stmts):
        local s is stmts[i]
        cg_stmt_line of [c, s]
        if s[0] == "_line":
            s is s[2]
        cg_node of [c, s]
        if i < ((len of stmts) - 1):
            cg_emit of [c, OP_POP]

# A statement list leaving NOTHING (every value popped).
define cg_block_discard(c, stmts) as:
    for i in range of (len of stmts):
        local s is stmts[i]
        cg_stmt_line of [c, s]
        if s[0] == "_line":
            s is s[2]
        cg_node of [c, s]
        cg_emit of [c, OP_POP]

# Collect names bound at module scope (top-level assigns + defines).
define cg_scan_module_names(stmts) as:
    for i in range of (len of stmts):
        local s is stmts[i]
        if s[0] == "_line":
            s is s[2]
        if s[0] == "assign":
            MODULE_NAMES[s[1]] is 1
        if s[0] == "func":
            MODULE_NAMES[s[1]] is 1
        if s[0] == "destructure":
            local d_names is s[1]
            for di in range of (len of d_names):
                MODULE_NAMES[d_names[di]] is 1
        # Descend into top-level block bodies — a name first bound inside a
        # module-scope if/loop/for/try is still a module binding (the C runtime
        # resolves it dynamically). Missing it made an inner function shadow the
        # name instead of mutating the global (silent wrong result). Function
        # bodies are NOT scanned (their assignments are function-scope).
        if s[0] == "if":
            cg_scan_module_names of s[2]
            cg_scan_module_names of s[3]
        if s[0] == "loop":
            cg_scan_module_names of s[2]
        if s[0] == "for":
            cg_scan_module_names of s[3]
        if s[0] == "try":
            cg_scan_module_names of s[1]
            cg_scan_module_names of s[3]

# Compile source to a chunk descriptor:
#   [ABI_REV, code, constants, functions, 0, name, []].
# Element 0 is the bytecode ABI revision stamp (upstream #704/#748): the
# runtime refuses a top-level descriptor whose stamp doesn't match its
# EIGS_BYTECODE_ABI, so a stale producer fails loudly instead of running
# with unverifiable operand widths. Nested function descriptors carry no
# stamp. Bump OURO_BYTECODE_ABI only together with an upstream revision.
OURO_BYTECODE_ABI is 1

define ouro_compile(source) as:
    local tokens is eigen_tokenize of source
    local ast is eigen_parse of tokens
    MODULE_NAMES is {}
    USES_HISTORY[0] is 0
    cg_scan_module_names of ast[1]
    local c is cg_new of 0
    cg_block_value of [c, ast[1]]
    cg_emit of [c, OP_RETURN]
    return [OURO_BYTECODE_ABI, c.code, c.consts, c.functions, 0, "<module>", []]

define ouro_run(source) as:
    local compiled is ouro_compile of source
    if USES_HISTORY[0] == 1:
        record_history of 1                            # prev / at need history
    return vm_run_bytecode of compiled
