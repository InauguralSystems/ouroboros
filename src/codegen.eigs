# ouroboros — a bytecode back-end for EigenScript, written in EigenScript.
#
# Front-end (src/frontend.eigs, vendored from lib/eigen.eigs) → AST; this file
# walks it and emits the C VM's bytecode as data, run via vm_run_bytecode. The
# chunk runs on the real VM, so codegen needs only semantic correctness, not
# byte-identity with compile_ast (F-OURO-2); the oracle is stdout parity.
#
# Compilation context `c` (one per module / function):
#   code, consts, functions  — this chunk's bytecode, pool, nested fn descriptors
#   loops                    — stack of {header, breaks} for break/continue
#   is_function              — 0 at module scope, 1 inside a function
#   locals, local_names, next_slot — local-slot allocation (params + body locals)
#
# Slice 3 adds functions and locals: define, parameters, `return`, local
# variables (slot-allocated), calls with EigenScript's `f of [a,b]` arg-spread
# convention, and recursion. The `local` keyword and the observer opcodes are
# still out of scope (the vendored front-end doesn't parse `local`; observers
# are a later slice).

# --- opcodes (src/vm.h enum order) ---------------------------------------
OP_CONST is 0
OP_NULL is 1
OP_ADD is 4
OP_SUB is 5
OP_MUL is 6
OP_DIV is 7
OP_MOD is 8
OP_BAND is 9
OP_BOR is 10
OP_BXOR is 11
OP_SHL is 12
OP_SHR is 13
OP_NEG is 14
OP_NOT is 15
OP_BNOT is 16
OP_EQ is 17
OP_NE is 18
OP_LT is 19
OP_GT is 20
OP_LE is 21
OP_GE is 22
OP_GET_LOCAL is 23
OP_SET_LOCAL is 24
OP_GET_NAME is 25
OP_SET_NAME is 26
OP_SET_NAME_LOCAL is 27
OP_JUMP is 29
OP_JUMP_BACK is 30
OP_JUMP_IF_FALSE is 31
OP_JUMP_IF_FALSE_PEEK is 33
OP_JUMP_IF_TRUE_PEEK is 34
OP_POP is 35
OP_DUP2 is 37
OP_CLOSURE is 38
OP_DICT is 43
OP_INDEX_GET is 44
OP_INDEX_SET is 45
OP_DOT_GET is 46
OP_DOT_SET is 47
OP_SLICE_GET is 80
OP_CALL is 39
OP_RETURN is 40
OP_RETURN_NULL is 41
OP_LIST is 42
OP_LISTCOMP_BEGIN is 66
OP_LISTCOMP_APPEND is 67
OP_ITER_SETUP is 48
OP_ITER_NEXT is 49
OP_TRY_BEGIN is 54
OP_TRY_END is 55
OP_LOOP_ENV_FRESH is 50
OP_LOOP_ENV_END is 51
OP_OBSERVE_ASSIGN is 56
OP_OBSERVE_ASSIGN_LOCAL is 57
OP_INTERROGATE is 58
OP_PREDICATE is 59
OP_INTERROGATE_NAMED is 76
OP_INTERROGATE_NAMED_AT is 77
OP_DEFAULT_PARAM is 78
OP_DESTRUCTURE_UNPACK is 79
# #262 Phase-3 slot model: re-observe a name binding AFTER its SET (the binding
# now exists), so the per-binding Env slot — not the Value object — carries the
# trajectory the predicates/report/interrogatives read. The C compiler emits
# this after every name `is` assignment; on the slot-default runtime it is
# load-bearing — without it a name is never observed (nums are now immediates).
OP_OBSERVE_NAME_POST is 82
OP_LINE is 68
OP_LOOP_STALL_CHECK is 62
OP_LOOP_CAP_CHECK is 63

# Names bound at module scope (assigns + defines). Inside a function, an `is`
# assignment to such a name modifies the module binding (SET_NAME) rather than
# shadowing it with a fresh local — matching compile_ast's resolution.
MODULE_NAMES is {}

# Set to 1 when the program uses `prev` or `... at <line>`, which need runtime
# per-assignment history recording (the C compiler enables it automatically; the
# self-hosted runner enables it via record_history in ouro_run).
USES_HISTORY is [0]

# --- context -------------------------------------------------------------
define cg_new(is_function) as:
    return {"code": [], "consts": [], "functions": [], "loops": [], "is_function": is_function, "locals": {}, "local_names": [], "next_slot": 0}

define cg_loop_top(c) as:
    return c.loops[(len of c.loops) - 1]

# Allocate a new local slot for `name`; return its index.
define cg_add_local(c, name) as:
    local slot is c.next_slot
    c.locals[name] is slot
    append of [c.local_names, name]
    c.next_slot is c.next_slot + 1
    return slot

# --- emit primitives -----------------------------------------------------
define cg_emit(c, byte) as:
    append of [c.code, byte]

define cg_emit_u16(c, val) as:
    append of [c.code, val % 256]
    append of [c.code, floor of (val / 256)]

define cg_const(c, val) as:
    for i in range of (len of c.consts):
        if c.consts[i] == val:
            return i
    append of [c.consts, val]
    return (len of c.consts) - 1

# --- jumps (offsets relative to the byte after the operand) ---------------
define cg_emit_jump(c, op) as:
    cg_emit of [c, op]
    local hole is len of c.code
    cg_emit of [c, 0]
    cg_emit of [c, 0]
    return hole

define cg_patch_jump(c, hole) as:
    local off is (len of c.code) - (hole + 2)
    c.code[hole] is off % 256
    c.code[hole + 1] is floor of (off / 256)

define cg_patch_breaks(c) as:
    local top is cg_loop_top of c
    for i in range of (len of top.breaks):
        cg_patch_jump of [c, top.breaks[i]]
    list_truncate of [c.loops, (len of c.loops) - 1]

define cg_emit_jump_back(c, target) as:
    cg_emit of [c, OP_JUMP_BACK]
    local off is ((len of c.code) + 2) - target
    cg_emit of [c, off % 256]
    cg_emit of [c, floor of (off / 256)]

define cg_binop_code(op) as:
    if op == "+":
        return OP_ADD
    if op == "-":
        return OP_SUB
    if op == "*":
        return OP_MUL
    if op == "/":
        return OP_DIV
    if op == "%":
        return OP_MOD
    if op == "&":
        return OP_BAND
    if op == "|":
        return OP_BOR
    if op == "^":
        return OP_BXOR
    if op == "<<":
        return OP_SHL
    if op == ">>":
        return OP_SHR
    if op == "==":
        return OP_EQ
    if op == "!=":
        return OP_NE
    if op == "<":
        return OP_LT
    if op == ">":
        return OP_GT
    if op == "<=":
        return OP_LE
    if op == ">=":
        return OP_GE
    throw of ("ouroboros: unsupported binary op '" + op + "'")

# Is a loop condition observer-based? (mirrors compile_ast's cond_is_observer_based:
# recurse only through unary/binop structure; a predicate makes it observer-based,
# everything else — names, calls, literals — is opaque and biases toward "plain".)
define cg_cond_observer(node) as:
    local t is node[0]
    if t == "_line":
        return cg_cond_observer of node[2]
    if t == "predicate":
        return 1
    if t == "unary":
        return cg_cond_observer of node[2]
    if t == "binop":
        if (cg_cond_observer of node[2]) == 1:
            return 1
        return cg_cond_observer of node[3]
    return 0

# --- variable resolution -------------------------------------------------
define cg_load_name(c, name) as:
    if (c.is_function == 1) and (has_key of [c.locals, name]):
        cg_emit of [c, OP_GET_LOCAL]
        cg_emit_u16 of [c, c.locals[name]]
    else:
        cg_emit of [c, OP_GET_NAME]
        cg_emit_u16 of [c, cg_const of [c, name]]

# Store TOS into `name` (value stays on the stack — all SET_* keep TOS). Each
# `is` assignment is preceded by the matching OBSERVE op, which updates the
# observer state (entropy / dH window) on the assigned value and sets it as the
# last observer — the foundation the predicates read. (Slot-based locals use the
# _LOCAL variants; name-based stores use OBSERVE_ASSIGN with the name index.)
define cg_store_name(c, name) as:
    if c.is_function == 1:
        if has_key of [c.locals, name]:
            local slot is c.locals[name]
            cg_emit of [c, OP_OBSERVE_ASSIGN_LOCAL]
            cg_emit_u16 of [c, slot]
            cg_emit of [c, OP_SET_LOCAL]
            cg_emit_u16 of [c, slot]
        elif has_key of [MODULE_NAMES, name]:
            local idx is cg_const of [c, name]
            cg_emit of [c, OP_OBSERVE_ASSIGN]
            cg_emit_u16 of [c, idx]
            cg_emit of [c, OP_SET_NAME]
            cg_emit_u16 of [c, idx]
            cg_emit of [c, OP_OBSERVE_NAME_POST]
            cg_emit_u16 of [c, idx]
        else:
            local nslot is cg_add_local of [c, name]
            cg_emit of [c, OP_OBSERVE_ASSIGN_LOCAL]
            cg_emit_u16 of [c, nslot]
            cg_emit of [c, OP_SET_LOCAL]
            cg_emit_u16 of [c, nslot]
    else:
        local midx is cg_const of [c, name]
        cg_emit of [c, OP_OBSERVE_ASSIGN]
        cg_emit_u16 of [c, midx]
        cg_emit of [c, OP_SET_NAME]
        cg_emit_u16 of [c, midx]
        cg_emit of [c, OP_OBSERVE_NAME_POST]
        cg_emit_u16 of [c, midx]

# --- node codegen: leaves exactly one value on the stack ------------------
define cg_node(c, node) as:
    local t is node[0]
    if t == "_line":
        cg_node of [c, node[2]]
        return null
    if t == "num":
        cg_emit of [c, OP_CONST]
        cg_emit_u16 of [c, cg_const of [c, node[1]]]
        return null
    if t == "str":
        cg_emit of [c, OP_CONST]
        cg_emit_u16 of [c, cg_const of [c, node[1]]]
        return null
    if t == "null":
        cg_emit of [c, OP_NULL]
        return null
    if t == "ident":
        cg_load_name of [c, node[1]]
        return null
    if t == "assign":
        cg_node of [c, node[2]]
        cg_store_name of [c, node[1]]
        return null
    if t == "binop":
        local op is node[1]
        if op == "and":
            cg_node of [c, node[2]]
            local ja is cg_emit_jump of [c, OP_JUMP_IF_FALSE_PEEK]
            cg_emit of [c, OP_POP]
            cg_node of [c, node[3]]
            cg_patch_jump of [c, ja]
            return null
        if op == "or":
            cg_node of [c, node[2]]
            local jo is cg_emit_jump of [c, OP_JUMP_IF_TRUE_PEEK]
            cg_emit of [c, OP_POP]
            cg_node of [c, node[3]]
            cg_patch_jump of [c, jo]
            return null
        cg_node of [c, node[2]]
        cg_node of [c, node[3]]
        cg_emit of [c, cg_binop_code of op]
        return null
    if t == "unary":
        cg_node of [c, node[2]]
        if node[1] == "-":
            cg_emit of [c, OP_NEG]
        elif node[1] == "~":
            cg_emit of [c, OP_BNOT]
        else:
            cg_emit of [c, OP_NOT]
        return null
    if t == "call":
        cg_node of [c, node[1]]                       # callee
        local arg is node[2]
        if arg[0] == "_line":
            arg is arg[2]
        # Calling convention (matches compile_ast): a list literal with 0 or >1
        # elements spreads into positional args (`f of [a, b]` -> f(a, b),
        # `f of []` -> zero-arg); a 1-element list does NOT spread — `f of [x]`
        # passes the one-element list [x] itself. Any non-list arg is one arg.
        # #355 (v0.24.0): a parenthesized literal list (3rd marker slot)
        # never spreads — it is one argument.
        if (arg[0] == "list") and ((len of arg) == 2) and ((len of arg[1]) != 1):
            local elems is arg[1]
            for i in range of (len of elems):
                cg_node of [c, elems[i]]
            cg_emit of [c, OP_CALL]
            cg_emit_u16 of [c, len of elems]
        else:
            cg_node of [c, arg]
            cg_emit of [c, OP_CALL]
            cg_emit_u16 of [c, 1]
        return null
    if t == "list":
        local elems is node[1]
        for i in range of (len of elems):
            cg_node of [c, elems[i]]
        cg_emit of [c, OP_LIST]
        cg_emit_u16 of [c, len of elems]
        return null
    if t == "dict":
        local pairs is node[1]
        for i in range of (len of pairs):
            cg_node of [c, pairs[i][0]]                # key
            cg_node of [c, pairs[i][1]]                # value
        cg_emit of [c, OP_DICT]
        cg_emit_u16 of [c, len of pairs]
        return null
    if t == "index":
        cg_node of [c, node[1]]                        # target
        cg_node of [c, node[2]]                        # index
        cg_emit of [c, OP_INDEX_GET]
        return null
    if t == "slice":
        cg_node of [c, node[1]]                        # target
        if node[2] == null:                            # start (NULL -> whole)
            cg_emit of [c, OP_NULL]
        else:
            cg_node of [c, node[2]]
        if node[3] == null:                            # end (NULL -> whole)
            cg_emit of [c, OP_NULL]
        else:
            cg_node of [c, node[3]]
        cg_emit of [c, OP_SLICE_GET]
        return null
    if t == "dot":
        cg_node of [c, node[1]]                        # target
        cg_emit of [c, OP_DOT_GET]
        cg_emit_u16 of [c, cg_const of [c, node[2]]]   # field name
        return null
    if t == "index_assign":
        cg_node of [c, node[1]]                        # target
        cg_node of [c, node[2]]                        # index
        if (len of node) >= 5:
            # Compound (`l[i] += e`): target/index evaluated ONCE, mirroring
            # the C compiler's DUP2 → INDEX_GET → expr → binop → INDEX_SET.
            cg_emit of [c, OP_DUP2]
            cg_emit of [c, OP_INDEX_GET]
            cg_node of [c, node[3]]                    # raw rhs
            cg_emit of [c, cg_binop_code of node[4]]
        else:
            cg_node of [c, node[3]]                    # value (kept on stack)
        cg_emit of [c, OP_INDEX_SET]
        return null
    if t == "destructure":
        # ["destructure", [names], rhs] — compile rhs, unpack into N stack
        # slots (element 0 at TOS), then store each name (stores keep TOS)
        # with an OP_POP between names; the last value remains, matching the
        # one-value-per-statement convention (C's AST_LIST_PATTERN_ASSIGN).
        cg_node of [c, node[2]]
        local d_names is node[1]
        cg_emit of [c, OP_DESTRUCTURE_UNPACK]
        cg_emit_u16 of [c, len of d_names]
        for i in range of (len of d_names):
            cg_store_name of [c, d_names[i]]
            if i < ((len of d_names) - 1):
                cg_emit of [c, OP_POP]
        return null
    if t == "dot_assign":
        cg_node of [c, node[1]]                        # target
        cg_node of [c, node[3]]                        # value (kept on stack)
        cg_emit of [c, OP_DOT_SET]
        cg_emit_u16 of [c, cg_const of [c, node[2]]]   # field name
        return null
    if t == "listcomp":
        # ["listcomp", expr, var, iter_expr, filter_or_null]
        cg_emit of [c, OP_LISTCOMP_BEGIN]              # accumulator
        cg_node of [c, node[3]]                        # iterable
        cg_emit of [c, OP_ITER_SETUP]
        local header is len of c.code
        local jn is cg_emit_jump of [c, OP_ITER_NEXT]  # exit when exhausted
        cg_emit of [c, OP_SET_NAME_LOCAL]
        cg_emit_u16 of [c, cg_const of [c, node[2]]]   # bind comprehension var
        cg_emit of [c, OP_POP]
        local jfilt is 0 - 1
        if node[4] != null:
            cg_node of [c, node[4]]                    # filter condition
            jfilt is cg_emit_jump of [c, OP_JUMP_IF_FALSE]
        cg_node of [c, node[1]]                        # element expression
        cg_emit of [c, OP_LISTCOMP_APPEND]
        if jfilt >= 0:
            cg_patch_jump of [c, jfilt]                # filter-false -> re-iterate
        cg_emit_jump_back of [c, header]
        cg_patch_jump of [c, jn]                       # exit
        cg_emit of [c, OP_POP]                         # drop iterator; accumulator remains
        return null
    if t == "predicate":
        # bare observer predicate (converged/stable/improving/...) — reads the
        # last-observed variable's entropy/dH window. kind matches compile_ast.
        cg_emit of [c, OP_PREDICATE]
        cg_emit_u16 of [c, node[1]]
        return null
    if t == "interrogate":
        # ["interrogate", kind, expr, at_expr]. kinds: 0 what,1 who,2 when,
        # 3 where,4 why,5 how,6 prev. Opcode selection mirrors compile_ast:
        #   at-form on an ident       -> INTERROGATE_NAMED_AT [kind][name]
        #   who/when/prev on an ident -> INTERROGATE_NAMED     [kind][name]
        #   otherwise (value-based)   -> INTERROGATE           [kind]
        local kind is node[1]
        local iexpr is node[2]
        local at_expr is node[3]
        local is_ident is (iexpr[0] == "ident")
        if (kind == 6) or (at_expr != null):
            USES_HISTORY[0] is 1                        # prev / at need history
        if (at_expr != null) and is_ident:
            cg_node of [c, at_expr]                     # push the line number
            cg_emit of [c, OP_INTERROGATE_NAMED_AT]
            cg_emit_u16 of [c, kind]
            cg_emit_u16 of [c, cg_const of [c, iexpr[1]]]
        else:
            cg_node of [c, iexpr]                       # push the target value
            # who/when/prev AND where/why/how on a known binding read its slot
            # (INTERROGATE_NAMED); only `what` (kind 0) stays value-based. The C
            # compiler routes where/why/how (3/4/5) to NAMED under the slot flag,
            # which is the default — and on the slot runtime the bare form would
            # read the now-empty Value, so NAMED is required for correctness.
            if is_ident and (kind != 0):
                cg_emit of [c, OP_INTERROGATE_NAMED]
                cg_emit_u16 of [c, kind]
                cg_emit_u16 of [c, cg_const of [c, iexpr[1]]]
            else:
                cg_emit of [c, OP_INTERROGATE]
                cg_emit_u16 of [c, kind]
        return null
    if t == "return":
        cg_node of [c, node[1]]
        cg_emit of [c, OP_RETURN]
        return null
    if t == "func":
        cg_func of [c, node]
        return null

    # ---- control flow ----
    if t == "if":
        cg_node of [c, node[1]]
        local jf is cg_emit_jump of [c, OP_JUMP_IF_FALSE]
        cg_block_value of [c, node[2]]
        local je is cg_emit_jump of [c, OP_JUMP]
        cg_patch_jump of [c, jf]
        cg_block_value of [c, node[3]]
        cg_patch_jump of [c, je]
        return null
    if t == "loop":
        local header is len of c.code
        append of [c.loops, {"header": header, "breaks": []}]
        cg_node of [c, node[1]]
        local jf is cg_emit_jump of [c, OP_JUMP_IF_FALSE]
        cg_block_discard of [c, node[2]]
        # Loop-stall classifier (#247, correctness-critical): an observer-based
        # condition (references a predicate) gets OP_LOOP_STALL_CHECK (opt-in
        # auto-halt on convergence); a plain condition gets OP_LOOP_CAP_CHECK
        # (iteration cap only). Encoded in the opcode at compile time.
        local cap_op is OP_LOOP_CAP_CHECK
        if (cg_cond_observer of node[1]) == 1:
            cap_op is OP_LOOP_STALL_CHECK
        local jcap is cg_emit_jump of [c, cap_op]
        cg_emit_jump_back of [c, header]
        cg_patch_jump of [c, jf]
        cg_patch_jump of [c, jcap]
        cg_patch_breaks of c
        cg_emit of [c, OP_NULL]
        return null
    if t == "for":
        cg_node of [c, node[2]]
        cg_emit of [c, OP_ITER_SETUP]
        local header is len of c.code
        append of [c.loops, {"header": header, "breaks": []}]
        local jn is cg_emit_jump of [c, OP_ITER_NEXT]
        cg_emit of [c, OP_LOOP_ENV_FRESH]
        # Bind the loop var. If it already owns a local slot (a parameter or an
        # earlier assignment in this function), write THAT slot — the body reads
        # it via GET_LOCAL, and a SET_NAME_LOCAL would leave the slot stale, so
        # the body never sees the iteration value (silent wrong result).
        if (c.is_function == 1) and (has_key of [c.locals, node[1]]):
            cg_emit of [c, OP_SET_LOCAL]
            cg_emit_u16 of [c, c.locals[node[1]]]
        else:
            cg_emit of [c, OP_SET_NAME_LOCAL]
            cg_emit_u16 of [c, cg_const of [c, node[1]]]
        cg_emit of [c, OP_POP]
        cg_block_discard of [c, node[3]]
        cg_emit of [c, OP_LOOP_ENV_END]
        cg_emit_jump_back of [c, header]
        cg_patch_jump of [c, jn]
        cg_patch_breaks of c
        cg_emit of [c, OP_POP]
        cg_emit of [c, OP_NULL]
        return null
    if t == "try":
        # ["try", try_body, err_name, catch_body]. TRY_BEGIN installs a handler
        # whose offset points at the catch; on throw the VM unwinds the try
        # body's stack and pushes the thrown value. Both paths leave one value.
        local tb is cg_emit_jump of [c, OP_TRY_BEGIN]
        cg_block_value of [c, node[1]]                 # try body -> 1 value
        cg_emit of [c, OP_TRY_END]
        local je is cg_emit_jump of [c, OP_JUMP]       # no-throw: skip the catch
        cg_patch_jump of [c, tb]                        # catch handler starts here
        cg_emit of [c, OP_SET_NAME_LOCAL]               # bind the thrown value
        cg_emit_u16 of [c, cg_const of [c, node[2]]]
        cg_emit of [c, OP_POP]
        cg_block_value of [c, node[3]]                  # catch body -> 1 value
        cg_patch_jump of [c, je]
        return null
    if t == "break":
        local hole is cg_emit_jump of [c, OP_JUMP]
        append of [(cg_loop_top of c).breaks, hole]
        return null
    if t == "continue":
        cg_emit_jump_back of [c, (cg_loop_top of c).header]
        return null

    throw of ("ouroboros: cannot compile node type '" + t + "'")

# Compile a function definition: ["func", name, params, body]. Builds a nested
# chunk descriptor, registers it in the parent's functions[], emits OP_CLOSURE,
# and binds the function name.
define cg_func(c, node) as:
    local fname is node[1]
    local params is node[2]
    local body is node[3]
    local fc is cg_new of 1
    for i in range of (len of params):
        cg_add_local of [fc, params[i]]               # params -> slots 0..P-1
    # Default-param prologue (mirrors the C compiler): for each param with a
    # default, OP_DEFAULT_PARAM <slot> <skip>; <default expr>; OP_SET_LOCAL;
    # OP_POP. The opcode compares slot vs frame->call_argc — if the caller
    # supplied the arg it skips the default (an explicit null stays null).
    # The descriptor format has no first_default field (the pinned
    # vm_run_bytecode sets it to param_count), but OP_DEFAULT_PARAM reads
    # only call_argc, so the hand-emitted prologue is sufficient.
    local has_defaults is 0
    if (len of node) >= 5:
        local defaults is node[4]
        for i in range of (len of defaults):
            if defaults[i] != null:
                has_defaults is 1
                cg_emit of [fc, OP_DEFAULT_PARAM]
                cg_emit_u16 of [fc, i]
                local dhole is len of fc.code
                cg_emit of [fc, 0]
                cg_emit of [fc, 0]
                cg_node of [fc, defaults[i]]
                cg_emit of [fc, OP_SET_LOCAL]
                cg_emit_u16 of [fc, i]
                cg_emit of [fc, OP_POP]
                cg_patch_jump of [fc, dhole]
    cg_block_discard of [fc, body]                    # body statements discarded
    # Underfed-call slot guarantee: the pinned VM pre-allocates env slots
    # (env_reserve_slots) only when local_count > param_count. Since the
    # v0.23.0 pin (#348) OP_SET_LOCAL on a slot >= env->count RAISES
    # "SET_LOCAL slot N out of range" (it used to silently drop the write) —
    # upstream chose runtime-error over auto-reserve, so this pad is the
    # legitimate reservation mechanism: without it, the defaults prologue in
    # a function with NO body locals would raise on every underfed call.
    # Padding one never-read local slot forces the reserve, so every param
    # slot exists (null) before the prologue runs — the same placeholder
    # state the C compiler's native path produces.
    if (has_defaults == 1) and (fc.next_slot == (len of params)):
        cg_add_local of [fc, "__defaults_pad"]
    cg_emit of [fc, OP_RETURN_NULL]                   # fall-through return
    local desc is [fc.code, fc.consts, fc.functions, len of params, fname, fc.local_names]
    local fn_idx is len of c.functions
    append of [c.functions, desc]
    cg_emit of [c, OP_CLOSURE]
    cg_emit_u16 of [c, fn_idx]
    cg_emit of [c, OP_SET_NAME_LOCAL]                 # bind the name in this scope
    cg_emit_u16 of [c, cg_const of [c, fname]]

# Emit OP_LINE for a statement's source line (drives error messages and the
# `<kw> is x at <line>` temporal query). `s` may be an _line-wrapped statement.
define cg_stmt_line(c, s) as:
    if s[0] == "_line":
        cg_emit of [c, OP_LINE]
        cg_emit_u16 of [c, s[1]]

# A statement list leaving its LAST value (null if empty).
define cg_block_value(c, stmts) as:
    if (len of stmts) == 0:
        cg_emit of [c, OP_NULL]
        return null
    for i in range of (len of stmts):
        local s is stmts[i]
        cg_stmt_line of [c, s]
        if s[0] == "_line":
            s is s[2]
        cg_node of [c, s]
        if i < ((len of stmts) - 1):
            cg_emit of [c, OP_POP]

# A statement list leaving NOTHING (every value popped).
define cg_block_discard(c, stmts) as:
    for i in range of (len of stmts):
        local s is stmts[i]
        cg_stmt_line of [c, s]
        if s[0] == "_line":
            s is s[2]
        cg_node of [c, s]
        cg_emit of [c, OP_POP]

# Collect names bound at module scope (top-level assigns + defines).
define cg_scan_module_names(stmts) as:
    for i in range of (len of stmts):
        local s is stmts[i]
        if s[0] == "_line":
            s is s[2]
        if s[0] == "assign":
            MODULE_NAMES[s[1]] is 1
        if s[0] == "func":
            MODULE_NAMES[s[1]] is 1
        if s[0] == "destructure":
            local d_names is s[1]
            for di in range of (len of d_names):
                MODULE_NAMES[d_names[di]] is 1
        # Descend into top-level block bodies — a name first bound inside a
        # module-scope if/loop/for/try is still a module binding (the C runtime
        # resolves it dynamically). Missing it made an inner function shadow the
        # name instead of mutating the global (silent wrong result). Function
        # bodies are NOT scanned (their assignments are function-scope).
        if s[0] == "if":
            cg_scan_module_names of s[2]
            cg_scan_module_names of s[3]
        if s[0] == "loop":
            cg_scan_module_names of s[2]
        if s[0] == "for":
            cg_scan_module_names of s[3]
        if s[0] == "try":
            cg_scan_module_names of s[1]
            cg_scan_module_names of s[3]

# Compile source to a chunk descriptor: [code, constants, functions, 0, name, []].
define ouro_compile(source) as:
    local tokens is eigen_tokenize of source
    local ast is eigen_parse of tokens
    MODULE_NAMES is {}
    USES_HISTORY[0] is 0
    cg_scan_module_names of ast[1]
    local c is cg_new of 0
    cg_block_value of [c, ast[1]]
    cg_emit of [c, OP_RETURN]
    return [c.code, c.consts, c.functions, 0, "<module>", []]

define ouro_run(source) as:
    local compiled is ouro_compile of source
    if USES_HISTORY[0] == 1:
        record_history of 1                            # prev / at need history
    return vm_run_bytecode of compiled
