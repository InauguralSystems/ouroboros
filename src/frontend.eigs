# ============================================================
# EigenScript Meta-Circular Interpreter
# ============================================================
#
# EigenScript implemented in EigenScript — full parity with C evaluator.
#
# Usage:
#   load_file of "lib/eigen.eigs"
#   result is eigen_run of "x is 42\nprint of x"
#
# Components:
#   eigen_tokenize of source    -> list of [type, value, line] tokens
#   eigen_parse of tokens       -> AST (nested lists)
#   eigen_eval of [ast, env]    -> value
#   eigen_run of source         -> evaluate source string

# ============================================================
# Tokenizer
# ============================================================

# Token types (strings for readability):
# "num", "str", "ident", "op", "kw", "newline", "indent", "dedent", "eof"
# "lparen", "rparen", "lbracket", "rbracket", "lbrace", "rbrace"
# "comma", "colon", "dot", "arrow", "pipe", "null"

define _is_digit(c) as:
    return contains of ["0123456789", c]

define _is_alpha(c) as:
    return contains of ["abcdefghijklmnopqrstuvwxyz_ABCDEFGHIJKLMNOPQRSTUVWXYZ", c]

define _is_alnum(c) as:
    if (_is_alpha of c) == 1:
        return 1
    return _is_digit of c

define _is_space(c) as:
    if c == " ":
        return 1
    if c == "\t":
        return 1
    return 0

define _is_hex_digit(c) as:
    return contains of ["0123456789abcdefABCDEF", c]

define _hex_val(c) as:
    local i is index_of of ["0123456789abcdefABCDEF", c]
    if i < 0:
        return 0
    if i >= 16:
        return i - 6
    return i

# Full keyword list matching C lexer
_keywords is ["is", "of", "define", "as", "if", "else", "elif", "loop", "while", "return", "and", "or", "not", "for", "in", "null", "try", "catch", "break", "continue", "import", "match", "case", "unobserved", "local", "prev", "at", "what", "who", "when", "where", "why", "how", "converged", "stable", "improving", "oscillating", "diverging", "equilibrium"]

# Interrogative keywords
_interrogatives is ["what", "who", "when", "where", "why", "how"]

# Predicate keywords
_predicates is ["converged", "stable", "improving", "oscillating", "diverging", "equilibrium"]

define _is_keyword(word) as:
    for i in range of (len of _keywords):
        if word == _keywords[i]:
            return 1
    return 0

define _is_interrogative(word) as:
    for i in range of (len of _interrogatives):
        if word == _interrogatives[i]:
            return 1
    return 0

define _is_predicate(word) as:
    for i in range of (len of _predicates):
        if word == _predicates[i]:
            return 1
    return 0

define _predicate_index(word) as:
    for i in range of (len of _predicates):
        if word == _predicates[i]:
            return i
    return 0

define _interrogative_index(word) as:
    for i in range of (len of _interrogatives):
        if word == _interrogatives[i]:
            return i
    return 0

define eigen_tokenize(source) as:
    tokens is []
    pos is 0
    line is 1
    src_len is len of source
    indent_stack is [0]
    at_line_start is 1
    bracket_depth is 0

    loop while pos < src_len:
        # Handle line start: measure indent
        if at_line_start == 1:
            at_line_start is 0
            if bracket_depth == 0:
                # lexer.c:252-256 measures indent in THREE ordered runs --
                # spaces, then tabs, then trailing spaces -- and STOPS: a tab
                # after that demotes to inline whitespace. This loop used to
                # count space/tab interleaved in any order, which silently
                # ACCEPTED block structure the C lexer rejects ("unexpected
                # indent", rc 1, vs the frontend running the program, rc 0 --
                # the over-acceptance rot class reject_one exists to stop).
                spaces is 0
                loop while (pos < src_len) and ((char_at of [source, pos]) == " "):
                    spaces is spaces + 1
                    pos is pos + 1
                if (pos < src_len) and ((char_at of [source, pos]) == "\t"):
                    loop while (pos < src_len) and ((char_at of [source, pos]) == "\t"):
                        spaces is spaces + 4
                        pos is pos + 1
                    loop while (pos < src_len) and ((char_at of [source, pos]) == " "):
                        spaces is spaces + 1
                        pos is pos + 1
                # Skip comment lines
                if pos < src_len:
                    if (char_at of [source, pos]) == "#":
                        loop while (pos < src_len) and ((char_at of [source, pos]) != "\n"):
                            pos is pos + 1
                        if pos < src_len:
                            pos is pos + 1
                            line is line + 1
                        at_line_start is 1
                        continue
                # Skip blank lines. #880 mirror: a CRLF blank line -- swallow
                # the CR so the "\n" below sees an empty line. The C lexer
                # skips CR ONLY when the next byte is LF (lexer.c:265,308); a
                # lone CR stays an error on both sides, measured before
                # writing this -- CRLF sources ran on the VM and died here.
                blank_line is 0
                if (pos + 1) < src_len:
                    if ((char_at of [source, pos]) == "\r") and ((char_at of [source, pos + 1]) == "\n"):
                        pos is pos + 1
                if pos < src_len:
                    if (char_at of [source, pos]) == "\n":
                        pos is pos + 1
                        line is line + 1
                        at_line_start is 1
                        blank_line is 1
                if pos >= src_len:
                    blank_line is 1
                if blank_line == 0:
                    # Emit indent/dedent
                    current_indent is indent_stack[(len of indent_stack) - 1]
                    if spaces > current_indent:
                        append of [indent_stack, spaces]
                        append of [tokens, ["indent", null, line]]
                    else:
                        loop while spaces < (indent_stack[(len of indent_stack) - 1]):
                            # pop
                            new_stack is []
                            for si in range of ((len of indent_stack) - 1):
                                append of [new_stack, indent_stack[si]]
                            indent_stack is new_stack
                            append of [tokens, ["dedent", null, line]]
                        # C lexer (lexer.c): after popping, the indent must
                        # land EXACTLY on an outer level — a partial dedent
                        # silently changed block structure here (#99).
                        if spaces != (indent_stack[(len of indent_stack) - 1]):
                            throw of ("ouroboros: indentation does not match any outer level at line " + (str of line))
        # Now handle non-indent characters
        if (at_line_start == 0) and (pos < src_len):
            c is char_at of [source, pos]
            handled is 0
            # Skip inline spaces. CR is space ONLY as the CR of a CRLF pair
            # (lexer.c:308 mirrors: ' ' | '\t' | '\r'+LF); skipping a lone CR
            # here would over-accept what the C lexer rejects.
            if (_is_space of c) == 1:
                pos is pos + 1
                handled is 1
            if (handled == 0) and (c == "\r") and ((pos + 1) < src_len):
                if (char_at of [source, pos + 1]) == "\n":
                    pos is pos + 1
                    handled is 1
            # Comments
            if (handled == 0) and (c == "#"):
                commenting is 1
                loop while (pos < src_len) and (commenting == 1):
                    ch2 is char_at of [source, pos]
                    if ch2 == "\n":
                        commenting is 0
                    else:
                        pos is pos + 1
                handled is 1
            # Newlines
            if (handled == 0) and (c == "\n"):
                if bracket_depth == 0:
                    if (len of tokens) > 0:
                        last is tokens[(len of tokens) - 1]
                        if last[0] != "newline":
                            if last[0] != "indent":
                                if last[0] != "dedent":
                                    append of [tokens, ["newline", null, line]]
                    at_line_start is 1
                pos is pos + 1
                line is line + 1
                handled is 1
            # f-strings: f"text {expr}"
            if (handled == 0) and (c == "f") and ((pos + 1) < src_len):
                if (char_at of [source, pos + 1]) == "\"":
                    pos is pos + 2
                    # Wrap the whole desugaring in parens so the f-string is a
                    # single primary (like the C parser's TOK_FSTR), regardless
                    # of surrounding precedence. Without this, `print of f"..."`
                    # mis-parses once `of` binds tightly: `of` would take only
                    # the first `seg` and leave `+ (str of ...)` as a stray
                    # statement.
                    append of [tokens, ["lparen", null, line]]
                    has_segments is 0
                    buf is ""
                    reading_fstr is 1
                    loop while (pos < src_len) and (reading_fstr == 1):
                        fc is char_at of [source, pos]
                        if fc == "\"":
                            pos is pos + 1
                            reading_fstr is 0
                        elif fc == "\\":
                            pos is pos + 1
                            if pos < src_len:
                                esc is char_at of [source, pos]
                                if esc == "n":
                                    buf is buf + "\n"
                                elif esc == "t":
                                    buf is buf + "\t"
                                elif esc == "r":
                                    # lexer.c:361 decodes \r; this table never
                                    # did, and the first line of OUR OWN SOURCE
                                    # to use "\r" exposed it: self-compiled,
                                    # the comparison became c == "r" and the
                                    # stage-2 lexer ate any lone identifier r
                                    # before a newline ("return r" lost its
                                    # operand). The bootstrap fixed point is
                                    # the gate that caught it.
                                    buf is buf + "\r"
                                elif esc == "\\":
                                    buf is buf + "\\"
                                elif esc == "\"":
                                    buf is buf + "\""
                                elif esc == "{":
                                    buf is buf + "{"
                                elif esc == "}":
                                    buf is buf + "}"
                                else:
                                    buf is buf + esc
                                pos is pos + 1
                        elif fc == "{":
                            # Emit accumulated literal
                            if ((len of buf) > 0) or (has_segments == 0):
                                if has_segments == 1:
                                    append of [tokens, ["op", "+", line]]
                                append of [tokens, ["str", buf, line]]
                                has_segments is 1
                            buf is ""
                            pos is pos + 1
                            # Emit + (str of (expr))
                            if has_segments == 1:
                                append of [tokens, ["op", "+", line]]
                            else:
                                has_segments is 1
                            append of [tokens, ["lparen", null, line]]
                            append of [tokens, ["ident", "str", line]]
                            append of [tokens, ["kw", "of", line]]
                            append of [tokens, ["lparen", null, line]]
                            # Collect expression text inside braces
                            depth is 1
                            expr_buf is ""
                            loop while (pos < src_len) and (depth > 0):
                                bc is char_at of [source, pos]
                                if bc == "\"":
                                    # #334's OTHER half, never mirrored: a
                                    # string literal inside {...} is copied
                                    # wholesale so its braces are text --
                                    # f"{"a}b"}" prints a}b on the VM and this
                                    # collector cut at the } inside the string
                                    # ("unterminated string", rc 1). Escapes
                                    # ride through in pairs, exactly as
                                    # lexer.c:400-410 does.
                                    expr_buf is expr_buf + bc
                                    pos is pos + 1
                                    loop while (pos < src_len) and ((char_at of [source, pos]) != "\""):
                                        local bsc is char_at of [source, pos]
                                        if (bsc == "\\") and ((pos + 1) < src_len):
                                            expr_buf is expr_buf + bsc
                                            pos is pos + 1
                                            bsc is char_at of [source, pos]
                                        expr_buf is expr_buf + bsc
                                        pos is pos + 1
                                    if pos < src_len:
                                        expr_buf is expr_buf + "\""
                                        pos is pos + 1
                                elif bc == "{":
                                    depth is depth + 1
                                    expr_buf is expr_buf + bc
                                    pos is pos + 1
                                elif bc == "}":
                                    depth is depth - 1
                                    if depth > 0:
                                        expr_buf is expr_buf + bc
                                    pos is pos + 1
                                else:
                                    expr_buf is expr_buf + bc
                                    pos is pos + 1
                            # C lexer: a brace expression still open at
                            # end-of-source is a loud error (#99).
                            if depth > 0:
                                throw of ("ouroboros: unterminated f-string expression at line " + (str of line))
                            # Recursively tokenize the inner expression.
                            # Layout tokens from the sub-lex are meaningless
                            # inside a spliced expression — the C lexer drops
                            # NEWLINE, INDENT and DEDENT; dropping only
                            # eof/newline left `f"v={ 1 + 2 }"` with a stray
                            # indent token (leading space = line-start indent
                            # in the sub-lex) and broke the parse (#99).
                            inner_tokens is eigen_tokenize of expr_buf
                            for iti in range of (len of inner_tokens):
                                itok is inner_tokens[iti]
                                if itok[0] != "eof":
                                    if itok[0] != "newline":
                                        if itok[0] != "indent":
                                            if itok[0] != "dedent":
                                                append of [tokens, itok]
                            append of [tokens, ["rparen", null, line]]
                            append of [tokens, ["rparen", null, line]]
                        else:
                            buf is buf + fc
                            pos is pos + 1
                    # C lexer: an f-string still open at end-of-source is a
                    # loud "unterminated f-string" error (#99).
                    if reading_fstr == 1:
                        throw of ("ouroboros: unterminated f-string at line " + (str of line))
                    # Emit trailing literal
                    if (len of buf) > 0:
                        if has_segments == 1:
                            append of [tokens, ["op", "+", line]]
                        append of [tokens, ["str", buf, line]]
                    elif has_segments == 0:
                        append of [tokens, ["str", "", line]]
                    append of [tokens, ["rparen", null, line]]  # close the wrap
                    handled is 1
            # Strings
            if (handled == 0) and (c == "\""):
                pos is pos + 1
                buf is ""
                reading_str is 1
                loop while (pos < src_len) and (reading_str == 1):
                    ch is char_at of [source, pos]
                    if ch == "\"":
                        pos is pos + 1
                        reading_str is 0
                    elif ch == "\\":
                        pos is pos + 1
                        esc is char_at of [source, pos]
                        if esc == "n":
                            buf is buf + "\n"
                        elif esc == "t":
                            buf is buf + "\t"
                        elif esc == "r":
                            # see the f-string site: lexer.c:361 parity
                            buf is buf + "\r"
                        elif esc == "\\":
                            buf is buf + "\\"
                        elif esc == "\"":
                            buf is buf + "\""
                        else:
                            buf is buf + esc
                        pos is pos + 1
                    else:
                        buf is buf + ch
                        pos is pos + 1
                # C lexer: a string still open at end-of-source is a loud
                # "unterminated string" error — emitting the accumulated
                # buffer silently swallowed every following line (#99).
                if reading_str == 1:
                    throw of ("ouroboros: unterminated string at line " + (str of line))
                append of [tokens, ["str", buf, line]]
                handled is 1
            # Numbers (integer, decimal, leading-dot, scientific notation),
            # matching the C lexer's strtod. A leading `.` starts a number only
            # when followed by a digit, so `.field` still lexes as a dot.
            num_start is 0
            if handled == 0:
                if (_is_digit of c) == 1:
                    num_start is 1
                elif (c == ".") and ((pos + 1) < src_len):
                    if (_is_digit of (char_at of [source, pos + 1])) == 1:
                        num_start is 1
            if num_start == 1:
                # Hex INTEGER literals (v0.25.0 pin, upstream #378): the C
                # lexer consumes 0x/0X + hex digits itself — strtod never
                # sees a hex prefix. 0x starts a hex number ONLY when a hex
                # digit follows; otherwise (`0x`, `0x.8`) the plain-number
                # path below lexes just the `0`, the `x` re-lexes as an
                # identifier, and the parse fails loudly — identical to the
                # C lexer's decisive-prefix behavior. Hex-float fraction and
                # p/P-exponent forms are gone from the language.
                is_hex is 0
                if (c == "0") and ((pos + 2) < src_len):
                    xch is char_at of [source, pos + 1]
                    if (xch == "x") or (xch == "X"):
                        if (_is_hex_digit of (char_at of [source, pos + 2])) == 1:
                            is_hex is 1
                if is_hex == 1:
                    hval is 0
                    pos is pos + 2
                    reading_hex is 1
                    loop while (pos < src_len) and (reading_hex == 1):
                        hch is char_at of [source, pos]
                        if (_is_hex_digit of hch) == 1:
                            hval is (hval * 16) + (_hex_val of hch)
                            pos is pos + 1
                        else:
                            reading_hex is 0
                    append of [tokens, ["num", hval, line]]
                    handled is 1
            if (num_start == 1) and (handled == 0):
                buf is ""
                has_dot is 0
                reading_num is 1
                loop while (pos < src_len) and (reading_num == 1):
                    ch is char_at of [source, pos]
                    if (_is_digit of ch) == 1:
                        buf is buf + ch
                        pos is pos + 1
                    elif (ch == ".") and (has_dot == 0):
                        has_dot is 1
                        buf is buf + ch
                        pos is pos + 1
                    else:
                        reading_num is 0
                # Exponent: e/E, optional sign, >=1 digit. The lookahead guards
                # against consuming a bare `e` (strtod parity: `1e` -> 1 + `e`).
                if pos < src_len:
                    ech is char_at of [source, pos]
                    if (ech == "e") or (ech == "E"):
                        ep is pos + 1
                        esign is ""
                        if ep < src_len:
                            sc is char_at of [source, ep]
                            if (sc == "+") or (sc == "-"):
                                esign is sc
                                ep is ep + 1
                        if ep < src_len:
                            if (_is_digit of (char_at of [source, ep])) == 1:
                                buf is buf + ech + esign
                                pos is ep
                                loop while (pos < src_len) and ((_is_digit of (char_at of [source, pos])) == 1):
                                    buf is buf + (char_at of [source, pos])
                                    pos is pos + 1
                append of [tokens, ["num", num of buf, line]]
                handled is 1
            # Identifiers and keywords
            if (handled == 0) and ((_is_alpha of c) == 1):
                buf is ""
                reading_id is 1
                loop while (pos < src_len) and (reading_id == 1):
                    ch is char_at of [source, pos]
                    if (_is_alnum of ch) == 1:
                        buf is buf + ch
                        pos is pos + 1
                    else:
                        reading_id is 0
                if buf == "null":
                    append of [tokens, ["null", null, line]]
                elif (_is_interrogative of buf) == 1:
                    append of [tokens, ["interrogative", buf, line]]
                elif (_is_predicate of buf) == 1:
                    append of [tokens, ["predicate", buf, line]]
                elif (_is_keyword of buf) == 1:
                    append of [tokens, ["kw", buf, line]]
                else:
                    append of [tokens, ["ident", buf, line]]
                handled is 1
            # Three-character operators (<<=, >>=) — must precede the two-char
            # checks so longest-match wins.
            if (handled == 0) and ((pos + 2) < src_len):
                three is (c + (char_at of [source, pos + 1])) + (char_at of [source, pos + 2])
                if (three == "<<=") or (three == ">>="):
                    append of [tokens, ["op", three, line]]
                    pos is pos + 3
                    handled is 1
            # Two-character operators
            if (handled == 0) and ((pos + 1) < src_len):
                next is char_at of [source, pos + 1]
                two is c + next
                if two == "==":
                    append of [tokens, ["op", "==", line]]
                    pos is pos + 2
                    handled is 1
                elif two == "!=":
                    append of [tokens, ["op", "!=", line]]
                    pos is pos + 2
                    handled is 1
                elif two == "<=":
                    append of [tokens, ["op", "<=", line]]
                    pos is pos + 2
                    handled is 1
                elif two == ">=":
                    append of [tokens, ["op", ">=", line]]
                    pos is pos + 2
                    handled is 1
                elif two == "=>":
                    append of [tokens, ["arrow", null, line]]
                    pos is pos + 2
                    handled is 1
                elif two == "|>":
                    append of [tokens, ["pipe", null, line]]
                    pos is pos + 2
                    handled is 1
                elif (two == "+=") or (two == "-=") or (two == "*=") or (two == "/=") or (two == "%="):
                    append of [tokens, ["op", two, line]]
                    pos is pos + 2
                    handled is 1
                elif (two == "&=") or (two == "|=") or (two == "^="):
                    append of [tokens, ["op", two, line]]
                    pos is pos + 2
                    handled is 1
                elif (two == "<<") or (two == ">>"):
                    append of [tokens, ["op", two, line]]
                    pos is pos + 2
                    handled is 1
            # Single-character operators and punctuation
            if handled == 0:
                if (contains of ["+-*/%<>&|^~", c]) == 1:
                    append of [tokens, ["op", c, line]]
                    pos is pos + 1
                    handled is 1
                elif c == "(":
                    append of [tokens, ["lparen", null, line]]
                    pos is pos + 1
                    bracket_depth is bracket_depth + 1
                    handled is 1
                elif c == ")":
                    append of [tokens, ["rparen", null, line]]
                    pos is pos + 1
                    if bracket_depth > 0:
                        bracket_depth is bracket_depth - 1
                    handled is 1
                elif c == "[":
                    append of [tokens, ["lbracket", null, line]]
                    pos is pos + 1
                    bracket_depth is bracket_depth + 1
                    handled is 1
                elif c == "]":
                    append of [tokens, ["rbracket", null, line]]
                    pos is pos + 1
                    if bracket_depth > 0:
                        bracket_depth is bracket_depth - 1
                    handled is 1
                elif c == "{":
                    append of [tokens, ["lbrace", null, line]]
                    pos is pos + 1
                    bracket_depth is bracket_depth + 1
                    handled is 1
                elif c == "}":
                    append of [tokens, ["rbrace", null, line]]
                    pos is pos + 1
                    if bracket_depth > 0:
                        bracket_depth is bracket_depth - 1
                    handled is 1
                elif c == ",":
                    append of [tokens, ["comma", null, line]]
                    pos is pos + 1
                    handled is 1
                elif c == ":":
                    append of [tokens, ["colon", null, line]]
                    pos is pos + 1
                    handled is 1
                elif c == ".":
                    append of [tokens, ["dot", null, line]]
                    pos is pos + 1
                    handled is 1
                else:
                    # Unknown character — raise, matching the C lexer. Silently
                    # skipping it dropped real tokens (the `=` of `+=`, the
                    # bitwise `& | ^ ~`, `\`, `@`, …) and produced a
                    # silently-WRONG parse instead of an error — e.g. `x += 3`
                    # lexed as `x + 3` (discarded) and `~5` as `5`.
                    throw of ("ouroboros: unexpected character '" + c + "' at line " + (str of line))

    # Emit remaining dedents
    loop while (len of indent_stack) > 1:
        new_stack is []
        for si in range of ((len of indent_stack) - 1):
            append of [new_stack, indent_stack[si]]
        indent_stack is new_stack
        append of [tokens, ["dedent", null, line]]

    append of [tokens, ["eof", null, line]]
    return tokens

# ============================================================
# Parser
# ============================================================
#
# AST nodes are lists: [type, ...data]
# Examples:
#   ["num", 42]
#   ["str", "hello"]
#   ["ident", "x"]
#   ["assign", "x", expr]
#   ["binop", "+", left, right]
#   ["call", fn_expr, arg_expr]
#   ["if", cond, if_body, else_body]
#   ["loop", cond, body]
#   ["for", var, iter, body]
#   ["func", name, [params], body]
#   ["return", expr]
#   ["list", [elems]]
#   ["index", target, idx]
#   ["null"]
#   ["try", try_body, err_name, catch_body]
#   ["block", [stmts]]
#   ["dict", [[key, val], ...]]
#   ["dot", target, "field"]
#   ["dot_assign", target, "field", expr]
#   ["index_assign", target, index, expr]          (5th elem: compound base op)
#   ["destructure", [names], expr]
#   ["func", name, [params], body, [defaults]]     (defaults: expr or null per param)
#   ["lambda", [params], body_expr]
#   ["match", expr, [[pattern, body], ...]]
#   ["break"]
#   ["continue"]
#   ["import", name]
#   ["listcomp", expr, var, iter_expr, filter_expr_or_null]
#   ["unobserved", body_stmts]
#   ["interrogate", kind, expr]
#   ["predicate", kind]

define _parser_new(tokens) as:
    return [tokens, 0]

define _p_pos(p) as:
    return p[1]

define _p_cur(p) as:
    if p[1] >= (len of p[0]):
        return ["eof", null, 0]
    return p[0][p[1]]

define _p_advance(p) as:
    set_at of [p, 1, p[1] + 1]

define _p_peek_type(p) as:
    tok is _p_cur of p
    return tok[0]

define _p_peek_val(p) as:
    tok is _p_cur of p
    return tok[1]

define _p_peek_at(p, offset) as:
    idx is p[1] + offset
    if idx >= (len of p[0]):
        return ["eof", null, 0]
    return p[0][idx]

define _p_expect(p, ttype) as:
    tok is _p_cur of p
    if tok[0] != ttype:
        throw of f"parse error: expected {ttype}, got {tok[0]} ('{tok[1]}') at line {tok[2]}"
    _p_advance of p
    return tok

# Expect one SPECIFIC keyword, mirroring the C parser's p_expect(TOK_IN) /
# p_expect(TOK_CATCH) exact-token checks. A bare kw-class expect accepted ANY
# keyword (`for x of [1,2]:` parsed, C rejects) — #99 item 8.
define _p_expect_kw(p, word) as:
    tok is _p_cur of p
    if tok[0] != "kw":
        throw of f"parse error: expected {word}, got {tok[0]} ('{tok[1]}') at line {tok[2]}"
    if tok[1] != word:
        throw of f"parse error: expected {word}, got {tok[0]} ('{tok[1]}') at line {tok[2]}"
    _p_advance of p
    return tok

# Soft keywords are usable as ordinary identifiers outside their special forms,
# mirroring the canonical C parser (EigenScript/src/parser.c). prev/at tokenize
# as "kw", the six question words as "interrogative".
# Identifier-like in a binding position (params, loop vars, catch, local):
define _tok_ident_like(tok) as:
    if tok[0] == "ident":
        return 1
    if tok[0] == "interrogative":
        return 1
    if tok[0] == "kw":
        if (tok[1] == "prev") or (tok[1] == "at"):
            return 1
    return 0

# A bare `X is ...` assignment target: identifier-like minus the question words
# (`what is e` is the interrogative form). prev/at have no `is` special form.
define _tok_assign_name(tok) as:
    if tok[0] == "ident":
        return 1
    if tok[0] == "kw":
        if (tok[1] == "prev") or (tok[1] == "at"):
            return 1
    return 0

# Consume an identifier-like token in a binding position; return it.
define _p_expect_ident_like(p) as:
    tok is _p_cur of p
    if (_tok_ident_like of tok) == 0:
        throw of f"parse error: expected identifier, got {tok[0]} ('{tok[1]}') at line {tok[2]}"
    _p_advance of p
    return tok

define _p_skip_newlines(p) as:
    loop while (_p_peek_type of p) == "newline":
        _p_advance of p

# Dot keys (upstream #542, in the v0.30.0 pin): after `.` nothing but a field
# name can appear, so the position is unambiguous and ANY word serves as a
# key — mirrors the C parser's tok_is_dot_key (TOK_IDENT plus the whole
# contiguous word-keyword run TOK_IS..TOK_LOCAL, all lexed through the
# identifier path). Frontend-side that is "ident" plus every word-lexed
# token type: "kw", "interrogative", "predicate", and "null"; the "null"
# token carries no lexeme, so the word is restored here. Returns the key
# STRING, covering read, write, compound assign, any chain depth.
define _p_expect_dot_key(p) as:
    local tok is _p_cur of p
    if tok[0] == "ident":
        _p_advance of p
        return tok[1]
    if (tok[0] == "kw") or (tok[0] == "interrogative") or (tok[0] == "predicate"):
        _p_advance of p
        return tok[1]
    if tok[0] == "null":
        _p_advance of p
        return "null"
    throw of f"parse error: expected ident, got {tok[0]} ('{tok[1]}') at line {tok[2]}"

# Statement-terminator enforcement (upstream #326, in the v0.23.0 pin): a
# SIMPLE statement must be followed by newline / dedent / eof — leftover
# tokens are a parse error ("one statement per line"). Called at the simple-
# statement return points only; block statements (if/for/loop/define/try/
# match/unobserved) consume their own DEDENT, so they must NOT get this check.
# (v0.24.0: upstream #351 closed the old dot-/index-assign terminator gap —
# the exemption that used to live on those paths is gone; the reject canary
# in test/ pins the enforcement.)
define _p_end_statement(p) as:
    tt is _p_peek_type of p
    if tt == "newline":
        return null
    if tt == "eof":
        return null
    if tt == "dedent":
        return null
    tok is _p_cur of p
    throw of f"parse error: unexpected {tok[0]} ('{tok[1]}') after statement at line {tok[2]} — one statement per line"

define _p_parse_block(p) as:
    stmts is []
    if (_p_peek_type of p) == "indent":
        _p_advance of p
        loop while (_p_peek_type of p) != "dedent":
            if (_p_peek_type of p) == "eof":
                return stmts
            _p_skip_newlines of p
            if (_p_peek_type of p) == "dedent":
                return stmts
            stmt is _p_parse_statement of p
            if stmt != null:
                append of [stmts, stmt]
            _p_skip_newlines of p
        _p_advance of p
    else:
        # NO single-line arm, and one lived here for the frontend's whole
        # life. parser.c requires an indent after EVERY colon header --
        # `if 1 == 1: print of x` is "expected indent, got identifier" -- and
        # this arm parsed the NEXT LINE as the body instead, so a colon header
        # with an unindented follower ran (rc 0, wrong tree possible) where
        # the oracle dies rc 1. The worst measured shape parsed a SAME-INDENT
        # `print` as the body of the `if` above it. Silent over-acceptance in
        # the parser, one level above the two lexer mirrors of the previous
        # round; registered in reject_one alongside them.
        throw of ("ouroboros: expected indent after ':' block header (line " + (str of ((_p_cur of p)[2])) + ")")
    return stmts

define _p_parse_statement(p) as:
    _p_skip_newlines of p
    tt is _p_peek_type of p
    _stmt_line is (_p_cur of p)[2]

    if tt == "eof":
        return null
    if tt == "dedent":
        return null

    # define
    if tt == "kw":
        # local NAME is expr — declare a binding in the CURRENT scope only,
        # mirroring the C parser's TOK_LOCAL statement (AST_ASSIGN with
        # local_only=1). The marker rides as a 4th element on the assign
        # node; codegen honors it like compiler.c's emit_assign_for_tos
        # (#99 item 2 — dropping it made `local` shadowing a module name
        # MUTATE the module binding, the exact outward-mutation `local`
        # exists to prevent). `is` is required, as in C (p_expect TOK_IS).
        if (_p_peek_val of p) == "local":
            _p_advance of p
            local_tok is _p_expect_ident_like of p
            is_ok is 0
            if (_p_peek_type of p) == "kw":
                if (_p_peek_val of p) == "is":
                    _p_advance of p
                    is_ok is 1
            if is_ok == 0:
                bad is _p_cur of p
                throw of f"parse error: expected is, got {bad[0]} ('{bad[1]}') at line {bad[2]}"
            local_expr is _p_parse_expr of p
            _p_end_statement of p
            return ["_line", _stmt_line, ["assign", local_tok[1], local_expr, 1]]
        if (_p_peek_val of p) == "define":
            _p_advance of p
            name_tok is _p_expect of [p, "ident"]
            name is name_tok[1]
            # Optional params; each may carry a trailing default
            # (`define f(a, b is 10)`), matching the C parser. A required
            # param may not follow a defaulted one.
            params is []
            param_defaults is []
            first_default is 0 - 1
            if (_p_peek_type of p) == "lparen":
                _p_advance of p
                loop while (_tok_ident_like of (_p_cur of p)) == 1:
                    append of [params, (_p_cur of p)[1]]
                    _p_advance of p
                    has_default is 0
                    if (_p_peek_type of p) == "kw":
                        if (_p_peek_val of p) == "is":
                            _p_advance of p
                            append of [param_defaults, _p_parse_expr of p]
                            has_default is 1
                            if first_default < 0:
                                first_default is (len of params) - 1
                    if has_default == 0:
                        append of [param_defaults, null]
                        if first_default >= 0:
                            throw of f"parse error: required parameter '{params[(len of params) - 1]}' cannot follow a parameter with a default at line {_stmt_line}"
                    if (_p_peek_type of p) == "comma":
                        _p_advance of p
                _p_expect of [p, "rparen"]
            if (len of params) == 0:
                params is ["n"]
                param_defaults is [null]
            # as:
            if (_p_peek_type of p) == "kw":
                if (_p_peek_val of p) == "as":
                    _p_advance of p
            _p_expect of [p, "colon"]
            _p_skip_newlines of p
            body is _p_parse_block of p
            return ["_line", _stmt_line, ["func", name, params, body, param_defaults]]

        # if
        if (_p_peek_val of p) == "if":
            _p_advance of p
            cond is _p_parse_expr of p
            _p_expect of [p, "colon"]
            _p_skip_newlines of p
            if_body is _p_parse_block of p
            else_body is []
            _p_skip_newlines of p
            if (_p_peek_type of p) == "kw":
                if (_p_peek_val of p) == "elif":
                    # Rewrite as else { if ... }
                    set_at of [(_p_cur of p), 1, "if"]
                    elif_stmt is _p_parse_statement of p
                    else_body is [elif_stmt]
                elif (_p_peek_val of p) == "else":
                    _p_advance of p
                    _p_expect of [p, "colon"]
                    _p_skip_newlines of p
                    else_body is _p_parse_block of p
            return ["_line", _stmt_line, ["if", cond, if_body, else_body]]

        # return
        if (_p_peek_val of p) == "return":
            _p_advance of p
            expr is _p_parse_expr of p
            _p_end_statement of p
            return ["_line", _stmt_line, ["return", expr]]

        # for
        if (_p_peek_val of p) == "for":
            _p_advance of p
            var_tok is _p_expect_ident_like of p
            _p_expect_kw of [p, "in"]
            iter is _p_parse_expr of p
            _p_expect of [p, "colon"]
            _p_skip_newlines of p
            body is _p_parse_block of p
            return ["_line", _stmt_line, ["for", var_tok[1], iter, body]]

        # loop while
        if (_p_peek_val of p) == "loop":
            _p_advance of p
            # expect "while"
            if (_p_peek_type of p) == "kw":
                if (_p_peek_val of p) == "while":
                    _p_advance of p
            cond is _p_parse_expr of p
            _p_expect of [p, "colon"]
            _p_skip_newlines of p
            body is _p_parse_block of p
            return ["_line", _stmt_line, ["loop", cond, body]]

        # try/catch
        if (_p_peek_val of p) == "try":
            _p_advance of p
            _p_expect of [p, "colon"]
            _p_skip_newlines of p
            try_body is _p_parse_block of p
            _p_skip_newlines of p
            _p_expect_kw of [p, "catch"]
            err_name is "err"
            if (_tok_ident_like of (_p_cur of p)) == 1:
                err_name is (_p_cur of p)[1]
                _p_advance of p
            _p_expect of [p, "colon"]
            _p_skip_newlines of p
            catch_body is _p_parse_block of p
            return ["_line", _stmt_line, ["try", try_body, err_name, catch_body]]

        # break
        if (_p_peek_val of p) == "break":
            _p_advance of p
            _p_end_statement of p
            return ["_line", _stmt_line, ["break"]]

        # continue
        if (_p_peek_val of p) == "continue":
            _p_advance of p
            _p_end_statement of p
            return ["_line", _stmt_line, ["continue"]]

        # import
        if (_p_peek_val of p) == "import":
            _p_advance of p
            name_tok is _p_expect of [p, "ident"]
            _p_end_statement of p
            return ["_line", _stmt_line, ["import", name_tok[1]]]

        # match
        if (_p_peek_val of p) == "match":
            _p_advance of p
            expr is _p_parse_expr of p
            _p_expect of [p, "colon"]
            _p_skip_newlines of p
            _p_expect of [p, "indent"]
            _p_skip_newlines of p
            cases is []
            loop while (_p_peek_type of p) == "kw":
                if (_p_peek_val of p) != "case":
                    break
                _p_advance of p
                # Pattern: _ is wildcard
                pattern is null
                if (_p_peek_type of p) == "ident":
                    if (_p_peek_val of p) == "_":
                        _p_advance of p
                    else:
                        pattern is _p_parse_expr of p
                else:
                    pattern is _p_parse_expr of p
                _p_expect of [p, "colon"]
                _p_skip_newlines of p
                case_body is _p_parse_block of p
                append of [cases, [pattern, case_body]]
                _p_skip_newlines of p
            if (_p_peek_type of p) == "dedent":
                _p_advance of p
            return ["_line", _stmt_line, ["match", expr, cases]]

        # unobserved
        if (_p_peek_val of p) == "unobserved":
            _p_advance of p
            _p_expect of [p, "colon"]
            _p_skip_newlines of p
            body is _p_parse_block of p
            return ["_line", _stmt_line, ["unobserved", body]]

    # Destructuring assignment: [a, b] is rhs (C parse_statement's bracket
    # scan: bracket-count to the matching ']'; committed once the next token
    # is `is`, with destructure-specific errors — identifiers only, no
    # trailing comma).
    if tt == "lbracket":
        d_found is 0
        d_i is p[1] + 1
        d_depth is 0
        d_scanning is 1
        loop while (d_scanning == 1) and (d_i < (len of p[0])):
            d_tok is p[0][d_i]
            if d_tok[0] == "lbracket":
                d_depth is d_depth + 1
            elif d_tok[0] == "rbracket":
                if d_depth == 0:
                    if (d_i + 1) < (len of p[0]):
                        d_next is p[0][d_i + 1]
                        if (d_next[0] == "kw") and (d_next[1] == "is"):
                            d_found is 1
                    d_scanning is 0
                else:
                    d_depth is d_depth - 1
            elif d_tok[0] == "eof":
                d_scanning is 0
            d_i is d_i + 1
        if d_found == 1:
            _p_advance of p                               # skip '['
            d_names is []
            d_collect is 1
            loop while d_collect == 1:
                if (_p_peek_type of p) != "ident":
                    throw of f"parse error: destructuring pattern requires identifiers at line {_stmt_line}"
                append of [d_names, (_p_cur of p)[1]]
                _p_advance of p
                if (_p_peek_type of p) == "rbracket":
                    d_collect is 0
                elif (_p_peek_type of p) == "comma":
                    _p_advance of p
                    if (_p_peek_type of p) == "rbracket":
                        throw of f"parse error: trailing comma in destructuring pattern at line {_stmt_line}"
                else:
                    throw of f"parse error: expected ',' or ']' in destructuring pattern at line {_stmt_line}"
            _p_advance of p                               # skip ']'
            _p_advance of p                               # skip 'is' (scan verified)
            d_rhs is _p_parse_expr of p
            _p_end_statement of p
            return ["_line", _stmt_line, ["destructure", d_names, d_rhs]]

    # Dot-/index-assignment: PLAIN-ident targets only (C gates this lookahead
    # on TOK_IDENT). A soft-keyword base with postfix (`prev[0] is e`) parses
    # as an expression statement whose leftover `is` then hits the #326
    # terminator check — a parse error at the v0.23.0 pin, verified vs the
    # oracle. `is` and the compound family are both accepted; C
    # desugars dot compounds by re-reading the target and keeps index
    # compounds once-evaluated (OP_DUP2), mirrored here via a 5th
    # index_assign element carrying the base op.
    if tt == "ident":
        peek1 is _p_peek_at of [p, 1]
        if (peek1[0] == "dot") or (peek1[0] == "lbracket"):
            saved_pos is p[1]
            target is _p_parse_postfix of p
            if target[0] == "dot":
                if (_p_peek_type of p) == "kw":
                    if (_p_peek_val of p) == "is":
                        _p_advance of p
                        expr is _p_parse_expr of p
                        # v0.24.0 pin: upstream #351 closed the #326 gap on
                        # dot/index-assign — the oracle now enforces the
                        # terminator here, so we do too.
                        _p_end_statement of p
                        return ["_line", _stmt_line, ["dot_assign", target[1], target[2], expr]]
                if (_p_peek_type of p) == "op":
                    cbase is _compound_base_op of (_p_peek_val of p)
                    if cbase != "":
                        _p_advance of p
                        cexpr is _p_parse_expr of p
                        # obj.f += e  →  obj.f is obj.f + e (C clones the
                        # target subtree — it is evaluated twice). #351
                        # closed: terminator enforced (see dot_assign note).
                        _p_end_statement of p
                        return ["_line", _stmt_line, ["dot_assign", target[1], target[2], ["binop", cbase, ["dot", target[1], target[2]], cexpr]]]
            if target[0] == "index":
                if (_p_peek_type of p) == "kw":
                    if (_p_peek_val of p) == "is":
                        _p_advance of p
                        expr is _p_parse_expr of p
                        # #351 closed: terminator enforced (see dot_assign note).
                        _p_end_statement of p
                        return ["_line", _stmt_line, ["index_assign", target[1], target[2], expr]]
                if (_p_peek_type of p) == "op":
                    cbase is _compound_base_op of (_p_peek_val of p)
                    if cbase != "":
                        _p_advance of p
                        cexpr is _p_parse_expr of p
                        # #351 closed: terminator enforced (see dot_assign note).
                        _p_end_statement of p
                        return ["_line", _stmt_line, ["index_assign", target[1], target[2], cexpr, cbase]]
            # Not an assignment — restore and fall through
            set_at of [p, 1, saved_pos]

    # Plain assignment `X is e` (identifier-like minus the question words —
    # `what is e` is the interrogative form; prev/at qualify) and compound
    # `X += e` (the FULL identifier-like set including question words —
    # compound is never interrogative). Mirrors C's tok_is_assign_name /
    # tok_is_ident_like split.
    cur_tok is _p_cur of p
    peek1 is _p_peek_at of [p, 1]
    if (_tok_assign_name of cur_tok) == 1:
        if (peek1[0] == "kw") and (peek1[1] == "is"):
            _p_advance of p
            _p_advance of p
            expr is _p_parse_expr of p
            _p_end_statement of p
            return ["_line", _stmt_line, ["assign", cur_tok[1], expr]]
    if (_tok_ident_like of cur_tok) == 1:
        if peek1[0] == "op":
            cbase is _compound_base_op of peek1[1]
            if cbase != "":
                _p_advance of p
                _p_advance of p
                cexpr is _p_parse_expr of p
                _p_end_statement of p
                return ["_line", _stmt_line, ["assign", cur_tok[1], ["binop", cbase, ["ident", cur_tok[1]], cexpr]]]

    # Expression statement
    expr is _p_parse_expr of p
    _p_end_statement of p
    return ["_line", _stmt_line, expr]

# ---- Bracket parser: index `t[i]` or half-open slice `t[start:end]` ----
# The opening `[` is already consumed. `start`/`end` may be omitted (`t[:e]`,
# `t[s:]`, `t[:]`) -> null, matching the C parser's AST_SLICE (NULL ends).
define _p_parse_bracket(p, target) as:
    start is null
    if (_p_peek_type of p) != "colon":
        start is _p_parse_expr of p
    if (_p_peek_type of p) == "colon":
        _p_advance of p
        last is null
        if (_p_peek_type of p) != "rbracket":
            last is _p_parse_expr of p
        _p_expect of [p, "rbracket"]
        return ["slice", target, start, last]
    _p_expect of [p, "rbracket"]
    return ["index", target, start]

# ---- Postfix parser for dot/index chains (used by assignment detection) ----

define _p_parse_postfix(p) as:
    tok is _p_cur of p
    _p_advance of p
    node is ["ident", tok[1]]
    loop while ((_p_peek_type of p) == "dot") or ((_p_peek_type of p) == "lbracket"):
        if (_p_peek_type of p) == "dot":
            _p_advance of p
            local dkey is _p_expect_dot_key of p
            node is ["dot", node, dkey]
        else:
            _p_advance of p
            node is _p_parse_bracket of [p, node]
    return node

# ---- Expression parser (precedence climbing) ----

define _p_parse_expr(p) as:
    return _p_parse_pipe of p

define _p_parse_pipe(p) as:
    left is _p_parse_or of p
    loop while (_p_peek_type of p) == "pipe":
        _p_advance of p
        fn is _p_parse_or of p
        # a |> b desugars to b of a
        left is ["call", fn, left]
    return left

define _p_parse_or(p) as:
    left is _p_parse_and of p
    loop while (_p_peek_type of p) == "kw":
        if (_p_peek_val of p) == "or":
            _p_advance of p
            right is _p_parse_and of p
            left is ["binop", "or", left, right]
        else:
            return left
    return left

define _p_parse_and(p) as:
    left is _p_parse_comparison of p
    loop while (_p_peek_type of p) == "kw":
        if (_p_peek_val of p) == "and":
            _p_advance of p
            right is _p_parse_comparison of p
            left is ["binop", "and", left, right]
        else:
            return left
    return left

define _p_parse_comparison(p) as:
    left is _p_parse_bitor of p
    if (_p_peek_type of p) == "op":
        op is _p_peek_val of p
        if op == "==":
            _p_advance of p
            return ["binop", "==", left, _p_parse_bitor of p]
        if op == "!=":
            _p_advance of p
            return ["binop", "!=", left, _p_parse_bitor of p]
        if op == "<":
            _p_advance of p
            return ["binop", "<", left, _p_parse_bitor of p]
        if op == ">":
            _p_advance of p
            return ["binop", ">", left, _p_parse_bitor of p]
        if op == "<=":
            _p_advance of p
            return ["binop", "<=", left, _p_parse_bitor of p]
        if op == ">=":
            _p_advance of p
            return ["binop", ">=", left, _p_parse_bitor of p]
    return left

# Compound-assignment operator -> its base binary operator. "" for a
# non-compound op token. Mirrors C's compound_to_op (src/parser.c).
define _compound_base_op(op) as:
    if op == "+=":
        return "+"
    if op == "-=":
        return "-"
    if op == "*=":
        return "*"
    if op == "/=":
        return "/"
    if op == "%=":
        return "%"
    if op == "&=":
        return "&"
    if op == "|=":
        return "|"
    if op == "^=":
        return "^"
    if op == "<<=":
        return "<<"
    if op == ">>=":
        return ">>"
    return ""

# Bitwise precedence (looser -> tighter): bitor | bitxor ^ bitand & shift << >>
# Mirrors the C parser chain comparison -> bitor -> bitxor -> bitand -> shift ->
# addition (src/parser.c). Each level is left-associative like add/mul.
define _p_parse_bitor(p) as:
    left is _p_parse_bitxor of p
    loop while (_p_peek_type of p) == "op":
        op is _p_peek_val of p
        if op == "|":
            _p_advance of p
            left is ["binop", "|", left, _p_parse_bitxor of p]
        else:
            return left
    return left

define _p_parse_bitxor(p) as:
    left is _p_parse_bitand of p
    loop while (_p_peek_type of p) == "op":
        op is _p_peek_val of p
        if op == "^":
            _p_advance of p
            left is ["binop", "^", left, _p_parse_bitand of p]
        else:
            return left
    return left

define _p_parse_bitand(p) as:
    left is _p_parse_shift of p
    loop while (_p_peek_type of p) == "op":
        op is _p_peek_val of p
        if op == "&":
            _p_advance of p
            left is ["binop", "&", left, _p_parse_shift of p]
        else:
            return left
    return left

define _p_parse_shift(p) as:
    left is _p_parse_add of p
    loop while (_p_peek_type of p) == "op":
        op is _p_peek_val of p
        if op == "<<":
            _p_advance of p
            left is ["binop", "<<", left, _p_parse_add of p]
        elif op == ">>":
            _p_advance of p
            left is ["binop", ">>", left, _p_parse_add of p]
        else:
            return left
    return left

define _p_parse_add(p) as:
    left is _p_parse_mul of p
    loop while (_p_peek_type of p) == "op":
        op is _p_peek_val of p
        if op == "+":
            _p_advance of p
            left is ["binop", "+", left, _p_parse_mul of p]
        elif op == "-":
            _p_advance of p
            left is ["binop", "-", left, _p_parse_mul of p]
        else:
            return left
    return left

define _p_parse_mul(p) as:
    left is _p_parse_unary of p
    loop while (_p_peek_type of p) == "op":
        op is _p_peek_val of p
        if op == "*":
            _p_advance of p
            left is ["binop", "*", left, _p_parse_unary of p]
        elif op == "/":
            _p_advance of p
            left is ["binop", "/", left, _p_parse_unary of p]
        elif op == "%":
            _p_advance of p
            left is ["binop", "%", left, _p_parse_unary of p]
        else:
            return left
    return left

# Prefix unary operators, mirroring the C parser's parse_unary_body: `-`,
# `not` and `~` all sit at UNARY tightness (tighter than every binary op)
# and recurse into parse_unary for the operand. `not` used to sit between
# `and` and comparison (#99 item 1): `not x + 1` parsed as `not (x + 1)`
# where the C parser reads `(not x) + 1`, and `not 2 == 1` as
# `not (2 == 1)` where C reads `(not 2) == 1` — silent wrong values in
# BOTH compilers (shared frontend).
define _p_parse_unary(p) as:
    if (_p_peek_type of p) == "op":
        if (_p_peek_val of p) == "-":
            _p_advance of p
            return ["unary", "-", _p_parse_unary of p]
        if (_p_peek_val of p) == "~":
            _p_advance of p
            return ["unary", "~", _p_parse_unary of p]
    if (_p_peek_type of p) == "kw":
        if (_p_peek_val of p) == "not":
            _p_advance of p
            return ["unary", "not", _p_parse_unary of p]
    return _p_parse_call of p

define _p_parse_call(p) as:
    left is _p_parse_primary of p
    # Handle `of` application only. Dot/index postfix lives INSIDE
    # _p_parse_primary per primary kind, mirroring the canonical C parser
    # (parse_primary): the postfix set depends on the primary — idents,
    # parens (incl. desugared f-strings), dict literals, and (since the
    # v0.23.0 pin, #328) the prev/at and question-word identifier fallbacks
    # take `.field` and `[idx]`; num/str/list literals take `[idx]` only;
    # listcomps, null and predicates take none. A call result (`f of x`)
    # takes no postfix at all — C's parse_relation returns it directly.
    parsing is 1
    loop while parsing == 1:
        if (_p_peek_type of p) == "kw":
            if (_p_peek_val of p) == "of":
                _p_advance of p
                # RHS is unary-or-tighter, matching the C parser
                # (parser.c parse_relation): `of` does not absorb trailing
                # infix, so `sqrt of x + 1` is `(sqrt of x) + 1` and
                # `len of xs - 1` is `(len of xs) - 1`. Right-associative
                # `f of g of x` and `f of -x` still work (unary recurses).
                arg is _p_parse_unary of p
                left is ["call", left, arg]
            else:
                parsing is 0
        else:
            parsing is 0
    return left

# Postfix chains for primaries, mirroring the C parser's per-primary loops.
# _p_postfix_full: `.field` + `[idx]`/slices (idents, parens, dicts, and the
# prev/at + question-word identifier fallbacks since the v0.23.0 pin).
# _p_postfix_brackets: `[idx]`/slices only (num/str/list literals).
define _p_postfix_full(p, node) as:
    chaining is 1
    loop while chaining == 1:
        if (_p_peek_type of p) == "dot":
            _p_advance of p
            local dkey is _p_expect_dot_key of p
            node is ["dot", node, dkey]
        elif (_p_peek_type of p) == "lbracket":
            _p_advance of p
            node is _p_parse_bracket of [p, node]
        else:
            chaining is 0
    return node

define _p_postfix_brackets(p, node) as:
    loop while (_p_peek_type of p) == "lbracket":
        _p_advance of p
        node is _p_parse_bracket of [p, node]
    return node

define _p_parse_primary(p) as:
    tt is _p_peek_type of p

    if tt == "num":
        tok is _p_cur of p
        _p_advance of p
        # C: numeric literals take [idx] postfix only — `1.5.x` / `[1,2].x`
        # style dot-postfix is a parse error at the canonical parser.
        return _p_postfix_brackets of [p, ["num", tok[1]]]

    if tt == "str":
        tok is _p_cur of p
        _p_advance of p
        # C: string literals take [idx] postfix only.
        return _p_postfix_brackets of [p, ["str", tok[1]]]

    if tt == "null":
        _p_advance of p
        return ["null"]

    # Temporal: `prev of x [at <e> | when <e>]` (kind 6); bare `prev`/`at` are
    # ordinary identifiers (soft keywords), matching the C grammar.
    if tt == "kw":
        if (_p_peek_val of p) == "prev":
            prev_line is (_p_cur of p)[2]
            _p_advance of p
            is_temporal is 0
            if (_p_peek_type of p) == "kw":
                if (_p_peek_val of p) == "of":
                    is_temporal is 1
            if is_temporal == 1:
                _p_advance of p
                # #634 (mirrors parse_primary's TOK_PREV): the operand is
                # unary-or-tighter like every other `of`, and MUST be a bare
                # variable name — a literal/index/dot/paren operand has no
                # assignment history and used to return null silently.
                prev_expr is _p_parse_unary of p
                if prev_expr[0] != "ident":
                    throw of ("ouroboros: parse error: 'prev of' requires a variable name at line " + (str of prev_line))
                prev_at is null
                prev_when is null
                if (_p_peek_type of p) == "kw":
                    if (_p_peek_val of p) == "at":
                        _p_advance of p
                        prev_at is _p_parse_expr of p
                if prev_at == null:
                    if (_p_peek_type of p) == "interrogative":
                        if (_p_peek_val of p) == "when":
                            _p_advance of p                # #868 qualifier
                            prev_when is _p_parse_expr of p
                return ["interrogate", 6, prev_expr, prev_at, prev_when]
            # Identifier fallback: takes the FULL dot+bracket postfix chain
            # like a plain ident (upstream #328, in the v0.23.0 pin).
            return _p_postfix_full of [p, ["ident", "prev"]]
        if (_p_peek_val of p) == "at":
            _p_advance of p
            return _p_postfix_full of [p, ["ident", "at"]]

    # Interrogatives: `<kw> is x [at <e> | when <e>]` (what/who/when/where/
    # why/how). Matches the C grammar: the operand and the at/when qualifier
    # operands are FULL expressions (parse_expression), not primaries —
    # `who is y + 1` interrogates the value of y + 1 (#99 item 6). The #868
    # `when <N>` qualifier (Nth recorded assignment) is in the v0.39.0 pin;
    # arriving at a current `when` token means the operand expression is
    # already complete, so it is unambiguously the qualifier.
    if tt == "interrogative":
        tok is _p_cur of p
        _p_advance of p
        kind is _interrogative_index of tok[1]
        if (_p_peek_type of p) == "kw":
            if (_p_peek_val of p) == "is":
                _p_advance of p
                iexpr is _p_parse_expr of p
                at_expr is null
                when_expr is null
                if (_p_peek_type of p) == "kw":
                    if (_p_peek_val of p) == "at":
                        _p_advance of p
                        at_expr is _p_parse_expr of p
                if at_expr == null:
                    if (_p_peek_type of p) == "interrogative":
                        if (_p_peek_val of p) == "when":
                            _p_advance of p
                            when_expr is _p_parse_expr of p
                return ["interrogate", kind, iexpr, at_expr, when_expr]
        # Not `<kw> is ...` — treat as a plain identifier. Since v0.23.0
        # (#328) the C question-word fallback takes the full dot+bracket
        # postfix chain (verified vs the oracle: `how.k` works).
        return _p_postfix_full of [p, ["ident", tok[1]]]

    # Predicates: converged, stable, improving, oscillating, diverging, equilibrium
    if tt == "predicate":
        tok is _p_cur of p
        _p_advance of p
        kind is _predicate_index of tok[1]
        return ["predicate", kind]

    if tt == "ident":
        tok is _p_cur of p
        _p_advance of p
        return _p_postfix_full of [p, ["ident", tok[1]]]

    if tt == "lparen":
        # Check for lambda: (params) => expr
        saved_pos is p[1]
        _p_advance of p
        # Scan ahead to see if this is lambda
        is_lambda is 0
        scan_pos is p[1]
        scan_ok is 1
        loop while scan_ok == 1:
            if scan_pos >= (len of p[0]):
                scan_ok is 0
            else:
                stok is p[0][scan_pos]
                # C scan: tok_is_ident_like or COMMA — soft keywords (prev/
                # at/question words) are valid lambda params (#99 item 8).
                if ((_tok_ident_like of stok) == 1) or (stok[0] == "comma"):
                    scan_pos is scan_pos + 1
                elif stok[0] == "rparen":
                    # Check if next is arrow
                    if (scan_pos + 1) < (len of p[0]):
                        if p[0][scan_pos + 1][0] == "arrow":
                            is_lambda is 1
                    scan_ok is 0
                else:
                    scan_ok is 0
        if is_lambda == 1:
            params is []
            loop while (_tok_ident_like of (_p_cur of p)) == 1:
                append of [params, (_p_cur of p)[1]]
                _p_advance of p
                if (_p_peek_type of p) == "comma":
                    _p_advance of p
            if (len of params) == 0:
                params is ["n"]
            _p_expect of [p, "rparen"]
            _p_expect of [p, "arrow"]
            body is _p_parse_expr of p
            return ["lambda", params, body]
        # Not a lambda — restore and parse as grouping. Parenthesized
        # expressions (including desugared f-strings) take full postfix.
        set_at of [p, 1, saved_pos]
        _p_advance of p
        expr is _p_parse_expr of p
        _p_expect of [p, "rparen"]
        expr is _p_postfix_full of [p, expr]
        # #355 (v0.24.0): parens always mean ONE argument — a parenthesized
        # literal list carries a 3rd marker slot so call sites do not
        # spread it. Postfix-consumed forms wrap in index/dot nodes and
        # fall through untouched.
        if expr[0] == "list":
            if (len of expr) == 2:
                return ["list", expr[1], 1]
        return expr

    if tt == "lbracket":
        _p_advance of p
        # Empty list
        if (_p_peek_type of p) == "rbracket":
            _p_advance of p
            return ["list", []]
        first is _p_parse_expr of p
        # List comprehension: [expr for x in iter]
        if (_p_peek_type of p) == "kw":
            if (_p_peek_val of p) == "for":
                _p_advance of p
                var_tok is _p_expect_ident_like of p
                _p_expect_kw of [p, "in"]
                iter_expr is _p_parse_expr of p
                filter_expr is null
                if (_p_peek_type of p) == "kw":
                    if (_p_peek_val of p) == "if":
                        _p_advance of p
                        filter_expr is _p_parse_expr of p
                _p_expect of [p, "rbracket"]
                return ["listcomp", first, var_tok[1], iter_expr, filter_expr]
        elems is [first]
        loop while (_p_peek_type of p) == "comma":
            _p_advance of p
            if (_p_peek_type of p) == "rbracket":
                break
            append of [elems, _p_parse_expr of p]
        _p_expect of [p, "rbracket"]
        # C: list literals take [idx] postfix only (listcomps take none —
        # that branch returns directly above).
        return _p_postfix_brackets of [p, ["list", elems]]

    # Dict literal: {"key": value, ...}
    if tt == "lbrace":
        _p_advance of p
        pairs is []
        if (_p_peek_type of p) != "rbrace":
            key is _p_parse_expr of p
            _p_expect of [p, "colon"]
            val is _p_parse_expr of p
            append of [pairs, [key, val]]
            loop while (_p_peek_type of p) == "comma":
                _p_advance of p
                if (_p_peek_type of p) == "rbrace":
                    break
                key is _p_parse_expr of p
                _p_expect of [p, "colon"]
                val is _p_parse_expr of p
                append of [pairs, [key, val]]
        _p_expect of [p, "rbrace"]
        return _p_postfix_full of [p, ["dict", pairs]]

    throw of f"parse error: unexpected token {tt} '{_p_peek_val of p}'"

define eigen_parse(tokens) as:
    p is _parser_new of tokens
    stmts is []
    _p_skip_newlines of p
    loop while (_p_peek_type of p) != "eof":
        stmt is _p_parse_statement of p
        if stmt != null:
            append of [stmts, stmt]
        _p_skip_newlines of p
    return ["block", stmts]

# ============================================================
# Evaluator
# ============================================================

define _env_new(parent) as:
    return [[], parent]

define _env_get(env, name) as:
    bindings is env[0]
    for i in range of (len of bindings):
        if bindings[i][0] == name:
            return bindings[i][1]
    if env[1] != null:
        return _env_get of [env[1], name]
    return null

define _env_set(env, name, val) as:
    bindings is env[0]
    for i in range of (len of bindings):
        if bindings[i][0] == name:
            set_at of [bindings, i, [name, val]]
            return null
    if env[1] != null:
        parent_val is _env_get of [env[1], name]
        if parent_val != null:
            _env_set of [env[1], name, val]
            return null
    # New binding in current scope
    append of [bindings, [name, val]]
    return null

define _env_set_local(env, name, val) as:
    bindings is env[0]
    for i in range of (len of bindings):
        if bindings[i][0] == name:
            set_at of [bindings, i, [name, val]]
            return null
    append of [bindings, [name, val]]
    return null

# Return / break / continue mechanism — global flags
_eigen_returning is 0
_eigen_return_val is null
_eigen_breaking is 0
_eigen_continuing is 0

# Debug hook support — set via eigen_set_hook to intercept each statement
_eigen_debug_hook is null
_eigen_current_line is 0

define eigen_set_hook(hook) as:
    _eigen_debug_hook is hook

# Observer state per binding: [name, value, obs_count, entropy, prev_entropy, dH]
# For simplicity, we store observer metadata in a separate dict keyed by name.
_eigen_obs is {}

define _compute_entropy(val) as:
    t is type of val
    if t == "num":
        x is abs of val
        if (x == 0) or (x == 1):
            return 0
        p is 1.0 / (1.0 + x)
        if (p <= 0) or (p >= 1):
            return 0
        return 0 - (p * ((log of p) / (log of 2)) + (1 - p) * ((log of (1 - p)) / (log of 2)))
    if t == "str":
        slen is len of val
        if slen == 0:
            return 0
        return (log of (slen + 1)) / (log of 2)
    if t == "list":
        llen is len of val
        if llen == 0:
            return 0
        return (log of (llen + 1)) / (log of 2)
    if t == "dict":
        dk is keys of val
        dlen is len of dk
        if dlen == 0:
            return 0
        return (log of (dlen + 1)) / (log of 2)
    return 0

define _update_observer(name, val) as:
    new_entropy is _compute_entropy of val
    if (has_key of [_eigen_obs, name]) == 1:
        old is _eigen_obs[name]
        obs_count is old[0] + 1
        prev_ent is old[1]
        dH is new_entropy - prev_ent
        dict_set of [_eigen_obs, name, [obs_count, new_entropy, dH, old[3]]]
    else:
        dict_set of [_eigen_obs, name, [1, new_entropy, 0, 0]]
    return null

define _get_observer(name) as:
    if (has_key of [_eigen_obs, name]) == 1:
        return _eigen_obs[name]
    return [0, 0, 0, 0]

# Apply a base binary operator to two already-evaluated values (used by the
# compound index-assignment desugar; mirrors the binop evaluation below).
define _apply_binop(op, left, right) as:
    if op == "+":
        if (type of left) == "str":
            return left + (str of right)
        if (type of right) == "str":
            return (str of left) + right
        return left + right
    if op == "-":
        return left - right
    if op == "*":
        return left * right
    if op == "/":
        if right == 0:
            return 0
        return left / right
    if op == "%":
        if right == 0:
            return 0
        return left % right
    if op == "&":
        return left & right
    if op == "|":
        return left | right
    if op == "^":
        return left ^ right
    if op == "<<":
        return left << right
    if op == ">>":
        return left >> right
    throw of f"unsupported compound operator {op}"

define eigen_eval(node, env) as:
    if node == null:
        return null
    ntype is node[0]

    # Unwrap _line wrapper (line-number annotation from parser)
    if ntype == "_line":
        _eigen_current_line is node[1]
        return eigen_eval of [node[2], env]

    if ntype == "num":
        return node[1]
    if ntype == "str":
        return node[1]
    if ntype == "null":
        return null

    if ntype == "ident":
        val is _env_get of [env, node[1]]
        if val == null:
            # Check if it might actually be null vs undefined
            # For now, return null (same as C evaluator for undefined)
            return null
        return val

    if ntype == "assign":
        val is eigen_eval of [node[2], env]
        # 4th element = local_only marker (`local NAME is e`): bind in the
        # CURRENT scope only, never walk to an outer binding.
        if (len of node) >= 4:
            _env_set_local of [env, node[1], val]
        else:
            _env_set of [env, node[1], val]
        _update_observer of [node[1], val]
        return val

    if ntype == "binop":
        op is node[1]
        if op == "and":
            left is eigen_eval of [node[2], env]
            if left == 0:
                return 0
            if (left == null) or (left == ""):
                return 0
            right is eigen_eval of [node[3], env]
            if right:
                return 1
            return 0
        if op == "or":
            left is eigen_eval of [node[2], env]
            if left:
                return 1
            right is eigen_eval of [node[3], env]
            if right:
                return 1
            return 0
        left is eigen_eval of [node[2], env]
        right is eigen_eval of [node[3], env]
        if op == "+":
            if (type of left) == "str":
                return left + (str of right)
            if (type of right) == "str":
                return (str of left) + right
            return left + right
        if op == "-":
            return left - right
        if op == "*":
            return left * right
        if op == "/":
            if right == 0:
                return 0
            return left / right
        if op == "%":
            if right == 0:
                return 0
            return left % right
        if op == "==":
            if left == right:
                return 1
            return 0
        if op == "!=":
            if left != right:
                return 1
            return 0
        if op == "<":
            if left < right:
                return 1
            return 0
        if op == ">":
            if left > right:
                return 1
            return 0
        if op == "<=":
            if left <= right:
                return 1
            return 0
        if op == ">=":
            if left >= right:
                return 1
            return 0

    if ntype == "unary":
        operand is eigen_eval of [node[2], env]
        if node[1] == "-":
            return 0 - operand
        if node[1] == "not":
            if operand:
                return 0
            return 1

    if ntype == "call":
        fn is eigen_eval of [node[1], env]
        arg is eigen_eval of [node[2], env]
        # Check for eigen function (meta-interpreter defined)
        if (type of fn) == "list":
            if (len of fn) >= 4:
                if fn[0] == "__eigen_fn__":
                    # fn is [__eigen_fn__, name, params, body, defaults?]
                    params is fn[2]
                    body is fn[3]
                    call_env is _env_new of env
                    bound_n is 0
                    if (len of params) > 1:
                        if (type of arg) == "list":
                            for pi in range of (len of params):
                                if pi < (len of arg):
                                    _env_set_local of [call_env, params[pi], arg[pi]]
                                    bound_n is bound_n + 1
                    else:
                        _env_set_local of [call_env, params[0], arg]
                        bound_n is 1
                    # Trailing parameter defaults: fill slots the caller did
                    # not supply (missing args only — an explicit null stays
                    # null), evaluated at call time in the callee env.
                    if (len of fn) >= 5:
                        fdefs is fn[4]
                        for pi in range of (len of params):
                            if (pi >= bound_n) and (pi < (len of fdefs)):
                                if fdefs[pi] != null:
                                    _env_set_local of [call_env, params[pi], eigen_eval of [fdefs[pi], call_env]]
                    _eigen_returning is 0
                    result is _eval_block of [body, call_env]
                    if _eigen_returning == 1:
                        _eigen_returning is 0
                        return _eigen_return_val
                    return result
        # C builtin — call it directly through the host runtime
        return fn of arg

    if ntype == "list":
        elems is node[1]
        result is []
        for i in range of (len of elems):
            append of [result, eigen_eval of [elems[i], env]]
        return result

    if ntype == "dict":
        pairs is node[1]
        result is {}
        for i in range of (len of pairs):
            pair is pairs[i]
            k is eigen_eval of [pair[0], env]
            v is eigen_eval of [pair[1], env]
            dict_set of [result, str of k, v]
        return result

    if ntype == "index":
        target is eigen_eval of [node[1], env]
        idx is eigen_eval of [node[2], env]
        return target[idx]

    if ntype == "dot":
        target is eigen_eval of [node[1], env]
        key is node[2]
        if (type of target) == "dict":
            if (has_key of [target, key]) == 1:
                return target[key]
            return null
        throw of f"cannot access .{key} on {type of target}"

    if ntype == "dot_assign":
        target is eigen_eval of [node[1], env]
        key is node[2]
        val is eigen_eval of [node[3], env]
        if (type of target) == "dict":
            dict_set of [target, key, val]
            return val
        throw of f"cannot assign .{key} on {type of target}"

    if ntype == "index_assign":
        target is eigen_eval of [node[1], env]
        idx is eigen_eval of [node[2], env]
        val is eigen_eval of [node[3], env]
        # Compound form (5th element = base op): target/index evaluated once,
        # read-modify-write, mirroring C's OP_DUP2 lowering.
        if (len of node) >= 5:
            val is _apply_binop of [node[4], target[idx], val]
        if (type of target) == "list":
            set_at of [target, idx, val]
            return val
        if (type of target) == "dict":
            dict_set of [target, str of idx, val]
            return val
        throw of f"cannot index-assign on {type of target}"

    if ntype == "destructure":
        d_val is eigen_eval of [node[2], env]
        d_names is node[1]
        if (type of d_val) != "list":
            throw of f"destructuring requires a list, got {type of d_val}"
        if (len of d_val) != (len of d_names):
            throw of f"destructuring expected list of length {len of d_names}, got {len of d_val}"
        for di in range of (len of d_names):
            _env_set of [env, d_names[di], d_val[di]]
            _update_observer of [d_names[di], d_val[di]]
        return d_val[(len of d_names) - 1]

    if ntype == "lambda":
        params is node[1]
        body_expr is node[2]
        # Wrap body expression as a return statement
        body is [["return", body_expr]]
        # Don't capture env to avoid circular references in value lists
        return ["__eigen_fn__", "", params, body]

    if ntype == "if":
        cond is eigen_eval of [node[1], env]
        if cond:
            return _eval_block of [node[2], env]
        else:
            return _eval_block of [node[3], env]

    if ntype == "loop":
        result is null
        max_iter is 1000000
        running is 1
        loop while (max_iter > 0) and (running == 1):
            cond is eigen_eval of [node[1], env]
            if cond == 0:
                running is 0
            elif cond == null:
                running is 0
            else:
                result is _eval_block of [node[2], env]
                if _eigen_returning == 1:
                    return result
                if _eigen_breaking == 1:
                    _eigen_breaking is 0
                    running is 0
                elif _eigen_continuing == 1:
                    _eigen_continuing is 0
                max_iter is max_iter - 1
        return result

    if ntype == "for":
        var_name is node[1]
        iter is eigen_eval of [node[2], env]
        result is null
        for i in range of (len of iter):
            _env_set_local of [env, var_name, iter[i]]
            result is _eval_block of [node[3], env]
            if _eigen_returning == 1:
                return result
            if _eigen_breaking == 1:
                _eigen_breaking is 0
                break
            if _eigen_continuing == 1:
                _eigen_continuing is 0
        return result

    if ntype == "func":
        name is node[1]
        params is node[2]
        body is node[3]
        fn_defaults is []
        if (len of node) >= 5:
            fn_defaults is node[4]
        # Don't capture env to avoid circular references in value lists
        fn_val is ["__eigen_fn__", name, params, body, fn_defaults]
        _env_set of [env, name, fn_val]
        return fn_val

    if ntype == "return":
        val is eigen_eval of [node[1], env]
        _eigen_returning is 1
        _eigen_return_val is val
        return val

    if ntype == "break":
        _eigen_breaking is 1
        return null

    if ntype == "continue":
        _eigen_continuing is 1
        return null

    if ntype == "block":
        return _eval_block of [node[1], env]

    if ntype == "try":
        try_body is node[1]
        err_name is node[2]
        catch_body is node[3]
        _try_result is null
        _try_caught is 0
        try:
            _try_result is _eval_block of [try_body, env]
        catch err:
            _try_caught is 1
            catch_env is _env_new of env
            _env_set_local of [catch_env, err_name, err]
            _try_result is _eval_block of [catch_body, catch_env]
        return _try_result

    if ntype == "match":
        val is eigen_eval of [node[1], env]
        cases is node[2]
        for ci in range of (len of cases):
            case_pair is cases[ci]
            pattern is case_pair[0]
            case_body is case_pair[1]
            if pattern == null:
                # Wildcard — always matches
                return _eval_block of [case_body, env]
            pat_val is eigen_eval of [pattern, env]
            if val == pat_val:
                return _eval_block of [case_body, env]
        return null

    if ntype == "import":
        mod_name is node[1]
        # Use load_file to load lib/NAME.eigs, then run it in isolated env
        path is "lib/" + mod_name + ".eigs"
        try:
            source is read_text of path
        catch err:
            throw of f"import: module '{mod_name}' not found"
        # Parse and eval in a child environment
        mod_tokens is eigen_tokenize of source
        mod_ast is eigen_parse of mod_tokens
        mod_env is _env_new of env
        eigen_eval of [mod_ast, mod_env]
        # Collect bindings into a dict
        mod_dict is {}
        mod_bindings is mod_env[0]
        for mi in range of (len of mod_bindings):
            bname is mod_bindings[mi][0]
            bval is mod_bindings[mi][1]
            # Skip private names starting with _
            if (len of bname) > 0:
                first_char is char_at of [bname, 0]
                if first_char != "_":
                    dict_set of [mod_dict, bname, bval]
        _env_set of [env, mod_name, mod_dict]
        return mod_dict

    if ntype == "listcomp":
        expr_node is node[1]
        var_name is node[2]
        iter is eigen_eval of [node[3], env]
        filter_node is node[4]
        result is []
        for i in range of (len of iter):
            comp_env is _env_new of env
            _env_set_local of [comp_env, var_name, iter[i]]
            if filter_node != null:
                cond is eigen_eval of [filter_node, comp_env]
                if cond == 0:
                    continue
                if cond == null:
                    continue
            val is eigen_eval of [expr_node, comp_env]
            append of [result, val]
        return result

    if ntype == "unobserved":
        # Execute the body — meta-interpreter just runs it normally
        return _eval_block of [node[1], env]

    if ntype == "interrogate":
        kind is node[1]
        target is eigen_eval of [node[2], env]
        # kind: 0=what, 1=who, 2=when, 3=where, 4=why, 5=how
        if kind == 0:
            # what: value / magnitude
            if (type of target) == "num":
                return target
            if (type of target) == "str":
                return len of target
            if (type of target) == "list":
                return len of target
            return 0
        if kind == 1:
            # who: name / type
            if node[2][0] == "ident":
                return node[2][1]
            return type of target
        if kind == 2:
            # when: observation count
            if node[2][0] == "ident":
                obs is _get_observer of node[2][1]
                return obs[0]
            return 0
        if kind == 3:
            # where: entropy
            if node[2][0] == "ident":
                obs is _get_observer of node[2][1]
                return obs[1]
            return _compute_entropy of target
        if kind == 4:
            # why: dH (entropy change)
            if node[2][0] == "ident":
                obs is _get_observer of node[2][1]
                return obs[2]
            return 0
        if kind == 5:
            # how: stability score
            if node[2][0] == "ident":
                obs is _get_observer of node[2][1]
                ent is obs[1]
                prior is obs[3]
                initial is prior
                if initial <= 0:
                    initial is 1.0
                if ent > 0:
                    return 1.0 - (ent / initial)
                return 1.0
            return 1.0
        return 0

    if ntype == "predicate":
        kind is node[1]
        # Look at last observer state
        # kind: 0=converged, 1=stable, 2=improving, 3=oscillating, 4=diverging, 5=equilibrium
        h is 0
        dh is 0
        prev_dh is 0
        # Try to get the latest observer state from __observer__ binding
        last_obs is _env_get of [env, "__observer__"]
        if last_obs != null:
            h is _compute_entropy of last_obs
        if kind == 0:
            # converged: low dH and low entropy
            if (abs of dh) < 0.001:
                if h < 0.1:
                    return 1
            return 0
        if kind == 1:
            # stable: low dH, moderate entropy
            if (abs of dh) < 0.01:
                if h >= 0.1:
                    return 1
            return 0
        if kind == 2:
            # improving: negative dH
            if dh < (0 - 0.001):
                return 1
            return 0
        if kind == 3:
            # oscillating: sign change in dH
            if (dh * prev_dh) < 0:
                if (abs of dh) > 0.001:
                    return 1
            return 0
        if kind == 4:
            # diverging: positive dH
            if dh > 0.001:
                return 1
            return 0
        if kind == 5:
            # equilibrium: very low dH
            if (abs of dh) < 0.001:
                return 1
            return 0
        return 0

    return null

define _eval_block(stmts, env) as:
    result is null
    for i in range of (len of stmts):
        stmt is stmts[i]
        # Unwrap _line wrapper to extract line number
        if (type of stmt) == "list":
            if (len of stmt) >= 3:
                if stmt[0] == "_line":
                    _eigen_current_line is stmt[1]
                    stmt is stmt[2]
        # Call debug hook if set
        if _eigen_debug_hook != null:
            _eigen_debug_hook of [stmt, env]
        result is eigen_eval of [stmt, env]
        if _eigen_returning == 1:
            return result
        if _eigen_breaking == 1:
            return result
        if _eigen_continuing == 1:
            return result
    return result

# ============================================================
# Built-in functions for the meta-circular environment
# ============================================================

define _make_default_env as:
    env is _env_new of null
    # Bridge ALL C builtins into the meta-interpreter's environment.
    # Since we're running inside the C runtime, these names resolve to
    # VAL_BUILTIN values. The evaluator's "call" handler calls them
    # with `fn of arg` which the C runtime handles natively.
    _env_set_local of [env, "print", print]
    _env_set_local of [env, "write", write]
    _env_set_local of [env, "flush", flush]
    _env_set_local of [env, "len", len]
    _env_set_local of [env, "str", str]
    _env_set_local of [env, "num", num]
    _env_set_local of [env, "append", append]
    _env_set_local of [env, "type", type]
    _env_set_local of [env, "report", report]
    _env_set_local of [env, "assert", assert]
    _env_set_local of [env, "throw", throw]
    _env_set_local of [env, "keys", keys]
    _env_set_local of [env, "values", values]
    _env_set_local of [env, "has_key", has_key]
    _env_set_local of [env, "dict_set", dict_set]
    _env_set_local of [env, "dict_remove", dict_remove]
    _env_set_local of [env, "observe", observe]
    _env_set_local of [env, "contains", contains]
    _env_set_local of [env, "starts_with", starts_with]
    _env_set_local of [env, "ends_with", ends_with]
    _env_set_local of [env, "split", split]
    _env_set_local of [env, "trim", trim]
    _env_set_local of [env, "str_replace", str_replace]
    _env_set_local of [env, "str_lower", str_lower]
    _env_set_local of [env, "str_upper", str_upper]
    _env_set_local of [env, "char_at", char_at]
    _env_set_local of [env, "substr", substr]
    _env_set_local of [env, "index_of", index_of]
    _env_set_local of [env, "join", join]
    _env_set_local of [env, "concat", concat]
    _env_set_local of [env, "range", range]
    _env_set_local of [env, "abs", abs]
    _env_set_local of [env, "floor", floor]
    _env_set_local of [env, "ceil", ceil]
    _env_set_local of [env, "round", round]
    _env_set_local of [env, "min", min]
    _env_set_local of [env, "max", max]
    _env_set_local of [env, "sin", sin]
    _env_set_local of [env, "cos", cos]
    _env_set_local of [env, "tan", tan]
    _env_set_local of [env, "asin", asin]
    _env_set_local of [env, "acos", acos]
    _env_set_local of [env, "atan", atan]
    _env_set_local of [env, "atan2", atan2]
    _env_set_local of [env, "log", log]
    _env_set_local of [env, "exp", exp]
    _env_set_local of [env, "sqrt", sqrt]
    _env_set_local of [env, "pow", pow]
    _env_set_local of [env, "pi", pi]
    _env_set_local of [env, "random", random]
    _env_set_local of [env, "random_int", random_int]
    _env_set_local of [env, "seed_random", seed_random]
    _env_set_local of [env, "set_at", set_at]
    _env_set_local of [env, "get_at", get_at]
    _env_set_local of [env, "load_file", load_file]
    _env_set_local of [env, "file_exists", file_exists]
    _env_set_local of [env, "read_text", read_text]
    _env_set_local of [env, "write_text", write_text]
    _env_set_local of [env, "json_encode", json_encode]
    _env_set_local of [env, "json_decode", json_decode]
    _env_set_local of [env, "coalesce", coalesce]
    _env_set_local of [env, "env_get", env_get]
    _env_set_local of [env, "exec_capture", exec_capture]
    _env_set_local of [env, "path_join", path_join]
    _env_set_local of [env, "path_dir", path_dir]
    _env_set_local of [env, "path_base", path_base]
    _env_set_local of [env, "path_ext", path_ext]
    _env_set_local of [env, "mkdir", mkdir]
    _env_set_local of [env, "ls", ls]
    _env_set_local of [env, "rm", rm]
    _env_set_local of [env, "regex_match", regex_match]
    _env_set_local of [env, "regex_find", regex_find]
    _env_set_local of [env, "regex_replace", regex_replace]
    _env_set_local of [env, "monotonic_ms", monotonic_ms]
    _env_set_local of [env, "monotonic_ns", monotonic_ns]
    _env_set_local of [env, "chr", chr]
    _env_set_local of [env, "try_parse", try_parse]
    return env

# ============================================================
# Public API
# ============================================================

define eigen_run(source) as:
    # Reset control-flow flags from any previous run
    _eigen_returning is 0
    _eigen_return_val is null
    _eigen_breaking is 0
    _eigen_continuing is 0
    tokens is eigen_tokenize of source
    ast is eigen_parse of tokens
    env is _make_default_env of null
    result is eigen_eval of [ast, env]
    # Capture return value and reset flags
    if _eigen_returning == 1:
        result is _eigen_return_val
    _eigen_returning is 0
    _eigen_return_val is null
    _eigen_breaking is 0
    _eigen_continuing is 0
    return result
