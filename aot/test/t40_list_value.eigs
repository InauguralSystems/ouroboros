# Lists/strings in value context: list-typed locals, list-literal returns, a
# boxed list mutated with append (direct-borrow ref), string returns, and
# value-context indexing target[idx] (list/dict/string, negative indices).
define make_pair(x) as:
    h is [x, x + 1]
    return h
define triple(n) as:
    return [n, n * 2, n + 100]
define grow(n) as:
    hist is [n]
    i is 0
    loop while i < 3:
        append of [hist, i * i]
        i is i + 1
    return [len of hist, hist[0], hist[3], hist[-1]]
define label(k) as:
    if k == 0:
        return "zero"
    return "nonzero"
print of (make_pair of 5)
print of (triple of 3)
print of (grow of 7)
print of (label of 0)
print of (label of 9)
d is {"a": 10, "b": 20}
print of d["a"]
s is "hello"
print of s[0]
print of s[-1]
lst is [100, 200, 300]
print of lst[1]
print of lst[-2]
