# #70: a for-in loop var lives in the env (aot_set each step), so a numeric-
# context read of it (buffer index / index_assign RHS) must emit
# aot_num(aot_get(...)), not a bare C identifier ('j' undeclared). Also covers
# the unmasked half: a C-local buffer indexed by a BOXED numeric in a value
# context reads elementwise via aot_buf_get, not via the env.
define f(q) as:
    local u is buffer of 4
    for j in range of 4:
        u[j] is j * 1.5
    local t is 0.0
    for j in range of 4:
        t is t + u[j]
    return t

print of (f of 0)

# same shape at module scope
w is buffer of 3
for j in range of 3:
    w[j] is j + 10
tot is 0
for j in range of 3:
    tot is tot + w[j]
print of tot
