define f_evrt(n) as:
    return (ev of "a") + (len of n)
define f_evdisp(n) as:
    return (dispatch of [etbl, 0, [n]]) + (sqrt of (n - 5))
define f_evexpr(n) as:
    return (etbl[0] of "a") + (sqrt of (n - 5))
define f_sortby(n) as:
    return (len of (sort_by of [[3, 1, 2], mkey])) + (sqrt of (n - 5))
