# (#126) A numeric LOCAL used as a for BINDER inside an OBSERVED function.
# Sibling of t333, one storage class over (the nm[fvar] binder arm rather
# than the parameter arm), and silently wrong the same way on the base
# compiler -- post-loop `s` read 9 (the last iterable element, from the
# terminal env arm) where the VM's loop-scoped local holds 1:
#
#   f of 4.0   VM ["moving", 1, 14]   AOT ["moving", 9, 14]
#   f of 2.0   VM ["moving", 1, 13]   AOT ["moving", 9, 13]
#   both rc 0, no diagnostic
define f(n) as:
    local w is n
    local s is 0.0
    s is s + 1.0
    for s in [7.0, 8.0, 9.0]:
        w is w + s
    w is w * 0.5
    return [report of w, s, w]
print of (f of 4.0)
print of (f of 2.0)
