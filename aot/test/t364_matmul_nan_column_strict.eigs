# (#1361) A NaN ELEMENT in a matmul operand, read by the unguarded (no-overflow)
# arm: aot_buf_maxabs does not screen NaNs, so the arm tests each stored chunk
# of output columns and hands a NaN chunk to its scalar tail. The NaN is
# W[1], so row 0's column 0 is finite and column 1 is not: the VM stores
# O[0] and then raises at column 1 (strict), or stores 0 for the NaN term and
# runs on (EIGS_STRICT=0). A chunk-level raise would leave O[0] unwritten.
# The NaN comes from an ext_store round-trip of a tagged buffer body (t358).
define mm(out, X, W, S, Din, Dout) as:
    i is 0
    loop while i < S:
        o is 0
        loop while o < Dout:
            s is 0
            d is 0
            loop while d < Din:
                s is s + X[i * Din + d] * W[d * Dout + o]
                d is d + 1
            out[i * Dout + o] is s
            o is o + 1
        i is i + 1
    return 0
path is "/tmp/ouroboros_t364_strict_nan.store"
remove_file of path
st is store_open of path
k is store_put of [st, "c", {"v": {"_eigs_buffer": [2, "nan", 3, 4], "_eigs_shape": [0, 0]}}]
got is store_get of [st, "c", k]
store_close of st
remove_file of path
W is buffer of 32
w is 0
loop while w < 32:
    W[w] is 1
    w is w + 1
buf_copy of [got.v, 0, W, 0, 4]
X is buffer of 8
x is 0
loop while x < 8:
    X[x] is x + 1
    x is x + 1
O is buffer of 16
try:
    mm of [O, X, W, 2, 4, 8]
    print of "ran"
catch e:
    print of e.message
    print of e.line
print of f"{O[0]} {O[1]} {O[2]} {O[3]} {O[8]} {O[9]} {O[10]}"
