# ouroboros#175: a compiled function called THROUGH A VALUE (the __wrap_
# path) with fewer arguments than it declares. aot_arg_at returned NULL for
# every index of a non-list argument, so a numeric parameter's unbox
# dereferenced NULL (segfault, rc 139) where the VM raises or runs. Now a
# non-list argument is the single argument (index 0) and an unsupplied slot
# is a shared null Value, so the parameter's own check decides. Shapes: a
# missing second parameter that is never read (VM 6), a full-arity call
# through a value, and a single boxed argument reaching a generic
# parameter (the callee reads `type of`, so it is generic).
define f(a, b) as:
    print of (a + 1)
    return 0
define ap(fn) as:
    return (fn of 5)
x is ap of f
define g(a, b) as:
    print of (a * b)
    return 0
define ap2(fn) as:
    return (fn of [6, 7])
y is ap2 of g
define h(a, b) as:
    print of (type of a)
    print of a
    return 0
define ap3(fn) as:
    return (fn of "x")
z is ap3 of h
print of "after"
