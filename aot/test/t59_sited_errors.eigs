# #86: the buf class is INDEXABLE VALUE, not just VAL_BUFFER — a list of
# numbers must work through the same ops (parity with the VM's indexing).
define sum_idx(xs) as:
    total is 0
    i is 0
    loop while i < (len of xs):
        total is total + xs[i]
        i is i + 1
    return total

define bump_first(xs) as:
    xs[0] is xs[0] + 100
    return xs[0]

nums is [3, 4, 5]
print of (sum_idx of nums)
print of (bump_first of nums)
print of (sum_idx of nums)

# strings ride the same class via len
define slen(s) as:
    return len of s
print of (slen of "abcdef")

# a function returning its DICT parameter is Value*-returning (declaring
# it double handed the caller a number, and the next field read failed)
define tag_record(rec) as:
    rec.tag is "seen"
    return rec

r is {"tag": "", "n": 3}
r2 is tag_record of r
print of r2.tag
print of r2.n

# elements of an indexed value can be strings: `x[i]` proves indexable,
# never numeric-element
define first_is_p(parts) as:
    if parts[0] == "p":
        return 1
    return 0

print of (first_is_p of (["p", "cnf"]))
print of (first_is_p of (["c", "note"]))
