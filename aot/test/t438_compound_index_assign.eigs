# (#276) Compound indexed assignment: all parser-supported operators, every
# mutable target kind, once-only target/key evaluation, and runtime errors.
local xs is [20, 9]
xs[0] += 2
xs[0] -= 3
xs[0] *= 2
xs[0] /= 3
xs[0] %= 5
xs[1] &= 12
xs[1] |= 2
xs[1] ^= 3
xs[1] <<= 2
xs[1] >>= 1
print of xs

local b is buffer of 2
b[0] += 10
b[0] *= 3
b[1] |= 5
b[1] <<= 2
print of b[0]
print of b[1]

local d is {"f": 0, "n": 8}
d["f"] += 2
d["n"] >>= 1
print of d.f
print of d.n

define target_once() as:
    print of "target"
    return "inner"
define key_once() as:
    print of "key"
    return "f"
local outer is {"inner": d}
outer[target_once of []][key_once of []] += 3
print of outer.inner.f

try:
    xs[99] += 1
catch e:
    print of e.kind
    print of e.message

# The field-write census must demote f from its numeric-literal seed before
# emission: this is deliberately incompatible at runtime, not an AOT refusal.
try:
    d["f"] += "s"
catch e:
    print of e.kind
    print of e.message
