# (#1361) the packed guard aot_vguard collapses a NaN LANE to 0; under strict
# the VM's per-element num_guard raises instead. Four emitters use it: the
# reassociated `dot` of two buffers (inf * 0 in one product), the
# element-wise vector map (emit_vectorized), the output-axis matmul loop
# (outvec) and the row-wise map (rowmap). The raise must also name the STATEMENT's line: the vectorized
# bodies never stamped one, so a raise inside them reported the loop header.
# The inf is a matmul overflow copied into a buffer (raw, as on the VM).
define vmap(a, o1, o2, n) as:
    i is 0
    loop while i < n:
        o1[i] is a[i] + 1
        o2[i] is a[i] - a[i]
        i is i + 1
    return 0
define vmap1(a, o1, n) as:
    i is 0
    loop while i < n:
        o1[i] is a[i] * 0
        i is i + 1
    return 0
define mm(out, X, W, S, Din, Dout) as:
    i is 0
    loop while i < S:
        o is 0
        loop while o < Dout:
            s is 0
            d is 0
            loop while d < Din:
                s is s + X[i * Din + d] * W[d * Dout + o]
                d is d + 1
            out[i * Dout + o] is s
            o is o + 1
        i is i + 1
    return 0
define rows(out, x, g, S, D) as:
    i is 0
    loop while i < S:
        d is 0
        loop while d < D:
            out[i * D + d] is g[d] * x[i * D + d] + 1
            d is d + 1
        i is i + 1
    return 0
nb is buffer of 4
nb[0] is 1e300
nb[1] is 1e300
nb[2] is 1e300
nb[3] is 1e300
nm is reshape of [nb, 2, 2]
np is matmul of [nm, nm]
xb is buffer of 8
xb[1] is 3
xb[5] is np[0]
print of (xb[5] > 1e308)
zb is buffer of 8
zb[1] is 2
try:
    print of (dot of [xb, zb])
catch e:
    print of e.message
    print of e.line
try:
    print of (dot of [xb[0 : 8], zb[0 : 8]])
catch e:
    print of e.message
    print of e.line
o1 is buffer of 8
o2 is buffer of 8
try:
    vmap of [xb, o1, o2, 8]
    print of o2[5]
catch e:
    print of e.message
    print of e.line
try:
    vmap1 of [xb, o1, 8]
    print of o1[5]
catch e:
    print of e.message
    print of e.line
W is buffer of 32
w is 0
loop while w < 32:
    W[w] is 1
    w is w + 1
W[13] is 0
O is buffer of 16
try:
    mm of [O, xb, W, 2, 4, 8]
    print of O[0]
catch e:
    print of e.message
    print of e.line
g is buffer of 4
g[0] is 1
g[1] is 0
g[2] is 1
g[3] is 1
R is buffer of 8
try:
    rows of [R, xb, g, 2, 4]
    print of R[5]
catch e:
    print of e.message
    print of e.line
print of "after"
