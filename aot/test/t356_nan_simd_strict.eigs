# (#1361) Ordinary matmul_at creates a raw NaN, copied into xb[5]
# without a scalar read. Scalar buffer reads raise under strict1 and normalize
# NaN to0 under strict0. The separate overflowing matmul scalar read is finite
# clamp coverage, not the strict discriminator. Keep dot/ranged-dot, two-store
# vector map, one-store map, matmul-shaped outvec and rowmap target calls.
# vmap's first input is finite; only its second statement reads xb's NaN,
# so element5's first store precedes its strict failure. Print the prefix/state
# after the catch. A nonzero second-output sentinel distinguishes untouched
# failure/later lanes from completed zero stores; shared-X matmul/rowmap
# fail at their first NaN operand read.
define vmap(a, c, o1, o2, n) as:
    i is 0
    loop while i < n:
        o1[i] is a[i] + 1
        o2[i] is c[i] - c[i]
        i is i + 1
    return 0
define vmap1(a, o1, n) as:
    i is 0
    loop while i < n:
        o1[i] is a[i] * 0
        i is i + 1
    return 0
define mm(out, X, W, S, Din, Dout) as:
    i is 0
    loop while i < S:
        o is 0
        loop while o < Dout:
            s is 0
            d is 0
            loop while d < Din:
                s is s + X[i * Din + d] * W[d * Dout + o]
                d is d + 1
            out[i * Dout + o] is s
            o is o + 1
        i is i + 1
    return 0
define rows(out, x, g, S, D) as:
    i is 0
    loop while i < S:
        d is 0
        loop while d < D:
            out[i * D + d] is g[d] * x[i * D + d] + 1
            d is d + 1
        i is i + 1
    return 0
raw_inf_buf is buffer of 4
raw_inf_buf[0] is 1e300
raw_inf_buf[1] is 1e300
raw_inf_buf[2] is 1e300
raw_inf_buf[3] is 1e300
raw_inf_mat is reshape of [raw_inf_buf, 2, 2]
raw_inf is matmul of [raw_inf_mat, raw_inf_mat]
print of (raw_inf[0] > 1e308)
