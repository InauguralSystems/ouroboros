# EXPECT: re-collects the list WHOLE
# ouroboros#180 / #145 / #181: a 2-element literal arg list to a 1-parameter
# callee. The VM re-collects it whole (EigenScript#733): g's `b` is [a, b]
# and `len of b` is 2, rc 0. The compiler used to index the callee's ptypes
# by argument position, walk off the end, and die "index 1 out of range"
# with no AOT: line -- inside find_buf_param_use, reached by lib/pkg.eigs
# through `import pkg`. Now a named refusal.
define g(b) as:
    return len of b
define h(a, b) as:
    return g of [a, b]
buf is zeros of 4
print of (h of [buf, 2])
