# (#1361) Standalone guarded output-axis loop, not the matmul recognizer.
# X remains finite. Ordinary matmul_at/buf_copy places raw NaN at W[7], read
# only at column3/d1; strict1 retains columns0..2 then raises at that read.
# Strict0 normalizes it and finishes. Keep o/d/s and all four output values.
# Raw-infinity extraction separately witnesses finite scalar clamping.
raw_inf_buf is buffer of 4
raw_inf_buf[0] is 1e300
raw_inf_buf[1] is 1e300
raw_inf_buf[2] is 1e300
raw_inf_buf[3] is 1e300
raw_inf_mat is reshape of [raw_inf_buf, 2, 2]
raw_inf is matmul of [raw_inf_mat, raw_inf_mat]
print of (raw_inf[0] > 1e308)
seed_a is buffer of 2
seed_a[0] is 1e300
seed_a[1] is 1e300
seed_b is buffer of 2
seed_b[0] is 1e300
seed_b[1] is 0 - 1e300
seed_am is reshape of [seed_a, 2, 1]
seed_bm is reshape of [seed_b, 2, 1]
seed_nan is matmul_at of [seed_am, seed_bm]
define ov(out, X, W, Din, Dout) as:
    o is 0
    s is 0
    d is 0
    try:
        loop while o < Dout:
            s is 0
            d is 0
            loop while d < Din:
                s is s + X[d] * W[d * Dout + o]
                d is d + 1
            out[o] is s
            o is o + 1
    catch e:
        print of e.message
        print of e.line
    print of f"o={o} d={d} s={s}"
    return 0
X is buffer of 3
X[0] is 2
X[1] is 3
X[2] is 5
W is buffer of 12
w is 0
loop while w < 12:
    W[w] is 1
    w is w + 1
buf_copy of [seed_nan, 0, W, 7, 1]
print of "preparation-complete"
O is buffer of 4
ov of [O, X, W, 3, 4]
print of f"{O[0]} {O[1]} {O[2]} {O[3]}"
