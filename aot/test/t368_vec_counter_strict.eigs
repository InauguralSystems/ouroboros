# (#1361) Real vector-map counter after caught scalar-read failure.
# Ordinary matmul_at/buf_copy puts raw NaN at c[5]. Strict1 must preserve
# earlier output lanes and return failing counter5; strict0 normalizes the
# input and completes. Keep the actual loop, caught line, counter and prefix
# row. Raw-infinity extraction separately witnesses finite scalar clamping.
raw_inf_buf is buffer of 4
raw_inf_buf[0] is 1e300
raw_inf_buf[1] is 1e300
raw_inf_buf[2] is 1e300
raw_inf_buf[3] is 1e300
raw_inf_mat is reshape of [raw_inf_buf, 2, 2]
raw_inf is matmul of [raw_inf_mat, raw_inf_mat]
print of (raw_inf[0] > 1e308)
seed_a is buffer of 2
seed_a[0] is 1e300
seed_a[1] is 1e300
seed_b is buffer of 2
seed_b[0] is 1e300
seed_b[1] is 0 - 1e300
seed_am is reshape of [seed_a, 2, 1]
seed_bm is reshape of [seed_b, 2, 1]
seed_nan is matmul_at of [seed_am, seed_bm]
define f(c, o, n) as:
    i is 0
    try:
        loop while i < n:
            o[i] is (c[i] - c[i]) + 1
            i is i + 1
    catch e:
        print of e.message
        print of e.line
    return i
c is buffer of 8
buf_copy of [seed_nan, 0, c, 5, 1]
print of "preparation-complete"
o is buffer of 8
print of (f of [c, o, 8])
print of f"{o[0]} {o[3]} {o[4]} {o[5]} {o[6]} {o[7]}"
