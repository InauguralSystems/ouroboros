# The shared frontend gives `not` its new precedence below comparisons and
# arithmetic (#307). These witnesses explicitly retain their intended former
# unary-first grouping; the AOT consumes the same AST shapes. This fixture also
# covers `%=`, f-string splice layout, and #1637's bool/number type errors.
x is 3
try:
    print of ((not x) + 1)
catch e:
    print of e.message
try:
    print of ((not 2) == 1)
catch e:
    print of e.message
try:
    print of ((not 0) * 5)
catch e:
    print of e.message
# Preserve this fixture's intended unary-first comparison explicitly (#307).
print of ((not x) == false)
print of (not not x)
y is 9
y %= 4
print of y
print of f"v={ 1 + 2 }"
define pick(a, b) as:
    if (not a) + b:
        return 1
    return 0
try:
    print of (pick of [0, -1])
catch e:
    print of f"{e.message} @{e.line}"
