# (#1361, round 3) A row-wise map (emit_rowmap) meeting a NaN mid-chunk: row
# 1's element 1 is inf * 0. The VM writes out[4] and raises at out[5] with
# i = 1, d = 1; under EIGS_STRICT=0 the NaN is 0 and the loop runs on. The
# rowmap used to raise the chunk in place, leaving out[4] unwritten and d at
# the chunk's first element.
nb is buffer of 4
nb[0] is 1e300
nb[1] is 1e300
nb[2] is 1e300
nb[3] is 1e300
nm is reshape of [nb, 2, 2]
p is matmul of [nm, nm]
define rm(out, x, g, S, D) as:
    i is 0
    d is 0
    try:
        loop while i < S:
            d is 0
            loop while d < D:
                out[i * D + d] is x[i * D + d] * g[d]
                d is d + 1
            i is i + 1
    catch e:
        print of e.message
        print of e.line
    print of f"i={i} d={d}"
    return 0
x is buffer of 8
g is buffer of 4
k is 0
loop while k < 8:
    x[k] is k + 1
    k is k + 1
k is 0
loop while k < 4:
    g[k] is 2
    k is k + 1
x[5] is p[0]
g[1] is 0
out is buffer of 8
rm of [out, x, g, 2, 4]
print of f"{out[0]} {out[1]} {out[2]} {out[3]} {out[4]} {out[5]} {out[6]} {out[7]}"
