# (#1361) Rowmap mid-chunk partial-state and counter control.
# Ordinary matmul_at/buf_copy puts raw NaN at x[5], row1/element1. Strict1
# fails at its scalar read after out[4] was written, with i=1,d=1; strict0
# normalizes the read and completes. Keep g[1]=0, actual rowmap shape and
# complete output/counter row. Raw infinity separately clamps on extraction.
raw_inf_buf is buffer of 4
raw_inf_buf[0] is 1e300
raw_inf_buf[1] is 1e300
raw_inf_buf[2] is 1e300
raw_inf_buf[3] is 1e300
raw_inf_mat is reshape of [raw_inf_buf, 2, 2]
raw_inf is matmul of [raw_inf_mat, raw_inf_mat]
print of (raw_inf[0] > 1e308)
seed_a is buffer of 2
seed_a[0] is 1e300
seed_a[1] is 1e300
seed_b is buffer of 2
seed_b[0] is 1e300
seed_b[1] is 0 - 1e300
seed_am is reshape of [seed_a, 2, 1]
seed_bm is reshape of [seed_b, 2, 1]
seed_nan is matmul_at of [seed_am, seed_bm]
define rm(out, x, g, S, D) as:
    i is 0
    d is 0
    try:
        loop while i < S:
            d is 0
            loop while d < D:
                out[i * D + d] is x[i * D + d] * g[d]
                d is d + 1
            i is i + 1
    catch e:
        print of e.message
        print of e.line
    print of f"i={i} d={d}"
    return 0
x is buffer of 8
g is buffer of 4
k is 0
loop while k < 8:
    x[k] is k + 1
    k is k + 1
k is 0
loop while k < 4:
    g[k] is 2
    k is k + 1
buf_copy of [seed_nan, 0, x, 5, 1]
print of "preparation-complete"
g[1] is 0
out is buffer of 8
rm of [out, x, g, 2, 4]
print of f"{out[0]} {out[1]} {out[2]} {out[3]} {out[4]} {out[5]} {out[6]} {out[7]}"
