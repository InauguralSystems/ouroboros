# `of` binds its argument as unary-or-tighter, matching the C parser:
# it does not absorb trailing infix arithmetic. Differential vs the VM oracle.
x is 3
print of (sqrt of x + 1)        # (sqrt of x) + 1
xs is [10, 20, 30]
print of (len of xs - 1)        # (len of xs) - 1
print of (1 + len of xs)        # 1 + (len of xs)
print of (sqrt of sqrt of 16.0) # right-associative: sqrt of (sqrt of 16)
print of (sqrt of 4.0)
