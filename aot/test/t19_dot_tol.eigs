# dot reduction: AOT reassociates across SIMD lanes (association-unspecified by
# spec), so it matches the VM within tolerance, not byte-for-byte (_tol harness).
a is buffer of 300
b is buffer of 300
i is 0
loop while i < 300:
    a[i] is i * 0.013 - 1.7
    b[i] is i * 0.027 + 0.4
    i is i + 1
print of (dot of [a, b])

# a second, shorter dot whose length isn't a multiple of the SIMD width
c is buffer of 53
d is buffer of 53
i is 0
loop while i < 53:
    c[i] is i * 0.5
    d[i] is i - 10.0
    i is i + 1
print of (dot of [c, d])

# sum and norm reassociate the same way (association-unspecified) — tolerance.
print of (sum of a)
print of (norm of a)
print of (sum of c)
print of (norm of d)
