define identity(n) as:
    return n
define run(items) as:
    local k is 6001
    loop while k > 0:
        local callee is identity
        if k == 1:
            callee is 0
        local result is callee of (1 +
            2)
        k is k - 1
    return result
got is 0
try:
    result is run of ([1])
catch e:
    got is e.line
print of got
