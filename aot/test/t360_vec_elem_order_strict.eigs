# (#1361, critic round 1) A vectorized loop with TWO stores that can each fail
# must raise in the VM's ELEMENT order. The VM runs element 0's two statements,
# then element 1's: element 0's second statement (c[0] - c[0] = inf - inf, a
# NaN) fails first, at line 21, after o1[0] was written. The packed body ran
# one statement at a time over a whole chunk and raised element 1's `1 / 0`
# (line 20) first, with nothing of the chunk stored. Under EIGS_STRICT=0 the
# NaN becomes 0 and element 1's division by zero raises on both sides.
# The critic's repro (vorder_min), wrapped in try so both modes exit 0; the
# state after the raise is printed too.
nb is buffer of 4
nb[0] is 1e300
nb[1] is 1e300
nb[2] is 1e300
nb[3] is 1e300
nm is reshape of [nb, 2, 2]
p is matmul of [nm, nm]
define f(z, c, o1, o2, n) as:
    i is 0
    loop while i < n:
        o1[i] is 1 / z[i]
        o2[i] is c[i] - c[i]
        i is i + 1
    return 0
z is buffer of 4
c is buffer of 4
z[0] is 1
z[1] is 0
z[2] is 1
z[3] is 1
c[0] is p[0]
o1 is buffer of 4
o2 is buffer of 4
try:
    f of [z, c, o1, o2, 4]
catch e:
    print of e.message
    print of e.line
print of f"{o1[0]} {o1[1]} {o1[2]} {o1[3]} / {o2[0]} {o2[1]} {o2[2]} {o2[3]}"
