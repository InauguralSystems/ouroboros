# (#1361) First-statement-first control for element/chunk replay ordering.
# At element4 (chunk start at widths2/4), statement1 reads raw NaN; statement2
# reads another raw NaN only at later element5. Strict1 must fail at the first
# read with prior lanes intact. Strict0 normalizes both reads and completes.
# Keep full outputs; raw-infinity extraction separately pins scalar clamping.
raw_inf_buf is buffer of 4
raw_inf_buf[0] is 1e300
raw_inf_buf[1] is 1e300
raw_inf_buf[2] is 1e300
raw_inf_buf[3] is 1e300
raw_inf_mat is reshape of [raw_inf_buf, 2, 2]
raw_inf is matmul of [raw_inf_mat, raw_inf_mat]
print of (raw_inf[0] > 1e308)
seed_a is buffer of 2
seed_a[0] is 1e300
seed_a[1] is 1e300
seed_b is buffer of 2
seed_b[0] is 1e300
seed_b[1] is 0 - 1e300
seed_am is reshape of [seed_a, 2, 1]
seed_bm is reshape of [seed_b, 2, 1]
seed_nan is matmul_at of [seed_am, seed_bm]
define h(a, z, c, o1, o2, n) as:
    i is 0
    loop while i < n:
        o1[i] is a[i] * z[i]
        o2[i] is c[i] - c[i] + z[i]
        i is i + 1
    return 0
a is buffer of 8
z is buffer of 8
c is buffer of 8
k is 0
loop while k < 8:
    a[k] is k + 1
    z[k] is 2
    c[k] is k
    k is k + 1
buf_copy of [seed_nan, 0, a, 4, 1]
z[4] is 0
buf_copy of [seed_nan, 0, c, 5, 1]
print of "preparation-complete"
o1 is buffer of 8
o2 is buffer of 8
try:
    h of [a, z, c, o1, o2, 8]
catch e:
    print of e.message
    print of e.line
print of f"{o1[0]} {o1[1]} {o1[2]} {o1[3]} {o1[4]} {o1[5]} {o1[6]} {o1[7]}"
print of f"{o2[0]} {o2[1]} {o2[2]} {o2[3]} {o2[4]} {o2[5]} {o2[6]} {o2[7]}"
