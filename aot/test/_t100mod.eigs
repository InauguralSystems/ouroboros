# Every shape the conditional-binding guard must ACCEPT.
a is 1

# v0.43.0 pin (#1106): a `for` body's FRESH `is` now reaches the module dict
# exactly like an `if` body's -- conditionally -- so that shape moved to the
# refuse tier (test/refuse/for_body_fresh_binding.eigs). What stays accepted:
# a `for` body that RE-ASSIGNS an already-bound top-level name (the dict is
# the same either way) and one that writes its own BINDER (loop-scoped on
# every road: `keys of M` has no `qv`, and `M.qv` is null).
floop is 4
for qv in range of 2:
    floop is floop + 1
    qv is qv + 100

# re-assigning an ALREADY top-level name inside an `if` is not a new binding:
# the dict is identical whichever way the branch goes.
if a == 1:
    a is 2

# same, through a loop and a match
b is 10
loop while b < 12:
    b is b + 1
match a:
    case 2:
        b is 99

define g() as:
    # a function body binds nothing at import time — the dict is a snapshot
    # taken before any function has run
    hidden is 7
    return hidden

# `unobserved:` always executes, so this IS a top-level binding
unobserved:
    u1 is 3
