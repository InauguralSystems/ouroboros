# (#1361) a packed division inside a vectorized map (aot_vdiv -> aot_vdivp).
# Its zero-divisor raise holds in both modes; a NaN lane (inf - inf in the
# numerator) raises under strict. Which comes first is decided ELEMENT BY
# ELEMENT on the VM, so the three rows put the inf and the zero in different
# elements: NaN only (5), zero before NaN (4 then 5), NaN before zero.
define qmap(a, b, o, n) as:
    i is 0
    loop while i < n:
        o[i] is (a[i] - a[i]) / b[i]
        i is i + 1
    return 0
nb is buffer of 4
nb[0] is 1e300
nb[1] is 1e300
nb[2] is 1e300
nb[3] is 1e300
nm is reshape of [nb, 2, 2]
np is matmul of [nm, nm]
a is buffer of 8
b is buffer of 8
o is buffer of 8
cases is [[5, 0 - 1], [5, 4], [4, 5], [2, 7]]
for c in cases:
    k is 0
    loop while k < 8:
        a[k] is k
        b[k] is 1
        k is k + 1
    a[c[0]] is np[0]
    if c[1] >= 0:
        b[c[1]] is 0
    try:
        qmap of [a, b, o, 8]
        print of o[3]
    catch e:
        print of e.message
        print of e.line
print of "after"
