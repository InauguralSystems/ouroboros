# (#1361) Real vector division-map ordering across NaN and zero-divisor lanes.
# Seed raw NaN through matmul_at/buf_copy; its numerator scalar read raises
# under strict1 and becomes0 under strict0. Preserve all four NaN/zero rows
# and caught error/line results. Separate raw-infinity scalar extraction pins
# finite clamping, not a NaN arithmetic event. Preparation is marked per row.
define qmap(a, b, o, n) as:
    i is 0
    loop while i < n:
        o[i] is (a[i] - a[i]) / b[i]
        i is i + 1
    return 0
raw_inf_buf is buffer of 4
raw_inf_buf[0] is 1e300
raw_inf_buf[1] is 1e300
raw_inf_buf[2] is 1e300
raw_inf_buf[3] is 1e300
raw_inf_mat is reshape of [raw_inf_buf, 2, 2]
raw_inf is matmul of [raw_inf_mat, raw_inf_mat]
print of (raw_inf[0] > 1e308)
seed_a is buffer of 2
seed_a[0] is 1e300
seed_a[1] is 1e300
seed_b is buffer of 2
seed_b[0] is 1e300
seed_b[1] is 0 - 1e300
seed_am is reshape of [seed_a, 2, 1]
seed_bm is reshape of [seed_b, 2, 1]
seed_nan is matmul_at of [seed_am, seed_bm]
a is buffer of 8
b is buffer of 8
o is buffer of 8
cases is [[5, 0 - 1], [5, 4], [4, 5], [2, 7]]
for c in cases:
    k is 0
    loop while k < 8:
        a[k] is k
        b[k] is 1
        k is k + 1
    buf_copy of [seed_nan, 0, a, c[0], 1]
    print of "preparation-complete"
    if c[1] >= 0:
        b[c[1]] is 0
    try:
        qmap of [a, b, o, 8]
        print of o[3]
    catch e:
        print of e.message
        print of e.line
print of "after"
