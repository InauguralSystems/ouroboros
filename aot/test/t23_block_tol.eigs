# Full pre-norm transformer block (iLambdaAi v2 architecture): d_model=32,
# d_ff=64, seq_len=8.  x + attn(LN(x)) ; then + ffn(LN(.)).  Exercises matmul
# (int-indexed), layernorm (ranged `sum` for the mean), attention (slice
# score-dot + softmax `sum`), GELU (tanh via exp), and residual adds.

define matmul(out, X, W, S, Din, Dout) as:
    i is 0
    loop while i < S:
        o is 0
        loop while o < Dout:
            s is 0
            d is 0
            loop while d < Din:
                s is s + X[i * Din + d] * W[d * Dout + o]
                d is d + 1
            out[i * Dout + o] is s
            o is o + 1
        i is i + 1

define layernorm(out, x, gamma, beta, S, D, eps) as:
    i is 0
    loop while i < S:
        mu is (sum of x[i * D : i * D + D]) / D
        v is 0
        d is 0
        loop while d < D:
            diff is x[i * D + d] - mu
            v is v + diff * diff
            d is d + 1
        v is v / D
        inv is 1 / (sqrt of (v + eps))
        d is 0
        loop while d < D:
            out[i * D + d] is gamma[d] * (x[i * D + d] - mu) * inv + beta[d]
            d is d + 1
        i is i + 1

define attn_scores(scores, Q, K, S, D, scale, neg) as:
    i is 0
    loop while i < S:
        j is 0
        loop while j < S:
            sc is (dot of [Q[i * D : i * D + D], K[j * D : j * D + D]]) * scale
            if j > i:
                sc is neg
            scores[i * S + j] is sc
            j is j + 1
        i is i + 1

define softmax_rows(scores, S) as:
    i is 0
    loop while i < S:
        m is scores[i * S]
        j is 1
        loop while j < S:
            if scores[i * S + j] > m:
                m is scores[i * S + j]
            j is j + 1
        j is 0
        loop while j < S:
            scores[i * S + j] is exp of (scores[i * S + j] - m)
            j is j + 1
        z is sum of scores[i * S : i * S + S]
        j is 0
        loop while j < S:
            scores[i * S + j] is scores[i * S + j] / z
            j is j + 1
        i is i + 1

define context_mm(ctx, scores, V, S, D) as:
    i is 0
    loop while i < S:
        d is 0
        loop while d < D:
            s is 0
            j is 0
            loop while j < S:
                s is s + scores[i * S + j] * V[j * D + d]
                j is j + 1
            ctx[i * D + d] is s
            d is d + 1
        i is i + 1

define attention(out, x, Wq, Wk, Wv, Wo, Q, K, V, scores, ctx, S, D, scale, neg) as:
    matmul of [Q, x, Wq, S, D, D]
    matmul of [K, x, Wk, S, D, D]
    matmul of [V, x, Wv, S, D, D]
    attn_scores of [scores, Q, K, S, D, scale, neg]
    softmax_rows of [scores, S]
    context_mm of [ctx, scores, V, S, D]
    matmul of [out, ctx, Wo, S, D, D]

define gelu(out, h, n) as:
    i is 0
    loop while i < n:
        xv is h[i]
        c is 0.7978845608028654 * (xv + 0.044715 * xv * xv * xv)
        e is exp of (2 * c)
        t is (e - 1) / (e + 1)
        out[i] is 0.5 * xv * (1 + t)
        i is i + 1

define ffn(out, x, W1, W2, hbuf, S, D, Dff) as:
    matmul of [hbuf, x, W1, S, D, Dff]
    gelu of [hbuf, hbuf, S * Dff]
    matmul of [out, hbuf, W2, S, Dff, D]

S is 8
D is 32
Dff is 64
eps is 0.00001
scale is 0.17677669529663687
neg is 0 - 1000000
x is buffer of (S * D)
Wq is buffer of (D * D)
Wk is buffer of (D * D)
Wv is buffer of (D * D)
Wo is buffer of (D * D)
W1 is buffer of (D * Dff)
W2 is buffer of (Dff * D)
g1 is buffer of D
b1 is buffer of D
g2 is buffer of D
b2 is buffer of D
t1 is buffer of (S * D)
t2 is buffer of (S * D)
att is buffer of (S * D)
h is buffer of (S * D)
ffo is buffer of (S * D)
Q is buffer of (S * D)
K is buffer of (S * D)
V is buffer of (S * D)
scores is buffer of (S * S)
ctx is buffer of (S * D)
hbuf is buffer of (S * Dff)
out is buffer of (S * D)
i is 0
loop while i < (S * D):
    x[i] is ((i % 13) - 6) * 0.05
    i is i + 1
i is 0
loop while i < (D * D):
    Wq[i] is ((i % 7) - 3) * 0.03
    Wk[i] is ((i % 11) - 5) * 0.02
    Wv[i] is ((i % 5) - 2) * 0.04
    Wo[i] is ((i % 9) - 4) * 0.025
    i is i + 1
i is 0
loop while i < (D * Dff):
    W1[i] is ((i % 7) - 3) * 0.02
    i is i + 1
i is 0
loop while i < (Dff * D):
    W2[i] is ((i % 5) - 2) * 0.03
    i is i + 1
i is 0
loop while i < D:
    g1[i] is 1
    b1[i] is 0
    g2[i] is 1
    b2[i] is 0
    i is i + 1
r is 0
loop while r < 2:
    layernorm of [t1, x, g1, b1, S, D, eps]
    attention of [att, t1, Wq, Wk, Wv, Wo, Q, K, V, scores, ctx, S, D, scale, neg]
    k is 0
    loop while k < (S * D):
        h[k] is x[k] + att[k]
        k is k + 1
    layernorm of [t2, h, g2, b2, S, D, eps]
    ffn of [ffo, t2, W1, W2, hbuf, S, D, Dff]
    k is 0
    loop while k < (S * D):
        out[k] is h[k] + ffo[k]
        k is k + 1
    r is r + 1
print of out[0]
print of out[100]
print of out[255]
