# (round 176) an index store whose operands contain a CALL is sequenced
# (target read owned, VM operand order) and, when the value is numeric,
# stored in place without a box. Lists and buffers, a negative index, a
# call that mutates the target list mid-statement, and an out-of-range
# store caught by try.
define src(i) as:
    return (i * 7) & 255
define grow(xs) as:
    append of [xs, 0]
    return 1
local buf is buffer of 8
local i is 0
loop while i < 8:
    buf[i] is src of (i + 3)
    i is i + 1
define dump(b, n) as:
    local o is ""
    local k is 0
    loop while k < n:
        o is o + (str of b[k]) + " "
        k is k + 1
    return o
print of (dump of [buf, 8])
local xs is [0, 0, 0, 0]
xs[-1] is src of 9
xs[grow of xs] is src of 1
print of xs
local d is {"data": buffer of 4, "n": 0}
d.data[d.n + 1] is src of 2
d.data[3] is (src of 5) + 0.5
print of (dump of [d.data, 4])
try:
    xs[99] is src of 1
catch e:
    print of "caught"
