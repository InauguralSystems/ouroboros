+# Only actual lowered-frame storage participates. The complete consumer is
+# call-free, so borrowed sources cannot be rebound by a sibling expression.
+# Keep this scalar reader separate from assignment: a list's heap number is
+# read raw, whereas storing it in a local may cross a later make_num boundary.
+define slot_sum_operands(node, nm, bt) as:
+    local n is unwrap of node
+    if n[0] != "binop":
+        return []
+    if n[1] != "+":
+        return []
+    local left is lowered_slot_expr of [n[2], nm, bt]
+    local right is lowered_slot_expr of [n[3], nm, bt]
+    if (left == "") or (right == ""):
+        return []
+    return [left, right]
+
+define emit_slot_index_operand(node, nm, bt) as:
+    local source is lowered_slot_expr of [node, nm, bt]
+    if source != "":
+        return "aot_scalar_slot(" + source + ")"
+    local pair is slot_sum_operands of [node, nm, bt]
+    if (len of pair) == 2:
+        return "aot_scalar_add_slots(" + pair[0] + ", " + pair[1] + ")"
+    return ""
+
+define emit_slot_scalar_read(node, nm, bt) as:
+    if (is_num_expr of [node, nm, bt]) == 1:
+        # Preserve the existing numeric emitter's checks and boundaries.
+        return "aot_scalar_number(" + (emit_num of [node, nm, bt, 0]) + ")"
+    local source is lowered_slot_expr of [node, nm, bt]
+    if source != "":
+        return "aot_scalar_slot(" + source + ")"
+    local n is unwrap of node
+    if n[0] == "index":
+        local target is lowered_slot_expr of [n[1], nm, bt]
+        local index is emit_slot_index_operand of [n[2], nm, bt]
+        if (target != "") and (index != ""):
+            return "({ EigsSlot _sct = " + target + "; AotScalarRead _sci = " + index + "; aot_scalar_index(_sct, _sci); })"
+    return ""
+
+define slot_scalar_rhs_safe(node, nm, bt) as:
+    # A borrowed frame slot may need an owned Value fallback on the LHS.
+    # Do not stage that ownership before a RHS which can raise: longjmp does
+    # not run scalar_equal's release. Call-free alone is insufficient.
+    if (lowered_slot_expr of [node, nm, bt]) != "":
+        return 1
+    local n is unwrap of node
+    if n[0] == "num":
+        return 1
+    if n[0] == "unary":
+        local operand is unwrap of n[2]
+        if (n[1] == "-") and (operand[0] == "num"):
+            return 1
+        return 0
+    if n[0] == "ident":
+        if (nm[n[1]] == 1) and ((bound_bit_read_of of [n[1], nm]) == 0) and (g_cur_interloc[n[1]] != 1) and ((obs_name of n[1]) == 0):
+            return 1
+    return 0
+
+define emit_slot_condition(node, nm, bt) as:
+    if (g_lowerloc != 1) or ((has_call_node of node) == 1):
+        return ""
+    local n is unwrap of node
+    if n[0] != "binop":
+        return ""
+    if (n[1] == "and") or (n[1] == "or"):
+        local left_cond is emit_slot_condition of [n[2], nm, bt]
+        local right_cond is emit_slot_condition of [n[3], nm, bt]
+        if (left_cond == "") or (right_cond == ""):
+            return ""
+        local op is " && "
+        if n[1] == "or":
+            op is " || "
+        # Only condition position: and/or in value position return operands.
+        return "(" + left_cond + op + right_cond + ")"
+    if (n[1] != "==") and (n[1] != "!="):
+        return ""
+    if (slot_scalar_rhs_safe of [n[3], nm, bt]) != 1:
+        return ""
+    if ((is_num_expr of [n[2], nm, bt]) == 1) and ((is_num_expr of [n[3], nm, bt]) == 1):
+        return ""
+    local left_read is emit_slot_scalar_read of [n[2], nm, bt]
+    local right_read is emit_slot_scalar_read of [n[3], nm, bt]
+    if (left_read == "") or (right_read == ""):
+        return ""
+    local neg is ""
+    if n[1] == "!=":
+        neg is "!"
+    # Stage the READ, not just its index operands. The RHS is nonraising by
+    # the explicit atom whitelist above, not merely because it is call-free.
+    return "({ AotScalarRead _scl = " + left_read + "; AotScalarRead _scr = " + right_read + "; " + neg + "aot_scalar_equal(_scl, _scr); })"
+
