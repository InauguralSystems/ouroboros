# OBSERVER-GATE COST, arm B of the triple (ouroboros#126).
# Method, numbers and mechanism: obs_gate_a_unobserved.eigs.
#
# One predicate read at the very end makes g_observed == 1 for the WHOLE unit,
# which demotes every scalar to a name-keyed env lookup. The hot loops are
# wrapped in `unobserved:`, so no entropy walk runs inside them.
#
# B minus A is therefore the compile-time gate ALONE: same arithmetic, same
# (zero) runtime observer work in the loops. Measured 3.04x.
#
# This arm is also the standing evidence that `unobserved:` is the WRONG lever
# for this cost. It makes aot_observe_num return early from the entropy walk,
# but the name-keyed store and lookup are already emitted — so B is inside
# `unobserved:` throughout and still pays 3x. (Upstream it is the right lever:
# 8.51x on EigenMiniSat for EigenScript#915, where the cost IS the walk.)
define dots(out, A, B, M, D) as:
    k is 0
    loop while k < M:
        out[k] is dot of [A[k * D : k * D + D], B[k * D : k * D + D]]
        k is k + 1
D is 256
M is 512
A is buffer of (M * D)
B is buffer of (M * D)
out is buffer of M
unobserved:
    i is 0
    loop while i < (M * D):
        A[i] is ((i % 17) - 8) * 0.01
        B[i] is ((i % 13) - 6) * 0.02
        i is i + 1
    r is 0
    loop while r < 30:
        dots of [out, A, B, M, D]
        r is r + 1
    acc is 0.0
    j is 0
    loop while j < M:
        acc is acc + out[j]
        j is j + 1
print of f"checksum {acc}"
ch is 1.0
ch is 2.0
print of f"obs {converged of ch}"
