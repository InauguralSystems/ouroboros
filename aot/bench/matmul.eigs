# Matmul X[S,Din] @ W[Din,Dout] — the transformer-scale kernel. Index dimensions
# (Din/Dout) and loop counters are inferred INTEGER and emitted as native C
# `long`, so the index `i*Din+d` runs in integer math (no float index, no
# double->long conversion per access, no num_guard on the index). Accumulator
# `s` stays `double` (it sums buffer values; as a long it would wrap where the
# VM clamps). The output column `o` is also OUTPUT-AXIS SIMD vectorized (each
# lane = one output, summed in the VM's d-order -> byte-exact). Measured
# d_model=512, 100 passes (dev box): all-double 34.6s -> int-index 16.9s ->
# +output-axis SIMD 8.4s -> +num_guard elision 3.2s = ~10.8x total, byte-identical
# (SSE2 2-wide; AVX2 ~2x more on the SIMD step). The guard elision is gated on a
# once-per-call overflow precheck (Din*max|X|*max|W| <= 1e308); above that it
# falls back to the guarded path (clamps exactly like the VM).
define matmul(out, X, W, S, Din, Dout) as:
    i is 0
    loop while i < S:
        o is 0
        loop while o < Dout:
            s is 0
            d is 0
            loop while d < Din:
                s is s + X[i * Din + d] * W[d * Dout + o]
                d is d + 1
            out[i * Dout + o] is s
            o is o + 1
        i is i + 1
S is 8
D is 512
X is buffer of (S * D)
W is buffer of (D * D)
O is buffer of (S * D)
i is 0
loop while i < (S * D):
    X[i] is ((i % 13) - 6) * 0.05
    i is i + 1
i is 0
loop while i < (D * D):
    W[i] is ((i % 7) - 3) * 0.003
    i is i + 1
r is 0
loop while r < 100:
    matmul of [O, X, W, S, D, D]
    r is r + 1
print of O[0]
print of O[4095]
