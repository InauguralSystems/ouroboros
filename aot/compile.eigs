            # shadow; a lifted C fn reads the file-scope global and a
            # capbind capture is a stale value snapshot.
            shwhy is "the name is referenced by a nested define/lambda"
        elif (sh_binds of [body, shn]) == 1:
            # a binder is not a chain-walk write — the VM loop-scopes a
            # for-var over the shadow (post-loop reads see the SHADOW, not
            # the last iterate); the C emission would write the shadow
            # through. Refuse anywhere in the body (a pre-decl binder has
            # its own module-scope twin, see the issue referenced by
            # F-OURO-33).
            shwhy is "the name is re-bound as a for/catch/comprehension variable"
