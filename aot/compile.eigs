                local mkw is "if"
                if mfirst == 0:
                    mkw is "else if"
                mout is mout + ind + "    " + mkw + " (" + msub + " == " + (emit_num of [mpat, nm, bt, 0]) + ") {\n" + (emit_stmts of [mbody, ind + "        ", nm, bt, minits, gf]) + ind + "    }\n"
                mfirst is 0
            mi is mi + 1
        return mout + ind + "}\n"
    if t == "func":
        # (round 127, #199) a define nested in a MODULE-scope loop/branch
        # body: the lift pass runs over function bodies only, so the node
        # reached the emitter raw and the refusal named the AST node.
        # On the VM a define inside a `for` body is loop-scoped (its name
        # dies with the loop); the module-scope lift is not built.
        throw of ("AOT: define '" + (str of (node[1])) + "' is nested inside a module-scope block (a loop or branch body); nested defines are lifted inside functions only, and a define inside a module `for` body is loop-scoped on the VM. Move it to top level, or into a function (ouroboros#199).")
    throw of ("AOT: cannot emit statement node '" + t + "'")

# ---- buffer value-bound inference (for guard elision in vectorized maps) ----
# A buffer starts at 0 (zeros/buffer init); each `buf[?] is expr` fill raises its
# bound by expr's bound. expr_bound returns a finite upper bound only if NO
# intermediate can overflow (all <= 1e300 << 1e308); else null (unknown/unsafe).
# Then num_guard is provably identity on the map -> safe to emit raw SIMD.
define expr_bound(node, bb) as:
    local n is unwrap of node
    local t is n[0]
    if t == "num":
        local a is n[1]
        if a < 0:
            a is 0 - a
        return a
    if t == "index":
        local tgt is unwrap of n[1]
        if tgt[0] != "ident":
            return null
        return bb[tgt[1]]
    if t == "ident":
        return g_scalbound[n[1]]
    if t == "binop":
        local op is n[1]
        local ba is expr_bound of [n[2], bb]
        if ba == null:
            return null
        local bc is expr_bound of [n[3], bb]
        if bc == null:
            return null
        local r is 0
        if op == "*":
            r is ba * bc
        elif op == "+":
            r is ba + bc
        elif op == "-":
            r is ba + bc
        else:
            return null
        if r > 1e300:
            return null
        return r
    return null

# A numeric scalar is value-bounded if every assignment to it is a num literal
# (bound = max |literal|); otherwise unknown. Catches constant coefficients.
define infer_scalar_bounds(stmts, nm) as:
    local assigns is collect_assigns of [stmts, {}]
    local names is keys of assigns
    local sb is {}
    for k in range of (len of names):
        local v is names[k]
        if nm[v] == 1:
            local rhss is assigns[v]
            local mx is 0
            local allok is 1
            for j in range of (len of rhss):
                local r is unwrap of rhss[j]
                if r[0] == "num":
                    local a is r[1]
                    if a < 0:
                        a is 0 - a
                    if a > mx:
                        mx is a
                else:
                    allok is 0
            if allok == 1:
                sb[v] is mx
    return sb

define collect_iassigns_stmt(node, acc) as:
    local t is node[0]
    if t == "_line":
        collect_iassigns_stmt of [node[2], acc]
        return null
    if t == "index_assign":
        local tgt is unwrap of node[1]
        if tgt[0] == "ident":
            local b is tgt[1]
            if acc[b] == null:
                acc[b] is []
            acc[b] is (append of [acc[b], node[3]])
        return null
    if t == "if":
        collect_iassigns of [node[2], acc]
        collect_iassigns of [node[3], acc]
        return null
    if t == "loop":
        collect_iassigns of [node[2], acc]
        return null
    return null

define collect_iassigns(stmts, acc) as:
    for k in range of (len of stmts):
        collect_iassigns_stmt of [stmts[k], acc]
    return acc

define infer_buffer_bounds(stmts, bt) as:
    local fills is collect_iassigns of [stmts, {}]
    local bb is {}
    local bnames is keys of bt
    for k in range of (len of bnames):
        if bt[bnames[k]] == 1:
            bb[bnames[k]] is 0
    local changed is 1
    local iters is 0
    loop while (changed == 1) and (iters < 20):
        changed is 0
        iters is iters + 1
        local fnames is keys of fills
        for k in range of (len of fnames):
            local b is fnames[k]
            local vals is fills[b]
            for j in range of (len of vals):
                if bb[b] != null:
                    local eb is expr_bound of [vals[j], bb]
                    if eb == null:
                        bb[b] is null
                        changed is 1
                    elif eb > bb[b]:
                        bb[b] is eb
                        changed is 1
    return bb

define map_elidable(val) as:
    if (expr_bound of [val, g_bufbound]) == null:
        return 0
    return 1

# ---- vectorized element-wise buffer-map recognition ----
# Pattern: `loop while ctr < bound:  <buf>[ctr] is <vecexpr> ...;  ctr is ctr+1`
# where every index is exactly the counter and vecexpr is buffer[ctr] reads,
# numeric literals, and +/-/*. Emitted as a SIMD loop + scalar tail behind a
# runtime guard (ctr==0 && bound<=len), with the scalar loop as the fallback —
# so it is always correct regardless of the static analysis.
define is_vec_expr(node, ctr, nm, bt) as:
    local n is unwrap of node
    local t is n[0]
    if t == "num":
        return 1
    if t == "ident":
        # the counter as a value = iota ({_vi, _vi+1, ...}); any other numeric
        # scalar is loop-invariant (the body only assigns the counter + buffer
        # elements) and is broadcast across lanes.
        if n[1] == ctr:
            return 1
        if nm[n[1]] == 1:
            return 1
        return 0
    if t == "index":
        local tgt is unwrap of n[1]
        local idx is unwrap of n[2]
        if tgt[0] != "ident":
            return 0
        if bt[tgt[1]] != 1:
            return 0
        # index must be the counter, or counter +/- a constant (a neighbor)
        if idx[0] == "ident":
            if idx[1] == ctr:
                return 1
            return 0
        if idx[0] == "binop":
            if (idx[1] != "+") and (idx[1] != "-"):
                return 0
            local ia is unwrap of idx[2]
            local ib is unwrap of idx[3]
            if ia[0] != "ident":
                return 0
            if ia[1] != ctr:
                return 0
            if ib[0] != "num":
                return 0
            return 1
        return 0
    if t == "binop":
        local op is n[1]
        if (op != "+") and (op != "-") and (op != "*") and (op != "/"):
            return 0
        if (is_vec_expr of [n[2], ctr, nm, bt]) == 0:
            return 0
        return is_vec_expr of [n[3], ctr, nm, bt]
    return 0

# Neighbor-offset helpers: idx node is `ctr` (0) or `ctr +/- const`.
define idx_offset(idxnode, ctr) as:
    local n is unwrap of idxnode
    if n[0] == "ident":
        return 0
    local c is (unwrap of n[3])[1]
    if n[1] == "+":
        return c
    return 0 - c

define off_suffix(idxnode, ctr) as:
    local o is idx_offset of [idxnode, ctr]
    if o == 0:
        return ""
    if o > 0:
        return " + " + (str of o)
    return " - " + (str of (0 - o))

define collect_offsets(node, ctr, acc) as:
    local n is unwrap of node
    if n[0] == "index":
        return append of [acc, (idx_offset of [n[2], ctr])]
    if n[0] == "binop":
        return collect_offsets of [n[3], ctr, (collect_offsets of [n[2], ctr, acc])]
    return acc

define refs_ctr(node, ctr) as:
    local n is unwrap of node
    local t is n[0]
    if t == "ident":
        if n[1] == ctr:
            return 1
        return 0
    if t == "binop":
        if (refs_ctr of [n[2], ctr]) == 1:
            return 1
        return refs_ctr of [n[3], ctr]
    if t == "index":
        return refs_ctr of [n[2], ctr]
    if t == "unary":
        return refs_ctr of [n[2], ctr]
    return 0

define reads_written_offset(node, ctr, wbufs) as:
    # (round 76) does this expression READ a buffer this loop WRITES, at a
    # NONZERO offset? Loop-carried dependence: the SIMD block reads lanes
    # the serial VM has already updated (or not yet written), so the
    # vectorized interior diverges -- `b[i] is b[i-1] + 1` printed
    # 1 2 1 2... where the VM chains 1 2 3 4..., and a cross-statement
    # b[i+1] read inverted the other way, both rc 0. Zero-offset reads of
    # written buffers stay: per-statement vector emission preserves
    # same-lane ordering in both directions (RMW and cross-statement),
    # matching serial semantics. Nonzero-offset reads of written buffers
    # bail to the scalar path, which is byte-exact by construction.
    local n is unwrap of node
    local t is n[0]
    if t == "index":
        local tgt is unwrap of n[1]
        if (tgt[0] == "ident") and (wbufs[tgt[1]] == 1):
            if (idx_offset of [n[2], ctr]) != 0:
                return 1
        return 0
    if t == "binop":
        if (reads_written_offset of [n[2], ctr, wbufs]) == 1:
            return 1
        return reads_written_offset of [n[3], ctr, wbufs]
    return 0

define collect_read_bufs(node, bufs) as:
    local n is unwrap of node
    local t is n[0]
    if t == "index":
        local tgt is unwrap of n[1]
        if tgt[0] == "ident":
            bufs[tgt[1]] is 1
        return null
    if t == "binop":
        collect_read_bufs of [n[2], bufs]
        collect_read_bufs of [n[3], bufs]
        return null
    return null

define vec_loop(loopnode, nm, bt) as:
    local cond is unwrap of loopnode[1]
    if cond[0] != "binop":
        return null
    if cond[1] != "<":
        return null
    local lhs is unwrap of cond[2]
    if lhs[0] != "ident":
        return null
    local ctr is lhs[1]
    local bound is unwrap of cond[3]
    # bound may be any loop-invariant numeric expression (e.g. n - 1), but must
    # not reference the counter (that's a degenerate loop the scalar path handles).
    if (is_num_expr of [bound, nm, bt]) != 1:
        return null
    if (refs_ctr of [bound, ctr]) == 1:
        return null
    local body is loopnode[2]
    local assigns is []
    local bufs is {}
    local wbufs is {}
    local sawinc is 0
    local inccount is 0
    local incpos is 0 - 1
    for k in range of (len of body):
        local st is unwrap of body[k]
        if st[0] == "assign":
            if st[1] != ctr:
                return null
            local r is unwrap of st[2]
            if r[0] != "binop":
                return null
            if r[1] != "+":
                return null
            local ra is unwrap of r[2]
            local rb is unwrap of r[3]
            if ra[0] != "ident":
                return null
            if ra[1] != ctr:
                return null
            if rb[0] != "num":
                return null
            if rb[1] != 1:
                return null
            sawinc is 1
            inccount is inccount + 1
            incpos is k
        elif st[0] == "index_assign":
            local tgt is unwrap of st[1]
            local idx is unwrap of st[2]
            if tgt[0] != "ident":
                return null
            if bt[tgt[1]] != 1:
                return null
            if idx[0] != "ident":
                return null
            if idx[1] != ctr:
                return null
            if (is_vec_expr of [st[3], ctr, nm, bt]) != 1:
                return null
            bufs[tgt[1]] is 1
            wbufs[tgt[1]] is 1
            collect_read_bufs of [st[3], bufs]
            assigns is (append of [assigns, {"buf": tgt[1], "val": st[3]}])
        else:
            return null
    if sawinc != 1:
        return null
    # (round 81) the increment's POSITION and COUNT are part of the
    # semantics the emitters hard-code: they model increment-LAST, so a
    # write after `ctr is ctr + 1` reads the POST-increment counter in
    # the VM (executed: `i is i+1 / b[i] is i` -- VM 0 1 2 3, AOT
    # 0 1 2 0, both rc 0; straddling writes hit wrong lanes both ways),
    # and TWO increments make a step-2 loop the hoist would run as
    # step-1. Admission requires exactly one increment, in final
    # position; every other interleaving demotes to the scalar path,
    # which is byte-exact by construction. Every green vec fixture
    # already had it last -- invariants 16/19: no fixture had executed
    # the other interleaving until round 81's probe.
    if inccount != 1:
        return null
    if incpos != ((len of body) - 1):
        return null
    if (len of assigns) == 0:
        return null
    # (round 76) loop-carried dependence check -- runs AFTER the statement
    # loop so wbufs holds every write target regardless of statement order
    # (a read in stmt 1 of a buffer written in stmt 2 carries the same
    # hazard). See reads_written_offset.
    for dchk in range of (len of assigns):
        if (reads_written_offset of [(assigns[dchk])["val"], ctr, wbufs]) == 1:
            return null
    # (round 79) the BOUND gets the round-78 rule too: emit_vectorized
    # hoists it ONCE into _n, while the VM re-evaluates the condition
    # every iteration -- a bound reading a buffer this loop WRITES went
    # stale (`loop while i < b[0]` with `b[i] is 1`: VM exits after one
    # iteration, the hoisted _n ran three). Index-shape-blind, per
    # reads_buf_any; demotion is scalar and byte-exact.
    local wbk79 is keys of wbufs
    for wchk in range of (len of wbk79):
        if (reads_buf_any of [bound, wbk79[wchk]]) == 1:
            return null
    return {"ctr": ctr, "bound": bound, "assigns": assigns, "bufs": keys of bufs}

define emit_vec(node, ctr, raw) as:
    local n is unwrap of node
    local t is n[0]
    if t == "num":
        return "aot_vset(" + (str of n[1]) + ")"
    if t == "index":
        local tgt is unwrap of n[1]
        return "aot_vload(_p_" + (cn of tgt[1]) + " + _vi" + (off_suffix of [n[2], ctr]) + ")"
    if t == "ident":
        if n[1] == ctr:
            return "aot_viota(_vi)"
        return "aot_vset(" + (cn of n[1]) + ")"
    local op is n[1]
    local a is emit_vec of [n[2], ctr, raw]
    local b is emit_vec of [n[3], ctr, raw]
    if op == "/":
        return "aot_vdiv(" + a + ", " + b + ")"
    local inner is ""
    if op == "+":
        inner is "aot_vadd(" + a + ", " + b + ")"
    elif op == "-":
        inner is "aot_vsub(" + a + ", " + b + ")"
    else:
        inner is "aot_vmul(" + a + ", " + b + ")"
    if raw == 1:
        return inner
    return "aot_vguard(" + inner + ")"

define emit_vscalar(node, ctr, raw) as:
    local n is unwrap of node
    local t is n[0]
    if t == "num":
        return str of n[1]
    if t == "index":
        local tgt is unwrap of n[1]
        return "_p_" + (cn of tgt[1]) + "[_vi" + (off_suffix of [n[2], ctr]) + "]"
    if t == "ident":
        if n[1] == ctr:
            return "(double)_vi"
        return cn of n[1]
    local op is n[1]
    local a is emit_vscalar of [n[2], ctr, raw]
    local b is emit_vscalar of [n[3], ctr, raw]
    if op == "/":
        return "aot_ddiv(" + a + ", " + b + ")"
    local inner is ""
    if op == "+":
        inner is a + " + " + b
    elif op == "-":
        inner is a + " - " + b
    else:
        inner is a + " * " + b
    if raw == 1:
        return "(" + inner + ")"
    return "num_guard(" + inner + ")"

# Checked boundary value: buffer reads go through aot_buf_get (integer/negative-
# resolve/bounds, exactly like the VM) using _vi + offset; the counter is _vi.
define emit_vcheck(node, ctr) as:
    local n is unwrap of node
    local t is n[0]
    if t == "num":
        return str of n[1]
    if t == "ident":
        if n[1] == ctr:
            return "(double)_vi"
        return cn of n[1]
    if t == "index":
        local tgt is unwrap of n[1]
        return "aot_buf_get(" + (cn of tgt[1]) + ", (double)(_vi" + (off_suffix of [n[2], ctr]) + "))"
    local op is n[1]
    local a is emit_vcheck of [n[2], ctr]
    local b is emit_vcheck of [n[3], ctr]
    if op == "/":
        return "aot_ddiv(" + a + ", " + b + ")"
    if op == "+":
        return "num_guard(" + a + " + " + b + ")"
    if op == "-":
        return "num_guard(" + a + " - " + b + ")"
    return "num_guard(" + a + " * " + b + ")"

define emit_vectorized(node, vinfo, ind, nm, bt, minits) as:
    local ctr is vinfo["ctr"]
    local bufs is vinfo["bufs"]
    local assigns is vinfo["assigns"]
    local boundc is emit_num of [vinfo["bound"], nm, bt, 0]
    # offset range across all reads (write is at offset 0)
    local offs is []
    for a in range of (len of assigns):
        offs is collect_offsets of [(assigns[a])["val"], ctr, offs]
    local minoff is 0
    local maxoff is 0
    for k in range of (len of offs):
        if offs[k] < minoff:
            minoff is offs[k]
        if offs[k] > maxoff:
            maxoff is offs[k]
    local i2 is ind + "    "
    local i3 is i2 + "    "
    local i4 is i3 + "    "
    local s is ind + "{\n"
    # (round 79) ceiling + clamp, not truncation: the VM's `i < 2.5` runs
    # 3 iterations and ends the counter at 3 where (long)2.5 ran 2; a
    # NEGATIVE bound never enters the VM's loop and leaves the counter
    # untouched, where the raw hoist force-assigned it to the bound (-3).
    # (round 80) the bound is tested AS A DOUBLE before the cast:
    # (long)ceil(1e19) is UB (LLONG_MIN on x86-64) and the round-79
    # `_n < 0` clamp -- written for legitimately negative bounds --
    # LAUNDERED the overflow sentinel into an empty loop (VM dies out of
    # range; AOT printed 0, rc 0). An unrepresentable bound fails the
    # guard and takes the scalar branch, which dies byte-exactly.
    s is s + i2 + "double _bd = (" + boundc + ");\n"
    s is s + i2 + "long _n = 0; if (_bd > 0 && _bd <= 9.2e18) _n = (long)ceil(_bd);\n"
    # (round 80) the counter guard is an EXACT double compare: the old
    # `(long)ctr == 0` truncation admitted any start in (-1, 1), so
    # `i is 0.5` ran the integer-lane vector path (rc 0, wrong indices
    # AND values) where the VM dies "index must be an integer, got 0.5".
    # (round 88) per-name TYPE clauses come before anything that calls
    # aot_buf_data: the bt class is "really INDEXABLE VALUE" and a LIST
    # flowing through it is legal in the VM, but the _p_ hoists ran
    # aot_buf_data BEFORE the guard and its VAL_BUFFER hard-assert killed
    # an in-envelope program the scalar branch runs byte-exactly. The &&
    # chain short-circuits, so the type checks license every later
    # aot_buf_data; the hoists moved inside the guarded branch.
    local guard is (cn of ctr) + " == 0.0 && _bd <= 9.2e18"
    for k in range of (len of bufs):
        guard is guard + " && " + (cn of bufs[k]) + " && " + (cn of bufs[k]) + "->type == VAL_BUFFER"
    for k in range of (len of bufs):
        guard is guard + " && _n <= (long)aot_buf_len(" + (cn of bufs[k]) + ")"
    # (round 87) POINTER distinctness: buffer assignment ALIASES by
    # reference in the VM (measured), so two NAMES can be one heap
    # buffer and every by-name dependence bail is blind to it -- an
    # in-place kernel called f of [b, b] printed six wrong numbers of
    # eight, rc 0. Any written buffer aliasing any other touched name
    # demotes to the scalar branch at runtime.
    local vwr is {}
    for k in range of (len of assigns):
        vwr[((assigns[k])["buf"])] is 1
    local vwk is keys of vwr
    for k in range of (len of vwk):
        for j in range of (len of bufs):
            if (bufs[j]) != (vwk[k]):
                guard is guard + " && aot_buf_data(" + (cn of vwk[k]) + ") != aot_buf_data(" + (cn of bufs[j]) + ")"
    s is s + i2 + "if (" + guard + ") {\n"
    for k in range of (len of bufs):
        s is s + i3 + "double* _p_" + (cn of bufs[k]) + " = aot_buf_data(" + (cn of bufs[k]) + ");\n"
    # safe interior [_lo, _hi): all neighbor offsets land in [0, _n)
    s is s + i3 + "long _lo = " + (str of (0 - minoff)) + "; if (_lo > _n) _lo = _n;\n"
    s is s + i3 + "long _hi = _n - " + (str of maxoff) + "; if (_hi < _lo) _hi = _lo;\n"
    s is s + i3 + "long _vi = 0;\n"
    # head boundary: checked (matches VM wrap/error)
    s is s + i3 + "for (; _vi < _lo; _vi++) {\n"
    for a in range of (len of assigns):
        s is s + i4 + "aot_buf_set(" + (cn of (assigns[a])["buf"]) + ", (double)_vi, " + (emit_vcheck of [(assigns[a])["val"], ctr]) + ");\n"
    s is s + i3 + "}\n"
    # interior vector
    s is s + i3 + "for (; _vi + AOT_VW <= _hi; _vi += AOT_VW) {\n"
    for a in range of (len of assigns):
        local rw is map_elidable of (assigns[a])["val"]
        s is s + i4 + "aot_vstore(_p_" + (cn of (assigns[a])["buf"]) + " + _vi, " + (emit_vec of [(assigns[a])["val"], ctr, rw]) + ");\n"
    s is s + i3 + "}\n"
    # interior scalar remainder: raw (still in-bounds)
    s is s + i3 + "for (; _vi < _hi; _vi++) {\n"
    for a in range of (len of assigns):
        local rw2 is map_elidable of (assigns[a])["val"]
        s is s + i4 + "_p_" + (cn of (assigns[a])["buf"]) + "[_vi] = " + (emit_vscalar of [(assigns[a])["val"], ctr, rw2]) + ";\n"
    s is s + i3 + "}\n"
    # tail boundary: checked
    s is s + i3 + "for (; _vi < _n; _vi++) {\n"
    for a in range of (len of assigns):
        s is s + i4 + "aot_buf_set(" + (cn of (assigns[a])["buf"]) + ", (double)_vi, " + (emit_vcheck of [(assigns[a])["val"], ctr]) + ");\n"
    s is s + i3 + "}\n"
    s is s + i3 + (cn of ctr) + " = (double)_n;\n"
    s is s + i2 + "} else {\n"
    local lg is loop_gf of [node, minits]
    s is s + i3 + "while (" + (emit_cond of [node[1], nm, bt]) + ") {\n"
    s is s + (emit_stmts of [node[2], i3 + "    ", nm, bt, minits, lg])
    s is s + i3 + "}\n"
    s is s + i2 + "}\n"
    return s + ind + "}\n"

# ---- output-axis SIMD for matmul-shaped loops ----
# Vectorize the OUTPUT-column loop `o`, not the reduction: each SIMD lane is an
# independent output `out[.. + o0+k]` summed over the inner index in the SAME
# order the scalar VM uses, so it is BYTE-EXACT (no reassociation). The shape:
#   loop while O < OBOUND:        # output column
#       ACC is 0
#       D is 0
#       loop while D < IBOUND:    # reduction
#           ACC is ACC + TERM
#           D is D + 1
#       RES[SBASE + O] is ACC     # contiguous store (O coeff 1)
#       O is O + 1
# TERM's buffer reads must each be O-independent (broadcast) or `base + O`
# (coeff 1 -> contiguous vector load). The vector path touches a SUBSET of the
# scalar loop's indices (same o range, grouped), so it inherits its bounds.

# An index `base + O` / `O + base` with O appearing once at coeff 1 -> base node.
define extract_o_base(idxnode, O) as:
    local n is unwrap of idxnode
    if (n[0] == "ident") and (n[1] == O):
        return ["num", 0]
    if n[0] == "binop":
        if n[1] == "+":
            local a is unwrap of n[2]
            local b is unwrap of n[3]
            if (a[0] == "ident") and (a[1] == O) and ((name_in_expr of [n[3], O]) == 0):
                return n[3]
            if (b[0] == "ident") and (b[1] == O) and ((name_in_expr of [n[2], O]) == 0):
                return n[2]
    return null

# TERM is vectorizable over O if every read is O-independent or `base+O`.
define term_ov_ok(node, O) as:
    local n is unwrap of node
    local t is n[0]
    if t == "num":
        return 1
    if t == "ident":
        if n[1] == O:
            return 0
        return 1
    if t == "index":
        if (name_in_expr of [n[2], O]) == 1:
            if (extract_o_base of [n[2], O]) == null:
                return 0
            return 1
        return 1
    if t == "binop":
        local op is n[1]
        if (op != "+") and (op != "-") and (op != "*"):
            return 0
        if (term_ov_ok of [n[2], O]) == 0:
            return 0
        return term_ov_ok of [n[3], O]
    return 0

define reads_buf_any(node, name) as:
    # (round 78) does this expression READ buffer `name` at ANY index
    # shape? The round-77 alias bail asked the right question of the wrong
    # map: collect_ov_bufs records only O-indexed reads (its job is the
    # _pv_ pointer declarations), so a read of the written buffer at a
    # bare inner-counter index (`out[d]`) or a constant (`out[0]`) was
    # invisible -- a Gauss-Seidel-style in-place kernel printed seven
    # wrong numbers of eight, rc 0 (rowmap variant too). This walker is
    # index-shape-blind on purpose; the bails consume it directly.
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    local n is unwrap of node
    if ((type of n) == "list") and ((len of n) > 0):
        if n[0] == "index":
            local tg is unwrap of n[1]
            if (tg[0] == "ident") and (tg[1] == name):
                return 1
        for k in range of (len of n):
            if (reads_buf_any of [n[k], name]) == 1:
                return 1
    return 0

define is_plain_step1(st, name) as:
    # (round 82) exact-content check for `name is name + 1` -- the sibling
    # recognizers admitted counter statements by POSITION and TARGET only
    # while the emitters re-synthesized canonical `+ 1` stepping, so
    # `d is d + 2` (and `d is 1` inits, and `o is o + 2`) were admitted
    # and emitted as step-1: four executed silent-wrong shapes, one root
    # (the round-81 lesson on CONTENT instead of position).
    if st[0] != "assign":
        return 0
    if st[1] != name:
        return 0
    local r is unwrap of st[2]
    if r[0] != "binop":
        return 0
    if r[1] != "+":
        return 0
    local ra is unwrap of r[2]
    if ra[0] != "ident":
        return 0
    if ra[1] != name:
        return 0
    local rb is unwrap of r[3]
    if rb[0] != "num":
        return 0
    if rb[1] != 1:
        return 0
    return 1

define is_zero_init(st, name) as:
    # (round 82) exact-content check for `name is 0`; see is_plain_step1.
    if st[0] != "assign":
        return 0
    if st[1] != name:
        return 0
    local r is unwrap of st[2]
    if r[0] != "num":
        return 0
    if r[1] != 0:
        return 0
    return 1

define is_affine_in(node, name) as:
    # (round 85) is this expression AFFINE in `name` (a*name + b with a, b
    # name-free)? The endpoint evaluation in the round-84 bounds guard is
    # sound only for affine bases -- the grammar admitted any O-free
    # polynomial in D, and a concave base (d * (7 - d)) had endpoint
    # values 0/0 with interior max 12: the guard passed and the vector
    # path read heap garbage past the buffer (VM rc 1 out of range; AOT
    # printed the garbage, rc 0).
    local n is unwrap of node
    if (name_in_expr of [node, name]) == 0:
        return 1
    if n[0] == "ident":
        if n[1] == name:
            return 1
        return 1
    if n[0] == "binop":
        if (n[1] == "+") or (n[1] == "-"):
            if (is_affine_in of [n[2], name]) == 0:
                return 0
            return is_affine_in of [n[3], name]
        if n[1] == "*":
            # affine iff at most one factor mentions the name, and that
            # factor is itself affine
            local lm is name_in_expr of [n[2], name]
            local rm is name_in_expr of [n[3], name]
            if (lm == 1) and (rm == 1):
                return 0
            if lm == 1:
                return is_affine_in of [n[2], name]
            return is_affine_in of [n[3], name]
        return 0
    if n[0] == "unary":
        # (round 87) minus ONLY: emit_int compiles every unary as
        # negation, so a `not d` base was admitted as affine and emitted
        # as -d -- guard and vloads consistently wrong together, all
        # eight outputs wrong, rc 0.
        if n[1] != "-":
            return 0
        return is_affine_in of [n[2], name]
    return 0

define collect_ov_sites(node, O, acc) as:
    # (round 84) O-dependent read SITES with their base expressions, for
    # the runtime bounds guard: each vload reaches base(D) + [O, OBOUND).
    local n is unwrap of node
    if n[0] == "index":
        if (name_in_expr of [n[2], O]) == 1:
            acc is (append of [acc, {"buf": ((unwrap of n[1])[1]), "base": (extract_o_base of [n[2], O])}])
        return acc
    if n[0] == "binop":
        acc is collect_ov_sites of [n[2], O, acc]
        return collect_ov_sites of [n[3], O, acc]
    return acc

define collect_ov_bufs(node, O, acc) as:
    local n is unwrap of node
    if n[0] == "index":
        if (name_in_expr of [n[2], O]) == 1:
            acc[(unwrap of n[1])[1]] is 1
        return null
    if n[0] == "binop":
        collect_ov_bufs of [n[2], O, acc]
        collect_ov_bufs of [n[3], O, acc]
        return null
    return null

# Emit TERM as a packed vector over O (lanes = consecutive output columns).
# guard=0 drops the packed num_guard — sound only when the caller proved the
# reduction can't overflow (emit_matmul's runtime precheck).
define emit_term_ov(node, O, nm, bt, guard) as:
    local n is unwrap of node
    local t is n[0]
    if t == "num":
        return "aot_vset(" + (str of n[1]) + ")"
    if t == "ident":
        return "aot_vset((double)" + (cn of n[1]) + ")"
    if t == "index":
        local tg is unwrap of n[1]
        if (name_in_expr of [n[2], O]) == 1:
            local base is extract_o_base of [n[2], O]
            return "aot_vload(_pv_" + (cn of tg[1]) + " + " + (emit_int of base) + " + " + (cn of O) + ")"
        if (is_int_expr of n[2]) == 1:
            return "aot_vset(aot_buf_get_i(" + (cn of tg[1]) + ", " + (emit_int of n[2]) + "))"
        return "aot_vset(aot_buf_get(" + (cn of tg[1]) + ", " + (emit_num of [n[2], nm, bt, 0]) + "))"
    local op is n[1]
    local a is emit_term_ov of [n[2], O, nm, bt, guard]
    local b is emit_term_ov of [n[3], O, nm, bt, guard]
    local inner is ""
    if op == "*":
        inner is "aot_vmul(" + a + ", " + b + ")"
    elif op == "+":
        inner is "aot_vadd(" + a + ", " + b + ")"
    else:
        inner is "aot_vsub(" + a + ", " + b + ")"
    if guard == 1:
        return "aot_vguard(" + inner + ")"
    return inner

define outvec_loop(node, nm, bt) as:
    local cond is unwrap of node[1]
    if cond[0] != "binop":
        return null
    if cond[1] != "<":
        return null
    local lhs is unwrap of cond[2]
    if lhs[0] != "ident":
        return null
    local O is lhs[1]
    local OBOUND is cond[3]
    local raw is node[2]
    local stmts is []
    for k in range of (len of raw):
        stmts is (append of [stmts, unwrap of raw[k]])
    if (len of stmts) != 5:
        return null
    # stmt0: ACC is 0
    local s0 is stmts[0]
    if s0[0] != "assign":
        return null
    local ACC is s0[1]
    local s0r is unwrap of s0[2]
    if s0r[0] != "num":
        return null
    if s0r[1] != 0:
        return null
    # stmt2: inner reduction loop -> D, IBOUND, TERM
    local s2 is stmts[2]
    if s2[0] != "loop":
        return null
    local icond is unwrap of s2[1]
    if icond[0] != "binop":
        return null
    if icond[1] != "<":
        return null
    local ilhs is unwrap of icond[2]
    if ilhs[0] != "ident":
        return null
    local D is ilhs[1]
    local IBOUND is icond[3]
    local ibody is []
    for k in range of (len of s2[2]):
        ibody is (append of [ibody, unwrap of (s2[2])[k]])
    if (len of ibody) != 2:
        return null
    local a0 is ibody[0]
    if a0[0] != "assign":
        return null
    if a0[1] != ACC:
        return null
    local a0r is unwrap of a0[2]
    if a0r[0] != "binop":
        return null
    if a0r[1] != "+":
        return null
    local a0l is unwrap of a0r[2]
    if a0l[0] != "ident":
        return null
    if a0l[1] != ACC:
        return null
    local TERM is a0r[3]
    # (round 82) ibody[1] was NEVER examined -- `d is d + 2` was admitted
    # and emitted as step-1. Exact content required.
    if (is_plain_step1 of [ibody[1], D]) == 0:
        return null
    # stmt1: D is 0 (inner counter init) -- RHS content enforced (round 82:
    # `d is 1` was admitted and emitted as `= 0`).
    local s1 is stmts[1]
    if (is_zero_init of [s1, D]) == 0:
        return null
    # stmt3: RES[SIDX] is ACC
    local s3 is stmts[3]
    if s3[0] != "index_assign":
        return null
    local rtg is unwrap of s3[1]
    if rtg[0] != "ident":
        return null
    local RES is rtg[1]
    if bt[RES] != 1:
        return null
    local SIDX is s3[2]
    local sval is unwrap of s3[3]
    if sval[0] != "ident":
        return null
    if sval[1] != ACC:
        return null
    # stmt4: O is O + 1 -- RHS content enforced (round 82: `o is o + 2`
    # was admitted and emitted as step-1).
    local s4 is stmts[4]
    if (is_plain_step1 of [s4, O]) == 0:
        return null
    local SBASE is extract_o_base of [SIDX, O]
    if SBASE == null:
        return null
    if (name_in_expr of [TERM, O]) == 0:
        return null
    if (term_ov_ok of [TERM, O]) == 0:
        return null
    local ovb is {}
    collect_ov_bufs of [TERM, O, ovb]
    # (round 77/78) ALIAS/DEPENDENCE bail, the round-76 rule for this
    # recognizer: if anything reads the buffer being written, lanes read
    # stale/updated values the serial VM would not. Round 78 rebuilt the
    # check on reads_buf_any -- the round-77 version consumed
    # collect_ov_bufs, which records only O-indexed reads, so `out[d]`
    # and `out[0]` reads were invisible (executed: seven wrong numbers of
    # eight, rc 0). The BOUND and store-index expressions are checked too:
    # the vector path re-evaluates them per BLOCK, not per iteration, so a
    # bound reading the written buffer diverges the same way. Also covers
    # matmul_loop (it wraps this recognizer) and its aot_buf_maxabs
    # precheck's input reads.
    if (reads_buf_any of [TERM, RES]) == 1:
        return null
    if (reads_buf_any of [OBOUND, RES]) == 1:
        return null
    if (reads_buf_any of [IBOUND, RES]) == 1:
        return null
    if (reads_buf_any of [SIDX, RES]) == 1:
        return null
    # (round 85) WRITTEN-NAME discipline on every hoisted expression --
    # three executed members of one family: O in IBOUND gave every lane
    # the BLOCK-BASE column's reduction length (triangular reduction,
    # every odd column wrong, rc 0); D/ACC in SBASE made the round-84
    # store-reach guard evaluate a STALE base and the vstore smash the
    # heap; a non-affine read base defeated the endpoint bound. The
    # loop's own written names (O, D, ACC) may not appear in the bounds
    # or the store base, and read-site bases must be structurally AFFINE
    # in D for the endpoint evaluation to bound them. Violations demote
    # to the scalar path via the recognizer.
    if (name_in_expr of [IBOUND, O]) == 1:
        return null
    if (name_in_expr of [IBOUND, ACC]) == 1:
        return null
    # (round 86) the SELF-counter checks the round-85 comment claimed and
    # the code omitted: O in OBOUND admits a whole block when the block-
    # BASE column satisfies a shrinking bound (VM stops at o=3, the AOT
    # wrote out[3], rc 0); D in IBOUND defeats the round-84 guard's
    # entry-hoisted _ibd (stale D=5 gave _ibn=3, the real loop reached
    # d=3 past the buffer -- heap-garbage read, rc 0).
    if (name_in_expr of [IBOUND, D]) == 1:
        return null
    if (name_in_expr of [OBOUND, O]) == 1:
        return null
    if (name_in_expr of [OBOUND, D]) == 1:
        return null
    if (name_in_expr of [OBOUND, ACC]) == 1:
        return null
    if (name_in_expr of [SBASE, D]) == 1:
        return null
    if (name_in_expr of [SBASE, ACC]) == 1:
        return null
    local r85sites is collect_ov_sites of [TERM, O, []]
    for r85k in range of (len of r85sites):
        local r85b is (r85sites[r85k])["base"]
        if (name_in_expr of [r85b, ACC]) == 1:
            return null
        if (is_affine_in of [r85b, D]) == 0:
            return null
    return {"O": O, "OBOUND": OBOUND, "ACC": ACC, "D": D, "IBOUND": IBOUND, "RES": RES, "SIDX": SIDX, "SBASE": SBASE, "TERM": TERM, "ovbufs": (keys of ovb), "node": node}

# (round 117) see the recognizers' heads: every NAME in a recognized shape is
# bound by construction on each path the lowering emits. Recurses one level
# for matmul's nested "ov" descriptor.
define drop_recog_bits(desc) as:
    local _rbk is keys of desc
    for _rbi in range of (len of _rbk):
        local _rbv is desc[(_rbk[_rbi])]
        if (type of _rbv) == "str":
            g_bound_bit[_rbv] is null
        elif (type of _rbv) == "dict":
            drop_recog_bits of _rbv
    return 0

define emit_outvec(d, ind, nm, bt, guard, minits) as:
    # (round 117) every NAME in the recognized shape -- counters, the
    # accumulator, the buffers -- is bound by construction on each path this
    # lowering emits (it re-inits the inner counter itself for the vector
    # and scalar-tail passes, outside the assign arm that sets a boundness
    # bit), so their bits are dropped here: reads inside stay raw, and the
    # gate's t141/t145/t154/t155 died "undefined variable 'd'" before this.
    drop_recog_bits of d
    local O is d["O"]
    local OB is emit_num of [d["OBOUND"], nm, bt, 0]
    local IB is emit_num of [d["IBOUND"], nm, bt, 0]
    local D is d["D"]
    local ACC is d["ACC"]
    local RES is d["RES"]
    local SBASE is emit_int of d["SBASE"]
    local TERM is d["TERM"]
    local ovbufs is d["ovbufs"]
    # (round 77) every source-name emission goes through cn: this emitter
    # family was missed when cn went prefix-everything (99de31a), and its
    # raw names either failed gcc unnamed or -- for source names spelled
    # eig_X -- aliased into a SIBLING variable's mangled storage and
    # compiled cleanly against the wrong memory (the loop ran as a no-op,
    # rc 0). cn(O)/cn(D)/cn(ACC)/cn(RES) are the C locals; _pv_ pointers
    # key on cn too so emit_term_ov's vloads match the declarations.
    local cO is cn of O
    local cD is cn of D
    local cACC is cn of ACC
    local cRES is cn of RES
    local i2 is ind + "    "
    local i3 is i2 + "    "
    local i4 is i3 + "    "
    local s is ind + "{\n"
    # (round 84) RUNTIME BOUNDS GUARD. The old design comment claimed the
    # vector path "inherits the scalar loop's bounds" -- true only when
    # the scalar loop COMPLETES. When the VM would die "buffer index out
    # of range" mid-loop, the raw _pv_ loads/stores read heap garbage
    # (silent-wrong, rc 0) or smashed the heap (SIGABRT, executed both
    # ways). Entry checks: the store reach (SBASE + [O, ceil(OBOUND)))
    # within RES; each O-dependent read site's reach, with its base
    # evaluated at the inner counter's ENDPOINTS (bases are affine in D
    # in this grammar, so the endpoints bound the range); O nonnegative;
    # bounds representable (the round-80 rule). Any failure demotes to
    # the faithful scalar while below, which dies byte-exactly.
    s is s + i2 + "int _ovok = 1;\n"
    s is s + i2 + "double _obd = (" + OB + "); double _ibd = (" + IB + ");\n"
    s is s + i2 + "long _obn = 0; if (_obd > 0 && _obd <= 9.2e18) _obn = (long)ceil(_obd); else if (_obd > 9.2e18) _ovok = 0;\n"
    s is s + i2 + "long _ibn = 0; if (_ibd > 0 && _ibd <= 9.2e18) _ibn = (long)ceil(_ibd); else if (_ibd > 9.2e18) _ovok = 0;\n"
    s is s + i2 + "if (" + cO + " < 0) _ovok = 0;\n"
    s is s + i2 + "{ long _sb = (" + SBASE + "); if (_sb < 0 || _sb + _obn > (long)aot_buf_len(" + cRES + ")) _ovok = 0; }\n"
    # (round 87) pointer distinctness -- see the vec guard note: aliasing
    # is a runtime fact the by-name bails cannot see (a helper reading a
    # param while writing the module global it aliases diverged rc 0).
    # (round 88) TYPE checks first: a LIST through a bt name is legal in
    # the VM and aot_buf_data hard-asserts VAL_BUFFER, so the compares
    # are gated on _ovok after per-name type clauses.
    s is s + i2 + "if (!(" + cRES + ") || (" + cRES + ")->type != VAL_BUFFER) _ovok = 0;\n"
    for pk in range of (len of ovbufs):
        s is s + i2 + "if (!(" + (cn of ovbufs[pk]) + ") || (" + (cn of ovbufs[pk]) + ")->type != VAL_BUFFER) _ovok = 0;\n"
    for pk in range of (len of ovbufs):
        if (ovbufs[pk]) != RES:
            s is s + i2 + "if (_ovok && aot_buf_data(" + cRES + ") == aot_buf_data(" + (cn of ovbufs[pk]) + ")) _ovok = 0;\n"
    local ovsites is collect_ov_sites of [TERM, O, []]
    for sk in range of (len of ovsites):
        local sbuf is cn of ((ovsites[sk])["buf"])
        local sbase is emit_int of ((ovsites[sk])["base"])
        s is s + i2 + "if (_ovok && _ibn > 0) { long _dsv = " + cD + "; " + cD + " = 0; long _b0 = (" + sbase + "); " + cD + " = _ibn - 1; long _b1 = (" + sbase + "); " + cD + " = _dsv; long _blo = _b0 < _b1 ? _b0 : _b1; long _bhi = (_b0 > _b1 ? _b0 : _b1) + _obn; if (_blo < 0 || _bhi > (long)aot_buf_len(" + sbuf + ")) _ovok = 0; }\n"
    s is s + i2 + "if (_ovok) {\n"
    s is s + i2 + "double* _pv_" + cRES + " = aot_buf_data(" + cRES + ");\n"
    for k in range of (len of ovbufs):
        s is s + i2 + "double* _pv_" + (cn of ovbufs[k]) + " = aot_buf_data(" + (cn of ovbufs[k]) + ");\n"
    # vector loop over O (each lane = one output column), byte-exact d-order sum.
    # guard=0 -> raw accumulate (caller proved no overflow); guard=1 -> packed guard.
    local accline is "_acc = aot_vadd(_acc, " + (emit_term_ov of [TERM, O, nm, bt, guard]) + ");\n"
    if guard == 1:
        accline is "_acc = aot_vguard(aot_vadd(_acc, " + (emit_term_ov of [TERM, O, nm, bt, 1]) + "));\n"
    s is s + i2 + "long _oent = " + cO + ";\n"
    s is s + i2 + "for (; " + cO + " + AOT_VW <= " + OB + "; " + cO + " += AOT_VW) {\n"
    s is s + i3 + "aot_vec _acc = aot_vset(0.0);\n"
    s is s + i3 + cD + " = 0;\n"
    s is s + i3 + "while (" + cD + " < " + IB + ") {\n"
    s is s + i4 + accline
    s is s + i4 + cD + " = " + cD + " + 1;\n"
    s is s + i3 + "}\n"
    s is s + i3 + "aot_vstore(_pv_" + cRES + " + " + SBASE + " + " + cO + ", _acc);\n"
    s is s + i2 + "}\n"
    # (round 83) materialize the carried scalar: the vector block
    # accumulates in the C-local aot_vec and never wrote cACC, so an ACC
    # read AFTER the loop was stale exactly when OBOUND % AOT_VW == 0 --
    # the scalar tail, the only cACC writer, never ran (VM 76.75, AOT 0,
    # both rc 0; appears and disappears with buffer size and SIMD width).
    # The last stored column IS ACC's final value (the stores are the
    # per-column sums, guarded and elided arms alike), so read it back.
    # (round 84) predicate corrected: `cO > 0` was a proxy for "the loop
    # advanced" and fired on ZERO-iteration entries with O pre-set,
    # clobbering ACC with a cell the loop never wrote (VM 99, AOT 0, both
    # rc 0) -- and with entry O past the buffer it was itself an OOB
    # read. Entry-value compare: only a loop that ADVANCED materializes.
    s is s + i2 + "if (" + cO + " > _oent) " + cACC + " = _pv_" + cRES + "[" + SBASE + " + " + cO + " - 1];\n"
    # scalar tail for the remaining columns (reuses the checked emit path)
    s is s + i2 + "while (" + cO + " < " + OB + ") {\n"
    s is s + i3 + cACC + " = 0;\n"
    s is s + i3 + cD + " = 0;\n"
    s is s + i3 + "while (" + cD + " < " + IB + ") {\n"
    s is s + i4 + cACC + " = num_guard(" + cACC + " + " + (emit_num of [TERM, nm, bt, 0]) + ");\n"
    s is s + i4 + cD + " = " + cD + " + 1;\n"
    s is s + i3 + "}\n"
    s is s + i3 + "aot_buf_set_i(" + cRES + ", " + (emit_int of d["SIDX"]) + ", " + cACC + ");\n"
    s is s + i3 + cO + " = " + cO + " + 1;\n"
    s is s + i2 + "}\n"
    s is s + i2 + "} else {\n"
    # faithful scalar fallback (the emit_vectorized pattern): the original
    # loop through the plain path, checked accesses, dies exactly as the
    # VM does.
    local ovnode is d["node"]
    local ovlg is loop_gf of [ovnode, minits]
    s is s + i3 + "while (" + (emit_cond of [ovnode[1], nm, bt]) + ") {\n"
    s is s + (emit_stmts of [ovnode[2], i3 + "    ", nm, bt, minits, ovlg])
    s is s + i3 + "}\n"
    s is s + i2 + "}\n"
    return s + ind + "}\n"

# ---- matmul: output-axis SIMD + accumulator num_guard elision ----
# Recognize the i-loop wrapping an outvec o-loop whose term is a two-read product
# A[.]*B[.] (matmul / context / projection — the dominant transformer kernel).
# Then a once-per-matmul precheck (Din*max|A|*max|B| <= 1e308) decides whether to
# run the UNGUARDED accumulation (byte-identical when no overflow) or the guarded
# one — eliding the per-op num_guard from the hot reduction when it's provably
# identity. Shape:  loop while I < OUTER: O is 0; <outvec o-loop>; I is I+1
define matmul_loop(node, nm, bt) as:
    local cond is unwrap of node[1]
    if cond[0] != "binop":
        return null
    if cond[1] != "<":
        return null
    local clhs is unwrap of cond[2]
    if clhs[0] != "ident":
        return null
    local I is clhs[1]
    local raw is node[2]
    local stmts is []
    for k in range of (len of raw):
        stmts is (append of [stmts, unwrap of raw[k]])
    if (len of stmts) != 3:
        return null
    # stmt0: O is 0
    local s0 is stmts[0]
    if s0[0] != "assign":
        return null
    local s0r is unwrap of s0[2]
    if s0r[0] != "num":
        return null
    if s0r[1] != 0:
        return null
    local O is s0[1]
    # stmt1: the outvec o-loop
    local s1 is stmts[1]
    if s1[0] != "loop":
        return null
    local ov is outvec_loop of [s1, nm, bt]
    if ov == null:
        return null
    if (ov["O"]) != O:
        return null
    # stmt2: I is I + 1
    local s2 is stmts[2]
    if s2[0] != "assign":
        return null
    if s2[1] != I:
        return null
    # term must be a two-read product A[.]*B[.] so the overflow bound is
    # Din*max|A|*max|B| (covers every product and partial sum).
    local term is unwrap of (ov["TERM"])
    if term[0] != "binop":
        return null
    if term[1] != "*":
        return null
    local ta is unwrap of term[2]
    local tb is unwrap of term[3]
    if ta[0] != "index":
        return null
    if tb[0] != "index":
        return null
    return {"icond": node[1], "oinit": raw[0], "iincr": raw[2], "ov": ov, "bufA": (unwrap of ta[1])[1], "bufB": (unwrap of tb[1])[1]}

define emit_matmul(d, ind, nm, bt, minits) as:
    # (round 117) every NAME in the recognized shape -- counters, the
    # accumulator, the buffers -- is bound by construction on each path this
    # lowering emits (it re-inits the inner counter itself for the vector
    # and scalar-tail passes, outside the assign arm that sets a boundness
    # bit), so their bits are dropped here: reads inside stay raw, and the
    # gate's t141/t145/t154/t155 died "undefined variable 'd'" before this.
    drop_recog_bits of d
    local ov is d["ov"]
    local IB is emit_num of [(ov["IBOUND"]), nm, bt, 0]
    local i2 is ind + "    "
    local i3 is i2 + "    "
    local s is ind + "{\n"
    # (round 77) cn-migrated with the rest of the family -- the fourth
    # un-migrated emitter, found by the module-level matmul probe built to
    # put the elision path under the oracle (gcc: 'w' undeclared).
    s is s + i2 + "double _mxA = aot_buf_maxabs(" + (cn of d["bufA"]) + ");\n"
    s is s + i2 + "double _mxB = aot_buf_maxabs(" + (cn of d["bufB"]) + ");\n"
    # Din*max|A|*max|B| <= 1e308  =>  no product/partial-sum exceeds 1e308  =>
    # num_guard is identity  =>  the unguarded reduction is byte-exact vs the VM.
    s is s + i2 + "int _noof = ((double)(" + IB + ") * _mxA * _mxB <= 1e308);\n"
    s is s + i2 + "while (" + (emit_cond of [d["icond"], nm, bt]) + ") {\n"
    s is s + (emit_stmt of [d["oinit"], i3, nm, bt, minits, {}])
    s is s + i3 + "if (_noof) {\n"
    s is s + (emit_outvec of [ov, i3 + "    ", nm, bt, 0, minits])
    s is s + i3 + "} else {\n"
    s is s + (emit_outvec of [ov, i3 + "    ", nm, bt, 1, minits])
    s is s + i3 + "}\n"
    s is s + (emit_stmt of [d["iincr"], i3, nm, bt, minits, {}])
    s is s + i2 + "}\n"
    return s + ind + "}\n"

# ---- row-wise element-wise map: RES[BASE+D] = vec_expr(D) ----
# Like the whole-buffer vec map, but the write index carries a loop-invariant
# base (`out[i*D + d]`) and reads may be at the bare counter (`gamma[d]`) or
# `base2 + d` (`x[i*D + d]`). Element-wise -> BYTE-EXACT (reuses emit_term_ov's
# broadcast/contiguous-load packing; the vstore touches a subset of the scalar
# loop's indices, so it inherits its bounds). Vectorizes layernorm's normalize.
define rowmap_loop(node, nm, bt) as:
    local cond is unwrap of node[1]
    if cond[0] != "binop":
        return null
    if cond[1] != "<":
        return null
    local lhs is unwrap of cond[2]
    if lhs[0] != "ident":
        return null
    local D is lhs[1]
    local BOUND is cond[3]
    local raw is node[2]
    local stmts is []
    for k in range of (len of raw):
        stmts is (append of [stmts, unwrap of raw[k]])
    if (len of stmts) != 2:
        return null
    # stmt0: RES[SIDX] is VEXPR
    local s0 is stmts[0]
    if s0[0] != "index_assign":
        return null
    local rtg is unwrap of s0[1]
    if rtg[0] != "ident":
        return null
    local RES is rtg[1]
    if bt[RES] != 1:
        return null
    local SIDX is s0[2]
    local VEXPR is s0[3]
    # stmt1: D is D + 1 -- RHS content enforced (round 82: `d2 is d2 + 2`
    # was admitted and emitted as step-1, filling elements the VM skips).
    local s1 is stmts[1]
    if (is_plain_step1 of [s1, D]) == 0:
        return null
    local SBASE is extract_o_base of [SIDX, D]
    if SBASE == null:
        return null
    if (name_in_expr of [VEXPR, D]) == 0:
        return null
    if (term_ov_ok of [VEXPR, D]) == 0:
        return null
    local vb is {}
    collect_ov_bufs of [VEXPR, D, vb]
    # (round 77/78) ALIAS/DEPENDENCE bail (the round-76 rule): any read of
    # the written buffer bails to the scalar path. Round 78 rebuilt it on
    # reads_buf_any -- the collect_ov_bufs-based check missed non-D-indexed
    # reads (`out[0]` served stale, rc 0, executed) -- and covers the
    # bound/store-index expressions, which the vector path re-evaluates
    # per block.
    if (reads_buf_any of [VEXPR, RES]) == 1:
        return null
    if (reads_buf_any of [BOUND, RES]) == 1:
        return null
    if (reads_buf_any of [SIDX, RES]) == 1:
        return null
    local vbufs is []
    local vbk is keys of vb
    for k in range of (len of vbk):
        if vbk[k] != RES:
            vbufs is (append of [vbufs, vbk[k]])
    # (round 85) written-name discipline, the outvec rule: the loop's
    # counter may not appear in the hoisted bound or store base.
    if (name_in_expr of [BOUND, D]) == 1:
        return null
    if (name_in_expr of [SBASE, D]) == 1:
        return null
    return {"D": D, "BOUND": BOUND, "RES": RES, "SBASE": SBASE, "SIDX": SIDX, "VEXPR": VEXPR, "vbufs": vbufs, "node": node}

define emit_rowmap(d, ind, nm, bt, minits) as:
    # (round 117) every NAME in the recognized shape -- counters, the
    # accumulator, the buffers -- is bound by construction on each path this
    # lowering emits (it re-inits the inner counter itself for the vector
    # and scalar-tail passes, outside the assign arm that sets a boundness
    # bit), so their bits are dropped here: reads inside stay raw, and the
    # gate's t141/t145/t154/t155 died "undefined variable 'd'" before this.
    drop_recog_bits of d
    local D is d["D"]
    local OB is emit_num of [d["BOUND"], nm, bt, 0]
    local RES is d["RES"]
    local SBASE is emit_int of d["SBASE"]
    local i2 is ind + "    "
    local i3 is i2 + "    "
    # (round 77) cn-migrated with emit_outvec; see the note there.
    local cD is cn of D
    local cRES is cn of RES
    local s is ind + "{\n"
    # (round 84) runtime bounds guard, the emit_outvec rule: raw _pv_
    # stores past the buffer smashed the heap where the VM dies cleanly.
    # Rowmap bases are loop-invariant (no inner counter), so reaches are
    # directly evaluable. Any failure demotes to the faithful scalar
    # while, which dies byte-exactly.
    s is s + i2 + "int _rmok = 1;\n"
    s is s + i2 + "double _rbd = (" + OB + ");\n"
    s is s + i2 + "long _rbn = 0; if (_rbd > 0 && _rbd <= 9.2e18) _rbn = (long)ceil(_rbd); else if (_rbd > 9.2e18) _rmok = 0;\n"
    s is s + i2 + "if (" + cD + " < 0) _rmok = 0;\n"
    s is s + i2 + "{ long _sb = (" + SBASE + "); if (_sb < 0 || _sb + _rbn > (long)aot_buf_len(" + cRES + ")) _rmok = 0; }\n"
    # (round 87) pointer distinctness -- see the vec guard note.
    # (round 88) type checks first; see the outvec note.
    local rmvb is d["vbufs"]
    s is s + i2 + "if (!(" + cRES + ") || (" + cRES + ")->type != VAL_BUFFER) _rmok = 0;\n"
    for pk in range of (len of rmvb):
        s is s + i2 + "if (!(" + (cn of rmvb[pk]) + ") || (" + (cn of rmvb[pk]) + ")->type != VAL_BUFFER) _rmok = 0;\n"
    for pk in range of (len of rmvb):
        if (rmvb[pk]) != RES:
            s is s + i2 + "if (_rmok && aot_buf_data(" + cRES + ") == aot_buf_data(" + (cn of rmvb[pk]) + ")) _rmok = 0;\n"
    local rmsites is collect_ov_sites of [d["VEXPR"], D, []]
    for sk in range of (len of rmsites):
        local sbuf is cn of ((rmsites[sk])["buf"])
        local sbase is emit_int of ((rmsites[sk])["base"])
        s is s + i2 + "{ long _b = (" + sbase + "); if (_b < 0 || _b + _rbn > (long)aot_buf_len(" + sbuf + ")) _rmok = 0; }\n"
    s is s + i2 + "if (_rmok) {\n"
    s is s + i2 + "double* _pv_" + cRES + " = aot_buf_data(" + cRES + ");\n"
    local vbufs is d["vbufs"]
    for k in range of (len of vbufs):
        s is s + i2 + "double* _pv_" + (cn of vbufs[k]) + " = aot_buf_data(" + (cn of vbufs[k]) + ");\n"
    s is s + i2 + "for (; " + cD + " + AOT_VW <= " + OB + "; " + cD + " += AOT_VW) {\n"
    s is s + i3 + "aot_vstore(_pv_" + cRES + " + " + SBASE + " + " + cD + ", " + (emit_term_ov of [d["VEXPR"], D, nm, bt, 1]) + ");\n"
    s is s + i2 + "}\n"
    s is s + i2 + "while (" + cD + " < " + OB + ") {\n"
    s is s + i3 + "aot_buf_set_i(" + cRES + ", " + (emit_int of d["SIDX"]) + ", " + (emit_num of [d["VEXPR"], nm, bt, 0]) + ");\n"
    s is s + i3 + cD + " = " + cD + " + 1;\n"
    s is s + i2 + "}\n"
    s is s + i2 + "} else {\n"
    local rmnode is d["node"]
    local rmlg is loop_gf of [rmnode, minits]
    s is s + i3 + "while (" + (emit_cond of [rmnode[1], nm, bt]) + ") {\n"
    s is s + (emit_stmts of [rmnode[2], i3 + "    ", nm, bt, minits, rmlg])
    s is s + i3 + "}\n"
    s is s + i2 + "}\n"
    return s + ind + "}\n"

# ---- user functions (slice 2 + buffer params) ----
# A param is a BUFFER (C Value*) if used as one in the body (indexed or len-of);
# otherwise a numeric double. Return is `double` if the body has a return, else
# `void` (a buffer-mutating kernel). g_funcs[name] = {"ptypes":[...], "ret":...}.
define find_buffer_use(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    local t is node[0]
    if t == "index":
        local tg is unwrap of node[1]
        if (tg[0] == "ident") and (tg[1] == name):
            return 1
    if t == "index_assign":
        local tg is unwrap of node[1]
        if (tg[0] == "ident") and (tg[1] == name):
            return 1
    if t == "slice":
        local tg is unwrap of node[1]
        if (tg[0] == "ident") and (tg[1] == name):
            return 1
    if t == "call":
        local callee is unwrap of node[1]
        if (callee[0] == "ident") and (callee[1] == "len"):
            local a is unwrap of node[2]
            if (a[0] == "ident") and (a[1] == name):
                return 1
    for k in range of (len of node):
        if (find_buffer_use of [node[k], name]) == 1:
            return 1
    return 0

define find_return(node) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "return":
        return 1
    for k in range of (len of node):
        if (find_return of node[k]) == 1:
            return 1
    return 0

define find_return_node(node) as:
    if (type of node) != "list":
        return null
    if (len of node) == 0:
        return null
    if node[0] == "return":
        return node[1]
    for k in range of (len of node):
        local r is find_return_node of node[k]
        if r != null:
            return r
    return null

# ret type: void (no return) | Value* (returns a buffer) | double (numeric).
# A value node that is never numeric (lives boxed in the env, not a C double):
# a list / string / dict / null literal.
# `fgen` is threaded in (round 102) because the ONE question this function
# answers about a call -- what class is the callee -- has a genp answer, and
# g_genp is invalid during inference so the table must arrive explicitly, the
# same reason return_node_is_boxed already receives it.
define is_boxed_node(node, fgen) as:
    local n is unwrap of node
    local t is n[0]
    if (t == "list") or (t == "str") or (t == "dict") or (t == "null"):
        return 1
    if (t == "binop") and (n[1] == "+"):
        # a `+` chain carrying a string LITERAL is concatenation (f-strings
        # desugar to these): `return "a" + (str of n)` was invisible here, so
        # func_ret_type declared double and the return coerced the string —
        # the same #100 item-3 silent 0 as the bare-builtin shape.
        if (chain_has_str of n) == 1:
            return 1
    if t == "call":
        # returning ANOTHER function's result: boxed iff that function is
        # (#86 — `return takes_str of v` must not be declared double, which
        # coerced the string through aot_num and returned 0). The g_funcs
        # ret fixpoint in emit_program re-derives this until stable.
        local c is unwrap of n[1]
        if (c[0] == "ident") and (g_funcs[c[1]] != null):
            if ((g_funcs[c[1]])["ret"]) == "Value*":
                return 1
        # a BUILTIN with a known non-numeric return (#100 item 3): `return
        # trim of v` was invisible here, so func_ret_type declared double and
        # the return coerced the string through aot_num — a silent 0 where
        # the VM returns the string. (An un-shadowed builtin only: a user fn
        # of the same name resolved above.)
        # (round 104) a BUILTIN whose return class we do not positively know
        # to be numeric is boxed. Was: only the 24 names on the boxed list.
        if (c[0] == "ident") and (g_funcs[c[1]] == null) and (NUM_RET_BUILTINS[c[1]] != 1):
            return 1
        # (round 102) a GENERIC PARAM callee: the result is whatever the
        # caller's function returns, unknowable here, so boxed. Round 101
        # taught this exact case to return_node_is_boxed's own call arm 25
        # lines below; the LOCAL arm routes through here instead, so
        # `r is fn of size / return r` -- one hop -- kept asking the old
        # question and declared the function double.
        if (c[0] == "ident") and (fgen != null):
            if fgen[c[1]] == 1:
                return 1
    return 0

# Collect EVERY return expression in a body (not just the first), recursing the
# same way find_return_node does. A return's expression has no nested returns,
# so we append it and don't descend into it.
define collect_return_nodes(node, out) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "return":
        append of [out, node[1]]
        return 0
    for k in range of (len of node):
        collect_return_nodes of [node[k], out]
    return 0

# Is a single return expression a boxed (non-numeric) Value? Mirrors the
# classification the return-statement emitter uses, so the declared type and the
# emission agree.
# (round 102) Is a LOCAL's value boxed, following local-to-local aliases?
#
# The rrhss scan used to look one level deep, so `a is fn of v / b is a /
# return b` -- two hops -- saw only the ident `a`, which is not itself a
# boxed NODE, and declared the function double. Round 102's own fixture
# caught this within minutes of the one-hop fix precisely because it swept
# the discriminator (invariant 22) instead of restating the syntax.
#
# `seen` makes the walk terminate on a self- or mutually-referential
# binding (`x is x`, or a pair that assigns from each other), which a
# plain recursion would follow forever.
define local_rhs_boxed(name, rba, fgen, fbt, fdict, ftt, seen) as:
    if seen[name] == 1:
        return 0
    seen[name] is 1
    local rhss is rba[name]
    if rhss == null:
        return 0
    for j in range of (len of rhss):
        if (is_boxed_node of [rhss[j], fgen]) == 1:
            return 1
        local rj is unwrap of rhss[j]
        if rj[0] == "ident":
            # an alias of a param carries that param's class...
            if (fbt[rj[1]] == 1) or (fdict[rj[1]] == 1) or (fgen[rj[1]] == 1) or (ftt[rj[1]] == 1):
                return 1
            # ...and an alias of another local carries whatever IT holds.
            if (local_rhs_boxed of [rj[1], rba, fgen, fbt, fdict, ftt, seen]) == 1:
                return 1
    return 0

define return_node_is_boxed(rnode, fbt, ftt, rba, fgen, fdict) as:
    local re is unwrap of rnode
    # `return (f of x)` where f has NO return statement. The VM's rule is that
    # such a function yields null, so this return is boxed. Without this the
    # two inferences disagree: func_ret_type asks return_node_is_boxed (which
    # said "not boxed" -> declare double) while the return EMITTER asks
    # is_num_expr (which correctly says "not numeric" -> emit a Value*), and
    # the mismatch met at the checked unbox:
    #
    #   define shout(m) as: print of m
    #   define wrap(m) as: return (shout of m)
    #   VM   prints, then null, rc 0
    #   AOT  "non-numeric value in a numeric context at wrap: return", rc 1
    #
    # This is the hazard CLAUDE.md names — when the declared type and the
    # emission cannot share one inference, they must agree at the boundary.
    # Here they can share it: both now call a void user fn non-numeric.
    if re[0] == "call":
        local rc1 is unwrap of re[1]
        if rc1[0] == "ident":
            if g_funcs[rc1[1]] != null:
                if (g_funcs[rc1[1]])["ret"] == "void":
                    return 1
            # (round 93) a direct BUILTIN call that yields a container is a
            # boxed return. `return zeros of n` used to ride the buffer
            # class; once `zeros` stopped being a buffer create (it never
            # made one) the return inferred numeric and the coercion killed
            # a program the VM runs. Same family as #167 (a direct
            # tensor-call return typed double), reached from the other
            # side.
            if (g_funcs[rc1[1]] == null) and (NUM_RET_BUILTINS[rc1[1]] != 1):
                return 1
            # (round 101) a GENERIC PARAM callee: its result is whatever the
            # caller's function returns, which is unknowable here, so the
            # return is boxed unconditionally. The ident arm below already
            # says a genp param RETURNED WHOLE is boxed; this arm never
            # asked, so `return fn` was boxed and `return (fn of x)` was
            # declared double -- the same table, one consumer taught and its
            # sibling not, three rounds running.
            #
            # It broke lib/functional.eigs on its OWN source: apply_when and
            # unless both `return (fn of value)`, so any callback returning
            # a string (or a void callback returning null -- the commoner
            # shape) died "non-numeric value in a numeric context at unless:
            # return (type str)" rc 1 where the VM prints the value rc 0.
            if fgen[rc1[1]] == 1:
                return 1
    if re[0] == "ident":
        if fbt[re[1]] == 1:
            return 1
        # a DICT param returned whole is a boxed Value (#86): omitting this
        # declared `_process_dimacs_parts` (which returns its state dict)
        # as double, so the caller received a number and the next field
        # read failed with "cannot access field 'current' on num".
        if fdict[re[1]] == 1:
            return 1
        # a generic param returned whole is whatever the caller passed — boxed.
        if fgen[re[1]] == 1:
            return 1
        # a tensor-returning function serializes its tensor to a Value.
        if ftt[re[1]] == 1:
            return 1
        # a local assigned a boxed value (list/str/dict/null) is non-numeric,
        # transitively through local-to-local aliases.
        if (local_rhs_boxed of [re[1], rba, fgen, fbt, fdict, ftt, {}]) == 1:
            return 1
    if (re[0] == "binop") and (re[1] == "+"):
        # (round 113, same finding, one level up) `+` is the ONE polymorphic
        # binop (str+str concatenates), and this function had no arm for it
        # at all -- is_boxed_node's chain_has_str catches only a string
        # LITERAL in the chain, so `return HEXD[a] + HEXD[b]` (no literal,
        # both sides boxed lookups) fell through to double. That is
        # tidelog's byte_hex verbatim. A `+` return is boxed if EITHER side
        # is boxed by this same classification; declaring Value* is safe in
        # the mixed case too, because the return boundary boxes a numeric
        # value value-preservingly.
        if (return_node_is_boxed of [re[2], fbt, ftt, rba, fgen, fdict]) == 1:
            return 1
        if (return_node_is_boxed of [re[3], fbt, ftt, rba, fgen, fdict]) == 1:
            return 1
    if re[0] == "index":
        # (round 113) an INDEX-READ return was presumed numeric -- this
        # function fell through to `return 0` for index nodes while
        # is_num_expr's index arm says NOT numeric unless the target is a
        # numeric C buffer. The two inferences disagreed at exactly the
        # boundary CLAUDE.md warns about: a string-table lookup
        # (`define pick1(b) as: return HEXD[b]` over a module list of
        # strings) was declared `static double`, the return died through
        # aot_num_ck_at, and the CALLER's accumulator was typed numeric off
        # the "numeric" callee (`s is s + pick1 of x` -> "name s (type
        # str)"), rc 1 where the VM runs. The same expression INLINE at the
        # use site was already correct -- the defect was only the
        # return-position consumer of "what class is a list element?", the
        # #178 family's return member.
        #
        # Reach: tidelog test/test_cbor.eigs byte_hex blocked the ENTIRE
        # RFC 8949 CBOR vector suite (VM "cbor: 73 passed, 0 failed" rc 0;
        # AOT rc 1 before printing anything).
        #
        # The one shape that stays double: a target ident that is a known
        # numeric buffer (fbt covers params, buffer locals, and module
        # buffers -- emit_function seeds it from gbt), mirroring
        # is_num_expr's own gate. Everything else -- list globals, dicts,
        # nested m[i][j], non-ident targets -- is boxed; a numeric value
        # boxes fine, and the boundary coercion is value-preserving.
        local itgt is unwrap of re[1]
        if (itgt[0] == "ident") and (fbt[(itgt[1])] == 1):
            return 0
        return 1
    if (is_buf_create of rnode) == 1:
        return 1
    if (is_boxed_node of [rnode, fgen]) == 1:
        return 1
    return 0

define func_ret_type(fn, fbt, fgen, fdict) as:
    local rets is []
    collect_return_nodes of [fn[3], rets]
    if (len of rets) == 0:
        return "void"
    # The function is `double` only if EVERY reachable return is numeric under
    # the same classification the return emitter uses. If ANY return is boxed,
    # declare Value* so a numeric return boxes (make_num) and a boxed return
    # stays a Value* — never coerce a boxed value through aot_num (which would
    # silently miscompile a mixed-return function).
    local ftt is infer_tensors of fn[3]
    local rba is collect_assigns of [fn[3], {}]
    for i in range of (len of rets):
        if (return_node_is_boxed of [rets[i], fbt, ftt, rba, fgen, fdict]) == 1:
            return "Value*"
    return "double"

# Does this function return a TENSOR (its return ident is a tensor local)? Such a
# call yields a boxed nested-list Value at the caller, not a buffer global.
define func_ret_tensor(fn) as:
    local rets is []
    collect_return_nodes of [fn[3], rets]
    if (len of rets) == 0:
        return 0
    # tensor-returning ONLY if EVERY return is a tensor local; a mixed
    # tensor/other function is generic Value* (callers must not use the
    # tensor-serialization path on a non-tensor return).
    local ftt is infer_tensors of fn[3]
    for i in range of (len of rets):
        local re is unwrap of rets[i]
        local istensor is 0
        if re[0] == "ident":
            if ftt[re[1]] == 1:
                istensor is 1
        if istensor == 0:
            return 0
    return 1

# Does this function return a BUFFER specifically (vs a boxed list/str/dict)? A
# call to it is buffer-producing (its result var is a Value* buffer, indexed with
# aot_buf_get); a list/str/dict-returning Value* function is NOT buffer-producing
# (its result is a boxed value, indexed with aot_index_get).
define func_ret_buf(fn, fbt) as:
    local rets is []
    collect_return_nodes of [fn[3], rets]
    if (len of rets) == 0:
        return 0
    # buffer-producing ONLY if EVERY return is a buffer (a buffer-local ident or
    # a direct buffer/zeros-of-N create). A mixed buffer/list function is generic
    # Value*; callers must index it with boxed aot_index_get, not the
    # buffer-specialized aot_buf_get (which on a list value reads garbage).
    for i in range of (len of rets):
        local re is unwrap of rets[i]
        local isbuf is 0
        if re[0] == "ident":
            if fbt[re[1]] == 1:
                isbuf is 1
        if (is_buf_create of rets[i]) == 1:
            isbuf is 1
        if isbuf == 0:
            return 0
    return 1

# Does this function observe (predicates/report) or use temporal queries on its
# own scope? Such a function routes locals/params through the GLOBAL env (Part
# 2a), which clobbers if it nests inside another observing function.
define func_observed(fn) as:
    if (uses_observer of fn[3]) == 1:
        return 1
    return has_interrogate of fn[3]

# Does this AST call a user function that is itself observed/temporal?
define calls_observed(node) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        local callee is unwrap of node[1]
        if callee[0] == "ident":
            if g_funcs[callee[1]] != null:
                if (g_funcs[callee[1]])["observed"] == 1:
                    return 1
    for k in range of (len of node):
        if (calls_observed of node[k]) == 1:
            return 1
    return 0

# a var is buffer-producing if assigned `buffer/zeros of N` or a Value*-returning call
define is_buf_producing(rhs) as:
    if (is_buf_create of rhs) == 1:
        return 1
    local n is unwrap of rhs
    if n[0] == "call":
        local callee is unwrap of n[1]
        if callee[0] == "ident":
            if g_funcs[callee[1]] != null:
                # a tensor-returning function yields a boxed nested-list Value;
                # it's an ordinary boxed value (env), not a buffer global.
                if (g_funcs[callee[1]])["rettensor"] == 1:
                    return 0
                # only a BUFFER-returning function makes its result a buffer; a
                # list/str/dict-returning Value* function yields a boxed value.
                if (g_funcs[callee[1]])["retbuf"] == 1:
                    return 1
    return 0

# Also a buffer if PASSED to an already-analyzed function at a buffer position
# (so `forward(out, x)` calling `matvec(out, x, …)` infers out/x as buffers).
# (round 118, #180 #145 #181) The VM's call-arity rule, measured: a 1-param
# callee RE-COLLECTS a bare literal arg list WHOLE at every count other than
# one (`g of [a, b]` binds b = [a, b]; `g of []` binds [], EigenScript#733);
# a 2+-param callee spreads it; more args than params on a 2+-param callee
# is a hard runtime error ("call passes N arguments but the callee takes M"). The walkers below indexed ptypes by
# argument position and walked off a 1-param callee's list -- the compiler
# itself died "index 1 out of range" with no AOT: line (#180; lib/pkg.eigs
# reached it through `import pkg`, #145).
define call_elems_for(fname, arg) as:
    local elems is []
    if (arg[0] == "list") and ((len of arg) == 2):
        elems is arg[1]
    else:
        elems is [arg]
    local pts is (g_funcs[fname])["ptypes"]
    if ((len of pts) == 1) and ((len of elems) != 1) and (arg[0] == "list") and ((len of arg) == 2):
        return [arg]
    return elems

define find_buf_param_use(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        local callee is unwrap of node[1]
        if callee[0] == "ident":
            if g_funcs[callee[1]] != null:
                local arg is unwrap of node[2]
                local elems is call_elems_for of [callee[1], arg]
                local pts is (g_funcs[callee[1]])["ptypes"]
                for k in range of (len of elems):
                    if k >= (len of pts):
                        break
                    if (pts[k]) == "buf":
                        local e is unwrap of elems[k]
                        if (e[0] == "ident") and (e[1] == name):
                            return 1
    for k in range of (len of node):
        if (find_buf_param_use of [node[k], name]) == 1:
            return 1
    return 0

# A param whose body dispatches on its runtime type (`type of x`) is GENERIC:
# it holds whatever the caller passed (string or buffer in checksum), so no
# specialized class is sound. Checked before the buffer rules — `len of x`
# beside a `type of x` dispatch would otherwise classify buf and die on
# string inputs at aot_buf_len's runtime type guard.
define uses_type_dispatch(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        local callee is unwrap of node[1]
        if (callee[0] == "ident") and (callee[1] == "type"):
            local a is unwrap of node[2]
            if (a[0] == "ident") and (a[1] == name):
                return 1
    for k in range of (len of node):
        if (uses_type_dispatch of [node[k], name]) == 1:
            return 1
    return 0

# Generic-ness propagates through calls like buf-ness does: a param passed at
# an already-analyzed function's "gen" position is itself generic (crc32's
# `data` flows to _blen/_byte). Definition order bounds this one-pass
# propagation, same as find_buf_param_use; a miss stays classified num and
# fails LOUDLY at the call site, never silently.
# Builtins whose arguments are strings/values, never numbers: a param fed
# to one of these is NOT numeric (found compiling EigenMiniSat's DIMACS
# tokenizer, #86 — `_tokens(line)` uses `line` only via str_replace/split
# and defaulted to "num", so a string-literal call site threw).
# Builtins whose return is never a number: a local assigned from one is a
# boxed value, which call-site widening needs to know (#86).
# (round 93) `zeros` joins the list: it is a tensor builtin returning a
# LIST, and once it stopped being a buffer create a direct
# `return zeros of n` inferred numeric and the coercion killed a program
# the VM runs. (A second table declared nearer the first consumer was
# silently clobbered by THIS assignment at module load -- one name, two
# definitions, the later one winning: the duplicate-define hazard the
# emitter refuses in compiled programs, live in the compiler's own source.)
# (round 104) THE POLARITY IS NOW SAFE-BY-DEFAULT.
#
# BOXED_RET_BUILTINS below is a 24-name hand-maintained allowlist against a
# runtime that registers ~238 builtins, and it was consulted to decide a
# function's DECLARED RETURN TYPE: a builtin not on the list was taken as
# "not boxed", so `return json_path of [j, k]` declared the function double
# and the string died through aot_num_ck_at at RUNTIME -- rc 0 -> rc 1,
# nothing printed, and no AOT: refusal, so the stdlib BUILD sweep could not
# see it either. 11 of 12 sampled un-listed boxed builtins reproduced it.
#
# An allowlist of the BOXED ones has the failure polarity backwards: every
# builtin nobody thought of, and every builtin upstream adds in future, is
# a silent latent instance. So the return class now defaults to BOXED --
# always correct, since a number boxes fine -- and the NUMERIC ones are the
# enumerated exception. An omission from this table now costs a make_num,
# not a miscompile.
#
# Every name here was MEASURED against the pin with `type of`, not assumed
# (`sign`/`trunc` were candidates and do not exist; log/sin/cos/tan and the
# predicate-shaped ones -- contains, starts_with, ends_with, file_exists --
# really do return num). The first six are exactly the set is_num_expr's
# own call arm already lowers as numeric.
NUM_RET_BUILTINS is {"len": 1, "sqrt": 1, "exp": 1, "dot": 1, "sum": 1, "norm": 1, "abs": 1, "floor": 1, "ceil": 1, "round": 1, "min": 1, "max": 1, "pow": 1, "log": 1, "sin": 1, "cos": 1, "tan": 1, "ord": 1, "index_of": 1, "contains": 1, "starts_with": 1, "ends_with": 1, "file_exists": 1, "monotonic_ns": 1, "random": 1, "num": 1, "buf_get": 1, "buf_len": 1, "write_text": 1}

# (round 111) the four observer special forms return str / str / dict /
# list. They were absent, so `check of [tag, report_value of x, want]`
# left the callee's param numeric and the string died at the coercion --
# a runtime death where the VM prints, and `report of x` as an argument
# had been dying the same way all along (test_report_value_convergence).
BOXED_RET_BUILTINS is {"report": 1, "report_value": 1, "trajectory": 1, "observe": 1, "zeros": 1, "read_text": 1, "read_lines": 1, "split": 1, "trim": 1, "substr": 1, "str_replace": 1, "str_lower": 1, "str_upper": 1, "char_at": 1, "join": 1, "str": 1, "keys": 1, "values": 1, "sort": 1, "sort_by": 1, "scan_ints": 1, "scan_int_tokens": 1, "range": 1, "hex": 1, "chr": 1, "json_decode": 1, "json_encode": 1, "args": 1}

STR_ARG_BUILTINS is {"split": 1, "trim": 1, "substr": 1, "str_replace": 1, "contains": 1, "index_of": 1, "char_at": 1, "starts_with": 1, "ends_with": 1, "str_lower": 1, "str_upper": 1, "ord": 1, "read_text": 1, "write_text": 1, "file_exists": 1, "read_lines": 1, "scan_ints": 1, "scan_int_tokens": 1}

# Is `name` read in a genuinely NUMERIC position (arithmetic/comparison
# operand, index expression, unary minus)? Used to keep the append-arg
# signal below from demoting numeric params that also get appended.
# Direct numeric evidence: arithmetic/comparison operand or index
# expression. Deliberately does NOT count "passed to a numeric param"
# (see local_gen_map).
# Is `name` handed to a call as (or inside) an argument? Passing it to a
# callee whose parameter is numeric is numeric evidence that
# find_numeric_use_direct deliberately does not count, and the ptypes fixpoint
# cannot be consulted from inside func_ptypes without circularity. Used only to
# hold back the value-reference boxing below (#130) — conservative in the safe
# direction: a param that is passed onward keeps whatever the body inferred.
define param_in_call_arg(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        if (contains_ident of [node[2], name]) == 1:
            return 1
    for k in range of (len of node):
        if (param_in_call_arg of [node[k], name]) == 1:
            return 1
    return 0

define contains_ident(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "ident":
        if node[1] == name:
            return 1
        return 0
    for k in range of (len of node):
        if (contains_ident of [node[k], name]) == 1:
            return 1
    return 0

define find_numeric_use_direct(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "binop":
        if (NUMONLY_OPS[node[1]] == 1) or (node[1] == "<") or (node[1] == ">") or (node[1] == "<=") or (node[1] == ">="):
            local l is unwrap of node[2]
            local r is unwrap of node[3]
            if (l[0] == "ident") and (l[1] == name):
                return 1
            if (r[0] == "ident") and (r[1] == name):
                return 1
    if node[0] == "index":
        local ix is unwrap of node[2]
        if (ix[0] == "ident") and (ix[1] == name):
            return 1
    for k in range of (len of node):
        if (find_numeric_use_direct of [node[k], name]) == 1:
            return 1
    return 0

define chain_has_str(node) as:
    local n is unwrap of node
    if (type of n) != "list":
        return 0
    if (len of n) == 0:
        return 0
    if n[0] == "str":
        return 1
    if n[0] == "fstring":
        return 1
    if (n[0] == "binop") and (n[1] == "+"):
        if (chain_has_str of n[2]) == 1:
            return 1
        return chain_has_str of n[3]
    return 0

# Call-site ground truth (#86): a user fn param that RECEIVES a non-numeric
# LITERAL (str/null/dict/nested list) at any call site cannot be "num".
# Collected once over the whole program into g_pt_overrides
# (fname -> slot-index-string -> 1) and applied after func_ptypes.
g_pt_overrides is {}

define scan_arg_overrides(node) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        local callee is unwrap of node[1]
        if (callee[0] == "ident") and (g_func_names[callee[1]] == 1):
            local arg is unwrap of node[2]
            local elems is []
            if (arg[0] == "list") and ((len of arg) == 2):
                elems is arg[1]
            else:
                elems is [arg]
            for k in range of (len of elems):
                local e is unwrap of elems[k]
                # ONLY genuine value literals. NOT "null" (that is the
                # zero-arg `f of null` idiom, #69) and NOT a bare "list"
                # (that is the argument list itself, #405) — claiming
                # either broke t51_nullcall / t54 / t56.
                local nonnum is 0
                if (e[0] == "str") or (e[0] == "dict"):
                    nonnum is 1
                if (e[0] == "binop") and (e[1] == "+") and ((chain_has_str of e) == 1):
                    # a desugared f-string argument (lex-level desugar: a
                    # parenthesized `+` chain carrying string literals)
                    nonnum is 1
                if nonnum == 1:
                    local ov is g_pt_overrides[callee[1]]
                    if ov == null:
                        ov is {}
                        g_pt_overrides[callee[1]] is ov
                    ov[(str of k)] is 1
    for k2 in range of (len of node):
        scan_arg_overrides of node[k2]
    return 0

# Positive evidence that `name`'s ELEMENTS are boxed, not numbers (#86).
# `x[i]` proves x is INDEXABLE, never that it holds numbers — the DIMACS
# tokenizer's `parts[0] == "p"` is a list of strings. Demoting only on
# this evidence keeps every numeric program on the unboxed fast path, so
# the change cannot regress the numeric benchmarks.
# Does any `name[i]` READ appear in a genuinely numeric position — an
# arithmetic/comparison operand, or an index expression? (#86 element-class.)
#
# `find_buffer_use` assigns "buf" from index USAGE alone, and the unboxed
# read it emits (aot_buf_get_i -> aot_list_num_at) EXITS on a non-numeric
# element. `elem_is_boxed_use` demotes that, but only on shapes that touch
# the element directly (x[i].f, x[i][j], for y in x[i]) — so a function whose
# only use is PASSING x[i] to another function kept the unboxed read.
#
# DMG hits exactly that: `_op_ld_bc_d16(ctx)` does
# `set_bc of [ctx[0], fetch16 of [ctx[0], ctx[1]]]` and never touches the
# element itself, so `ctx` stayed "buf" and the emulator died on
# `non-numeric element in ctx[0] (dict)` — while sibling handlers doing
# `ctx[0].sp` were demoted correctly. Same param, same value, two classes.
#
# The asymmetry decides the default: a wrong "buf" is a crash or a wrong
# read, a wrong "gen" is one boxed access. So an element read that is never
# used numerically demotes, rather than requiring proof that it is boxed.
define elem_has_numeric_use(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    # DIRECT operands only. `contains_index_of` descends into call arguments,
    # so `(get_bc of ctx[0]) + 1` counted ctx[0] as numerically used when the
    # numeric thing is the CALL RESULT — that false positive kept six DMG
    # handlers on the unboxed read. The element itself must be the operand.
    if node[0] == "binop":
        if (is_index_of of [node[2], name]) == 1:
            return 1
        if (is_index_of of [node[3], name]) == 1:
            return 1
    if node[0] == "unop":
        if (is_index_of of [node[2], name]) == 1:
            return 1
    # y[ x[i] ] — the element is used as an index, which must be a number
    if (node[0] == "index") or (node[0] == "index_assign"):
        if (is_index_of of [node[2], name]) == 1:
            return 1
    local k is 0
    loop while k < (len of node):
        if (type of node[k]) == "list":
            if (elem_has_numeric_use of [node[k], name]) == 1:
                return 1
        k is k + 1
    return 0

define elem_is_boxed_use(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    # x[i] compared against a string literal
    if node[0] == "binop":
        if (node[1] == "==") or (node[1] == "!="):
            local l is unwrap of node[2]
            local r is unwrap of node[3]
            if (is_index_of of [l, name]) == 1:
                if r[0] == "str":
                    return 1
            if (is_index_of of [r, name]) == 1:
                if l[0] == "str":
                    return 1
        # x[i] inside a string concatenation (incl. desugared f-strings)
        if node[1] == "+":
            if (chain_has_str of node) == 1:
                if (contains_index_of of [node, name]) == 1:
                    return 1
    # The element is used as a COLLECTION — each of these is a VM error on
    # a number, so it is positive proof the elements are boxed (#86
    # element-class: `x[i]` proves indexable, never numeric-element):
    #   x[i][j] / x[i][j] is v  — the element is indexed
    #   for y in x[i]           — the element is iterated
    #   x[i].f / x[i].f is v    — the element is a dict
    if (node[0] == "index") or (node[0] == "index_assign"):
        if (is_index_of of [node[1], name]) == 1:
            return 1
    if node[0] == "for":
        if (is_index_of of [node[2], name]) == 1:
            return 1
    if (node[0] == "dot") or (node[0] == "dot_assign"):
        if (is_index_of of [node[1], name]) == 1:
            return 1
    # x[i] passed to a string-only builtin
    if node[0] == "call":
        local callee is unwrap of node[1]
        # append's FIRST argument is its in-place list target: an element
        # there is a list (EigenMiniSat's watch buckets —
        # `append of [watches[idx], clause_index]`). The appended VALUE
        # position is NOT evidence (numbers are appended all the time).
        # `len of x[i]` is evidence too: a number has no len.
        if (callee[0] == "ident") and (callee[1] == "append"):
            local aarg is unwrap of node[2]
            if (aarg[0] == "list") and ((len of aarg) == 2):
                local ael is aarg[1]
                if (len of ael) >= 1:
                    if (is_index_of of [ael[0], name]) == 1:
                        return 1
        if (callee[0] == "ident") and (callee[1] == "len"):
            local larg is unwrap of node[2]
            if (is_index_of of [larg, name]) == 1:
                return 1
        if (callee[0] == "ident") and (STR_ARG_BUILTINS[callee[1]] == 1):
            local arg is unwrap of node[2]
            local elems is []
            if (arg[0] == "list") and ((len of arg) == 2):
                elems is arg[1]
            else:
                elems is [arg]
            for k in range of (len of elems):
                if (is_index_of of [elems[k], name]) == 1:
                    return 1
        # ...or to a user function's non-numeric param
        if (callee[0] == "ident") and (g_funcs[callee[1]] != null):
            local arg2 is unwrap of node[2]
            local el2 is []
            if (arg2[0] == "list") and ((len of arg2) == 2):
                el2 is arg2[1]
            else:
                el2 is [arg2]
            local pts2 is (g_funcs[callee[1]])["ptypes"]
            for k2 in range of (len of el2):
                if k2 < (len of pts2):
                    if ((pts2[k2]) == "gen") and ((is_index_of of [el2[k2], name]) == 1):
                        return 1
    for k3 in range of (len of node):
        if (elem_is_boxed_use of [node[k3], name]) == 1:
            return 1
    return 0

# is this node exactly `name[...]`?
define is_index_of(node, name) as:
    local n is unwrap of node
    if (type of n) != "list":
        return 0
    if (len of n) == 0:
        return 0
    if n[0] != "index":
        return 0
    local tgt is unwrap of n[1]
    if (tgt[0] == "ident") and (tgt[1] == name):
        return 1
    return 0

define contains_index_of(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if (is_index_of of [node, name]) == 1:
        return 1
    for k in range of (len of node):
        if (contains_index_of of [node[k], name]) == 1:
            return 1
    return 0

define find_gen_param_use(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        local callee is unwrap of node[1]
        if callee[0] == "ident":
            if g_funcs[callee[1]] != null:
                local arg is unwrap of node[2]
                local elems is call_elems_for of [callee[1], arg]
                local pts is (g_funcs[callee[1]])["ptypes"]
                for k in range of (len of elems):
                    if k >= (len of pts):
                        break
                    # dict and tensor positions count too (#86 gap 3): a
                    # param whose ONLY use is flowing into a callee's dict
                    # param holds a dict (EigenMiniSat's
                    # `should_compact_deleted_clauses(store, ...)` passing
                    # store straight to `clause_store_len`), and a numeric
                    # default there emits a numeric read of a boxed value.
                    if ((pts[k]) == "gen") or ((pts[k]) == "dict") or ((pts[k]) == "tensor"):
                        local e is unwrap of elems[k]
                        if (e[0] == "ident") and (e[1] == name):
                            return 1
    for k in range of (len of node):
        if (find_gen_param_use of [node[k], name]) == 1:
            return 1
    return 0

define func_ptypes(fn) as:
    local params is fn[2]
    local body is fn[3]
    local pt is []
    # Referenced as a VALUE somewhere in the program? Then its call sites are
    # not statically visible and the body licenses no narrowing: the default
    # "num" would have the wrapper coerce a non-number argument to 0.0 while
    # the VM passes it through (ouroboros#130, aot/test/t88_dispatch.eigs).
    # Applied HERE rather than at the single build site because the ptypes
    # fixpoint re-derives them up to four times.
    local fnval is 0
    if g_fnval_params[fn[1]] == 1:
        fnval is 1
    for p in range of (len of params):
        local cls is "num"
        if fnval == 1:
            # Box only when the BODY gives no evidence the parameter must be a
            # double: not an arithmetic/index operand, and not handed onward to
            # a call. `define h(ctx) as: return ctx` and `define _op_nop(ctx)
            # as: return 4` qualify — and those are exactly the shapes whose
            # wrapper coerced a dict or list argument to 0.0.
            if (find_numeric_use_direct of [body, params[p]]) == 0:
                if (param_in_call_arg of [body, params[p]]) == 0:
                    cls is "gen"
        if (uses_as_dot of [body, params[p]]) == 1:
            cls is "dict"
        elif (uses_as_tensor_arg of [body, params[p]]) == 1:
            cls is "tensor"
        elif (uses_type_dispatch of [body, params[p]]) == 1:
            cls is "gen"
        elif (find_buffer_use of [body, params[p]]) == 1:
            cls is "buf"
            # indexable, but the ELEMENTS are provably boxed (#86): route
            # reads through aot_index_get instead of the unboxed buffer
            # path. Demotion needs positive evidence, so numeric code is
            # untouched.
            if (elem_is_boxed_use of [body, params[p]]) == 1:
                cls is "gen"
            elif (elem_has_numeric_use of [body, params[p]]) == 0:
                # indexable, but nothing ever uses an element as a number —
                # take the boxed read rather than betting on it (#86).
                cls is "gen"
        elif (find_buf_param_use of [body, params[p]]) == 1:
            cls is "buf"
        elif (find_gen_param_use of [body, params[p]]) == 1:
            cls is "gen"
        pt is (append of [pt, cls])
    return pt

# ---- call-site widening of parameter classes (#86) ----
#
# func_ptypes infers each param's class from its OWN BODY and defaults to
# "num" when the body shows no evidence. That default is a silent wrong
# emission when a caller actually passes a string/list/dict: a numeric
# read of a boxed value is either a hard runtime error or garbage.
#
# This post-pass adds the missing half — evidence from CALL SITES — as a
# monotone widening (num -> gen only, never the reverse), iterated to a
# fixpoint so a value flowing through a chain of pass-through functions
# widens every param on the path. Two conditions keep it sound:
#
#   1. the body must show NO numeric use of the param (arithmetic,
#      comparison, index expression, or a numeric-param call arg) —
#      widening a genuinely numeric param would emit pointer arithmetic;
#   2. the argument must be PROVABLY non-numeric.
#
# Provably non-numeric means: a str or dict LITERAL, or an ident that the
# caller already classifies dict/gen. Deliberately NOT: `null` (that is
# the zero-arg `f of null` idiom, #69 — it means "no argument", not "a
# null value") and NOT a bare `list` argument node (that is the argument
# list itself under the #405 one-call rule). Misreading those two broke
# t51_nullcall / t54_generic_params / t56_forvar_unbox on the first
# attempt; they are the reason this pass is conservative by construction.
#
# Anything not provably non-numeric contributes NO constraint, so a
# program that never passes a boxed value into a num-defaulted param
# compiles exactly as it did before this pass existed.

# The class of an argument expression as seen from `caller_pt` (the
# caller's param classes): "num" | "gen" | "unknown".
define arg_class(node, caller_pt, caller_params, caller_locals) as:
    local e is unwrap of node
    if (len of e) == 0:
        return "unknown"
    local t is e[0]
    if t == "str":
        return "gen"
    if t == "dict":
        return "gen"
    if t == "list":
        # Safe HERE (unlike a raw argument node): widen_scan passes only
        # already-unpacked elements, so a list node in this position is a
        # genuine nested list literal, not the #405 argument list.
        return "gen"
    if t == "null":
        # Likewise safe: the zero-arg `f of null` idiom is the whole
        # ARGUMENT node and is skipped before elements are built, so a
        # null reaching here is a real null VALUE in a multi-arg call
        # (EigenMiniSat's `cdcl_result of [status, null, stats, state]`).
        return "gen"
    if t == "dot":
        # `x.f` where x is a local built from a dict LITERAL: the field's
        # type is statically known (EigenMiniSat's CLI config dict —
        # `cfg is {"mode": "solve", "path": "", ...}` then
        # `parse_dimacs_file of cfg.path`, a string reaching a numeric
        # param). Unknown fields stay unknown, contributing no constraint.
        local dtgt is unwrap of e[1]
        if dtgt[0] == "ident":
            local flds is caller_locals[dtgt[1] + ".#fields"]
            if flds != null:
                local fc is flds[e[2]]
                if fc != null:
                    return fc
        return "unknown"
    if (t == "binop") and (e[1] == "+"):
        # an f-string argument: the lexer desugars f"..{x}.." into a
        # parenthesized `+` chain, so a chain carrying a string literal is
        # a string-valued argument (EigenMiniSat's
        # `assert_clauses_match of [f"storage rebuild {c.name}", ...]`).
        if (chain_has_str of e) == 1:
            return "gen"
    if t == "num":
        return "num"
    if t == "call":
        # `g of (shout of "a")` where `shout` has no return. The VM binds null
        # to g's parameter and prints "null"; the AOT inferred `g` numeric from
        # this site contributing NO constraint, declared `double eig_n`, and
        # emitted `eig_g(eig_shout(...))` — a C void expression where a double
        # is required, so gcc failed the build outright:
        #
        #   VM   a / null, rc 0     AOT  "invalid use of void expression", no binary
        #
        # That is worse than a wrong answer: it is not an `AOT:` refusal, so it
        # carries no diagnostic naming the construct. A void call yields null,
        # which is boxed evidence exactly like a str or list argument.
        local vac is unwrap of e[1]
        if vac[0] == "ident":
            if g_func_void[vac[1]] == 1:
                return "gen"
            # A user function declared Value* returns a boxed value, which is
            # the same evidence. Returning "unknown" for it left
            # `guarded of (passthru of "x")` -- where passthru is `return
            # (shout of m)`, so Value* precisely BECAUSE of the void rule --
            # reaching gcc as "incompatible type for argument 1 of
            # 'eig_guarded'": no binary and no `AOT:` diagnostic, against a VM
            # that runs it at rc 0. ret is computed for every function before
            # widen_ptypes runs, so it is available here; a callee not yet in
            # g_funcs (first pass, later definition) stays unknown and the
            # fixpoint revisits it.
            local vcf is g_funcs[vac[1]]
            if vcf != null:
                if (vcf["ret"]) == "Value*":
                    return "gen"
            # (round 111) a BUILTIN callee with a known boxed return is the
            # same evidence. This arm consulted user functions only, so
            # `check of [tag, report_value of x, want]` left `got` numeric
            # and the string died at the coercion -- a runtime death where
            # the VM prints; `report of x` as an argument had died the same
            # way all along. NUM_RET_BUILTINS' comment records that the
            # boxed-allowlist polarity is backwards for RETURN classes; this
            # arm keeps "unknown" for an unlisted builtin (the widening to
            # boxed-by-default here is a separate, measured change).
            elif (g_func_names[vac[1]] != 1) and (BOXED_RET_BUILTINS[vac[1]] == 1):
                return "gen"
        return "unknown"
    if t == "ident":
        for k in range of (len of caller_params):
            if (caller_params[k]) == e[1]:
                local c is caller_pt[k]
                # EVERY Value*-class param is boxed evidence — buf and
                # tensor are C Value*s exactly like dict/gen, and passing
                # one into a callee's numeric param is the same silent
                # wrong emission (EigenMiniSat's `copy_assignment of asg`,
                # where asg is a buf param of dpll_rec).
                if (c == "dict") or (c == "gen") or (c == "buf") or (c == "tensor"):
                    return "gen"
                if c == "num":
                    return "num"
                return "unknown"
        if caller_locals[e[1]] == "gen":
            return "gen"
        # (round 99) a compiled FUNCTION NAME is boxed evidence, exactly
        # like a str/list/dict literal. Returning "unknown" here defaulted
        # the callee's parameter to numeric, so `reg of ["a", g]` declared
        # `double eig_f` and would have stored a NUMBER where the VM stores
        # a function -- the loud death downstream was masking a latent
        # silent-wrong, not preventing one.
        if g_func_names[e[1]] == 1:
            return "gen"
        return "unknown"
    if e[0] == "ident":
        if g_func_names[e[1]] == 1:
            return "gen"
    return "unknown"

# Boxed LOCALS of a function body: a name whose assignments include a
# list/dict/str literal, or a call to a Value*-returning user function, is
# a boxed value — the other half of the call-site evidence (EigenMiniSat's
# `out is []` / `asg is copy_assignment of ...` shapes). Numeric-used
# names are excluded: a name doing arithmetic is not widened on our say-so.
# Memoized per FUNCTION NAME (#86). local_gen_map walks the whole body,
# runs collect_assigns, and does a find_numeric_use_direct per name; the
# param-field propagation calls it once per function per round, which on a
# 218-function consumer pushed compile time past 10 minutes. Bodies do not
# change during inference, so one computation per function is sound.
G_LGM_CACHE is [{}]

define local_gen_map_for(fname, body) as:
    return local_gen_map_for_seeded of [fname, body, {}]

# Seed-aware memo (#86 element-class): widen_ptypes seeds each function's
# map with its boxed-element params (gen/dict), and those classes WIDEN
# across rounds — so the cache key must include the seed, or a map cached
# under an earlier (smaller) seed silently serves a later round. Seeds
# grow monotonically with ptypes, so keying on the seed's name list is a
# sound identity.
define local_gen_map_for_seeded(fname, body, seed) as:
    local sig is fname + "|" + (join of [keys of seed, ","])
    local c is (G_LGM_CACHE[0])[sig]
    if c != null:
        return c
    local m is local_gen_map_seeded of [body, seed]
    local cache is G_LGM_CACHE[0]
    cache[sig] is m
    return m

define local_gen_map(body) as:
    return local_gen_map_seeded of [body, {}]

# `seed` pre-populates "<name>.#fields" entries. Currently always empty:
# the call-site propagation that would fill it (typing a dict PARAM from
# its callers, so `_finish_parse_state(state)` can resolve
# `state.clauses`) needs local_gen_map memoized per function first — the
# unmemoized version pushed compile time past 10 minutes on a
# 218-function consumer. The seam is kept because that is the next step.
define local_gen_map_seeded(body, seed) as:
    local out is {}
    local sk is keys of seed
    for si in range of (len of sk):
        out[sk[si]] is seed[sk[si]]
    local assigns is collect_assigns of [body, {}]
    local names is keys of assigns
    for i in range of (len of names):
        local v is names[i]
        local rhss is assigns[v]
        local isgen is 0
        for j in range of (len of rhss):
            local r is unwrap of rhss[j]
            if (len of r) > 0:
                if (r[0] == "str") or (r[0] == "dict") or (r[0] == "list") or (r[0] == "null"):
                    # `null` belongs in this list and its absence was the
                    # plainest instance of the whole boxed-value class:
                    #
                    #   n is null / g of n     (g guards on null, then computes)
                    #   VM   null-arm, rc 0
                    #   AOT  builds clean, NO stdout, then "non-numeric value in
                    #        a numeric context at <module>: name n (type null)"
                    #
                    # The same file contradicted itself: the dict-field map
                    # below counts a `null` field value as boxed, and the
                    # void-call arm above is commented "yields null, which is
                    # boxed". Only the plainest spelling was missing, so
                    # `rows is [null] / r is rows[0] / g of r` MATCHED while a
                    # bare `n is null` did not.
                    isgen is 1
                # An INDEX read is boxed evidence (#86). `rom_path is argv[0]`
                # yields a str, but an index node was not evidence of anything,
                # so the name stayed unclassified, `load_rom`'s `path` kept its
                # num default, and the call emitted aot_num_ck_at on a string —
                # DMG died at `name rom_path (type str)` the moment #129 made
                # load_rom a COMPILED function instead of an interpreted one.
                #
                # Safe by the same veto every other signal here relies on:
                # find_numeric_use_direct below drops any name with direct
                # arithmetic use, so `x is buf[i]` followed by `x + 1` is not
                # widened. Over-widening costs a boxed read; UNDER-widening is
                # a wrong emission, which is the asymmetry this pass exists for.
                if r[0] == "index":
                    isgen is 1
                if r[0] == "call":
                    local rc is unwrap of r[1]
                    if rc[0] == "ident":
                        if g_funcs[rc[1]] != null:
                            if ((g_funcs[rc[1]])["ret"]) == "Value*":
                                isgen is 1
                            if g_func_void[rc[1]] == 1:
                                # a function with no return yields null, which
                                # is boxed. Testing only "Value*" missed it:
                                #   x is (shout of "a") / g of x
                                #   VM  a / null, rc 0
                                #   AOT a, then "non-numeric value in a numeric
                                #       context at <module>: name x", rc 1
                                isgen is 1
                        elif BOXED_RET_BUILTINS[rc[1]] == 1:
                            # a BUILTIN with a known non-numeric return
                            # (EigenMiniSat's `text is read_text of path`,
                            # then `parse_dimacs_text of text`)
                            isgen is 1
        # DIRECT numeric evidence only (arithmetic / index position) — a
        # "passed to a num param" signal would deadlock: that param's class
        # is exactly what this evidence is meant to decide.
        if (isgen == 1) and ((find_numeric_use_direct of [body, v]) == 0):
            out[v] is "gen"
        # Field types of a name built from a dict LITERAL, stored under a
        # side key so arg_class can resolve `name.field` statically.
        for j2 in range of (len of rhss):
            local r2 is unwrap of rhss[j2]
            if (len of r2) > 0:
                if r2[0] == "dict":
                    local fmap is {}
                    local prs is r2[1]
                    for pk in range of (len of prs):
                        local pr is prs[pk]
                        local kn is pr[0]
                        if (type of kn) == "list":
                            kn is kn[1]
                        local pv is unwrap of (pr[1])
                        if (len of pv) > 0:
                            if (pv[0] == "str") or (pv[0] == "list") or (pv[0] == "dict") or (pv[0] == "null"):
                                fmap[kn] is "gen"
                            elif pv[0] == "num":
                                fmap[kn] is "num"
                    out[v + ".#fields"] is fmap
            # ...or from a call to a function that RETURNS a dict literal
            # (EigenMiniSat's `cfg is parse_args of null`): adopt the
            # callee's recorded field map.
            if r2[0] == "call":
                local rc2 is unwrap of r2[1]
                if (rc2[0] == "ident") and (g_funcs[rc2[1]] != null):
                    local rf is (g_funcs[rc2[1]])["retfields"]
                    # keep the INFORMATIVE map: `state` is assigned first
                    # from the constructor (known fields) and then from a
                    # pass-through function whose fields aren't derivable;
                    # last-write-wins would clobber the real map with {}.
                    if (rf != null) and ((len of (keys of rf)) > 0):
                        out[v + ".#fields"] is rf
    # for-in loop VARIABLES: iterating a boxed collection yields boxed
    # elements (`for line in lines` where lines came from split/read_lines
    # — EigenMiniSat's DIMACS parser). Two rounds settle the common
    # split-then-iterate chain.
    local fr is 0
    loop while fr < 2:
        for_var_gen_scan of [body, out]
        fr is fr + 1
    return out

# Mark for-in loop variables whose iterable is a boxed value.
define for_var_gen_scan(node, out) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "for":
        local it is unwrap of node[2]
        local boxed is 0
        if (it[0] == "ident") and (out[it[1]] == "gen"):
            boxed is 1
        if it[0] == "call":
            local ic is unwrap of it[1]
            if (ic[0] == "ident") and (BOXED_RET_BUILTINS[ic[1]] == 1) and (ic[1] != "range"):
                boxed is 1
        if (boxed == 1) and ((find_numeric_use_direct of [node[3], node[1]]) == 0):
            out[node[1]] is "gen"
    for k in range of (len of node):
        for_var_gen_scan of [node[k], out]
    return 0

# Record every (callee, parameter index) that some call site fills with a call
# to a function that has NO return statement. Mirrors widen_scan's argument
# unpacking exactly (#405: a bare literal list IS the argument list; a
# paren-marked 3-slot list is one argument; `f of null` is the zero-arg idiom
# and constrains nothing) -- the two must agree about which element lands in
# which parameter, or this map points at the wrong index.
# Scan one function body for calls, widening callee params. Returns 1 if
# anything changed.
# Is arg_class's "gen" verdict on this argument GROUNDED -- true independently
# of a class the numeric pin can revoke?
#
# This is the distinction three consecutive fixes missed. g_boxed_arg is
# MONOTONE (set once, never cleared) but arg_class's ident arm reads caller_pt,
# and the pin's demotion is the one NON-monotone step in the fixpoint. Storing a
# transient verdict permanently is unsound in principle, and produced a silent
# wrong answer in practice:
#
#   define f(x) as: print of (x * 10) / g of x
#   define g(y) as: if y == null: takes_dict of y ... else: print of (y * 2)
#   f of 3
#
# In round 1 `f`'s x is still gen (find_gen_param_use saw `g of x` at a gen
# position), so arg_class said gen and g#0 was recorded boxed. The pin then
# demoted x back to num and SPARED y. Caller passes a C double, callee expects
# Value*, and emit_args fell through to an env lookup for a name that only
# exists as a C local:
#
#   VM   30 / 6, rc 0      AOT  builds clean, prints 30, then
#                               "undefined variable 'x'", rc 1
#
# Literals, void calls and Value*-returning calls are stable -- nothing can
# revoke them. A local is stable: the pin only touches parameters. A parameter
# is stable only when its own class cannot be demoted (dict/buf/tensor are never
# pinned) or when it is itself backed by grounded evidence.
define arg_gen_grounded(node, caller_pt, caller_params, caller_locals, caller_fn) as:
    local ge is unwrap of node
    if (len of ge) == 0:
        return 0
    if ge[0] == "ident":
        for gk in range of (len of caller_params):
            if (caller_params[gk]) == ge[1]:
                local gc is caller_pt[gk]
                if (gc == "dict") or (gc == "buf") or (gc == "tensor"):
                    return 1
                if gc == "gen":
                    # Ask the PIN's own predicate. g_boxed_arg is a SUFFICIENT
                    # condition for the pin sparing a parameter, never a
                    # necessary one -- the necessary and sufficient condition is
                    # that the pin does not fire at all. Testing the proxy
                    # declared this verdict revocable and then never revoked it:
                    #
                    #   define f(x) as: g of x        (f never computes with x)
                    #   rows is [null] / f of (rows[0])
                    #   VM 'n' rc 0, parent 'n' rc 0
                    #   HEAD~1  builds clean, then "non-numeric value in a
                    #           numeric context at f: name x (type null)", rc 1
                    #
                    # `f of (rows[0])` is an index node, which arg_class calls
                    # "unknown", so f#0 never gets a record -- yet x IS stable:
                    # find_numeric_use_direct(f, x) is 0, so the pin can never
                    # touch it. Testing the pin directly is also the only
                    # version that survives `pinned` later being computed
                    # differently; a downstream side-map would silently drift.
                    local gpin is g_pinned[caller_fn]
                    if gpin != null:
                        if gpin[(str of gk)] != 1:
                            return 1
                    if g_boxed_arg[caller_fn + "#" + (str of gk)] == 1:
                        return 1
                return 0
        if caller_locals[ge[1]] == "gen":
            return 1
        return 0
    return 1

define widen_scan(node, caller_pt, caller_params, caller_locals, caller_fn) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    local changed is 0
    if node[0] == "call":
        local callee is unwrap of node[1]
        # A dot-callee over an IMPORTED MODULE resolves statically: after
        # splicing, `M.fn` names the renamed function `M__fn`, whose wrapper
        # will coerce arguments against the inferred ptypes -- so a call site
        # spelled through the dict must contribute the same argument evidence
        # as a named call, or the evidence is silently lost:
        #
        #   _x2m.announce of 7 / _x2m.announce of "hi"
        #   VM  7 / hi / done, rc 0
        #   AOT builds, prints 7, then "non-numeric value in a numeric context
        #       at _x2m__announce parameter (type str)", rc 1
        #
        # Sound even if the program mutates the dict at runtime: extra widening
        # evidence only ever BOXES a parameter, and boxing is semantics-
        # preserving (measured, round 16) -- the cost of a stale resolution is
        # performance, never a wrong answer.
        if callee[0] == "dot":
            local dmt is unwrap of callee[1]
            if dmt[0] == "ident":
                if G_IMPORTED[dmt[1]] == 1:
                    if g_funcs[(dmt[1]) + "__" + callee[2]] != null:
                        callee is ["ident", (dmt[1]) + "__" + callee[2]]
        if callee[0] == "ident":
            local cf is g_funcs[callee[1]]
            if cf != null:
                local arg is unwrap of node[2]
                local elems is []
                local skip is 0
                if arg[0] == "null":
                    # the zero-arg idiom: no constraint at all
                    skip is 1
                elif (arg[0] == "list") and ((len of arg) == 3):
                    elems is [arg]
                elif arg[0] == "list":
                    elems is arg[1]
                else:
                    elems is [arg]
                if skip == 0:
                    local cpt is cf["ptypes"]
                    for k in range of (len of elems):
                        if k < (len of cpt):
                            # Consult arg_class UNCONDITIONALLY and widen
                            # conditionally, not the other way round. Gating
                            # the consult on `cpt[k] == "num"` meant a
                            # parameter that body inference had ALREADY called
                            # gen never recorded its evidence -- and the pin,
                            # which only asks what the body computes with, then
                            # demoted it to double:
                            #
                            #   define guarded3(n) as:
                            #       if n == null: takes_dict of n ... else: print of (n * 2)
                            #   guarded3 of 5 / guarded3 of (shout of 7)
                            #   VM  10 / 7 / guarded3-null, rc 0
                            #   AOT build FAILS (the backstop refuses)
                            #
                            # and it was hidden by the fixpoint: with no other
                            # widening in the program `changed` stays 0, the
                            # loop exits after the demotion, and there is no
                            # second round in which the now-num parameter would
                            # be widened and recorded. Correctness must not
                            # depend on an unrelated widening elsewhere in the
                            # program buying another round.
                            local acls is arg_class of [elems[k], caller_pt, caller_params, caller_locals]
                            if acls == "gen":
                                if (arg_gen_grounded of [elems[k], caller_pt, caller_params, caller_locals, caller_fn]) == 1:
                                    g_boxed_arg[(callee[1]) + "#" + (str of k)] is 1
                            if (cpt[k]) == "num":
                                if acls == "gen":
                                    cpt[k] is "gen"
                                    changed is 1
    for k2 in range of (len of node):
        if (widen_scan of [node[k2], caller_pt, caller_params, caller_locals, caller_fn]) == 1:
            changed is 1
    return changed

# The field map of a function's returned dict, when every return is an
# ident built from a dict literal in its body. Recorded on g_funcs so a
# caller's `cfg is parse_args of null` inherits the field types.
define dict_literal_fields(dictnode, lm) as:
    local fmap is {}
    local prs is dictnode[1]
    for pk in range of (len of prs):
        local pr is prs[pk]
        local kn is pr[0]
        if (type of kn) == "list":
            kn is kn[1]
        local pv is unwrap of (pr[1])
        if (len of pv) > 0:
            if (pv[0] == "str") or (pv[0] == "list") or (pv[0] == "dict") or (pv[0] == "null"):
                fmap[kn] is "gen"
            elif pv[0] == "num":
                fmap[kn] is "num"
            elif pv[0] == "dot":
                # `"clauses": state.clauses` — inherit from the source
                # record's field map when we know it (#86)
                local dt is unwrap of pv[1]
                if dt[0] == "ident":
                    local srcmap is lm[dt[1] + ".#fields"]
                    if srcmap != null:
                        local fc is srcmap[pv[2]]
                        if fc != null:
                            fmap[kn] is fc
            elif pv[0] == "ident":
                local ic is lm[pv[1]]
                if ic == "gen":
                    fmap[kn] is "gen"
    return fmap

# Record, on each callee, the field map of any dict argument we can type
# (#86). Memoized caller maps make this affordable now.
define pf_scan(node, caller_locals) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        local callee is unwrap of node[1]
        if (callee[0] == "ident") and (g_funcs[callee[1]] != null):
            local arg is unwrap of node[2]
            local elems is []
            if (arg[0] == "list") and ((len of arg) == 2):
                elems is arg[1]
            elif arg[0] != "null":
                elems is [arg]
            local ce is g_funcs[callee[1]]
            local cpf is ce["pfields"]
            if cpf == null:
                cpf is []
                for z in range of (len of (ce["ptypes"])):
                    append of [cpf, null]
                ce["pfields"] is cpf
            for k in range of (len of elems):
                if k < (len of cpf):
                    local e is unwrap of elems[k]
                    if e[0] == "ident":
                        local m is caller_locals[e[1] + ".#fields"]
                        if (m != null) and ((len of (keys of m)) > 0):
                            cpf[k] is m
    for k2 in range of (len of node):
        pf_scan of [node[k2], caller_locals]
    return 0

define func_retfields(fn) as:
    local rets is []
    collect_return_nodes of [fn[3], rets]
    if (len of rets) != 1:
        return null
    local pseed is {}
    local pf is (g_funcs[fn[1]])["pfields"]
    if pf != null:
        for pi in range of (len of fn[2]):
            if pi < (len of pf):
                if (pf[pi]) != null:
                    pseed[((fn[2])[pi]) + ".#fields"] is pf[pi]
    local lmap is local_gen_map_for of [fn[1], fn[3]]
    if (len of (keys of pseed)) > 0:
        # a param map exists: recompute unmemoized WITH the seed (rare —
        # only functions that receive a typed record)
        lmap is local_gen_map_seeded of [fn[3], pseed]
    local r is unwrap of rets[0]
    if r[0] == "dict":
        # returned DIRECTLY as a literal (EigenMiniSat's
        # `_empty_parse_state`, and `_finish_parse_state` whose fields are
        # `state.X` reads resolved through the param seed above)
        return dict_literal_fields of [r, lmap]
    if r[0] == "call":
        # `return parse_dimacs_text of text` — inherit the callee's map
        local rc is unwrap of r[1]
        if (rc[0] == "ident") and (g_funcs[rc[1]] != null):
            return (g_funcs[rc[1]])["retfields"]
        return null
    if r[0] != "ident":
        return null
    return lmap[r[1] + ".#fields"]

# Fixpoint over all user functions plus the module body.
define widen_ptypes(funcs, rest) as:
    # 40 rounds: each round can advance a chain by only one hop in the
    # worst (reverse definition) order, and consumer call graphs are deep
    # (EigenMiniSat's is ~200 functions).
    # Pins are computed ONCE, outside the loop. A comment here used to say they
    # were "recomputed EVERY round from the CURRENT classes ... a param passed
    # into a callee's num param counts as a numeric use, so pins must dissolve
    # as that callee widens", crediting t58's `passthru`. That is false, and was
    # disproved by execution rather than by reading: find_numeric_use_direct is
    # purely SYNTACTIC over the function body -- it reads no ptypes and no
    # g_funcs, and its own contract is that it does not count "passed to a
    # numeric param" -- so g_pinned came out bit-identical on all 40 rounds.
    # Hoisting it changes the emitted C for 0 of 154 programs, t58 included.
    #
    # The saving is (rounds - 1) x F x P, NOT "x 40" as this comment first
    # claimed. A round census over 147 programs: the fixpoint runs ONE round on
    # 134 of them, two on 9, three on 4 -- the loop exits on `changed == 0`, so
    # most programs never re-enter it. That also means the 0-differing result is
    # itself mostly vacuous: 134 of 147 programs execute the loop body once and
    # CANNOT distinguish the hoist, so the 13 multi-round programs are the only
    # ones carrying that evidence. Both numbers are worth stating honestly --
    # the correction to a false comment had a false number of its own.
    #
    # The claim had also been COPIED onto g_pinned's own declaration when that
    # global was added, which is how a false comment earns a second home.
    g_pinned is {}
    for k0 in range of (len of funcs):
        local fn0 is funcs[k0]
        local pins is {}
        for p0 in range of (len of fn0[2]):
            if (find_numeric_use_direct of [fn0[3], (fn0[2])[p0]]) == 1:
                pins[(str of p0)] is 1
        g_pinned[fn0[1]] is pins
    local round is 0
    loop while round < 40:
        local changed is 0
        # snapshot pinned classes so a widening cannot violate them
        for k in range of (len of funcs):
            local fn2 is funcs[k]
            # Seed the caller-locals map with the fn's BOXED-ELEMENT params
            # (gen/dict — classes whose elements are boxed values), so
            # for_var_gen_scan sees `for clause in clauses` where clauses
            # is a param, not a local (#86 element-class: the loop var is
            # boxed evidence for the callees it flows into). buf/tensor
            # params are deliberately NOT seeded: their elements are
            # numeric, and marking their loop vars gen would widen callee
            # params onto the boxed path for values living in C doubles.
            local pt2s is (g_funcs[fn2[1]])["ptypes"]
            local seed2 is {}
            for p2 in range of (len of fn2[2]):
                if ((pt2s[p2]) == "gen") or ((pt2s[p2]) == "dict"):
                    seed2[((fn2[2])[p2])] is "gen"
            if (widen_scan of [fn2[3], pt2s, fn2[2], local_gen_map_for_seeded of [fn2[1], fn2[3], seed2], fn2[1]]) == 1:
                changed is 1
        if (widen_scan of [rest, [], [], local_gen_map_for of ["<module>", rest], "<module>"]) == 1:
            changed is 1
        # restore any param the body proves numeric (pin wins over widening)
        for k in range of (len of funcs):
            local fn3 is funcs[k]
            local pt3 is (g_funcs[fn3[1]])["ptypes"]
            local pins3 is g_pinned[fn3[1]]
            for p in range of (len of pt3):
                if (pins3[(str of p)] == 1) and ((pt3[p]) == "gen"):
                    # ...unless some call site passes a VOID CALL here. The pin
                    # asks only what the BODY does; a body that computes with
                    # its parameter pins it numeric and silently discarded
                    # arg_class's boxed verdict, so the parameter went back to
                    # `double` and the emitted C was eig_g(eig_shout(...)) --
                    # a void expression where a double is required, failing the
                    # BUILD with a gcc error and no AOT diagnostic:
                    #
                    #   define g(n) as: if n == null: ... else: print of (n * 2)
                    #   g of 5 / g of (shout of "a")
                    #   VM  10 / a / nothing, rc 0     AOT  no binary
                    #
                    # The guard in the body is exactly why such a program is
                    # correct in the VM, and exactly what makes the pin wrong
                    # here: the parameter is numeric on one path and null on
                    # another, which is the boxed case.
                    if g_boxed_arg[(fn3[1]) + "#" + (str of p)] != 1:
                        pt3[p] is "num"
        if changed == 0:
            round is 40
        round is round + 1
    return 0

# args for a call, each emitted per its param type (buffer var name | numeric)
define emit_args(node, fname, nm, bt) as:
    local arg is unwrap of node[2]
    if g_funcs[fname] == null:
        # null["ptypes"] is silently null and null ptypes emit every arg
        # numeric — a silent wrong-emission generator. Loud beats silent.
        throw of ("AOT: emit_args on non-user function '" + fname + "' (builtin calls take the boxed path)")
    local ptypes is (g_funcs[fname])["ptypes"]
    local elems is []
    if arg[0] == "null":
        elems is []
    elif (arg[0] == "list") and ((len of arg) == 3):
        # #355: parenthesized literal list — ONE argument, never spread.
        elems is [arg]
    elif arg[0] == "list":
        # #405 (v0.27.0): a bare literal list is ALWAYS the argument list, at
        # every count — `f of [x]` is one arg (the element), so it is now
        # in-envelope for the AOT (the old whole-list binding threw here).
        elems is arg[1]
    else:
        elems is [arg]
    # (round 118, #181) the VM's arity rule, MEASURED (the critic's
    # p40_vm_rule): a 1-param callee re-collects a bare literal list WHOLE at
    # every count other than one -- `g of []` binds [] and `g of [a, b]`
    # binds [a, b] (EigenScript#733); a 2+-param callee given `[]` binds
    # every parameter null; `f of null` binds null; more args than a
    # 2+-param callee takes raises "call passes N arguments but the callee
    # takes M". The old block said "the VM binds null" for `g of []` and
    # "the VM drops extras" for the overflow -- both false, the #181 class.
    local lit_list is 0
    if (arg[0] == "list") and ((len of arg) == 2):
        lit_list is 1
    local dead is 0
    if ((g_funcs[fname])["nullok"]) == 1:
        dead is 1
    if (len of ptypes) == 1:
        if lit_list == 1:
            if (len of elems) != 1:
                # the single parameter holds the LIST (or [] at count 0)
                if dead == 1:
                    # the parameter is never read: any incoming value matches
                    return ["", "0"]
                throw of ("AOT: call to '" + fname + "' passes a " + (str of (len of elems)) + "-element literal list to its single parameter -- the VM re-collects the list WHOLE into that parameter (EigenScript#733: [] at count 0, [a, b] at count 2), and the parameter's C class was inferred from its body, so the call-site pack is not emitted yet (ouroboros#181). Parenthesize the list to pass it as one argument on both sides, or give the callee the parameters it reads.")
    if (len of elems) == 0:
        # `f of null` (or `[]` to a 2+-param callee): the incoming value is
        # null on every parameter. Dead parameters take a dummy 0 (#69);
        # otherwise the body would read 0 where the VM reads null.
        if dead == 1:
            return ["", "0"]
        if lit_list == 1:
            throw of ("AOT: zero-arg call to '" + fname + "' with `[]` -- the VM binds every one of its " + (str of (len of ptypes)) + " parameters null, and the callee reads them (no C equivalent for a null in a typed parameter); only a dead single parameter takes the dummy path (#69).")
        throw of ("AOT: zero-arg call to '" + fname + "' -- the VM binds its parameter null, and the callee reads it (no C equivalent for a null in a typed parameter); only a dead single parameter takes the dummy path (#69).")
    if (len of elems) > (len of ptypes):
        throw of ("AOT: call to '" + fname + "' passes " + (str of (len of elems)) + " arguments but the callee takes " + (str of (len of ptypes)) + " -- the VM raises exactly that at run time (EigenScript#733 arity rule; ouroboros#181); refused at build time instead.")
    # (round 89) per-arg strings, then SEQUENCING under hazard: bare C
    # argument lists evaluate in unspecified order, and gcc ran a sibling
    # argument's outward-rebinding call BEFORE a global read (VM 105, AOT
    # 1005) and two call arguments right-to-left (VM 12, AOT 21) -- the
    # round-88 setter defect, two sites over. When any argument contains
    # a call and there are two or more arguments, each is hoisted into a
    # typed temp in the VM's left-to-right push order inside a statement
    # expression (callers compose the prelude).
    local argl is []
    for k in range of (len of elems):
        local s is ""
        if (ptypes[k]) == "buf":
            # a buffer arg is a Value*: a plain ident -> its C name; a
            # buffer-returning call (e.g. `seed_blinker of W`) -> emit the call.
            local be is unwrap of elems[k]
            if be[0] == "ident":
                # a buffer C var by name; a generic param holding a buffer at
                # runtime is ALSO a C Value* (not in the env — the env read
                # would silently fetch null); a boxed Value that holds a buffer
                # at runtime (e.g. an env-stored list element) is read from the
                # env.
                if (bt[be[1]] == 1) or (g_genp[be[1]] == 1):
                    s is s + (cn of be[1])
                else:
                    s is s + (env_readb of be[1])
            elif be[0] == "call":
                s is s + (emit_call_num of [be, nm, bt])
            elif be[0] == "str":
                # a string literal to a buf-class param is the checksum
                # `_blen of "abc"` shape — the class is a string/buffer
                # union of C Value*s, and a boxed literal satisfies it.
                # Owned-and-leaked like the gen-param literal case below
                # (the callee can't tell owned from borrowed; one-shot).
                s is s + (emit_val of [elems[k], nm, bt])
            elif be[0] == "num":
                # a NUMBER to a buf param is a genuine misread — loud.
                throw of ("AOT: '" + fname + "' expects a buffer/string argument, got a num literal")
            else:
                s is s + (emit_val of [elems[k], nm, bt])
        elif ((ptypes[k]) == "tensor") or ((ptypes[k]) == "dict") or ((ptypes[k]) == "gen"):
            # pass the tensor/dict/generic Value BORROWED (callee doesn't consume
            # it): an ident reads the env without an incref (no per-call leak in
            # the hot path); a non-ident arg falls back to an owned emit_val
            # (leaked — the callee can't tell owned from borrowed; a literal to
            # a Value* param is rare and the process is one-shot).
            local te is unwrap of elems[k]
            if te[0] == "ident":
                # a buffer/dict/generic param or buffer C global is a Value* by
                # name (NOT in the env — the env read would silently fetch
                # null); otherwise read the env BORROWED.
                if (bt[te[1]] == 1) or (g_dict[te[1]] == 1) or (g_genp[te[1]] == 1):
                    s is s + (cn of te[1])
                elif (nm[te[1]] == 1) and (g_observed == 0):
                    # A NUMERIC C variable is not in the env either -- the same
                    # hazard the line above names for buffers, one type over.
                    #
                    # THE g_observed GUARD IS LOAD-BEARING and was missing when
                    # this arm was written. `nm[x] == 1` means "inferred
                    # numeric", NOT "is a live C double": under g_observed
                    # numeric names live in the ENV (aot_observe_num), which is
                    # the invariant emit_num states on its own ident arm and
                    # which the module decl loop enforces by emitting no
                    # `static double` at all. Asserting the opposite produced a
                    # SILENT WRONG VALUE -- a frame local declared `double
                    # eig_m = 0` and never written, so the call passed
                    # make_num(0):
                    #
                    #   VM  hi / 0 / 42 / ...     AOT  hi / 0 / 0 / ...
                    #   both rc 0, no diagnostic
                    #
                    # and at module scope, where no decl exists, a gcc error on
                    # an undeclared `eig_m`. Under g_observed the env read below
                    # is correct, because that is where the value actually is.
                    # Passing one to a boxed parameter emitted an env read for a
                    # name that only exists as a C double:
                    #
                    #   n is null / m is 21 / g of n / g of m
                    #   VM   null-arm / 42       AOT  ... then "undefined
                    #                                 variable 'm'", rc 1
                    #
                    # Only reachable once a parameter is boxed on evidence from
                    # ANOTHER call site, which is why it surfaced the moment
                    # `null` became boxed evidence: the two call sites disagree
                    # about the C type and the boxed one wins. Owned-and-leaked
                    # like the non-ident fallback below -- one-shot process.
                    s is s + "make_num(" + (cn of te[1]) + ")"
                elif g_func_names[te[1]] == 1:
                    # (round 99) a compiled function's NAME is not an env
                    # binding either -- the fifth "not in the env" regime,
                    # formalized in emit_val one screen away in round 98 and
                    # missing from this enumeration. The env read can only
                    # miss, so passing a function by name to a user function
                    # died "undefined variable 'g'" at runtime, after
                    # arbitrary stdout, on programs the VM runs. emit_val
                    # already emits the right thing (the per-function
                    # singleton).
                    s is s + (emit_val of [elems[k], nm, bt])
                else:
                    s is s + (env_readb of te[1])
            else:
                s is s + (emit_val of [elems[k], nm, bt])
        else:
            try:
                s is s + (emit_num of [elems[k], nm, bt, 0])
            catch e:
                throw of ("in call to '" + fname + "' arg " + (str of k) + ": " + e)
        argl is (append of [argl, s])
    # (round 121, #182) UNDER-applied by name: the VM binds null to every
    # unsupplied parameter (`two of [7]` -> b = null). A generic (Value*)
    # parameter takes make_null() -- null is a value it holds on the VM
    # too; a parameter the body never reads takes a dummy on either C
    # type (the #69 rule, per slot); a READ parameter of a typed class has
    # no C null, so the call is refused BY NAME instead of leaking gcc's
    # "too few arguments" to the user.
    if (len of elems) < (len of ptypes):
        local udead is (g_funcs[fname])["deadp"]
        local upn is (g_funcs[fname])["pnames"]
        for uk in range of (len of ptypes):
            if uk < (len of elems):
                continue
            local ucls is ptypes[uk]
            if ucls == "gen":
                argl is (append of [argl, "make_null()"])
            elif (udead != null) and (udead[uk] == 1):
                if ucls == "num":
                    argl is (append of [argl, "0"])
                elif ucls == "tensor":
                    argl is (append of [argl, "aot_tensor_null()"])
                else:
                    argl is (append of [argl, "make_null()"])
            else:
                throw of ("AOT: call to '" + fname + "' passes " + (str of (len of elems)) + " argument(s) but the callee takes " + (str of (len of ptypes)) + " -- the VM binds null to parameter '" + (str of (upn[uk])) + "' and the callee reads it, and its inferred C class (" + ucls + ") has no null; refused at build time (ouroboros#182). Pass the argument on both sides, or make the callee tolerate a missing one through a generic parameter.")
    local hazard is 0
    if (len of elems) >= 2:
        for hk in range of (len of elems):
            if (has_call_node of [elems[hk]]) == 1:
                hazard is 1
    if hazard == 0:
        local plain is ""
        for pk in range of (len of argl):
            if pk > 0:
                plain is plain + ", "
            plain is plain + (argl[pk])
        return ["", plain]
    local pre is ""
    local names is ""
    for qk in range of (len of argl):
        local qt is "Value*"
        if (ptypes[qk]) == "num":
            qt is "double"
        if (ptypes[qk]) == "tensor":
            qt is "AotTensor"
        pre is pre + qt + " _sqa" + (str of qk) + " = " + (argl[qk]) + "; "
        if qk > 0:
            names is names + ", "
        names is names + "_sqa" + (str of qk)
    return [pre, names]

define emit_call_num(node, nm, bt) as:
    local fcallee is unwrap of node[1]
    if fcallee[0] != "ident":
        throw of ("AOT: emit_call_num on a non-ident callee: " + (str of fcallee))
    local fname is fcallee[1]
    local ea4 is emit_args of [node, fname, nm, bt]
    if (ea4[0]) == "":
        return (cn of fname) + "(" + (ea4[1]) + ")"
    return "({ " + (ea4[0]) + (cn of fname) + "(" + (ea4[1]) + "); })"

# ---- --dump-inference support (#65 spec_audit) ----
# Walk a body recording each name's FIRST-assignment source line (from the
# frontend's _line wrappers) and the set of for-loop variables. Deterministic:
# pure AST order.
define dump_scan(node, cur, lines, forvars) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    local ln is cur
    if node[0] == "_line":
        ln is node[1]
        dump_scan of [node[2], ln, lines, forvars]
        return 0
    if node[0] == "assign":
        if lines[node[1]] == null:
            lines[node[1]] is ln
    if node[0] == "for":
        forvars[node[1]] is 1
        if lines[node[1]] == null:
            lines[node[1]] is ln
    for k in range of (len of node):
        dump_scan of [node[k], ln, lines, forvars]
    return 0

# Does this for-loop iterable provably yield NUMBERS every iteration?
# range (the builtin, not a user shadow) yields integers whatever its arg;
# a C buffer holds doubles; a literal list qualifies when every element is
# numeric (empty = zero iterations, trivially fine).
define iter_yields_nums(fiu, nmv, bt) as:
    if fiu[0] == "call":
        local callee is unwrap of fiu[1]
        if (callee[0] == "ident") and (callee[1] == "range"):
            if g_func_names["range"] != 1:
                return 1
        return 0
    if fiu[0] == "ident":
        if bt[fiu[1]] == 1:
            return 1
        return 0
    if fiu[0] == "list":
        local els is fiu[1]
        for k in range of (len of els):
            if (is_num_expr of [els[k], nmv, bt]) == 0:
                return 0
        return 1
    return 0

# Collect for-vars eligible for unboxing. acc[v]: 1 = every for-loop binding
# v so far is eligible; 0 = POISONED (any ineligible loop binding v keeps the
# name boxed everywhere — two loops sharing a name must agree on storage).
# strict=1 (module scope) requires the name never module-assigned (post-loop
# persistence of a pre-bound global through a loop-scoped binding is a
# semantics knot — skip it); function scope also accepts assigned-numeric.
define for_unbox_scan(node, ba, nmv, bt, acc, strict) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "func":
        return 0
    if node[0] == "for":
        local v is node[1]
        local ok is iter_yields_nums of [(unwrap of node[2]), nmv, bt]
        if (bt[v] == 1) or (g_dict[v] == 1) or (g_tensor[v] == 1) or (g_genp[v] == 1):
            ok is 0
        if ba[v] != null:
            if strict == 1:
                ok is 0
            elif nmv[v] != 1:
                ok is 0
        if ok == 0:
            acc[v] is 0
        elif acc[v] == null:
            acc[v] is 1
    for k in range of (len of node):
        for_unbox_scan of [node[k], ba, nmv, bt, acc, strict]
    return 0

# One dump record: D <scope> <role> <name> <kind> <line>
define dump_rec(scope, role, name, kind, ln) as:
    local l is ln
    if l == null:
        l is 0 - 1
    g_dump_out is g_dump_out + "D " + scope + " " + role + " " + name + " " + kind + " " + (str of l) + "\n"

# Collect names bound by a `local`-marked assign (4th element on the assign
# node, #99 item 2) anywhere in a subtree. Generic list walk (same shape as
# has_interrogate); strings/nums are skipped by the type check.
define collect_local_marked(node, acc) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "assign":
        if (len of node) >= 4:
            acc[node[1]] is 1
    for k in range of (len of node):
        collect_local_marked of [node[k], acc]
    return 0

# Collect names targeted by a PLAIN (unmarked) assign anywhere in a subtree —
# the round-6 companion of collect_local_marked, feeding the builtin-name
# clobber refusal in emit_function.
define collect_plain_assigns(node, acc) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "assign":
        if (len of node) == 3:
            acc[node[1]] is 1
    for k in range of (len of node):
        collect_plain_assigns of [node[k], acc]
    return 0

# ---- numeric `local` shadows of module globals (#109) ------------------
# A `local NAME` shadowing a NUMERIC module global compiles to a C local
# declared AT THE `local` STATEMENT'S SITE, so C block scoping reproduces
# the VM's chain-walk shadow semantics (oracle-probed at v0.39.0):
#   - reads/writes BEFORE the `local` line hit the module binding
#     (GET_NAME/SET_NAME find the module env — the frame binding does not
#     exist yet);
#   - from the `local` line on, every read/write in its scope hits the
#     shadow; the module binding is untouched;
#   - recursion gets a fresh shadow per call (C stack locals for free).
# What C block scope CANNOT reproduce, and sh_validate_block refuses:
#   - the VM shadow outliving its block (a `local` inside a loop/if is
#     still visible for the REST OF THE FUNCTION — probe: nested-in-loop
#     `local k`, read after the loop, VM answers the shadow, a C local
#     would answer the global);
#   - iteration carry (an occurrence before the decl inside the decl's
#     own loop reads the PREVIOUS iteration's shadow in the VM, the
#     global in C) — hence a nested decl must dominate every occurrence;
#   - a nested define/lambda reading the name (VM probe: the nested fn
#     sees the encloser's LIVE shadow; a lifted C fn would read the
#     file-scope global, and a capbind capture is a stale snapshot).

# Does `name` occur in `node` in ANY role — ident read, assign target,
# for-var, catch-var, or a capbind capture (a lifted nested define that
# referenced it)? Over-counting is safe (refusal); under-counting is the
# silent-wrong class.
define sh_touches(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if (node[0] == "ident") and (node[1] == name):
        return 1
    if (node[0] == "assign") and (node[1] == name):
        return 1
    if (node[0] == "for") and (node[1] == name):
        return 1
    if (node[0] == "try") and (node[2] == name):
        return 1
    if node[0] == "capbind":
        local cps is node[2]
        for c in range of (len of cps):
            if (cps[c])[0] == name:
                return 1
    for k in range of (len of node):
        if (sh_touches of [node[k], name]) == 1:
            return 1
    return 0

# Count `local NAME` decls (4th-element-marked assigns) in a subtree.
define sh_count_decls(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    local n is 0
    if (node[0] == "assign") and (node[1] == name):
        if (len of node) >= 4:
            n is 1
    for k in range of (len of node):
        n is n + (sh_count_decls of [node[k], name])
    return n

# Does a deferred-execution body (nested define pre-lift, lambda) reference
# the name? Its C emission cannot see a block-scoped shadow (and a capbind
# capture is a value snapshot, not the VM's live chain-walk read).
define sh_deferred_ref(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if (node[0] == "func") or (node[0] == "lambda") or (node[0] == "capbind"):
        return sh_touches of [node, name]
    for k in range of (len of node):
        if (sh_deferred_ref of [node[k], name]) == 1:
            return 1
    return 0

# Does `name` appear as a BINDER — a for-var, catch-var, or comprehension
# var — anywhere in the subtree? A binder is not a chain-walk write: the VM
# loop-scopes a for-var over a name-bound shadow (oracle probe: `local n is
# 55` then `for n in range of 3` prints 0/1/2 then 55 — the shadow keeps
# 55), while the emitter's C name would be written through. Role-based, not
# envelope-based: catch/listcomp are checked even where today's AOT refuses
# them for other reasons, so this guard cannot rot if that envelope grows.
define sh_binds(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if (node[0] == "for") and (node[1] == name):
        return 1
    if (node[0] == "try") and (node[2] == name):
        return 1
    if (node[0] == "listcomp") and (node[2] == name):
        return 1
    for k in range of (len of node):
        if (sh_binds of [node[k], name]) == 1:
            return 1
    return 0

# Validate one block for the decl-at-site emission. Returns:
#   0 — invalid (refuse the shadow);
#   2 — valid, no occurrence before the decl;
#   3 — valid, occurrences before the decl exist (depth-0 only: they read
#       the file-scope global, so the name must NOT be int-typed — the
#       global's C storage class is the MODULE scope's, not this body's).
# depth0=1 only for the function body itself: there a pre-decl occurrence
# runs exactly once, before the binding exists on every path (no enclosing
# loop can re-enter), so the C global read matches the VM's chain walk.
define sh_validate_block(stmts, name, depth0) as:
    local state is 0
    local had_pre is 0
    for i in range of (len of stmts):
        local st is unwrap of stmts[i]
        if state == 2:
            # the decl's block closed (nested container) — the VM shadow
            # would still be visible here, a C block-scope local is not.
            if (sh_touches of [st, name]) == 1:
                return 0
        elif state == 1:
            # decl live at this level: occurrences fine; a SECOND decl of
            # the same name is refused by the caller's count==1 check.
            state is 1
        elif ((type of st) == "list") and ((len of st) > 0) and (st[0] == "assign") and (st[1] == name) and ((len of st) >= 4):
            # the decl itself at this level. A self-referencing RHS
            # (`local n is n + 1`) reads the global — correct only when
            # this line runs at most once before binding, i.e. depth 0.
            if depth0 == 0:
                if (sh_touches of [st[2], name]) == 1:
                    return 0
            state is 1
        elif (sh_count_decls of [st, name]) > 0:
            # decl nested inside a container statement
            if (sh_container_ok of [st, name]) == 0:
                return 0
            state is 2
        elif (sh_touches of [st, name]) == 1:
            if depth0 == 0:
                return 0
            had_pre is 1
    if state == 0:
        return 0
    if had_pre == 1:
        return 3
    return 2

# The decl sits inside `st` (an if/loop/for/try/unobserved). Its
# condition/iterable/catch-name must not touch the name (they execute
# outside the C scope; under iteration the VM would already see the
# shadow), sibling sub-blocks must not touch it, and the sub-block holding
# the decl must itself validate (recursively, depth0=0).
define sh_container_ok(st, name) as:
    local t is st[0]
    if t == "if":
        if (sh_touches of [st[1], name]) == 1:
            return 0
        local tc is sh_count_decls of [st[2], name]
        local ec is sh_count_decls of [st[3], name]
        if (tc > 0) and (ec > 0):
            return 0
        if tc > 0:
            if (sh_touches of [st[3], name]) == 1:
                return 0
            if (sh_validate_block of [st[2], name, 0]) == 0:
                return 0
            return 1
        if (sh_touches of [st[2], name]) == 1:
            return 0
        if (sh_validate_block of [st[3], name, 0]) == 0:
            return 0
        return 1
    if t == "loop":
        if (sh_touches of [st[1], name]) == 1:
            return 0
        if (sh_validate_block of [st[2], name, 0]) == 0:
            return 0
        return 1
    if t == "for":
        if st[1] == name:
            return 0
        if (sh_touches of [st[2], name]) == 1:
            return 0
        if (sh_validate_block of [st[3], name, 0]) == 0:
            return 0
        return 1
    if t == "try":
        if st[2] == name:
            return 0
        local yc is sh_count_decls of [st[1], name]
        local cc is sh_count_decls of [st[3], name]
        if (yc > 0) and (cc > 0):
            return 0
        if yc > 0:
            if (sh_touches of [st[3], name]) == 1:
                return 0
            if (sh_validate_block of [st[1], name, 0]) == 0:
                return 0
            return 1
        if (sh_touches of [st[1], name]) == 1:
            return 0
        if (sh_validate_block of [st[3], name, 0]) == 0:
            return 0
        return 1
    if t == "unobserved":
        if (sh_validate_block of [st[1], name, 0]) == 0:
            return 0
        return 1
    # unknown container kind: refuse rather than guess.
    return 0

# Is `name` bound to a genuine BUILTIN in the runtime's global env? Cached
# type-of-eval probe (same mechanism as codegen.eigs's cg_is_builtin): only a
# real builtin answers type "builtin" — this compiler's own module functions
# are "function", and an unbound name throws into the catch.
AOT_BUILTIN_NAMES is {}
define aot_is_builtin_name(name) as:
    if has_key of [AOT_BUILTIN_NAMES, name]:
        return AOT_BUILTIN_NAMES[name]
    local r is 0
    try:
        if (type of (eval of name)) == "builtin":
            r is 1
    catch _aot_ib_err:
        r is 0
    AOT_BUILTIN_NAMES[name] is r
    return r

define emit_function(fn, finfo, gnm, gbt) as:
    local name is fn[1]
    G_CUR_FN[0] is name
    local params is fn[2]
    local body is fn[3]
    # Per-function observation: a function is observed/traced by ITS OWN body, so
    # a function that doesn't observe emits UNBOXED (params/locals as C doubles),
    # even inside an observed program. Saved/restored around the body emit.
    local _save_obs is g_observed
    local _save_tr is g_traced
    local _save_otr is g_obs_traced
    local _save_ret is g_ret_type
    g_ret_type is finfo["ret"]
    g_traced is g_prog_traced
    g_cur_params is {}
    for cp in range of (len of (fn[2])):
        g_cur_params[((fn[2])[cp])] is 1
    # The interrogated-name set is PER-SCOPE, measured after a round shipped it
    # program-wide: a never-called ghost function interrogating `p` was
    # loop-scoping every other function's `p` binder (VM 8, AOT 1, silent) --
    # the VM's rule keys on interrogates in the SAME function. Rebuilt here
    # from this function's own body; emit_program restores the module set.
    g_interrogated_names is {}
    collect_interrogated of [body, g_interrogated_names]
    g_obs_traced is has_obs_interrogate of body
    g_observed is 0
    if (uses_observer of body) == 1:
        g_observed is 1
    if g_obs_traced == 1:
        g_observed is 1
    # (round 63) outward-observe set is per-function; the decl loop below
    # repopulates it for this function's accepted outward writes.
    g_outward_obs is {}
    # Part 2a routes an observed/temporal function's locals through the GLOBAL
    # env, which is correct only when such functions don't nest. Fail loudly
    # rather than silently miscompile the nested case (the per-call env, Part 2b,
    # is what lifts this).
    if (g_observed == 1) or (g_traced == 1):
        if (calls_observed of body) == 1:
            throw of ("AOT: observed/temporal function '" + name + "' calls another observed/temporal function — needs a per-call env (Part 2b), not yet supported")
    local ptypes is finfo["ptypes"]
    local fnm is {}
    local fbt is {}
    # seed with module globals so functions can read them (file-scope in C);
    # params/locals shadow same-named globals below.
    #
    # (round 108, #189) NOT in an observed program. There, module numerics
    # are env-boxed and observed with NO file-scope C global (the module
    # decl loop is gated g_observed == 0), so seeding them here made every
    # read in a non-observing function a raw `eig_v` reference to a name
    # that does not exist -- gcc 'eig_shared' undeclared, no AOT: line, on
    # a six-line program (`shared is 7 / define f() as: return shared + 1 /
    # b is 1 / rr is report of b / print of (f of null)`). Round 63 named
    # the WRITE half of this and refused it; this is the read half it
    # called "a residual". Unseeded, the ident arm reads the env by name
    # (env_read_num -> aot_get_num_named_ic), which is where the observed
    # store put the value. An observed function (g_observed == 1) keeps
    # the seed: Part 2a already routes its reads through the env.
    local gn is keys of gnm
    for k in range of (len of gn):
        if gnm[gn[k]] == 1:
            if (g_mod_observed == 1) and (g_observed == 0):
                fnm[gn[k]] is 0
            else:
                fnm[gn[k]] is 1
    local gb is keys of gbt
    for k in range of (len of gb):
        if gbt[gb[k]] == 1:
            fbt[gb[k]] is 1
    # `local NAME is e` (#99 item 2, narrowed by #109, widened by #86):
    # a `local` shadowing a NUMERIC module global compiles to a C local
    # declared at the `local` statement's site; one shadowing a BOXED
    # module global (gnm key present, value 0) becomes a per-call-env
    # binding with runtime chain dispatch (F-OURO-35) — both validated
    # below, after inference (see the sh_* walkers). A BUFFER global stays
    # a loud refusal: it is a file-scope Value* C variable, invisible to
    # the env chain (#100/#107). A `local` of a non-global
    # name is a function local either way and falls through to the ordinary
    # assign path; a `local` of a PARAM name rebinds the param (the VM's
    # existing-slot-wins arbitration — the C param already shadows the
    # file-scope var, so the plain emission is already exact).
    # A PARAM that shadows a module global is refused too, but ONLY when this
    # function is observed or traced (ouroboros#123).
    #
    # The comment above is right on the unobserved path — the C param shadows
    # the file-scope var and the plain emission is exact. Under g_observed it
    # is false: Part 2a keys the param into __eigs_g BY NAME (aot_set below,
    # and aot_observe_num on every assignment), so the callee's `a` IS the
    # module's `a` and writing it clobbers the caller's binding. Measured:
    # `define work(a)` with a module-level `a is 5.0` printed a.val=5 in the
    # VM and a.val=129.746 from the AOT, both exiting 0 — the silent-wrong
    # class, reachable with `report` alone and invisible to all 97 fixtures.
    #
    # `local a` one branch down has been a loud refusal all along; this is the
    # same collision reached through the parameter list, so it gets the same
    # answer. The validated population was derived from one syntactic marker
    # (`local`) rather than from "names Part 2a keys into the global env",
    # which is why the parameter form fell out of it.
    # GATED ON THE SEEDING CONDITION ITSELF, not on a syntactic marker. Part 2a
    # seeds `if g_observed == 1:` and `if (ptypes[k]) == "num":` (see the
    # aot_set loop below) — so those are the two tests, read off the mechanism
    # rather than approximated.
    #
    # The first version of this guard used `func_observed of fn` and every
    # param, and was wrong in BOTH directions. Too wide: a STRING param
    # shadowing a module string is never seeded (it stays a plain C Value*),
    # yet was refused — a program the VM runs and the AOT previously compiled
    # byte-exact. `func_observed` is uses_observer OR has_interrogate, while
    # the seeding gates on g_observed (uses_observer OR has_obs_interrogate),
    # so a `prev of`-only function was refused with nothing seeded in it at
    # all. That is the same error this guard exists to fix — a population
    # derived from a marker instead of from the mechanism — committed one
    # level up while fixing an instance of it.
    # PARTIAL BY DESIGN, and this says so rather than reading as a closure.
    # It covers the PARAMETER shape of ouroboros#123. It does NOT cover the
    # sibling shape in #124: under g_observed every plain function-local
    # numeric assign is keyed into __eigs_g too, so a local leaks into module
    # scope and stays readable after the call — `converged of t` then answers
    # 0 about a binding the VM says does not exist. A refusal covering that
    # would reject essentially every observed function with a local variable,
    # so the class closes at Part 2b (the per-call env named at the aot_set
    # loop below), not here.
    if g_observed == 1:
        for p2 in range of (len of params):
            if (ptypes[p2]) == "num":
                local _pn is params[p2]
                if gnm[_pn] != null:
                    throw of ("AOT: numeric parameter `" + _pn + "` shadows a module binding in an observed function — Part 2a keys it into the global env BY NAME (aot_set below), so the call silently overwrites the caller's `" + _pn + "` (ouroboros#123). Rename the parameter.")
                if gbt[_pn] == 1:
                    throw of ("AOT: numeric parameter `" + _pn + "` shadows a module BUFFER binding in an observed function (ouroboros#123)")

    local _lmk is {}
    collect_local_marked of [body, _lmk]
    g_cur_localmarked is _lmk
    g_cur_interrogated is {}
    collect_interrogated of [body, g_cur_interrogated]
    # (round 64) the never-bound set for the function-scope `prev of` guard:
    # everything THIS function could possibly bind. Conservative-inclusive
    # (conditional assigns and binders count as bound), so the guard only
    # fires for names bound NOWHERE -- where the VM always raises.
    g_cur_bound is {}
    for cbp in range of (len of params):
        g_cur_bound[(params[cbp])] is 1
    local _cba is collect_assigns of [body, {}]
    local _cbk is keys of _cba
    for cbi in range of (len of _cbk):
        g_cur_bound[(_cbk[cbi])] is 1
    local _clk is keys of _lmk
    for cbl in range of (len of _clk):
        g_cur_bound[(_clk[cbl])] is 1
    # non-binder snapshot BEFORE binders join (round 65: binder-only names
    # are dead outside their loop; `prev of` there must raise like the VM)
    g_cur_bound_nb is {}
    local _cnbk is keys of g_cur_bound
    for cnb in range of (len of _cnbk):
        g_cur_bound_nb[(_cnbk[cnb])] is 1
    collect_for_binders of [body, g_cur_bound]
    # (round 117/119) every non-parameter LOCAL gets a per-call boundness
    # bit. Round 117 exempted locals with a top-level-statement assign as
    # "plainly bound" -- but function scope has no order guard, so a plain
    # `local r is 3` AFTER a `prev of r` left the read unbound (t226: the VM
    # dies, the exempted local answered). The bit costs one int and one
    # store per binding site and only `prev of` checks it.
    g_cur_bound_bit is {}
    local _cbparam is {}
    for _cbp in range of (len of params):
        _cbparam[(params[_cbp])] is 1
    local _cbk is keys of g_cur_bound_nb
    for _cbi in range of (len of _cbk):
        local _cbn is _cbk[_cbi]
        if (_cbparam[_cbn] != 1) and (g_module_names[_cbn] != 1):
            g_cur_bound_bit[_cbn] is 1
    local _lmn is keys of _lmk
    local _shcand is []
    local _bshcand is []
    for k in range of (len of _lmn):
        local _shp is 0
        for p in range of (len of params):
            if params[p] == _lmn[k]:
                _shp is 1
        if _shp == 0:
            if gbt[_lmn[k]] == 1:
                throw of ("AOT: `local " + _lmn[k] + "` shadowing a module BUFFER binding is not supported (the global is a file-scope C variable, invisible to the env chain)")
            if gnm[_lmn[k]] != null:
                if gnm[_lmn[k]] != 1:
                    # BOXED module global (string/list/dict/null-valued):
                    # per-call-env shadow with runtime chain dispatch (#86,
                    # F-OURO-35) — validated below, after inference.
                    append of [_bshcand, _lmn[k]]
                else:
                    append of [_shcand, _lmn[k]]
    # Round 6 (#99): a PLAIN function-body write to a BUILTIN name clobbers
    # the runtime's global binding under VM semantics (the in_globals veto in
    # emit_assign_for_tos makes it slot-ineligible -> OP_SET_NAME); the AOT's
    # plain-assign path would make it a C local instead — a silent wrong
    # value. Refuse loudly. A `local <builtin>` shadow (marked assign, and
    # its follow-up plain writes land on the shadow), a PARAM named after a
    # builtin (slot wins), and builtin READS all keep working.
    local _pas is {}
    collect_plain_assigns of [body, _pas]
    local _pan is keys of _pas
    for k in range of (len of _pan):
        if (aot_is_builtin_name of _pan[k]) == 1:
            if (_lmk[_pan[k]] != 1):
                local _isp is 0
                for p in range of (len of params):
                    if params[p] == _pan[k]:
                        _isp is 1
                if _isp == 0:
                    throw of ("AOT: `" + _pan[k] + " is ...` inside a function writes the GLOBAL builtin binding (VM semantics); the AOT has no global-clobber path — use `local " + _pan[k] + " is ...` for a function-local")
    # tensor (nested-list) layer for this scope: tensor locals (assigned from a
    # tensor RHS) + tensor/dict params.
    g_dict is {}
    g_genp is {}
    g_tensor is infer_tensors of body
    for k in range of (len of params):
        if (ptypes[k]) == "buf":
            fbt[params[k]] is 1
            fnm[params[k]] is 0
        elif (ptypes[k]) == "dict":
            g_dict[params[k]] is 1
            fbt[params[k]] is 0
            fnm[params[k]] is 0
        elif (ptypes[k]) == "gen":
            g_genp[params[k]] is 1
            fbt[params[k]] is 0
            fnm[params[k]] is 0
        elif (ptypes[k]) == "tensor":
            g_tensor[params[k]] is 1
            fbt[params[k]] is 0
            fnm[params[k]] is 0
        else:
            fnm[params[k]] is 1
            fbt[params[k]] is 0
    # local buffers created in the body
    local lb is infer_buffers of body
    local lbn is keys of lb
    for k in range of (len of lbn):
        fbt[lbn[k]] is 1
        fnm[lbn[k]] is 0
    local ba is collect_assigns of [body, {}]
    local banames is keys of ba
    # Names a local SHADOWS away from a same-named global buffer -> must be
    # DECLARED locally (not skipped as the global) in the decl loop.
    local shadowed is {}
    for k in range of (len of banames):
        local bav is banames[k]
        # A local assigned in the body SHADOWS a same-named global: if it isn't a
        # function-local buffer (lb) or a buffer param, clear any global-buffer
        # seed so it's classified from the function's own body (e.g. step's
        # numeric `rr` shadowing a buffer global `rr` in the caller's scope).
        if (lb[bav] != 1):
            local isbufparam is 0
            for p in range of (len of params):
                if (params[p] == bav) and ((ptypes[p]) == "buf"):
                    isbufparam is 1
            if isbufparam == 0:
                if gbt[bav] == 1:
                    shadowed[bav] is 1
                fbt[bav] is 0
    # Classify locals numeric via SEEDED inference: globals + numeric params (in
    # fnm) are the seed; a local is numeric iff every assignment is numeric. This
    # correctly demotes boxed values, `len of <list>`, and value-returning calls.
    local lnm is infer_numeric_seeded of [body, fbt, fnm]
    local lnk is keys of lnm
    for k in range of (len of lnk):
        if (lnm[lnk[k]] == 1) and (fbt[lnk[k]] != 1) and (g_tensor[lnk[k]] != 1):
            # ...but NEVER re-promote a parameter whose ptype is boxed. The
            # seeded inference classifies from body assignments alone, so a
            # gen/Value* param that the body increments (`idx is idx + 1`)
            # came back "numeric" and this merge overwrote the ptype's 0 --
            # the signature said `Value* eig_idx` while every body emission
            # said double, and gcc rejected the C. That is the CLAUDE.md
            # hazard verbatim: declared type and emission must share one
            # inference, and this line was where they stopped sharing. It is
            # also what broke DMG's BUILD while the census said "yes" -- the
            # census transpiles, its own header warns it does not compile.
            if (g_module_names[lnk[k]] == 1) and (gnm[lnk[k]] != 1) and (gbt[lnk[k]] != 1) and (g_tensor[lnk[k]] != 1) and (_lmk[lnk[k]] != 1):
                # same rule as the decl loop below: a DEMOTED module binding
                # written outward must not be numeric-promoted from its own
                # body assignments, or the emission writes a C variable that
                # was (correctly) never declared
                continue
            local lparam_boxed is 0
            for lpk in range of (len of params):
                if (params[lpk]) == lnk[k]:
                    if (ptypes[lpk]) != "num":
