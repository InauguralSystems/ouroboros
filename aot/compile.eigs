        local dfv is {}
        dump_scan of [body, 0 - 1, dl, dfv]
        for k in range of (len of params):
            local dpk is ptypes[k]
            local dkind is dpk
            if dpk == "buf":
                dkind is "buffer"
            elif dpk == "num":
                dkind is "double"
                if g_observed == 1:
                    dkind is "observed-env"
                elif g_int[params[k]] == 1:
                    dkind is "long"
            dump_rec of [name, "param", params[k], dkind, dl[params[k]]]
        for k in range of (len of banames):
            local dv is banames[k]
            local disp is 0
            for p in range of (len of params):
                if params[p] == dv:
                    disp is 1
            if ((gnm[dv] == 1) or (gbt[dv] == 1)) and (shadowed[dv] != 1):
                disp is 1
            if disp == 0:
                local lkind is "boxed-env"
                if g_boxshadow[dv] == 1:
                    lkind is "boxed-shadow"
                elif g_tensor[dv] == 1:
                    lkind is "tensor"
                elif fbt[dv] == 1:
                    lkind is "buffer"
                elif fnm[dv] == 1:
                    lkind is "double"
                    if g_observed == 1:
                        lkind is "observed-env"
                    elif g_int[dv] == 1:
                        lkind is "long"
                dump_rec of [name, "local", dv, lkind, dl[dv]]
        local dfvn is keys of dfv
