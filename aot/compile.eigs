                # named_ic env read), so there the C-var write is a DEAD STORE
                # and the terminal env arm below is the correct one. The first
                # version of this arm fired in both regimes and regressed an
                # observed program its parent compiled byte-exact (VM 8,
                # AOT 1) -- the same storage-mismatch class, mirrored.
                fo is fo + ind + "    " + (cn of fvar) + " = aot_num_ck_at(aot_iter_get(" + itv + ", " + kv + "), \"" + (c_escape of (G_CUR_FN[0])) + ": for-in " + (c_escape of fvar) + "\");\n"
                if g_traced == 1:
                    fo is fo + ind + "    aot_trace_assign(\"" + fvar + "\", " + (cn of fvar) + ");\n"
            elif (lscope == 0) and (nm[fvar] == 1) and (g_observed == 0):
