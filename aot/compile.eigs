        if callee[0] != "ident":
            # A callee that is an EXPRESSION, not a name (#140): `m.fn of x`,
            # `table[i] of x`. This is the module pattern — `import x` binds a
            # dict of functions — so refusing it made every stdlib-using
            # program un-compilable. Evaluate the callee and dispatch at
            # runtime; the argument convention is the builtin one (#405: a
            # bare 1-element literal list passes its element RAW), because a
            # dynamically-resolved callee has no statically known signature.
            local vcarg is unwrap of node[2]
            # (round 95) the CALLEE is evaluated before the argument -- the
            # last row of the target-vs-sibling axis. An expression callee
            # beside an argument whose call rebinds it dispatched to the
            # NEW binding (VM 6, AOT 105, rc 0 both).
            if (vcarg[0] == "list") and ((len of vcarg) == 2) and ((len of vcarg[1]) == 1):
                if (has_call_node of (vcarg[1])[0]) == 1:
                    return "({ Value* _sqcf = " + (emit_val of [node[1], nm, bt]) + "; Value* _sqca = " + (emit_val of [(vcarg[1])[0], nm, bt]) + "; aot_call_value(_sqcf, _sqca); })"
                return "aot_call_value(" + (emit_val of [node[1], nm, bt]) + ", " + (emit_val of [(vcarg[1])[0], nm, bt]) + ")"
            if (has_call_node of node[2]) == 1:
                return "({ Value* _sqcf = " + (emit_val of [node[1], nm, bt]) + "; Value* _sqca = " + (emit_val of [node[2], nm, bt]) + "; aot_call_value(_sqcf, _sqca); })"
            return "aot_call_value(" + (emit_val of [node[1], nm, bt]) + ", " + (emit_val of [node[2], nm, bt]) + ")"
        # `report of x` -> the most-specific predicate of x's observed slot.
        # (round 70) third arg = compiled-fn flag: a never-bound name must
        # RAISE like the VM (the helper's first version answered
        # "equilibrium" on any env miss), while a compiled function is
        # env-unbound here yet bound in the VM, whose unobserved slot
        # legitimately reports "equilibrium".
        # (round 109) ... and its three siblings. compiler.c special-cases
        # all FOUR observer forms on an ident argument (observe / report /
        # report_value / trajectory -> slot-reading opcodes); only `report`
        # was mirrored. `observe of x` fell to builtin_observe -- the
        # NO-BINDING fallback, a constant ["equilibrium", 0, 0, 0] -- and
        # report_value/trajectory are opcodes only, not builtins, so they
        # died "undefined variable" at runtime after partial output. A
        # non-ident argument falls through to the ordinary call in both
        # worlds. Band: 1 = compiled function (the #708 opaque answer;
        # round 70's "equilibrium" for it was stale against the pin),
        # 2 = C-emitted value class (round 87's unobserved-binding guess).
        if (callee[1] == "report") or (callee[1] == "report_value") or (callee[1] == "trajectory") or (callee[1] == "observe"):
            local ra is unwrap of node[2]
            if ra[0] == "ident":
                local rfn is "0"
                if g_func_names[(ra[1])] == 1:
                    rfn is "1"
                elif (((bt[(ra[1])] == 1) or (g_btmap[(ra[1])] == 1)) and (g_cur_params[(ra[1])] == 1)) or (g_dict[(ra[1])] == 1) or (g_tensor[(ra[1])] == 1):
                    # (round 110) an ASSIGNED buffer is env-stored now (bt
                    # assign arm); only a buffer PARAM keeps band 2.
                    rfn is "2"
                local rhelper is "aot_report"
                if callee[1] == "report_value":
                    rhelper is "aot_report_value"
                elif callee[1] == "trajectory":
                    rhelper is "aot_trajectory"
                elif callee[1] == "observe":
                    rhelper is "aot_observe_of"
                return rhelper + "(__eigs_g, \"" + ra[1] + "\", " + rfn + ")"
        # user function returning a Value* (e.g. a tensor-returning forward pass)
        # -> direct native C call.
        if g_funcs[callee[1]] != null:
            if (g_funcs[callee[1]])["ret"] == "Value*":
                # cn, not the raw name — see the void-call site: two of these
                # emitted the UNMANGLED name while the definition was mangled,
                # which only surfaced once `import` brought in a module
                # defining `div` (#121).
                local ea1 is emit_args of [node, callee[1], nm, bt]
                if (ea1[0]) == "":
                    return (cn of callee[1]) + "(" + (ea1[1]) + ")"
                return "({ " + (ea1[0]) + (cn of callee[1]) + "(" + (ea1[1]) + "); })"
            if (g_funcs[callee[1]])["ret"] == "void":
                # A function with NO return statement is emitted as a C `void`
                # function (func_ret_type), so it has no value form — and this
                # site used to fall through to the BUILTIN path below, which
                # resolves the name dynamically out of the env. A user function
                # is a `static` C function and is never in the env, so the
                # lookup always failed:
                #
                #   define shout(m) as: print of m
                #   y is (shout of "x")
                #   VM   prints x, y is null, rc 0
                #   AOT  aot: undefined function 'shout', rc 1
                #
                # The VM's rule is that a function that falls off its end
                # yields null, so the call still happens and answers null. The
                # statement-context call site already special-cases void; only
                # the value-context one was missing it. Three shapes were
                # affected — this in an assignment, in a `return`, and in a
                # top-level `return` — which is why it survived: none of them
                # is the common `shout of "x"` statement form, which compiles
                # to a direct C call and was always right.
                #
                # The wrapper generator solves the identical problem the same
                # way: `{ wcall; return make_null(); }`.
                local ea2 is emit_args of [node, callee[1], nm, bt]
                return "({ " + (ea2[0]) + (cn of callee[1]) + "(" + (ea2[1]) + "); make_null(); })"
        # Builtin calls mirror the VM's arg packing (one call rule, #405): a
        # bare literal list IS the argument list — 1 element passes that
        # element RAW (`buf_from_list of [[bytes]]` hands the builtin the
        # inner list, not a 1-wrapper); 0 or >1 elements pass a list, which
        # the literal emit below already matches (the VM packs multi-args
        # back into a list for builtins). A paren-marked list (3-slot node,
        # #355) is itself the single argument.
        local barg is unwrap of node[2]
        # `dispatch of [table, key, ctx]` with a bare 3-element literal list:
        # emit the stack-vector form, which avoids a make_list plus a boxed
        # key on a path DMG executes once per emulated instruction (#130).
        if (callee[1] == "dispatch") and (barg[0] == "list") and ((len of barg) == 2) and ((len of barg[1]) == 3):
            if (is_num_expr of [(barg[1])[1], nm, bt]) == 1:
                return seq_call3 of ["aot_dispatch", [[(emit_val of [(barg[1])[0], nm, bt]), (has_call_node of (barg[1])[0])], [(emit_num of [(barg[1])[1], nm, bt, 0]), (has_call_node of (barg[1])[1])], [(emit_val of [(barg[1])[2], nm, bt]), (has_call_node of (barg[1])[2])]], ["Value*", "double", "Value*"]]
        # (round 71) calling a name that is an UNBOXED C numeric: the env has
        # no binding (the value lives in a C double/long), so the helper's
        # env miss claimed "undefined function 'x'" -- a FALSE reason for a
        # defined variable (the VM says "cannot call num"). The class is
        # known statically; emit the VM's raise at the call's reachability
        # (a dead-branch call stays rc 0, exactly as the VM's would).
        if ((nm[(callee[1])] == 1) or (g_int[(callee[1])] == 1)) and (g_func_names[(callee[1])] != 1):
            # (round 100) The #168 arm that used to live here is GONE, and
            # round 99 is why. It said a called param's numeric class was an
            # inference DEFAULT rather than evidence -- true then, because
            # passing `f` made the param numeric and the VM ran the program.
            # Round 99 made a function argument produce a "gen" param and
            # round 100 gave that param a dispatching call site, so the
            # premise is retired: a numeric-classified param can no longer
            # HOLD a function. A caller passing one through a numerically
            # typed channel dies at the CALLER's own unbox ("non-numeric
            # value in a numeric context ... (type builtin)") and never
            # enters the callee -- measured, not argued. So a numeric class
            # here is real evidence, the param genuinely holds a number, and
            # the VM's own "cannot call num" is the honest message.
            # Divergence -> match. This closes ouroboros#168's second half.
            return "({ rt_error(EK_TYPE, g_trace_current_line, \"cannot call num\"); make_null(); })"
        # (round 98) a callee held in a LOWERED LOCAL is a C slot, NOT an env
        # binding: `local w is g / return (w of 4)` bound __lv_eig_w and then
        # resolved "w" through the env, dying "undefined variable 'w'" rc 1
        # on a program the VM runs (5). Invariant 14 -- the binding lives in
        # the lowered-local regime and the call site consulted the env one.
        # Read the slot and dispatch on the value.
        if (g_lowerloc == 1) and (g_envloc[(callee[1])] == 1) and (g_funcs[(callee[1])] == null):
            # the slot read is a BORROW and aot_call_value CONSUMES its
            # callee -- without the incref the first call frees the slot's
            # value and the second iteration dies "cannot call ?". The
            # hoist also keeps the round-95 order: callee, then argument.
            local lvcarg is unwrap of node[2]
            if (lvcarg[0] == "list") and ((len of lvcarg) == 2) and ((len of lvcarg[1]) == 1):
                return "({ Value* _lvf = " + (env_readb of callee[1]) + "; val_incref(_lvf); Value* _lva = " + (emit_val of [(lvcarg[1])[0], nm, bt]) + "; aot_call_value(_lvf, _lva); })"
            return "({ Value* _lvf = " + (env_readb of callee[1]) + "; val_incref(_lvf); Value* _lva = " + (emit_val of [node[2], nm, bt]) + "; aot_call_value(_lvf, _lva); })"
        # (round 100) a callee held in a GENERIC PARAMETER is a C slot too --
        # the same regime error as the lowered local above, one class over,
        # and the one the callback convention is actually WRITTEN in:
        # `define map(items, fn) as: ... fn of items[i]`. Round 99 made
        # arg_class type such a param "gen", so the caller now passes the
        # function correctly into `Value* eig_fn` -- and the callee then
        # resolved "fn" through the GLOBAL env, dying "undefined variable
        # 'fn'" rc 1 on a program the VM runs, naming a parameter that is
        # sitting in a live slot two inches away.
        #
        # Landing round 99's half also silently DELETED the honest
        # diagnostic that had covered this: while the param was numeric it
        # hit the #168 arm above and died "higher-order parameter 'fn' is
        # not yet typed". Typing it correctly routed it out of the true
        # message and into the false one, and no fixture pinned the true
        # one. This closes #168's second half -- call-position dispatch on
        # the param -- so the arm above is now unreachable for gen params.
        #
        # Callee first, then the argument (round 95), and the slot read is a
        # BORROW that aot_call_dispatch consumes (round 98's incref).
        if g_genp[(callee[1])] == 1:
            if (barg[0] == "list") and ((len of barg) == 2) and ((len of barg[1]) == 1):
                return "({ Value* _gpf = " + (cn of callee[1]) + "; val_incref(_gpf); Value* _gpa = " + (emit_val of [(barg[1])[0], nm, bt]) + "; aot_call_dispatch(_gpf, _gpa); })"
            return "({ Value* _gpf = " + (cn of callee[1]) + "; val_incref(_gpf); Value* _gpa = " + (emit_val of [node[2], nm, bt]) + "; aot_call_dispatch(_gpf, _gpa); })"
        if (barg[0] == "list") and ((len of barg) == 2) and ((len of barg[1]) == 1):
            local hc1 is ic_cache of 0
            # (round 96) UNCONDITIONAL. Round 95 gated the split on the
            # argument containing a call, but the VM loads the callee
            # first ALWAYS, and an argument with no call can still raise:
            # `nosuch of alsonosuch` reported the ARGUMENT's undefined
            # name, and `nosuch of lst[7]` reported an out-of-range index,
            # where the VM names the callee. Same stdout and rc, wrong
            # message -- and the _err tier compares message text.
            return "({ " + hc1[0] + "Value* _sqcf = aot_call_resolve(__eigs_g, \"" + callee[1] + "\", " + hc1[1] + "); Value* _sqca = " + (emit_val of [(barg[1])[0], nm, bt]) + "; aot_call_dispatch(_sqcf, _sqca); })"
        local hc2 is ic_cache of 0
        return "({ " + hc2[0] + "Value* _sqcf = aot_call_resolve(__eigs_g, \"" + callee[1] + "\", " + hc2[1] + "); Value* _sqca = " + (emit_val of [node[2], nm, bt]) + "; aot_call_dispatch(_sqcf, _sqca); })"
    throw of ("AOT: cannot emit value node '" + t + "'")

# Render a tensor-valued expression as a C `AotTensor` expr. Producers (matmul/
# add/relu/field) are wrapped in aot_treg so the per-call frame pool frees them;
# a tensor ident is just its C name.
define emit_tensor(node, nm, bt) as:
    local n is unwrap of node
    local t is n[0]
    if t == "ident":
        # (round 126, #184) only a tensor-classified name is a C AotTensor;
        # any other name (a buffer, a boxed list, a generic param holding
        # a nested list) is a Value* and converts at the operand -- the
        # bare C name was emitted whatever the storage class and gcc's
        # type error leaked, or a dead `double` decl was picked up.
        if g_tensor[n[1]] == 1:
            return cn of n[1]
        # owned emit: aot_tensor_from_value VIEWS a buffer's data, so the
        # Value must outlive the tensor -- an owned, never-freed temp does
        # (one-shot process; the same trade the gen-param literal makes).
        return "aot_treg(aot_tensor_from_value(" + (emit_val of [node, nm, bt]) + "))"
    if t == "dot":
        local tgt is unwrap of n[1]
        local dval is ""
        if (tgt[0] == "ident") and (g_dict[tgt[1]] == 1):
            dval is cn of tgt[1]
        else:
            dval is emit_val of [n[1], nm, bt]
        return "aot_treg(aot_tensor_field(" + dval + ", \"" + (c_escape of n[2]) + "\"))"
    if t == "call":
        local callee is unwrap of n[1]
        local fnname is callee[1]
        local arg is unwrap of n[2]
        local elems is []
        if arg[0] == "list":
            elems is arg[1]
        else:
            elems is [arg]
        if fnname == "matmul":
            return "aot_treg(aot_tensor_matmul(" + (emit_tensor of [elems[0], nm, bt]) + ", " + (emit_tensor of [elems[1], nm, bt]) + "))"
        if fnname == "add":
            return "aot_treg(aot_tensor_add(" + (emit_tensor of [elems[0], nm, bt]) + ", " + (emit_tensor of [elems[1], nm, bt]) + "))"
        if fnname == "relu":
            # (round 126) relu takes ONE parameter, so a bare literal list
            # of any count but one is re-collected WHOLE into it (the
            # arity-1 rule, EigenScript#733): `relu of [[0 - 1, 2], [3,
            # 0 - 4]]` is the matrix, not its first row. Measured: taking
            # elems[0] printed [0, 2] where the VM prints [[0, 2], [3, 0]].
            local rop is elems[0]
            if (arg[0] == "list") and ((len of elems) != 1):
                rop is arg
            return "aot_treg(aot_tensor_relu(" + (emit_tensor of [rop, nm, bt]) + "))"
    if t == "list":
        # (round 126, #184) a LITERAL nested list as a tensor operand
        # (`matmul of [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]`): build the
        # Value and convert, as the ident arm does for a non-tensor name.
        return "aot_treg(aot_tensor_from_value(" + (emit_val of [node, nm, bt]) + "))"
    throw of ("AOT: cannot emit tensor node '" + t + "'")

# `<expr> OP <numeric>` / `<numeric> OP <expr>` for a comparison, with the
# numeric side emitted as a C double instead of a boxed literal (#130). DMG's
# loop is full of `cpu.halted == 1`; the boxed rendering cost a make_num for
# the literal and another for the result, per conditional. Returns "" when the
# node is not a one-sided-numeric comparison (both sides numeric is already
# handled by the fully numeric path; neither side is the general boxed path).
CMP_OPS is {"==": 1, "!=": 1, "<": 1, ">": 1, "<=": 1, ">=": 1}
CMPN_R is {"==": "aot_eq_n", "!=": "aot_ne_n", "<": "aot_lt_n", ">": "aot_gt_n", "<=": "aot_le_n", ">=": "aot_ge_n"}
CMPN_L is {"==": "aot_eq_n", "!=": "aot_ne_n", "<": "aot_lt_nl", ">": "aot_gt_nl", "<=": "aot_le_nl", ">=": "aot_ge_nl"}
CMPNB_R is {"==": "aot_eq_nb_t", "!=": "aot_ne_nb_t", "<": "aot_lt_nb_t", ">": "aot_gt_nb_t", "<=": "aot_le_nb_t", ">=": "aot_ge_nb_t"}
CMPNB_L is {"==": "aot_eq_nb_t", "!=": "aot_ne_nb_t", "<": "aot_lt_nlb_t", ">": "aot_gt_nlb_t", "<=": "aot_le_nlb_t", ">=": "aot_ge_nlb_t"}

# `<cvar>.field` where <cvar> is a C Value* name (a dict/buffer/generic local
# or parameter, never a temporary) -> a BORROWED read: no ref is taken on the
# target and none on the result. Returns "" when the shape does not apply.
# A plain C Value* name (dict/buffer/generic local or parameter) is live for
# the whole statement, so a helper reading a field of it need not take a ref on
# it. Returns the C name, or "" when the target is a temporary and must be
# handed an owned ref as before (#130).
define borrowable_cvar(node, nm, bt) as:
    local n is unwrap of node
    if n[0] != "ident":
        return ""
    if bt[n[1]] == 1:
        return cn of n[1]
    if g_dict[n[1]] == 1:
        return cn of n[1]
    if g_genp[n[1]] == 1:
        return cn of n[1]
    return ""

define emit_borrow_dot(node, nm, bt) as:
    local n is unwrap of node
    if n[0] != "dot":
        return ""
    local cv is borrowable_cvar of [n[1], nm, bt]
    if cv == "":
        return ""
    local ic is ic_new of n[2]
    return "({ " + ic[0] + "aot_dot_borrow_ic(" + cv + ", \"" + (c_escape of n[2]) + "\", " + ic[1] + "); })"
define emit_cmp_n(node, nm, bt, want_bool) as:
    local n is unwrap of node
    if n[0] != "binop":
        return ""
    if CMP_OPS[n[1]] != 1:
        return ""
    local lnum is is_num_expr of [n[2], nm, bt]
    local rnum is is_num_expr of [n[3], nm, bt]
    if lnum == rnum:
        return ""
    local fn is ""
    local boxed is ""
    local num is ""
    if rnum == 1:
        fn is CMPN_R[n[1]]
        boxed is emit_val of [n[2], nm, bt]
        num is emit_num of [n[3], nm, bt, 0]
    else:
        fn is CMPN_L[n[1]]
        boxed is emit_val of [n[3], nm, bt]
        num is emit_num of [n[2], nm, bt, 0]
    if want_bool == 1:
        # condition position: if the boxed side is a field of a C variable,
        # borrow it and do no refcount work at all.
        local bexpr is ""
        if rnum == 1:
            bexpr is emit_val_borrow of [n[2], nm, bt, n[3]]
        else:
            bexpr is emit_val_borrow of [n[3], nm, bt, n[2]]
        if bexpr != "":
            local bfn is ""
            if rnum == 1:
                bfn is CMPNB_R[n[1]]
            else:
                bfn is CMPNB_L[n[1]]
            # borrow only exists when the sibling cannot call, so bare
            # arguments are order-safe here.
            return bfn + "(" + bexpr + ", " + num + ")"
        # (round 90) SEQUENCE under call-hazard, in SOURCE order: this fast
        # path's early return sat ABOVE the round-89 binop guard, so
        # `(f of 1) == (g of 1)` with one numeric side ran g-then-f under
        # this gcc (VM c=12, AOT c=3, both rc 0). The helper's operand
        # slots are (boxed, num) regardless of which was LEFT in source,
        # so the temps hoist in source order and the call uses the temps.
        if ((has_call_node of n[2]) == 1) or ((has_call_node of n[3]) == 1):
            if rnum == 1:
                return "({ Value* _sqcb = " + boxed + "; double _sqcn = " + num + "; " + fn + "_t(_sqcb, _sqcn); })"
            return "({ double _sqcn = " + num + "; Value* _sqcb = " + boxed + "; " + fn + "_t(_sqcb, _sqcn); })"
        return fn + "_t(" + boxed + ", " + num + ")"
    # (round 90) same sequencing for the value-position form.
    if ((has_call_node of n[2]) == 1) or ((has_call_node of n[3]) == 1):
        if rnum == 1:
            return "({ Value* _sqcb = " + boxed + "; double _sqcn = " + num + "; " + fn + "(_sqcb, _sqcn); })"
        return "({ double _sqcn = " + num + "; Value* _sqcb = " + boxed + "; " + fn + "(_sqcb, _sqcn); })"
    return fn + "(" + boxed + ", " + num + ")"

# Does this expression contain a CALL? A borrowed container is only safe while
# nothing can replace the slot holding it, and a call is the only thing in an
# operand position that could. C argument evaluation order is unspecified, so
# the sibling operand is checked, not assumed (#130).
define expr_has_call(node) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        return 1
    for k in range of (len of node):
        if (expr_has_call of node[k]) == 1:
            return 1
    return 0

# A BORROWED C expression for `node`, or "" when it cannot be borrowed: a plain
# C Value* variable, or a field of one. `sibling` is the expression evaluated
# alongside it; if that can call, the borrow is refused.
define emit_val_borrow(node, nm, bt, sibling) as:
    if (expr_has_call of sibling) == 1:
        return ""
    local cv is borrowable_cvar of [node, nm, bt]
    if cv != "":
        return cv
    return emit_borrow_dot of [node, nm, bt]

define emit_cond(node, nm, bt) as:
    if (is_num_expr of [node, nm, bt]) == 1:
        return "(" + (emit_num of [node, nm, bt, 0]) + " != 0.0)"
    local cn1 is emit_cmp_n of [node, nm, bt, 1]
    if cn1 != "":
        return cn1
    return "aot_truthy(" + (emit_val of [node, nm, bt]) + ")"

# One return statement, honoring the per-call env (#100 item 2): when the
# function owns an __eigs_l, every return path frees it AFTER the return value
# is computed into a temp (the value expression may read __eigs_l) and BEFORE
# control leaves. `pre` carries any extra pre-return cleanup (the tensor
# frame-pool release).
define emit_return(ctype, expr, ind, pre) as:
    if (g_envactive == 0) and (pre == ""):
        return ind + "return " + expr + ";\n"
    local s is ind + "{ " + ctype + " _rv = " + expr + ";"
    if pre != "":
        s is s + " " + pre
    if g_lowerloc == 1:
        # #132: the frame env was lowered to C slots — release each one on
        # this return path, in place of the single env_decref.
        local rlvn is keys of g_envloc
        for rk in range of (len of rlvn):
            s is s + " slot_decref(" + (lv of (rlvn[rk])) + ");"
    elif g_envactive == 1:
        s is s + " env_decref(__eigs_l);"
    return s + " return _rv; }\n"

define emit_stmts(stmts, ind, nm, bt, minits, gf) as:
    local out is ""
    for i in range of (len of stmts):
        out is out + (emit_stmt of [stmts[i], ind, nm, bt, minits, gf])
    return out

define emit_stmt(node, ind, nm, bt, minits, gf) as:
    local t is node[0]
    if t == "_line":
        # stamp the current source line for the trace tape (mirrors OP_LINE), so
        # `what is x at L` history entries get the right line.
        if g_traced == 1:
            return ind + "g_trace_current_line = " + (str of node[1]) + ";\n" + (emit_stmt of [node[2], ind, nm, bt, minits, gf])
        return emit_stmt of [node[2], ind, nm, bt, minits, gf]
    if t == "assign":
        local name is node[1]
        if g_genp[name] == 1:
            # A generic param is a C Value* var. Unobserved: rebind the C var
            # directly — every read of a genp uses the C name (emit_args,
            # emit_val), so the update is seen (#86: `line is trim of line`
            # in EigenMiniSat's DIMACS parser). Observed programs env-box
            # reads, where a C-var write WOULD go stale — still refused.
            if g_observed == 1:
                throw of ("AOT: rebinding generic parameter '" + name + "' in an observed program is not supported (env-boxed reads would see the stale incoming value)")
            # cn of name, NOT the raw name. The parameter is declared
            # `Value* eig_x` in the signature and this line wrote `x`:
            #
            #   define f(x) as: if (type of x) == "str": x is "z" / print of x
            #   VM  z / 0, rc 0      AOT  gcc "'x' undeclared", NO BINARY
            #
            # which is the exact shape the comment above says this arm exists to
            # support (#86's `line is trim of line`). Introduced when `cn`
            # mangled only a C-keyword allowlist, so it was correct then; #121
            # turned `cn` into prefix-everything and its commit message claimed
            # the prefix "turned latent bugs LOUD: SIX more emission sites were
            # still writing the raw name" and that the name class was CLOSED. A
            # seventh survived, because six were found by running the corpus and
            # nothing in the corpus rebinds a type-dispatched parameter.
            #
            # NO ENUMERATION CLAIM HERE, deliberately. Three consecutive
            # versions of one were written at this spot and all three were
            # false, each caught by the next review's single grep:
            #
            #   "the only site emitting a name in C IDENTIFIER position"
            #     -- the `for` arm builds "_it_"/"_n_"/"_k_" + fvar too
            #   "the only site emitting an identifier it does not also declare"
            #     -- line ~2017 (added by the commit that wrote this) emits
            #        `cn of fvar` for a genp, declared by the signature
            #
            # The pattern is the point: a summary of "where else could this be
            # wrong" is a claim about code nobody re-derived, and it decays into
            # false reassurance faster than the code decays. The fixture is the
            # durable half; if the class needs to be re-checked, re-run the
            # grep, do not read a sentence about it.
            return ind + (cn of name) + " = " + (emit_val of [node[2], nm, bt]) + ";\n"
        if g_boxshadow[name] == 1:
            # boxed module-shadow (#86, F-OURO-35): the `local` decl binds
            # the per-call frame env; a plain write goes wherever the VM's
            # chain walk says — the shadow if the decl has executed in this
            # call, the module binding otherwise (aot_set_sh dispatches on
            # binding presence). The RHS is evaluated BEFORE the set either
            # way (C argument order), so a self-referencing decl RHS reads
            # the pre-binding chain — module global on first execution, the
            # previous iteration's shadow under iteration carry — exactly
            # like the VM.
            if (len of node) >= 4:
                if (g_lowerloc == 1) and (g_envloc[name] == 1):
                    return ind + "aot_lv_set(&" + (lv of name) + ", " + (emit_val of [node[2], nm, bt]) + ");\n"
                local dc is ic_cache of 0
                return ind + "{ " + dc[0] + "aot_set_ic(__eigs_l, \"" + name + "\", " + dc[1] + ", " + (emit_val of [node[2], nm, bt]) + "); }\n"
            if (is_num_expr of [node[2], nm, bt]) == 1:
                return ind + (env_write_num of [name, (emit_num of [node[2], nm, bt, 0])]) + "\n"
            return ind + "aot_set_sh(__eigs_l, __eigs_g, \"" + name + "\", " + (emit_val of [node[2], nm, bt]) + ");\n"
        if g_tensor[name] == 1:
            return ind + (cn of name) + " = " + (emit_tensor of [node[2], nm, bt]) + ";\n"
        if bt[name] == 1:
            local cc is unwrap of node[2]
            # (round 110) In an OBSERVED scope the VM observes a buffer
            # assignment like any other -- a populated slot at the first
            # `b is buffer of 4` (entropy of the contents), stable/moving on
            # rebind, and the #711 query view sees element writes through the
            # binding. The C static has no env slot, so every observer
            # surface answered the no-binding constant (round 87's "band 2"
            # guess: VM ["stable", 3.17, ...] / AOT ["equilibrium", 0, 0, 0],
            # `diverging of c` VM 1 / AOT 0, all rc 0). So the store ALSO
            # goes into the env through the observe-store, with the SAME
            # pointer (the env takes its own ref; element writes through the
            # C static are visible at query time), and buffer names take the
            # env lookup in the observer arms instead of band 2.
            local bobs is ""
            if (g_observed == 1) or (g_outward_obs[name] == 1):
                bobs is ind + "val_incref(" + (cn of name) + "); aot_observe_val(" + (envc of name) + ", \"" + name + "\", " + (cn of name) + ");\n"
            if (is_buf_create of node[2]) == 1:
                # `buffer of [r, c]` -> a shaped 2-D buffer; pass the list Value.
                local barg is unwrap of cc[2]
                if barg[0] == "list":
                    return ind + (cn of name) + " = aot_call_name(__eigs_g, \"" + (unwrap of cc[1])[1] + "\", " + (emit_val of [cc[2], nm, bt]) + ");\n" + bobs
                return ind + (cn of name) + " = aot_call_name(__eigs_g, \"" + (unwrap of cc[1])[1] + "\", make_num(" + (emit_num of [cc[2], nm, bt, 0]) + "));\n" + bobs
            # buffer var assigned from a call: a USER function goes through
            # the typed C call; a BUILTIN callee (e.g. trim/substr on a
            # string riding the buf class) must NOT — g_funcs[builtin] is
            # null and null ptypes silently emitted every arg numeric
            # (found compiling EigenMiniSat's _is_int_token, #86). Builtin
            # and non-ident callees take the boxed emit_val path instead.
            local rcallee is unwrap of cc[1]
            if (rcallee[0] == "ident") and (g_funcs[rcallee[1]] != null):
                return ind + (cn of name) + " = " + (emit_call_num of [node[2], nm, bt]) + ";\n" + bobs
            return ind + (cn of name) + " = " + (emit_val of [node[2], nm, bt]) + ";\n" + bobs
        if nm[name] == 1:
            # observed program: numeric assign goes through the runtime observer
            # (store in env + update the slot's entropy/dH + set last-observer).
            if g_observed == 1:
                local orhs is emit_num of [node[2], nm, bt, 0]
                local oa is ""
                # trace entry FIRST (creates the history slot), then observe --
                # so aot_observe_num's trace_record_obs stamps THIS entry's
                # entropy/dH for `where/why/how is x at L`.
                if (traced_name of name) == 1:
                    oa is oa + ind + "aot_trace_assign(\"" + name + "\", " + orhs + ");\n"
                oa is oa + ind + "aot_observe_num(__eigs_g, \"" + name + "\", " + orhs + ");\n"
                return oa
            local raw is 0
            if gf[name] == 1:
                raw is 1
            if ((len of node) >= 4) and (g_locshadow[name] == 1):
                # #109: a validated numeric module-shadow `local` declares a
                # fresh C local HERE — C block scoping from this point on is
                # exactly the VM's chain-walk shadow (reads/writes before
                # this line resolved to the file-scope global above).
                local sty is "double"
                if g_int[name] == 1:
                    sty is "long"
                local srhs is emit_num of [node[2], nm, bt, raw]
                if (uses_ident of [node[2], name]) == 1:
                    # self-referencing RHS (`local n is n + 1`): in C the
                    # declared name is in scope in its own initializer, but
                    # the VM evaluates the RHS BEFORE binding (it reads the
                    # module global) — stage through a temp declared first,
                    # so the RHS still resolves to the file-scope var.
                    G_SH_N[0] is G_SH_N[0] + 1
                    local stn is "__aot_sh" + (str of (G_SH_N[0]))
                    local _lbset is ""
                    if g_cur_bound_bit[name] == 1:
                        _lbset is ind + (cn of name) + "_b = 1;\n"
                    return ind + sty + " " + stn + " = " + srhs + ";\n" + ind + sty + " " + (cn of name) + " = " + stn + ";\n" + _lbset
                if g_cur_bound_bit[name] == 1:
                    # (round 119) a `local` declaration is a binding too
                    return ind + sty + " " + (cn of name) + " = " + srhs + ";\n" + ind + (cn of name) + "_b = 1;\n"
                return ind + sty + " " + (cn of name) + " = " + srhs + ";\n"
            local asn is ind + (cn of name) + " = " + (emit_num of [node[2], nm, bt, raw]) + ";\n"
            if (bound_bit_of of [name, nm]) == 1:
                asn is asn + ind + (cn of name) + "_b = 1;\n"
            # temporal: record the new value on the trace tape (prev / at-line)
            if (traced_name of name) == 1:
                asn is asn + ind + "aot_trace_assign(\"" + name + "\", " + (cn of name) + ");\n"
            return asn
        if (is_num_expr of [node[2], nm, bt]) == 1:
            if (g_observed == 1) or (g_outward_obs[name] == 1):
                # a numeric RHS to a DEMOTED name (nm[name] != 1, e.g. after a
                # module-dict call elsewhere demoted it) still must observe --
                # this arm was the third unobserved store in the same family,
                # found by reading the emitted C: `a is 100.0` went through
                # aot_set_num_ic while the later boxed assigns observed, so the
                # window was short one entry.
                local o3 is ""
                if (traced_name of name) == 1:
                    o3 is o3 + ind + "aot_trace_assign(\"" + name + "\", " + (emit_num of [node[2], nm, bt, 0]) + ");\n"
                o3 is o3 + ind + "aot_observe_num(__eigs_g, \"" + name + "\", " + (emit_num of [node[2], nm, bt, 0]) + ");\n"
                return o3
            if (traced_name of name) == 1:
                # traced but UNOBSERVED: the numeric store to a demoted name
                # still records on the tape (staged through a temp so the RHS
                # is emitted once)
                return ind + "{ double __tv = " + (emit_num of [node[2], nm, bt, 0]) + "; aot_trace_assign(\"" + name + "\", __tv); " + (env_write_num of [name, "__tv"]) + " }\n"
            return ind + (env_write_num of [name, (emit_num of [node[2], nm, bt, 0])]) + "\n"
        if (g_lowerloc == 1) and (g_envloc[name] == 1):
            # No traced arm here, ON PURPOSE. One was added and reviewed dead:
            # g_envloc is populated only when g_traced == 0 and g_observed == 0,
            # so g_lowerloc && g_traced is contradictory and the arm could never
            # execute. A traced program's locals stay env-resident, and traced
            # boxed stores go through the terminal arm below.
            return ind + "aot_lv_set(&" + (lv of name) + ", " + (emit_val of [node[2], nm, bt]) + ");\n"
        if (g_observed == 1) or (g_outward_obs[name] == 1):
            # A BOXED assign in an observed program must still observe. This
            # path is reached when a name is demoted off the numeric class --
            # (round 63: also when a NON-observing function's accepted
            # outward write targets an observed module name -- the write
            # lands in the name's regime, not the writer's; g_outward_obs
            # carries the decl loop's verdict to this arm.)
            # measured: `a is M.step of a` four times, then `diverging of a`:
            # VM 1, AOT 0, both rc 0, because aot_set_ic stored the value and
            # updated no slot, so every predicate answered from an empty
            # window. aot_observe_val is the boxed sibling of aot_observe_num,
            # built on the runtime's own observer_slot_update, so containers
            # walk entropy exactly as the VM does.
            local ova is ""
            if (traced_name of name) == 1:
                ova is ova + ind + "{ Value* __ov = " + (emit_val of [node[2], nm, bt]) + "; aot_trace_assign_val(\"" + name + "\", __ov); aot_observe_val(" + (envc of name) + ", \"" + name + "\", __ov); }\n"
                return ova
            return ind + "aot_observe_val(" + (envc of name) + ", \"" + name + "\", " + (emit_val of [node[2], nm, bt]) + ");\n"
        local wc is ic_cache of 0
        if (traced_name of name) == 1:
            # traced but UNOBSERVED boxed store. Round 36's fixture filled the
            # {temporal} x {boxed} x {OBSERVED} corner and its commit claimed
            # the intersection closed; the unobserved corner was still empty
            # and still broken -- a four-line program showed it:
            #
            #   s is "alpha" / s is "beta" / print of (prev of s)
            #   VM  alpha        AOT  null       both rc 0
            #
            # The boxed path had never traced at all; only the numeric path
            # carried aot_trace_assign. A claim that an intersection is closed
            # must name every axis it was closed along.
            return ind + "{ " + wc[0] + "Value* __tv = " + (emit_val of [node[2], nm, bt]) + "; aot_trace_assign_val(\"" + name + "\", __tv); aot_set_ic(" + (envc of name) + ", \"" + name + "\", " + wc[1] + ", __tv); }\n"
        return ind + "{ " + wc[0] + "aot_set_ic(" + (envc of name) + ", \"" + name + "\", " + wc[1] + ", " + (emit_val of [node[2], nm, bt]) + "); }\n"
    if t == "index_assign":
        # Compound form (`l[i] += e`, 5th elem = base op) is not lowered here
        # yet -- node[3] is the RAW rhs, so emitting it as a plain set would be
        # a silent wrong-value. Fail loudly instead.
        if (len of node) >= 5:
            throw of "AOT: compound index assignment not supported yet"
        local tgt is unwrap of node[1]
        if tgt[0] == "ident":
            if bt[tgt[1]] == 1:
                # (round 99) a provably non-numeric RHS into a buffer element
                # is refused BY NAME. The three paths used to speak in three
                # voices -- an internal "emit_num on non-numeric node str" at
                # module scope, a numeric-context death for an ident RHS, and
                # "buffer elements must be numbers" on the boxed path -- and
                # only the last named the construct. (The VM silently stores
                # 0.0 here while raising in every other numeric context; that
                # asymmetry is a fail-soft residual and is filed upstream, so
                # the AOT stays loud rather than learning to coerce.)
                if (is_num_expr of [node[3], nm, bt]) != 1:
                    local rhk is unwrap of node[3]
                    if (rhk[0] == "str") or (rhk[0] == "list") or (rhk[0] == "dict") or (rhk[0] == "null"):
                        throw of ("AOT: buffer elements must be numbers -- '" + (cn of tgt[1]) + "' is assigned a " + rhk[0] + " (the VM silently stores 0.0 here; see the upstream fail-soft ledger)")
                if (is_int_expr of node[2]) == 1:
                    # (round 91) index before value, VM order (the boxed
                    # twins got this in round 88; this arm did not).
                    if ((has_call_node of node[2]) == 1) or ((has_call_node of node[3]) == 1):
                        return ind + (seq_buftgt_i of ["aot_buf_set_i", (cn of tgt[1]), (emit_int of node[2]), (emit_num of [node[3], nm, bt, 0])]) + "\n"
                    return ind + "aot_buf_set_i(" + (cn of tgt[1]) + ", " + (emit_int of node[2]) + ", " + (emit_num of [node[3], nm, bt, 0]) + ");\n"
                if ((has_call_node of node[2]) == 1) or ((has_call_node of node[3]) == 1):
                    return ind + (seq_buftgt of ["aot_buf_set", (cn of tgt[1]), (emit_num of [node[2], nm, bt, 0]), (emit_num of [node[3], nm, bt, 0]), "double"]) + "\n"
                return ind + "aot_buf_set(" + (cn of tgt[1]) + ", " + (emit_num of [node[2], nm, bt, 0]) + ", " + (emit_num of [node[3], nm, bt, 0]) + ");\n"
        # general boxed index-assign (#86): list / dict / buffer target as a
        # Value* — aot_index_set mirrors OP_INDEX_SET and consumes/adopts.
        if (is_num_expr of [node[2], nm, bt]) == 1:
            local sib is emit_val_borrow of [node[1], nm, bt, [node[2], node[3]]]
            if sib != "":
                return ind + "{ double _sai = " + (emit_num of [node[2], nm, bt, 0]) + "; aot_index_set_ib(" + sib + ", _sai, " + (emit_val of [node[3], nm, bt]) + "); }\n"
            # (round 88) SEQUENCE the target before the rhs: C argument
            # order is unspecified, and gcc evaluated an outward-rebinding
            # rhs FIRST, so the setter wrote into the container the rebind
            # just installed where the VM writes into the OLD one it
            # pushed before the rhs (VM 100, AOT 7, both rc 0). Temps in
            # VM push order (target, index, value) make the order a
            # sequence point, not a compiler mood.
            return ind + "{ Value* _sat = " + (emit_val of [node[1], nm, bt]) + "; double _sai = " + (emit_num of [node[2], nm, bt, 0]) + "; aot_index_set_i(_sat, _sai, " + (emit_val of [node[3], nm, bt]) + "); }\n"
        return ind + "{ Value* _sat = " + (emit_val of [node[1], nm, bt]) + "; Value* _sai = " + (emit_val of [node[2], nm, bt]) + "; aot_index_set(_sat, _sai, " + (emit_val of [node[3], nm, bt]) + "); }\n"
    if t == "capbind":
        # (#86) bind a lifted nested-define's captures: alias each captured
        # Value into the env under its mangled name (emit_val increfs; the
        # lifted body reads it as an env global — same Value, so mutation
        # through the capture stays live, matching the VM's closure).
        local cbs is ""
        local cpairs is node[2]
        for ck in range of (len of cpairs):
            cbs is cbs + ind + "aot_set(__eigs_g, \"" + (cpairs[ck])[1] + "\", " + (emit_val of [["ident", (cpairs[ck])[0]], nm, bt]) + ");\n"
        return cbs
    if t == "dot_assign":
        # ["dot_assign", target, field, rhs] (#86). The frontend desugars
        # compound dot-assigns (d.f += e) into this node with a binop rhs,
        # so one case covers both. aot_dot_set consumes the owned target and
        # adopts the owned rhs, mirroring the VM's set-field semantics (null
        # target -> silent no-op; non-dict -> EK_TYPE).
        # Inline-cached (#130). A rhs the numeric inference can prove scalar
        # goes through the double-taking setter, which reuses the slot's
        # existing box instead of allocating and freeing one per write.
        # (round 88) the borrow is only sound when the rhs cannot CALL --
        # invariant 12, which index_assign's borrow already enforced via
        # emit_val_borrow while this arm called borrowable_cvar with no
        # sibling check: an outward-rebinding rhs frees the container
        # under the borrowed pointer. And the OWNED forms sequence the
        # target before the rhs (see the index_assign note: C argument
        # order is unspecified and gcc ran the rebinding rhs first,
        # writing into the new dict where the VM writes into the old).
        if (is_num_expr of [node[3], nm, bt]) == 1:
            local icn is ic_new of node[2]
            local scv is borrowable_cvar of [node[1], nm, bt]
            if (scv != "") and ((has_call_node of node[3]) == 0):
                return ind + "{ " + icn[0] + "aot_dot_set_num_tb_ic(" + scv + ", \"" + (c_escape of node[2]) + "\", " + (emit_num of [node[3], nm, bt, 0]) + ", " + icn[1] + "); }\n"
            return ind + "{ " + icn[0] + "Value* _sat = " + (emit_val of [node[1], nm, bt]) + "; aot_dot_set_num_ic(_sat, \"" + (c_escape of node[2]) + "\", " + (emit_num of [node[3], nm, bt, 0]) + ", " + icn[1] + "); }\n"
        local icg is ic_new of node[2]
        return ind + "{ " + icg[0] + "Value* _sat = " + (emit_val of [node[1], nm, bt]) + "; aot_dot_set_ic(_sat, \"" + (c_escape of node[2]) + "\", " + (emit_val of [node[3], nm, bt]) + ", " + icg[1] + "); }\n"
    if t == "call":
        local callee is unwrap of node[1]
        if callee[0] == "ident":
            if g_funcs[callee[1]] != null:
                if (g_funcs[callee[1]])["ret"] == "void":
                    # cn, not the raw name: a user function whose name collides
                    # with a C identifier is emitted mangled everywhere else, and
                    # this site would have called the unmangled one (#121).
                    local ea3 is emit_args of [node, callee[1], nm, bt]
                    return ind + "{ " + (ea3[0]) + (cn of callee[1]) + "(" + (ea3[1]) + "); }\n"
        return ind + "{ Value* _r = " + (emit_val of [node, nm, bt]) + "; if (_r) val_decref(_r); }\n"
    if t == "if":
        local s is ind + "if (" + (emit_cond of [node[1], nm, bt]) + ") {\n"
        s is s + (emit_stmts of [node[2], ind + "    ", nm, bt, minits, gf])
        s is s + ind + "}"
        if (len of node[3]) > 0:
            s is s + " else {\n" + (emit_stmts of [node[3], ind + "    ", nm, bt, minits, gf]) + ind + "}"
        return s + "\n"
    if t == "loop":
        # Observed programs: every loop carries the VM's per-iteration halting
        # (mirrors OP_LOOP_STALL_CHECK / OP_LOOP_CAP_CHECK). An observer-based
        # condition (contains a predicate) gets the stall check (can halt while
        # the predicate still holds); a plain condition gets the cap only. No
        # vectorization here — observed numerics are env-boxed.
        #
        # PLACEMENT IS LOAD-BEARING: the check goes AFTER the body, on the
        # back-edge, not between cond and body. compiler.c emits
        #     loop_start: cond; JUMP_IF_FALSE exit; body; POP;
        #                 LOOP_STALL_CHECK exit; JUMP loop_start
        # so the body runs one more time than a before-the-body check allows —
        # that was exactly the ouroboros#96 off-by-one (steps=99 vs the VM's
        # 100). Emitting it last also makes C's `continue` skip the check, which
        # is what the VM does too: its continue_target is loop_start, ahead of
        # the check.
        if g_observed == 1:
            local chk is "eigs_loop_cap_step(__eigs_g)"
            if (has_predicate of node[1]) == 1:
                chk is "eigs_loop_stall_step(__eigs_g)"
            local olg is loop_gf of [node, minits]
            local os is ind + "while (" + (emit_cond of [node[1], nm, bt]) + ") {\n"
            os is os + (emit_stmts of [node[2], ind + "    ", nm, bt, minits, olg])
            os is os + ind + "    if (" + chk + ") break;\n"
            return os + ind + "}\n"
        local vinfo is vec_loop of [node, nm, bt]
        if vinfo != null:
            return emit_vectorized of [node, vinfo, ind, nm, bt, minits]
        local mm is matmul_loop of [node, nm, bt]
        if mm != null:
            return emit_matmul of [mm, ind, nm, bt, minits]
        local rm is rowmap_loop of [node, nm, bt]
        if rm != null:
            return emit_rowmap of [rm, ind, nm, bt, minits]
        local ov is outvec_loop of [node, nm, bt]
        if ov != null:
            return emit_outvec of [ov, ind, nm, bt, 1, minits]
        local lg is loop_gf of [node, minits]
        local s is ind + "while (" + (emit_cond of [node[1], nm, bt]) + ") {\n"
        s is s + (emit_stmts of [node[2], ind + "    ", nm, bt, minits, lg])
        return s + ind + "}\n"
    if t == "return":
        if (G_CUR_FN[0]) == "<module>":
            # A `return` at the PROGRAM's top level ends the program with
            # exit 0 and DISCARDS the value. Emitting the function-return path
            # here made the discarded value the process exit status, and
            # skipped main's epilogue:
            #
            #   ... / if n == 2: return 42 / print of "unreachable"
            #   VM  exit 0        AOT  exit 42, stdout BYTE-IDENTICAL
            #
            # Found by the fixture written to assert this path was fine
            # (ouroboros#146). Nothing in the suite had a top-level `return`
            # at all, and stdout is identical, so only the exit-code half of
            # the parity contract could ever have caught it.
            #
            # The expression is still evaluated — `return (f of 1)` must run
            # `f` for its side effects — and then discarded. aot_shutdown is a
            # no-op today, but it is main's designated epilogue and a bare C
            # `return` jumped over it.
            local tdv is ""
            if (is_num_expr of [node[1], nm, bt]) == 1:
                tdv is emit_num of [node[1], nm, bt, 0]
            else:
                tdv is emit_val of [node[1], nm, bt]
            return ind + "{ (void)(" + tdv + "); aot_shutdown(__eigs_g); return 0; }\n"
        local rexpr is unwrap of node[1]
        if rexpr[0] == "ident":
            if bt[rexpr[1]] == 1:
                return emit_return of ["Value*", (cn of rexpr[1]), ind, ""]
            # tensor return: serialize to a Value, then free the frame pool.
            if g_tensor[rexpr[1]] == 1:
                return emit_return of ["Value*", "aot_tensor_to_value(" + (cn of rexpr[1]) + ")", ind, "aot_tframe_leave(_tmark);"]
        # numeric return -> a C double; anything else (list/str/dict/non-numeric)
        # is a boxed Value*. Coerce the emitted value to the function's declared
        # return type (g_ret_type) so the C is type-correct even when the body's
        # per-variable inference disagrees with func_ret_type — e.g. a numeric
        # expression returned from a Value* function boxes via make_num
        # (value-preserving, byte-exact).
        if (is_num_expr of [node[1], nm, bt]) == 1:
            local nv is emit_num of [node[1], nm, bt, 0]
            if g_ret_type == "Value*":
                return emit_return of ["Value*", "make_num(" + nv + ")", ind, ""]
            return emit_return of ["double", nv, ind, ""]
        local vv is emit_val of [node[1], nm, bt]
        if g_ret_type == "double":
            # The unbox here is CHECKED (#100 item 3): func_ret_type now
            # consults BOXED_RET_BUILTINS, so builtin-returning functions are
            # Value* and never reach this coercion — whatever still does while
            # the VM would return a non-number dies loudly, never aot_num's
            # silent 0 (`return trim of v` printed 0 where the VM prints the
            # string).
            return emit_return of ["double", "aot_num_ck_at(" + vv + ", \"" + (c_escape of (G_CUR_FN[0])) + ": return\")", ind, ""]
        return emit_return of ["Value*", vv, ind, ""]
    if t == "break":
        return ind + "break;\n"
    if t == "continue":
        return ind + "continue;\n"
    if t == "for":
