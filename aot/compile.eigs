# ---- nested `define` lifting (#86) ----
# The VM makes a closure; the AOT lambda-lifts: the nested fn becomes a
# top-level function whose captured names are rewritten to mangled ENV
# globals, bound at the definition site (["capbind", ...] statement). A
# Value-class capture aliases the same Value, so mutation stays live —
# matching the VM: mutation THROUGH a capture is seen (`box[0] is 9`; t110
# covers it). Rebinding the NAME is the broken case -- for every type, not just
# numerics -- and lift_nested_at refuses it.
#
# This sentence used to claim numeric captures "throw". They never did; no such
# throw was written. The commit that FIXED the bug quoted this very sentence as
# false in its own message, rewrote a different comment, and left this copy
# standing -- where t110, added by that same commit and containing a numeric
# capture that is never rebound and does not throw, falsified it on arrival.
# The nested fn's name stays callable (g_funcs) and usable
# as a VALUE argument (emit_val emits make_builtin of a boxed wrapper).
G_LIFT_N is [0]
G_CUR_FN is ["<module>"]
g_fn_as_value is {}

define rename_idents(node, rmap) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "ident":
        if rmap[node[1]] != null:
            node[1] is rmap[node[1]]
        return 0
    for k in range of (len of node):
        rename_idents of [node[k], rmap]
    return 0

# (round 112) Scope-aware sibling of rename_idents for a `for` BINDER: rename
# every use of `old` in the loop body EXCEPT inside a nested `for` that
# binds the same name (its body refers to the inner binder; its iterable
# is evaluated in the outer scope and IS renamed) and inside `func` nodes
# (hoisted; they never see the loop env). Used to express the VM's loop
# env in a name-keyed world: the binder becomes a fresh env name per loop.
define rename_binder_uses(node, old, new) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "ident":
        if node[1] == old:
            node[1] is new
        return 0
    if node[0] == "func":
        return 0
    if (node[0] == "for") and (node[1] == old):
        rename_binder_uses of [node[2], old, new]
        return 0
    # an ASSIGN target is a bare string, not an ident node -- the first
    # version renamed reads only, and the in-loop rebind still hit the
    # module name (t209: post-loop 11 for 0).
    if (node[0] == "assign") and (node[1] == old):
        node[1] is new
    for k in range of (len of node):
        rename_binder_uses of [node[k], old, new]
    return 0

# Does `node` read NAME through an observer surface -- one of the four
# special forms or a predicate with NAME as the operand? (round 112: the
# observer history of a module for binder inside its own loop depends on
# the loop-env tier the VM's compiler picks, EigenScript#1062, so the AOT
# refuses this shape rather than mirror a tier.)
define observes_name(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        local oc is unwrap of node[1]
        local oa is unwrap of node[2]
        if (oa[0] == "ident") and (oa[1] == name):
            if oc[0] == "predicate":
                return 1
            if oc[0] == "ident":
                if (oc[1] == "report") or (oc[1] == "report_value") or (oc[1] == "trajectory") or (oc[1] == "observe"):
                    return 1
    for k in range of (len of node):
        if (observes_name of [node[k], name]) == 1:
            return 1
    return 0

G_FORREN is [0]

# Lift every nested func in `node` (a stmt list or block), given the
# ENCLOSING function's bound-name dict. Appends lifted fns to out_funcs
# and replaces each define stmt with a capbind, in place.
# Names bound by a `for` binder anywhere in these statements. A binder is a
# rebind for capture purposes -- HEAD's own genp for-binder writes the C
# variable, which a snapshot capture never sees.
define collect_for_binders(node, out) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "for":
        out[node[1]] is 1
    for fk in range of (len of node):
        collect_for_binders of [node[fk], out]
    return 0

# (round 123, #194) A define inside a `for` body is loop-scoped on the VM:
# a reference to its name after the loop dies "undefined variable" (measured
# on the pin: `for x in [1,2,3]: define inner ...` then `inner of 100` after
# the loop, inside a function). A `loop while` body is NOT (measured: the
# same shape prints 136; the gate's sibling_block_rebind family defines
# inside `loop while` and calls after it, VM 8) -- the `for` binder's env
# is what scopes the definition. The lifted C function is module-wide, so
# such a reference would answer instead. Count the name's ident uses in the
# whole function body against those inside the loop node; any use outside
# refuses by name. Escaping through a VALUE (`g is inner` in the body, `g of
# 100` after) is not a name use and is emitted: the VM's closure reads the
# last binder (139).
# The enclosing function's OWN for binders: the generic collector descends
# into nested define bodies, and a nested define's own binder then read as
# an enclosing binding -- its plain `x is 7` refused as an outward mutation
# (gate: nested_forbinder_plain_is refused for the wrong reason). Stop at
# `func` nodes, as collect_assigns does for the bound-set.
define collect_for_binders_nofunc(node, out) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "func":
        return 0
    if node[0] == "for":
        out[node[1]] is 1
    for fk in range of (len of node):
        collect_for_binders_nofunc of [node[fk], out]
    return 0

define count_ident(node, name) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "ident":
        if node[1] == name:
            return 1
        return 0
    local c is 0
    for k in range of (len of node):
        c is c + (count_ident of [node[k], name])
    return c

define collect_nested_defs(node, acc) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "func":
        acc[node[1]] is 1
    for k in range of (len of node):
        collect_nested_defs of [node[k], acc]
    return 0

define loopdef_escape_check(node, fbody, fname) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "for":
        local ldefs is {}
        collect_nested_defs of [node, ldefs]
        local ldn is keys of ldefs
        for k in range of (len of ldn):
            local dn is ldn[k]
            if (count_ident of [fbody, dn]) > (count_ident of [node, dn]):
                throw of ("AOT: nested define '" + dn + "' in '" + fname + "' is defined inside a loop body and referenced by name outside that loop. On the pinned VM the definition is loop-scoped (undefined variable '" + dn + "' after the loop), while the lifted C function would answer; refused rather than answering (ouroboros#194).")
    for k in range of (len of node):
        loopdef_escape_check of [node[k], fbody, fname]
    return 0

define lift_nested(node, bound, out_funcs) as:
    return lift_nested_at of [node, bound, out_funcs, []]

# `outer_after` carries the statements that follow this block in EVERY enclosing
# scope. Without it, "after this definition" meant "after it within the
# innermost statement list", so putting the nested define inside an `if` hid
# every later rebind and the stale-capture bug was fully alive:
#
#   local x is 100 / if y == 0: define inner(d) as: print of x / x is 7
#   VM 7   AOT 100   both build, both rc 0
#
# "After the definition" is a property of the enclosing FUNCTION, not of the
# block the define happens to sit in -- but saying that is not the same as
# achieving it. The first version threaded the suffix correctly and then lost
# the sibling blocks inside it, because collect_assigns_stmt discarded any
# element that was not a statement. It was accurate about intent and false
# about behaviour for a whole round.
define lift_nested_at(node, bound, out_funcs, outer_after) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    for k in range of (len of node):
        local st is node[k]
        local inner is st
        local wrapped is 0
        if ((type of st) == "list") and ((len of st) > 0):
            if st[0] == "_line":
                inner is st[2]
                wrapped is 1
        if ((type of inner) == "list") and ((len of inner) > 0):
            if inner[0] == "func":
                local fname is inner[1]
                local fparams is inner[2]
                local fbody is inner[3]
                if g_func_names[fname] == 1:
                    throw of ("AOT: nested define '" + fname + "' collides with a top-level function")
                local own is {}
                for p in range of (len of fparams):
                    own[(fparams[p])] is 1
                # ...and `local` DECLARATIONS at the nested body's top level. A
                # declaration is not outward mutation -- it is the construct
                # that PREVENTS it -- but the frontend emits `local x is e` as
                # ["assign","x",e,1], the same tag as an outward write with a
                # 4th marker element that collect_assigns_stmt discards. So the
                # outward-mutation guard refused the fix and the bug with one
                # message:
                #
                #   define f(y) as: local x is 100
                #       define b(d) as: local x is 7 / return d
                #   VM 101, and HEAD~1 compiled it byte-exact; the guard then
                #   refused it outright.
                #
                # TOP LEVEL, AND IT MUST DOMINATE EVERY USE. Top-level-ness
                # alone is necessary and NOT sufficient -- the first version of
                # this exemption checked only that, and a declaration then
                # retroactively legalised writes that ran BEFORE it:
                #
                #   define b(d) as: x is 1 / local x is 2 / return d
                #   VM 6 (outer x clobbered)   AOT 105 (outer x untouched)
                #   both build, both rc 0 -- and HEAD~1 had REFUSED it loudly
                #
                # and a READ before the declaration was worse: the capture
                # refusal shares this map, so admitting the name suppressed the
                # capture and the lifted function read its own not-yet-assigned
                # C local (VM 100, AOT 0).
                #
                # The conditional case is the same principle: a declaration
                # inside an `if` dominates nothing. Measured --
                #
                #   define b(d) as: if d == 1: local x is 7 / x is 5
                #   b of 1 -> outer x untouched;  b of 0 -> outer x CLOBBERED
                #
                # -- so it stays refused, now for a stated reason rather than a
                # positional coincidence.
                for lp in range of (len of fbody):
                    local lst is unwrap of fbody[lp]
                    if (type of lst) == "list":
                        if (len of lst) >= 4:
                            if lst[0] == "assign":
                                local dname is lst[1]
                                # every statement BEFORE this one, at any depth
                                local pre is []
                                local pq is 0
                                loop while pq < lp:
                                    append of [pre, fbody[pq]]
                                    pq is pq + 1
                                local pre_assigns is collect_assigns of [pre, {}]
                                local dominates is 1
                                if pre_assigns[dname] != null:
                                    dominates is 0
                                for pr in range of (len of pre):
                                    if (uses_ident of [pre[pr], dname]) == 1:
                                        dominates is 0
                                # ...and the declaration's OWN INITIALIZER. A
                                # declaration does not dominate a read inside
                                # itself: `local x is x + 1` reads the ENCLOSING
                                # x on the right before binding the inner one.
                                # Scanning only the preceding statements let it
                                # through and the capture was suppressed:
                                #
                                #   VM 101    AOT 1    both build, both rc 0
                                #
                                # emitted as `long eig_x = 0; eig_x = eig_x + 1;`
                                # -- the enclosing 100 never captured. This was
                                # the SECOND order bug in this exemption, and
                                # the first fix for the order bug reintroduced
                                # it one position over.
                                if (uses_ident of [(lst[2]), dname]) == 1:
                                    dominates is 0
                                if dominates == 1:
                                    own[dname] is 1
                local nested_assigns is collect_assigns of [fbody, {}]
                # Statements AFTER this define in the enclosing body. A capture
                # is a value SNAPSHOT taken HERE, so a later rebind of a
                # captured name is invisible to the nested function:
                #
                #   local x is 100 / define inner(d) as: print of x / x is 7
                #   print of (inner of 1)
                #   VM  7      AOT  100      both build, both rc 0
                #
                # The comment above this pass claimed such captures "throw".
                # They did not -- no such throw was ever written -- and it also
                # scoped the hazard to NUMERIC captures, which is wrong too: a
                # string rebind snapshots identically (VM "b", AOT "a"). What
                # the comment gets right is the other half, that mutation
                # THROUGH a capture stays live, because the Value is aliased:
                # `x[0] is 9` matches. Rebinding the NAME is the broken case,
                # and it is now refused rather than described.
                local after_stmts is []
                local ak is k + 1
                loop while ak < (len of node):
                    append of [after_stmts, node[ak]]
                    ak is ak + 1
                for oa in range of (len of outer_after):
                    append of [after_stmts, outer_after[oa]]
                local after_assigns is collect_assigns of [after_stmts, {}]
                local after_binders is {}
                collect_for_binders of [after_stmts, after_binders]
                local caps is []
                local rmap is {}
                local bnames is keys of bound
                for b in range of (len of bnames):
                    local cand is bnames[b]
                    if own[cand] != 1:
                        # OUTWARD MUTATION IS CHECKED FIRST AND WITHOUT THE READ
                        # GATE. `uses_ident` matches only ["ident", name], but an
                        # assignment target is a BARE STRING at node[1] -- so a
                        # nested define that only WRITES an enclosing name looked
                        # like it did not mention it at all, and the guard could
                        # not fire on its own headline case:
                        #
                        #   local x is 100
                        #   define b(d) as: x is 7 / return d
                        #   ... return x
                        #   VM 7   AOT 100   both build, both rc 0
                        #
                        # The write went to a fresh C local in the lifted
                        # function, because the name never entered rmap either.
                        # Adding a single READ of x to the same define makes it
                        # refuse correctly, which is what isolates the gate.
                        if nested_assigns[cand] != null:
                            throw of ("AOT: nested define '" + fname + "' assigns enclosing name '" + cand + "' (outward mutation is out of envelope)")
                    if (own[cand] != 1) and ((uses_ident of [fbody, cand]) == 1):
                        if (after_assigns[cand] != null) or (after_binders[cand] == 1):
                            throw of ("AOT: nested define '" + fname + "' captures '" + cand + "', which the enclosing function rebinds after this definition. The capture is a value snapshot taken at the definition, so the nested function would keep reading the old value while the VM reads the new one. Refused rather than answering with a stale value.")
                        local mangled is "__cap" + (str of (G_LIFT_N[0])) + "_" + cand
                        G_LIFT_N[0] is G_LIFT_N[0] + 1
                        append of [caps, [cand, mangled]]
                        rmap[cand] is mangled
                # A `for` binder in a NESTED define is loop-scoped by the VM
                # over EVERY binding kind except the define's own parameter --
                # measured, one row at a time:
                #
                #   binder over the define's `local`      VM loop-scopes (15)
                #   binder over a plain `is` binding      VM loop-scopes (15)
                #   binder over a CAPTURED enclosing name VM loop-scopes (108)
                #   binder over a module GLOBAL           VM loop-scopes; the
                #                                         AOT clobbered it
                #   binder over a fresh name, read after  VM dies rc 1; AOT ran
                #   binder over the define's PARAMETER    persists (parity)
                #
                # The first guard here keyed on BINDING KIND ("a dominating
                # top-level local") and the VM's rule keys on DEPTH -- deleting
                # the word `local` from the guard's own fixture evaded it, and
                # four more spellings each diverged silently (worst: VM 108 /
                # AOT 305 through a capture, and a clobbered global). One check
                # keyed on the right axis subsumes all of them: any binder
                # whose name is not a parameter refuses. Same top-level-vs-
                # nested asymmetry as the rest of EigenScript#1056.
                local nfb is {}
                collect_for_binders of [fbody, nfb]
                local nfk is keys of nfb
                for nfi in range of (len of nfk):
                    local nfn is nfk[nfi]
                    local isparam is 0
                    for nfp in range of (len of fparams):
                        if (fparams[nfp]) == nfn:
                            isparam is 1
                    if isparam == 0:
                        throw of ("AOT: nested define '" + fname + "' uses '" + nfn + "' as a for binder. Inside a nested define the VM loop-scopes that binder (for every binding kind except a parameter) while the AOT would reuse one C variable, so the post-loop value diverges. Refused rather than answering with the wrong one (EigenScript#1056).")
                rename_idents of [fbody, rmap]
                append of [out_funcs, ["func", fname, fparams, fbody]]
                g_func_names[fname] is 1
                local cb is ["capbind", fname, caps]
                if wrapped == 1:
                    st[2] is cb
                else:
                    node[k] is cb
        # recurse into sub-blocks (if/loop/for/try bodies, nested lists)
        if ((type of st) == "list") and ((len of st) > 0):
            if st[0] != "func":
                local sub_after is []
                local sk is k + 1
                loop while sk < (len of node):
                    append of [sub_after, node[sk]]
                    sk is sk + 1
                for oa2 in range of (len of outer_after):
                    append of [sub_after, outer_after[oa2]]
                # (round 115, #154) Descending into a LOOP body: textual order
                # is the wrong model there. A rebind that sits BEFORE the
                # nested define in the source -- an earlier sibling, the other
                # branch of the same `if`, an earlier `match` case -- runs
                # AFTER the definition on the next iteration, and the snapshot
                # capture is stale exactly as in the forward case the suffix
                # already refuses:
                #
                #   loop while i < 2: if i == z: x is 7
                #                     else: define inner(d) as: return x + d
                #   VM 8   AOT 101   both build, both rc 0
                #
                # So the suffix handed to a loop's body carries the WHOLE body
                # (both directions), not just the forward siblings. The BODY,
                # not the loop node: the loop's own `for` binder is bound
                # before each iteration's define runs and both sides read the
                # current value, so it must not count as a rebind. The model,
                # stated once: "can this rebind execute after the definition"
                # is, for structured control flow, "textually after it, or
                # anywhere inside an enclosing loop body". Straight-line
                # `if`/`else` needs no widening -- only one branch runs.
                local stu is unwrap of st
                if ((type of stu) == "list") and ((len of stu) > 0):
                    if stu[0] == "loop":
                        append of [sub_after, stu[2]]
                    if stu[0] == "for":
                        append of [sub_after, stu[3]]
                    # (round 122, #195) Straight-line `if`/`match`: only ONE
                    # arm runs, so a rebind in a SIBLING arm cannot execute
                    # after a define in this arm. The generic descent below
                    # walks the if node as a list, and the else body is a
                    # later ELEMENT of that list -- it entered the suffix as
                    # if it were a following statement, and the refusal named
                    # a rebind that cannot happen (VM 101, refused with a false
                    # reason). Descend into each arm with the suffix of the
                    # `if` STATEMENT (its following siblings + outer), not of
                    # the arm's position inside the node. Inside a loop body
                    # the loop's own widening above already carries every arm.
                    if stu[0] == "if":
                        lift_nested_at of [stu[2], bound, out_funcs, sub_after]
                        if (type of stu[3]) == "list":
                            lift_nested_at of [stu[3], bound, out_funcs, sub_after]
                        continue
                    if stu[0] == "match":
                        local mcs is stu[2]
                        for mci in range of (len of mcs):
                            lift_nested_at of [(mcs[mci])[1], bound, out_funcs, sub_after]
                        continue
                lift_nested_at of [st, bound, out_funcs, sub_after]
    return 0

define emit_program(ast) as:
    local stmts is ast
    if ast[0] == "block":
        stmts is ast[1]
    # Temporal programs: record assignments on the trace tape. PROGRAM-wide:
    # see g_prog_traced's declaration for the cross-scope divergence that
    # per-function derivation caused.
    g_prog_traced is has_interrogate of ast
    g_traced is g_prog_traced
    g_interrogated_names is {}
    collect_interrogated of [ast, g_interrogated_names]
    # (this whole-AST set only decides g_prog_traced-adjacent behavior during
    # module emission; each function rebuilds its own PER-SCOPE set, and main's
    # body is re-scanned below after the function partition)
    g_module_names is {}
    # Order matters: the VM's outward-write rule is RUNTIME -- `is` updates an
    # outer binding only if it EXISTS AT THAT MOMENT, else it creates a
    # function-local that dies with the call. g_module_names alone is
    # order-blind, and an arm keyed on it manufactured a module binding the
    # VM never creates (a function writing v, called before module v is ever
    # bound: VM rc 1 "undefined variable", the arm made it print 5, rc 0).
    # g_first_bind[name] = index of the first top-level statement CONTAINING a
    # binding of the name (per-statement collect_assigns, so a bind inside a
    # top-level if/loop/match counts at that statement's index -- sharing
    # collect_assigns' axes exactly, including its known #161 hole -- and a
    # `define` binds the FUNCTION name at the define statement, because the
    # VM binds function names when the define EXECUTES, not at parse).
    # A bind inside a conditional is counted optimistically (the branch may
    # not run at runtime); that residual is documented at the arm guard.
    # g_first_use[fname] = earliest top-level statement that could
    # TRANSITIVELY invoke the function: direct top-level mentions, closed
    # over "function B's body mentions A, so A inherits B's first use".
    # Round 57 measured both halves: without the closure a writer called
    # only from another function had null first-use (indirect programs with
    # the binding provably first were refused -- over-broad), and without
    # per-arm coverage the clean-numeric (gnm) arm routed outward with NO
    # order check at all (silent success, one arm over from round 56's fix).
    # The guard applies to EVERY outward-routing arm; see the decl loop.
    g_first_bind is {}
    g_first_plain_bind is {}
    g_first_use is {}
    for fbi in range of (len of stmts):
        local fba is collect_assigns of [[(stmts[fbi])], {}]
        local fbk is keys of fba
        for fbj in range of (len of fbk):
            if g_first_bind[(fbk[fbj])] == null:
                g_first_bind[(fbk[fbj])] is fbi
        local fbu is unwrap of stmts[fbi]
        if ((type of fbu) == "list") and ((len of fbu) > 0):
            if fbu[0] == "func":
                if g_first_bind[(fbu[1])] == null:
                    g_first_bind[(fbu[1])] is fbi
            # (round 68) MUST-bind table: plain top-level assigns only. The
            # binder guard's pre-bound exemption consumed g_first_bind's
            # containment optimism to answer a RUNTIME question ("did a
            # binding exist when the for executed?") -- a bind inside a
            # never-taken branch wrongly exempted the binder and the leak
            # returned (VM rc 1, AOT printed the leaked 8, rc 0). The
            # exemption keys on THIS table now: a plain assign statement
            # executes unconditionally before the loop.
            if fbu[0] == "assign":
                if g_first_plain_bind[(fbu[1])] == null:
                    g_first_plain_bind[(fbu[1])] is fbi
    if 1 == 1:
        local mn_a is collect_assigns of [stmts, {}]
        local mn_k is keys of mn_a
        for mi in range of (len of mn_k):
            g_module_names[(mn_k[mi])] is 1
        # tl_call[i] = statement i can perform a call when executed (func
        # defs cannot -- their bodies do not run at the define statement).
        # A function's first-use is the first call-bearing statement AT OR
        # AFTER its first top-level mention: a pure-data mention (`w is f`,
        # `table is [f]`) cannot invoke anything, so it SLIDES forward --
        # invocation through any alias or chain still requires executing a
        # statement that contains a call. Round 58 measured the pre-slide
        # rule evicting the module-scope function-table idiom (table built
        # above the data globals its handlers write; VM prints 11, AOT
        # refused) while the alias-call-before-bind shape stays refused.
        local tl_call is []
        for hci in range of (len of stmts):
            local hcn is unwrap of stmts[hci]
            local hcv is 0
            if ((type of hcn) == "list") and ((len of hcn) > 0):
                if hcn[0] != "func":
                    hcv is has_call_node of [hcn]
            tl_call is (append of [tl_call, hcv])
        for mi2 in range of (len of stmts):
            local mnu is unwrap of stmts[mi2]
            if ((type of mnu) == "list") and ((len of mnu) > 0):
                if mnu[0] == "func":
                    g_module_names[(mnu[1])] is 1
                    local fnm2 is mnu[1]
                    for fui in range of (len of stmts):
                        if g_first_use[fnm2] == null:
                            local fuu is unwrap of stmts[fui]
                            if ((type of fuu) == "list") and ((len of fuu) > 0):
                                if fuu[0] != "func":
                                    if (uses_ident of [stmts[fui], fnm2]) == 1:
                                        local sld is fui
                                        loop while (sld < (len of stmts)) and (tl_call[sld] != 1):
                                            sld is sld + 1
                                        if sld < (len of stmts):
                                            g_first_use[fnm2] is sld
        # Transitive closure: min-propagate first-use through function-body
        # mentions until fixpoint. A function whose closed first-use is still
        # null is unreachable from the top level -- its writes never execute,
        # so the arm guard treats null-use as safe (dead code), NOT refusable.
        local fdefs is []
        for ci in range of (len of stmts):
            local cnode is unwrap of stmts[ci]
            if ((type of cnode) == "list") and ((len of cnode) > 0):
                if cnode[0] == "func":
                    fdefs is (append of [fdefs, cnode])
        local fmention is []
        for ci2 in range of (len of fdefs):
            local mset is {}
            collect_idents_all of [(fdefs[ci2]), mset]
            fmention is (append of [fmention, mset])
        local fchanged is 1
        loop while fchanged == 1:
            fchanged is 0
            for ca in range of (len of fdefs):
                local aname is (fdefs[ca])[1]
                for cb in range of (len of fdefs):
                    if ca != cb:
                        local bname is (fdefs[cb])[1]
                        if ((fmention[cb])[aname] == 1) and (g_first_use[bname] != null):
                            local bidx is g_first_use[bname]
                            if (g_first_use[aname] == null) or (g_first_use[aname] > bidx):
                                g_first_use[aname] is bidx
                                fchanged is 1
    # TOP-LEVEL ORDER GUARD (round 57's root-cause probe): module globals are
    # emitted as C globals live-at-zero from program start, but the VM's
    # binding exists only from its first EXECUTED assignment -- `print of v /
    # v is 1` dies rc 1 on the VM and printed 0 here. A top-level use that
    # textually precedes the name's first top-level binding statement (or the
    # first bind's own rhs reading the name it binds) is refused. The scan is
    # scope-aware via collect_uses_scoped: for-BODY uses are skipped (loop-
    # local names would false-refuse), func defs don't execute at their
