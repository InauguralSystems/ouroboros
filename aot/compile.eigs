                if gnm[_pn] != null:
                    throw of ("AOT: numeric parameter `" + _pn + "` shadows a module binding in an observed function — Part 2a keys it into the global env BY NAME (aot_set below), so the call silently overwrites the caller's `" + _pn + "` (ouroboros#123). Rename the parameter.")
                if gbt[_pn] == 1:
                    throw of ("AOT: numeric parameter `" + _pn + "` shadows a module BUFFER binding in an observed function (ouroboros#123)")

    local _lmk is {}
    collect_local_marked of [body, _lmk]
    local _lmn is keys of _lmk
    local _shcand is []
    local _bshcand is []
    for k in range of (len of _lmn):
        local _shp is 0
        for p in range of (len of params):
