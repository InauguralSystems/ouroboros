        if (len of _bshn) == 0:
            g_lowerloc is 1
    local _lvn is keys of g_envloc
    if g_lowerloc == 1:
        for k in range of (len of _lvn):
            decls is decls + "    EigsSlot " + (lv of (_lvn[k])) + " = slot_null();\n"
    elif g_envactive == 1:
        decls is decls + "    Env* __eigs_l = env_new(NULL);\n"
