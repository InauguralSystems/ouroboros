    g_envactive is 0
    if (g_observed == 0) and (g_traced == 0):
        for k in range of (len of banames):
            local elv is banames[k]
            local elp is 0
            for p in range of (len of params):
                if params[p] == elv:
                    elp is 1
            if (elp == 0) and (gnm[elv] == null) and (gbt[elv] != 1):
                if (g_tensor[elv] != 1) and (fbt[elv] != 1) and (fnm[elv] != 1):
