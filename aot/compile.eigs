            elif (g_cur_params[fvar] == 1) and (g_observed == 0):
                # a NUMERIC parameter as binder, where unboxing is off because
                # the program is TRACED. The param lives in a C double and
                # every read takes it; the terminal env arm wrote __eigs_g and
                # the post-loop read returned the incoming argument (VM 8,
                # AOT 1). Same class as the genp arm above, one type over.
                #
                # g_observed == 0 IS LOAD-BEARING: an OBSERVED function routes
