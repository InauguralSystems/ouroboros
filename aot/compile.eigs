        if (isparam == 0) and (isglobal == 0) and (g_boxshadow[v] != 1):
            if g_tensor[v] == 1:
                decls is decls + "    AotTensor " + (cn of v) + " = aot_tensor_null();\n"
            elif fbt[v] == 1:
                decls is decls + "    Value* " + (cn of v) + " = NULL;\n"
            elif g_int[v] == 1:
                decls is decls + "    long " + (cn of v) + " = 0;\n"
            else:
                decls is decls + "    double " + (cn of v) + " = 0;\n"
            if (g_cur_bound_bit[v] == 1) and (g_tensor[v] != 1) and (fbt[v] != 1):
