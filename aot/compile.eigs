    local sig is "static " + finfo["ret"] + " " + (cn of name) + "("
    if (len of params) == 0:
        sig is sig + "void"
    for k in range of (len of params):
        if k > 0:
            sig is sig + ", "
        if (ptypes[k]) == "buf":
            sig is sig + "Value* " + (cn of params[k])
        elif (ptypes[k]) == "dict":
            sig is sig + "Value* " + (cn of params[k])
        elif (ptypes[k]) == "gen":
            sig is sig + "Value* " + (cn of params[k])
        elif (ptypes[k]) == "tensor":
