            # are not order-guarded (the guard keys on the first bind of any
            # kind), so `if q == 5: x is 7 / print of x / x is 3` read 0 where
            # the VM dies (critic p_a1). The bit covers that window too.
            g_bound_bit[_bbn] is 1
        else:
            # (round 125, #163 item 1) a plainly-bound name READ by a
            # function that can run BEFORE that plain bind: the order guard
            # sees module-level uses only, so `define f() as: return v + 1 /
            # print of (f of 0) / v is 1` read the static's 0 where the VM
            # dies. The function's first-use index (the closure over
            # mentions, round 57) against the plain bind's index is the same
            # test the outward-write guard makes for stores; a read side
            # earns the bit instead of a refusal, and dies exactly where
            # the VM does. A function bound after its readers' plain binds
            # (the common shape: DMG binds its state before its main loop)
            # earns nothing, so no hot read gains a check. NUMERIC names
            # only: the bit's decl and store sites live on the numeric
            # path, and a boxed name granted a bit left `eig_cpu_b`
            # undeclared at a read site (DMG's `cpu`/`mem`, bound after
            # the functions that read them are first usable -- the gate
            # caught it). A boxed read before its bind stays the silent
            # residual, noted on #163.
            if nm[_bbn] == 1:
                for _bfi in range of (len of funcs):
                    local _bfn is (funcs[_bfi])[1]
                    if (g_first_use[_bfn] != null) and (g_first_use[_bfn] <= g_first_plain_bind[_bbn]):
                        if (uses_ident of [(funcs[_bfi])[3], _bbn]) == 1:
                            g_bound_bit[_bbn] is 1
    for k in range of (len of funcs):
        fdefs is fdefs + "\n" + (emit_function of [funcs[k], g_funcs[(funcs[k])[1]], nm, bt])
    local fc is ""
    for k in range of (len of funcs):
        fc is fc + (g_fsigs[(funcs[k])[1]]) + ";\n"
    fc is fc + fdefs
    g_scalbound is infer_scalar_bounds of [rest, nm]
    g_bufbound is infer_buffer_bounds of [rest, bt]
    local minits is module_inits of rest
    # module globals as FILE-SCOPE decls (so functions can read them); main's
    # body assigns them (no re-declaration in main).
    # integer names for the module body (also makes integer globals `long`).
    # In an observed program nothing is unboxed/int-typed (vars live in the env).
    g_int is {}
    g_btmap is bt
    if g_observed == 0:
        g_int is infer_int of [rest, [], nm, bt]
    # tensor layer for the module body (functions set their own scope above).
    g_dict is {}
    g_genp is {}
    g_tensor is infer_tensors of rest
    # for-in loop-var unboxing at module scope. Safe to mutate nm here: the
    # functions were emitted above with the pre-mutation map, so they still
    # see the module binding the VM shows them.
    g_forunbox is {}
    if (g_observed == 0) and (g_traced == 0):
        local mfa is collect_assigns of [rest, {}]
        local mub is {}
        for_unbox_scan of [rest, mfa, nm, bt, mub, 1]
        local mubn is keys of mub
        for k in range of (len of mubn):
            if mub[mubn[k]] == 1:
                g_forunbox[mubn[k]] is 2
                nm[mubn[k]] is 1
                # (round 117, #185) a for-only module name has no plain
                # top-level bind, so it carries a boundness bit: the decl
                # loop below declares the static AND the bit (it used to skip
                # forunbox==2 names entirely, so a post-loop read was a gcc
                # "undeclared" error -- the earlier form printed the static's
                # 0). The loop's block-local shadows both with its own bit =
                # 1: in-loop reads pass, a post-loop read dies like the VM.
                if g_first_plain_bind[(mubn[k])] == null:
                    g_bound_bit[(mubn[k])] is 1
    # --dump-inference: module-scope records. These are the tape-joinable ones
    # (A records track top-level bindings), so the audit's evidence lives here.
    if g_dump == 1:
        local mdl is {}
        local mdfv is {}
        dump_scan of [rest, 0 - 1, mdl, mdfv]
        local mba is collect_assigns of [rest, {}]
        local mban is keys of mba
        for k in range of (len of mban):
            local mv is mban[k]
            local mkind is "boxed-env"
            if g_tensor[mv] == 1:
                mkind is "tensor"
            elif bt[mv] == 1:
                mkind is "buffer"
            elif nm[mv] == 1:
                mkind is "double"
                if g_observed == 1:
                    mkind is "observed-env"
                elif g_int[mv] == 1:
                    mkind is "long"
            dump_rec of ["module", "global", mv, mkind, mdl[mv]]
        local mdfvn is keys of mdfv
        for k in range of (len of mdfvn):
            if mba[mdfvn[k]] == null:
                local mfvk is "boxed-env-for"
                if g_forunbox[mdfvn[k]] != null:
                    mfvk is "double"
                dump_rec of ["module", "for", mdfvn[k], mfvk, mdl[mdfvn[k]]]
    # (round 117) which module names carry a boundness bit: every module
    # name with NO plain top-level bind. Populated here, before the decl
    # loop; function bodies were emitted earlier against g_bound_bit filled
    # by the pre-pass below, so the two must agree -- see the pre-pass.
    local gdecls is ""
    local names is keys of nm
    for i in range of (len of names):
        # observed numeric vars live in the env (created by aot_observe_num), so
        # no file-scope decl; otherwise emit static long/double.
        # unboxed module for-vars (g_forunbox==2) are declared INSIDE their
        # loop's C block, not file-scope — the VM loop-scopes the binding.
        if (nm[names[i]] == 1) and (g_observed == 0) and ((g_forunbox[names[i]] != 2) or (g_bound_bit[names[i]] == 1)):
            # (round 117) a for-only module name (g_forunbox == 2) had NO
            # file-scope decl since round 106, so a post-loop read was a gcc
            # "undeclared" error (#185's silent 0 in its earlier form). It
            # gets the static AND a bit the binder never sets (the binder
            # writes its C block-local, which carries its own bit = 1), so a
            # post-loop read dies "undefined variable" like the VM.
            if g_int[names[i]] == 1:
                gdecls is gdecls + "static long " + (cn of names[i]) + " = 0;\n"
            else:
                gdecls is gdecls + "static double " + (cn of names[i]) + " = 0;\n"
            if g_bound_bit[names[i]] == 1:
                gdecls is gdecls + "static int " + (cn of names[i]) + "_b = 0;   /* boundness bit (round 117) */\n"
    local bnames is keys of bt
    for i in range of (len of bnames):
        if bt[bnames[i]] == 1:
            gdecls is gdecls + "static Value* " + (cn of bnames[i]) + " = NULL;\n"
    # (round 126, #184) the tensor value layer at MODULE scope: g_tensor is
    # inferred for the module body (above) and the assign arm emits
    # `eig_x = <AotTensor expr>` in every scope, but this loop declared
    # only numeric and buffer names -- the C referenced an undeclared
    # name and gcc's error leaked with no AOT: line. Mirror the function
    # path's `AotTensor eig_x = aot_tensor_null();` as a static (a
    # zero-initialised struct is what aot_tensor_null builds).
    local tnames is keys of g_tensor
    for i in range of (len of tnames):
        if g_tensor[tnames[i]] == 1:
            gdecls is gdecls + "static AotTensor " + (cn of tnames[i]) + " = {0};   /* tensor (round 126) */\n"
    # emit_function sets G_CUR_FN; the module body has no emit_function, so
    # reset it or every site label in main() inherits the LAST function's
    # name (that stale label sent an earlier debugging session chasing
    # `lbd_activity_key` for a failure that was in main).
    G_CUR_FN[0] is "<module>"
    g_cur_params is {}
    # restore the MODULE body's own interrogated set (each emit_function call
    # above replaced it with that function's per-scope set)
    g_interrogated_names is {}
    collect_interrogated of [["block", rest], g_interrogated_names]
    # module scope has no shadows (a module-level `local` IS the module
    # binding) — clear the last function's maps before emitting main.
    g_locshadow is {}
    g_boxshadow is {}
    # (round 117) the module body is not a function: no `local` marks, no
    # per-call bits (the critic's p_d1: the LAST function's marks leaked here
    # and a module bit-name it had `local`-shadowed skipped its check).
    g_cur_localmarked is {}
    g_cur_bound_bit is {}
    local body is emit_stmts of [rest, "    ", nm, bt, minits, {}]
    local obshdr is ""
    if g_obs_traced == 1:
        # v0.41.0: the trace flags are atomic — the g_* names are LOAD
        # macros, not lvalues, so a raw store FAILS TO COMPILE against the
        # linked headers (by upstream design: write sites stay enumerable).
        # trace_flag_store is the sanctioned store (trace.h).
        obshdr is "    trace_flag_store(g_trace_obs_hist_storage, 1);\n"
    # (#86) boxed wrappers for user functions used as VALUES (sort_by keys
    # etc.): Value* -> Value*, arg borrowed per the builtin convention.
    local wraps is ""
    local wprotos is ""
    local wnames is keys of g_fn_as_value
    for i in range of (len of wnames):
        local wn is wnames[i]
        local wi is g_funcs[wn]
        # (round 98) ONE Value per function, for its whole life. make_builtin
        # allocated a fresh Value on every read of the name, and this VM
        # compares VAL_FN/VAL_BUILTIN by POINTER IDENTITY -- so `a is g /
        # c is g / print of (a == c)` printed 0 where the VM prints 1, rc 0
        # both sides. That is branch-deciding: `if handler == some_fn:` over
        # a dispatch table takes the other arm in the native binary. The VM
        # holds one Value in its env for the process's life; this mirrors
        # that lifetime.
        wprotos is wprotos + "static Value* __fnv_" + (cn of wn) + " = NULL;\n"
        local wpt is wi["ptypes"]
        if (len of wpt) != 1:
            # MULTI-PARAMETER value wrappers (#140). The builtin calling
            # convention hands arity-1 the value itself and arity>1 a LIST, so
            # a wrapper for an N-ary function unpacks that list. Refusing this
            # was what actually blocked the module pattern: stdlib calls are
            # multi-argument (`linalg.mat_mul of [a, b]`), so accepting dot
            # callees without this would not have compiled a single one.
            local wmulti is ""
            for wk in range of (len of wpt):
                if wk > 0:
                    wmulti is wmulti + ", "
                if (wpt[wk]) == "tensor":
                    throw of ("AOT: function '" + wn + "' used as a value takes a tensor parameter, which has no boxed calling convention")
                if (wpt[wk]) == "num":
                    wmulti is wmulti + "aot_num_ck_bat(aot_arg_at(__a, " + (str of wk) + "), \"" + (c_escape of wn) + " parameter " + (str of wk) + "\")"
                else:
                    wmulti is wmulti + "aot_arg_at(__a, " + (str of wk) + ")"
            local wcallm is (cn of wn) + "(" + wmulti + ")"
            wprotos is wprotos + "static Value* __wrap_" + (cn of wn) + "(Value* __a);\n"
            if (wi["ret"]) == "double":
                wraps is wraps + "static Value* __wrap_" + (cn of wn) + "(Value* __a) { return make_num(" + wcallm + "); }\n"
            elif (wi["ret"]) == "Value*":
                wraps is wraps + "static Value* __wrap_" + (cn of wn) + "(Value* __a) { return " + wcallm + "; }\n"
            else:
                wraps is wraps + "static Value* __wrap_" + (cn of wn) + "(Value* __a) { " + wcallm + "; return make_null(); }\n"
            continue
        local warg is "__a"
        if (wpt[0]) == "num":
            # NOT a silent coercion. A non-number here used to become 0.0 while
            # the VM went on using the value (#130); the whole F-OURO-29 /
            # #100-item-4 family is the same shape and the same answer applies:
            # a loud death beats a coercing guess. Borrowed, per the builtin
            # argument convention — this must not consume __a.
            warg is "aot_num_ck_bat(__a, \"" + (c_escape of wn) + " parameter\")"
        local wcall is (cn of wn) + "(" + warg + ")"
        wprotos is wprotos + "static Value* __wrap_" + (cn of wn) + "(Value* __a);\n"
        if (wi["ret"]) == "double":
            wraps is wraps + "static Value* __wrap_" + (cn of wn) + "(Value* __a) { return make_num(" + wcall + "); }\n"
        elif (wi["ret"]) == "Value*":
            wraps is wraps + "static Value* __wrap_" + (cn of wn) + "(Value* __a) { return " + wcall + "; }\n"
        else:
            wraps is wraps + "static Value* __wrap_" + (cn of wn) + "(Value* __a) { " + wcall + "; return make_null(); }\n"
    local hdr is "#include \"aot_rt.h\"\n\nstatic Env* __eigs_g = NULL;\n" + gdecls + "\n" + wprotos + fc + "\n" + wraps + "\nint main(int argc, char **argv) {\n    __eigs_g = aot_boot(); (void)__eigs_g;\n    aot_args(argc, argv);\n" + obshdr
    local ftr is "    aot_shutdown(__eigs_g);\n    return 0;\n}\n"
    return hdr + body + ftr

# ---- ouroboros#129: compile static `load_file` targets --------------------
#
# `load_file of "<literal>"` used to be emitted as a RUNTIME call, so the
# target was parsed and INTERPRETED by the linked VM while its parent ran as
# compiled C. That is the seam six separate defects came from (#127, #121,
# EigenScript#1046/#373), and it is why the AOT cannot accelerate any program
# that modularises its hot path: DMG is 3,288 lines of which 2,470 — including
# the 128-function opcode dispatch — live behind this call.
#
# A literal target is spliced into the compilation unit instead. emit_program
# already splits `func` nodes out of the top-level block and hoists them, so
# the child's definitions become visible to the parent and vice versa, which
# is exactly load_file's scope behaviour.
#
# A COMPUTED path stays a runtime call: that is a genuinely dynamic load and
# the hybrid is correct for it.
define _lf_dirname(p) as:
    local i is (len of p) - 1
    loop while i >= 0:
        if (char_at of [p, i]) == "/":
            return substr of [p, 0, i + 1]
        i is i - 1
    return ""

# The literal path if `st` is `load_file of "<str>"`, else null.
define _lf_target(st) as:
    local u is unwrap of st
    if u[0] != "call":
        return null
    local callee is unwrap of u[1]
    if callee[0] != "ident":
        return null
    if callee[1] != "load_file":
        return null
    local a is unwrap of u[2]
    if a[0] != "str":
        return null
    return a[1]

# `import NAME` if `st` is one, else null.
define _imp_target(st) as:
    local u is unwrap of st
    if u[0] != "import":
        return null
    return u[1]

# Stdlib root, passed as argv[2] by build.sh and the envelope census. Absent
# when compile.eigs is invoked by hand, in which case only project-local
# modules resolve and a stdlib import stays a loud refusal rather than a
# silently-wrong resolution.
G_STDLIB is [""]
# Modules already spliced in this compilation. The VM caches imports: a second
# `import M` does NOT re-run the module and rebinds the name to the SAME dict
# object, so a mutation the program made to that dict survives. Splicing twice
# would instead redefine every function (a C redefinition error) and re-run the
# module's top level. First import stashes the dict in __imp_M; a repeat import
# rebinds from the stash, which is the cached-object semantics exactly.
G_IMPORTED is {}

# Top-level binding names of a module, in SOURCE ORDER, first occurrence wins.
# That order is the contract: `keys of <module>` was probed against the VM and
# returns bindings in the order the module creates them, variables and
# functions interleaved.
define module_bindings(stmts) as:
    local names is []
    local seen is {}
    module_bindings_walk of [stmts, names, seen]
    return names

# Walks module-level statements in SOURCE ORDER, descending into control-flow
# bodies but NOT into `func` bodies. A binding made inside a module-level `if`
# is a real top-level binding — the VM's dict has it — and walking only the
# immediate statement list dropped it: `keys of M` lost the name and `M.b` read
# NULL, a wrong VALUE rather than a missing key. A binding made inside a
# FUNCTION body is different: the dict is a snapshot taken at import time,
# before any function has run, so that name does not exist yet.
define module_bindings_walk(stmts, names, seen) as:
    if (type of stmts) != "list":
        return 0
    for i in range of (len of stmts):
        local u is unwrap of stmts[i]
        if (type of u) != "list":
            continue
        if (len of u) == 0:
            continue
        local nm2 is null
        if u[0] == "func":
            nm2 is u[1]
        elif u[0] == "assign":
            nm2 is u[1]
        elif u[0] == "import":
            # an import binds the module name as a top-level binding, and the
            # VM's dict carries it: `(keys of linalg)[0]` is "complex".
            nm2 is u[1]
        if nm2 != null:
            if seen[nm2] != 1:
                seen[nm2] is 1
                append of [names, nm2]
        if u[0] == "unobserved":
            # `unobserved:` always executes, so bindings inside it are real
            # top-level bindings. It is the ONLY nested position that is.
            module_bindings_walk of [u[1], names, seen]
    return 0

# Does the module create a top-level binding inside CONDITIONAL control flow?
#
# The module dict is a SNAPSHOT OF WHAT RAN, and a static walk cannot know
# that. Two rounds proved it from both sides with the same walker: collecting
# only the immediate statement list DROPPED a binding made in a taken `if`
# (`M.b` read null); descending into every body INVENTED one from a not-taken
# `else` (`M.z` read 0 — a default-initialised global, so a plausible NUMBER
# rather than a null). Descending also picked up `for`-body names, which the VM
# does not have at all because a `for` body gets its own env.
#
# Only the immediate top level and `unobserved:` are unconditionally executed.
# Everything else is refused rather than guessed.
#
# WHICH bodies leak was MEASURED against the VM, not reasoned from "`if`
# creates no scope". A module `a is 1 / <body> / b is 2` imported and probed
# with `keys of M` gives:
#
#   if / loop while / try / match case    leak — `inner` is in the dict
#   for                                   does NOT — ["a", "b"], `M.inner` null
#
# so a `for` body can never create a top-level binding, and the first version
# of this guard, which refused on `for`, was refusing programs that were
# always fine. Same measurement settled two more: a `local` inside a top-level
# `if` DOES leak (so `local` is not exempt), and a `define` inside one does
# too (so a nested `func` is a binding to report, not a subtree to skip).
#
# A conditional assignment is only a problem when it is the name's FIRST
# binding. `x is 1` at the top level followed by `if c: x is 2` gives the same
# dict either way, so `bound` carries the names already bound at the immediate
# top level IN SOURCE ORDER and a re-assignment of one is not reported. Order
# matters as well as membership: binding conditionally BEFORE the top-level
# assignment changes where the key lands in `keys of M`, so only names bound
# EARLIER in source count.
#
# MEASURED cost across the 77 stdlib modules, by transpiling `import M` for
# each: 1 refused here — test_runner, whose `in_tests` is genuinely first bound
# inside an `if`. An earlier comment claimed 3 (pkg, test_runner, ui_draw); that
# number came out of the broken scan and only ever applied to one of the three.
# pkg and ui_draw refuse for unrelated reasons that fire earlier (an internal
# index error in find_buf_param_use; `cannot emit statement node 'try'`).
#
# The two halves of this guard are load-bearing TOGETHER. pkg's `rest is []`
# then `if ...: rest is argv[1:]`, and ui_draw's `_has_text_metrics is 0` then
# a `try:` that reassigns it, are exactly the re-assignment shape — so fixing
# only the aborted scan, without the `bound` rule, would have converted a
# silent wrong answer into a FALSE REFUSAL of two real stdlib modules.
define module_cond_binds(stmts, bound, out) as:
    if (type of stmts) != "list":
        return 0
    for i in range of (len of stmts):
        local u is unwrap of stmts[i]
        if (type of u) != "list":
            continue
        if (len of u) == 0:
            continue
        local h is u[0]
        if h == "unobserved":
            module_cond_binds of [u[1], bound, out]
        elif (h == "if") or (h == "loop") or (h == "try") or (h == "match"):
            collect_cond_binds of [u, bound, out]
        # A `func`/`assign`/`import` here is an immediate top-level binding, so
        # it joins `bound` and is NOT scanned. It must not `return` — a module
        # that declares a function before its conditional binding is the normal
        # shape, and aborting the scan at the first `define` put pkg (define
        # line 54, conditional binding line 573) and ui_draw (line 10 / line 35)
        # straight back into the dropped-binding bug this guard exists to catch.
        if (h == "func") or (h == "assign") or (h == "import"):
            bound[(u[1])] is 1
    return 0

define collect_cond_binds(node, bound, out) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    local h is node[0]
    if h == "for":
        # a `for` body has its own env: nothing inside it reaches the module
        return 0
    if h == "func":
        if bound[(node[1])] != 1:
            out[(node[1])] is 1
        return 0
    if h == "assign":
        if bound[(node[1])] != 1:
            out[(node[1])] is 1
    for k in range of (len of node):
        collect_cond_binds of [node[k], bound, out]
    return 0

# Does the module END ITS OWN TOP LEVEL early with a `return`?
#
# The guard above models which top-level bindings a module CREATES. This is the
# other half of "the dict is a snapshot of what RAN": a module top-level
# `return` means the rest of the module DID NOT RUN, so every binding below it
# is absent from the VM's dict.
#
# The AOT splices a module's statements into the program, so that `return`
# became a bare `return 0` in main — which returns from the WHOLE PROGRAM,
# before the dict is even constructed:
#
#   mI.eigs:  a is 1 / if a == 1: return 0 / b is 2
#   VM        ["a"] then 1 then null          AOT   no output at all, rc 0
#
# Both halves are wrong and both are silent: the program is truncated at the
# import, and the dict the code would have built invents `b`. `if` and `return`
# are each individually emittable, so nothing else refuses it.
#
# Correct lowering exists — emit the module body as its own C function so its
# `return` ends the module, then build the dict — but it is a real change to
# the splice design, so this refuses instead of guessing (ouroboros#146).
# Note a `return` in the MAIN program's top level is a different thing and
# stays supported: there it does mean "end the program", which is what the
# emitted `return 0` does.
define module_has_toplevel_return(node) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    local h is node[0]
    if h == "func":
        # a `return` inside a function body returns from the function
        return 0
    if h == "return":
        return 1
    for k in range of (len of node):
        if (module_has_toplevel_return of (node[k])) == 1:
            return 1
    return 0


# Names a module's statements can create or overwrite IN THE MERGED SCOPE: its
# top-level bindings, plus every assignment target at any depth that is not a
# parameter, a `local`, or a loop variable. `is` is outward-mutable, so a bare
# `ctr is 99` inside a module function writes the module's global — measured
# across the 77 stdlib modules: 66 do it, 892 distinct names, median 10 each.
# This is the set the namespacing renamer must rewrite.
define collect_free_assigns(node, bound, out) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    local h is node[0]
    if h == "func":
        local b2 is {}
        local bk is keys of bound
        for bi in range of (len of bk):
            b2[(bk[bi])] is 1
        local ps is node[2]
        for pk in range of (len of ps):
            b2[(ps[pk])] is 1
        local fk is 3
        loop while fk < (len of node):
            collect_local_decls of [node[fk], b2]
            fk is fk + 1
        fk is 3
        loop while fk < (len of node):
            collect_free_assigns of [node[fk], b2, out]
            fk is fk + 1
        return 0
    if h == "assign":
        if (len of node) < 4:
            if bound[node[1]] != 1:
                out[node[1]] is 1
        collect_free_assigns of [node[2], bound, out]
        return 0
    for k in range of (len of node):
        collect_free_assigns of [node[k], bound, out]
    return 0

# `local` declarations, loop variables and catch names inside a body — these do
# NOT merge outward. Collected for the whole body rather than from their
# declaration onward, which is the emitter's own approximation of `local`'s
# order-sensitivity.
define collect_local_decls(node, bound) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "assign":
        if (len of node) >= 4:
            bound[node[1]] is 1
    if (node[0] == "for") or (node[0] == "catch"):
        if (type of node[1]) == "str":
            bound[node[1]] is 1
    for k in range of (len of node):
        collect_local_decls of [node[k], bound]
    return 0

define module_shadow_names(stmts, out) as:
    if (type of stmts) != "list":
        return 0
    if (len of stmts) == 0:
        return 0
    if stmts[0] == "func":
        local ps is stmts[2]
        for pk in range of (len of ps):
            out[(ps[pk])] is 1
    if stmts[0] == "assign":
        if (len of stmts) >= 4:
            out[stmts[1]] is 1
    if (stmts[0] == "for") or (stmts[0] == "catch"):
        if (type of stmts[1]) == "str":
            out[stmts[1]] is 1
    for k in range of (len of stmts):
        module_shadow_names of [stmts[k], out]
    return 0

# ---- MODULE NAMESPACING (ouroboros#141) -----------------------------------
# Rename every name a module can create in the merged scope to `<M>__<name>`,
# so splicing cannot collide with the program and no guard is needed.
#
# Only two node shapes carry a name that must move: an `ident` reference, and
# the name slot of `assign`/`func`. Every OTHER binder — `for` variables,
# parameters, `catch` names — and every non-name string — `dot` field names,
# `dict` keys — is a bare string in the AST, so a walker that rewrites only
# those two shapes leaves them alone by construction rather than by a special
# case per shape.
define rename_ast(node, ren, shadow) as:
    if (type of node) != "list":
        return node
    if (len of node) == 0:
        return node
    local h is node[0]
    if h == "ident":
        if shadow[node[1]] != null:
            return ["ident", shadow[node[1]]]
        if ren[node[1]] != null:
            return ["ident", ren[node[1]]]
        return node
    # NO `block` ARM, deliberately. One was written here to make `local`
    # shadowing occurrence-scoped, and it was DEAD: _p_parse_block returns a
    # BARE statement list, not ["block", stmts] — the only producer of a block
    # node is eigen_parse's whole-program wrapper, and splice_module renames one
    # statement at a time. The commit that added it claimed occurrence-scoped
    # `local` handling as a feature; the code never ran.
    #
    # So module `local` binders are NOT renamed. That is currently safe rather
    # than merely untested: a module `local` colliding with a program global is
    # handled by the emitter's own g_locshadow/g_boxshadow machinery, which
    # either block-scopes it to a C local or refuses loudly ("`local X`
    # shadowing a module binding is not supported"). A review round built three
    # such collisions — a list global, a num global, and a self-referencing RHS
    # — and every one was handled correctly. If `local` renaming is ever wanted,
    # it needs a statement-list walker driven from the known body positions,
    # not a node-kind arm.
    if h == "assign":
        local an is node[1]
        if shadow[an] != null:
            an is shadow[an]
        elif ren[an] != null:
            an is ren[an]
        if (len of node) >= 4:
            return ["assign", an, (rename_ast of [node[2], ren, shadow]), node[3]]
        return ["assign", an, (rename_ast of [node[2], ren, shadow])]
    if h == "func":
        local fn2 is node[1]
        if ren[fn2] != null:
            fn2 is ren[fn2]
        # BINDERS ARE RENAMED TOO, not merely excluded. A module's parameter,
        # `local` or loop variable still lands in the merged scope when the
        # emitter gives it env storage, so leaving it alone left a live
        # collision with the program. Alpha-renaming a bound name together with
        # its in-scope references is always semantics-preserving, and doing it
        # uniformly means no name of the module's can reach the program at all.
        local sh3 is copy_map of shadow
        local fps is node[2]
        local nps is []
        for fpk in range of (len of fps):
            sh3[(fps[fpk])] is (G_MODPFX[0]) + "bnd__" + (fps[fpk])
            append of [nps, (G_MODPFX[0]) + "bnd__" + (fps[fpk])]
        local out2 is ["func", fn2, nps]
        local ki is 3
        loop while ki < (len of node):
            append of [out2, (rename_ast of [node[ki], ren, sh3])]
            ki is ki + 1
        return out2
    if h == "for":
        # ["for", var, iter, body] — the variable binds the BODY only; the
        # iterable is evaluated in the enclosing scope.
        local sh4 is copy_map of shadow
        local nv is node[1]
        if (type of node[1]) == "str":
            nv is (G_MODPFX[0]) + "bnd__" + node[1]
            sh4[node[1]] is nv
        return ["for", nv, (rename_ast of [node[2], ren, shadow]), (rename_ast of [node[3], ren, sh4])]
    if h == "try":
        # ["try", try_body, err_name, catch_body] — the binder is in slot 2,
        # not slot 1. The earlier helpers tested for a "catch" node this
        # frontend never produces: dead code that looked like coverage.
        local sh5 is copy_map of shadow
        local ne is node[2]
        if (type of node[2]) == "str":
            ne is (G_MODPFX[0]) + "bnd__" + node[2]
            sh5[node[2]] is ne
        return ["try", (rename_ast of [node[1], ren, shadow]), ne, (rename_ast of [node[3], ren, sh5])]
    if h == "listcomp":
        # ["listcomp", expr, var, iter, filter] — the variable binds the
        # element expression and the filter, not the iterable.
        local sh6 is copy_map of shadow
        local lv is node[2]
        if (type of node[2]) == "str":
            lv is (G_MODPFX[0]) + "bnd__" + node[2]
            sh6[node[2]] is lv
        return ["listcomp", (rename_ast of [node[1], ren, sh6]), lv, (rename_ast of [node[3], ren, shadow]), (rename_ast of [node[4], ren, sh6])]
    local out is []
    for k in range of (len of node):
        append of [out, (rename_ast of [node[k], ren, shadow])]
    return out

# Prefix of the module currently being renamed, read by the binder arms above.
# Binders take `<M>__bnd__<name>`, DISTINCT from a module global's `<M>__<name>`:
# renaming both to the same string makes a loop variable clobber the module
# global it shares a name with — `for ctr` over a module that also has a global
# `ctr` returned 2 where the VM returns 1.
G_MODPFX is [""]

define copy_map(m) as:
    local c is {}
    local ks is keys of m
    for i in range of (len of ks):
        c[(ks[i])] is m[(ks[i])]
    return c

# Ensure module `mname` is spliced into `out` exactly once, under its own
# `<M>__` prefix, leaving its snapshot dict at __moddict_<M>. Binding a NAME
# for it is the caller's job: a program-level import binds the plain name, a
# module's own import binds that module's renamed name.
define splice_module(mname, base, depth, out) as:
        # ---- `import NAME` (#121), NAMESPACED (#141) -------------------
        # Splice the module ONCE under its own prefix and bind a snapshot
        # dict, canonically as __moddict_<M>. Any later import of the same
        # module — by the program or by another module — rebinds from that,
        # which is the VM's module-cache identity.
        #
        # Renaming removes the whole collision problem rather than guarding
        # it: four review rounds found four distinct arms of a name-
        # comparison guard, and the measurement that ended it is that `is`
        # is outward-mutable, so 66 of 77 stdlib modules write a free name
        # from inside a function body (892 distinct, median 10 each, 56 of
        # them names as common as `i`/`n`/`key`/`result`). A sound guard
        # refuses nearly everything; a precise one has holes. Prefixed
        # names cannot collide, so there is nothing left to compare.
        if G_IMPORTED[mname] != 1:
            local mpath is (_lf_dirname of base) + mname + ".eigs"
            local msrc is read_text of mpath
            if (msrc == null) or ((len of msrc) == 0):
                if (G_STDLIB[0]) != "":
                    mpath is (G_STDLIB[0]) + "/lib/" + mname + ".eigs"
                    msrc is read_text of mpath
            if (msrc == null) or ((len of msrc) == 0):
                throw of ("AOT: import '" + mname + "' not found (looked beside the program, then in the stdlib lib/)")
            local mast is eigen_parse of (eigen_tokenize of msrc)
            # The rename set: every name the module can create in the merged
            # scope — top-level bindings plus free assignment targets at any
            # depth. Top-level alone is NOT enough; a module's bare
            # `ctr is 99` inside a function body is not a top-level binding
            # and was a silent divergence (VM 99/1, AOT 99/99).
            local rset is {}
            local rtop is module_bindings of (mast[1])
            for ri in range of (len of rtop):
                rset[(rtop[ri])] is 1
            collect_free_assigns of [["block", (mast[1])], {}, rset]
            # A module top-level binding made inside conditional control flow
            # cannot be represented: the dict is a snapshot of what RAN.
            if (module_has_toplevel_return of ["block", (mast[1])]) == 1:
                throw of ("AOT: module '" + mname + "' ends its own top level with a `return`. The AOT splices a module into the program, so that `return` would return from the whole program and skip building the module dict — silently, with no output at all. Refused rather than guessed (ouroboros#146).")
            local condb is {}
            module_cond_binds of [(mast[1]), {}, condb]
            local condk is keys of condb
            if (len of condk) > 0:
                throw of ("AOT: module '" + mname + "' creates the top-level binding '" + (condk[0]) + "' inside conditional control flow. The module dict is a snapshot of what RAN, and the AOT builds it statically — including it invents a key the VM does not have, omitting it drops one the VM does. Refused rather than guessed (ouroboros#141).")
            local rk is keys of rset
            local ren is {}
            for ri in range of (len of rk):
                ren[(rk[ri])] is mname + "__" + (rk[ri])
            # Mark BEFORE recursing so an import cycle terminates.
            G_IMPORTED[mname] is 1
            # Prefix for this module's binders, read by rename_ast's binder arms.
            G_MODPFX[0] is mname + "__"
            local mstmts is (mast[1])
            for mk in range of (len of mstmts):
                local mst1 is mstmts[mk]
                local inner is _imp_target of mst1
                if inner != null:
                    # The module's own import. Splice the inner module under
                    # ITS prefix and bind THIS module's renamed name for it.
                    # Recursing through splice_static_loads here was wrong:
                    # that path also emits the module's PLAIN name binding,
                    # which is correct only for a program-level import — as
                    # a nested one it bound `complex` globally and clobbered
                    # the importing program's own `complex`.
                    splice_module of [inner, mpath, depth + 1, out]
                    append of [out, ["assign", (ren[inner]), ["ident", "__moddict_" + inner]]]
                else:
                    append of [out, (rename_ast of [mst1, ren, {}])]
            local pairs is []
            for ri in range of (len of rtop):
                append of [pairs, [(rtop[ri]), ["ident", (ren[(rtop[ri])])]]]
            append of [out, ["assign", "__moddict_" + mname, ["dict", pairs]]]

# (round 114, ouroboros#127) A `load_file` whose path is COMPUTED cannot be
# spliced, so it would be emitted as a runtime call into the linked VM: the
# loaded file is interpreted, and interpreted code cannot see the program's
# compiled functions -- `child_calls_helper of 7.0` transpiles, links, prints
# a third of the program and dies "undefined variable 'helper'" (rc 1 where
# the VM prints 14). That was #127's headline; the literal-path half is
# spliced (t214), the computed half is refused by name rather than
# accepted-and-dying.
#
# SCOPE, measured on the DMG canary: LITERAL loads keep today's runtime-call
# behaviour wherever they sit. A literal top-level load the splice could not
# resolve is its documented best-effort case (t76's stdlib prong), and a
# literal load in a NESTED position (dmg.eigs loads lib/ui.eigs and
# debugger.eigs inside its debug branch) is conditional code the canary
# never reaches -- refusing it cut DMG out of the envelope for a branch it
# does not run. Those nested literal loads are #127's remaining residual
# (loud at run time if they call compiled functions), recorded on the issue.
# #147 owns the splice's cwd-vs-script-dir soundness question.
define has_computed_load_file(node) as:
    if (type of node) != "list":
        return 0
    if (len of node) == 0:
        return 0
    if node[0] == "call":
        local c is unwrap of node[1]
        if ((type of c) == "list") and ((len of c) > 1):
            if (c[0] == "ident") and (c[1] == "load_file"):
                local a is unwrap of node[2]
                if ((type of a) != "list") or ((len of a) == 0) or (a[0] != "str"):
                    return 1
    for k in range of (len of node):
        if (has_computed_load_file of node[k]) == 1:
            return 1
    return 0

define splice_static_loads(blk, base, depth) as:
    if depth > 16:
        throw of "AOT: load_file nesting deeper than 16 — cyclic load?"
    local out is []
    local stmts is blk[1]
    for i in range of (len of stmts):
        local st is stmts[i]
        local mname is _imp_target of st
        if mname != null:
            splice_module of [mname, base, depth, out]
            append of [out, ["assign", mname, ["ident", "__moddict_" + mname]]]
        else:
            local path is _lf_target of st
            if path == null:
                append of [out, st]
            else:
                # BEST-EFFORT, and that is the design rather than a shortcut.
                # The VM resolves load_file through a CHAIN: script-dir first,
                # then the exe-dir stdlib step (g_exe_dir/../<path>, which is how
                # `load_file of "lib/int_vector.eigs"` finds the stdlib). This
                # pass can only resolve the script-dir step — it has no idea what
                # the built binary's exe dir will be — so anything it cannot read
                # STAYS a runtime call and behaves exactly as it does today.
                #
                # Caught by t76_load_file_paths, which exercises both prongs: the
                # first version threw on an unresolvable path and turned a passing
                # stdlib load into a build failure.
                local full is (_lf_dirname of base) + path
                local csrc is read_text of full
                if csrc == null:
                    append of [out, st]
                elif (len of csrc) == 0:
                    append of [out, st]
                else:
                    local cast is eigen_parse of (eigen_tokenize of csrc)
                    # A THIRD `return` semantics, and the one that was left
                    # unguarded. `return` at the top level of a load_file'd
                    # target ends THAT FILE only and yields its value to the
                    # load_file call; the program continues. The module case
                    # ends the module; the main-program case ends the program.
                    # Splicing the target into main collapses all three into
                    # "end the program":
                    #
                    #   inc.eigs   print "inc-start" / return 7 / print "inc-after"
                    #   main.eigs  print "main-start" / load_file "inc.eigs" / print "main-end"
                    #   VM   main-start inc-start main-end      AOT  main-start inc-start
                    #
                    # This predates the #146 emission change, but that change
                    # made it QUIETER rather than louder: the old code emitted
                    # `return 7` from main, so the binary exited 7 against the
                    # VM's 0 and the suite's exit-code contract would have
                    # caught it. Emitting exit-0 left stdout as the only
                    # difference — the exact silent class #146 was about.
                    # Measured cost of refusing: 0 of the 55 literal load_file
                    # targets in the ecosystem (371 references).
                    if (module_has_toplevel_return of cast) == 1:
                        throw of ("AOT: load_file target '" + path + "' ends its own top level with a `return`. In the VM that ends only the loaded file and the caller continues; the AOT splices the target into the program, where it would end the WHOLE program. Refused rather than guessed (ouroboros#146).")
                    local sp is splice_static_loads of [cast, full, depth + 1]
                    local cs is sp[1]
                    for k in range of (len of cs):
                        append of [out, cs[k]]
    return ["block", out]

# ---- driver ----
argv is args of null
src is read_text of argv[0]
if (is_dir of (argv[0])) == 1:
    # see the self-host driver: a directory passes file_exists (fopen-based)
    # and reads as "", while the oracle refuses it -- is_dir separates it from
    # a genuinely empty file
    throw of ("AOT: cannot read source file '" + (argv[0]) + "' (is a directory)")
if (file_exists of (argv[0])) == 0:
    # read_text returns EMPTY STRING, not null, for a missing file -- the same
    # gotcha the import fallback hit -- so the driver once compiled a
    # NONEXISTENT source file into a valid empty program: full C skeleton,
    # empty main, rc 0, a binary that runs and prints nothing. The first
    # refusal lumped missing with EMPTY, and a review round proved the empty
    # half over-fired (an empty file is a valid program the VM runs to rc 0);
    # build.sh then carried a bash stand-in justified by "no existence builtin
    # exists" -- which was FALSE, file_exists was in the runtime all along.
    # The driver now does the three-way split itself: missing/unreadable
    # refuse by name, empty compiles to the empty program it genuinely is.
    throw of ("AOT: cannot read source file '" + (argv[0]) + "'")
ai is 1
loop while ai < (len of argv):
    if argv[ai] == "--dump-inference":
        g_dump is 1
    else:
        # stdlib root for `import` resolution (#121); build.sh and the
        # envelope census pass it. Absent when invoked by hand, in which case
        # only project-local modules resolve and a stdlib import refuses
        # loudly rather than resolving to the wrong thing.
        G_STDLIB[0] is argv[ai]
    ai is ai + 1
toks is eigen_tokenize of src
ast is eigen_parse of toks
ast is splice_static_loads of [ast, argv[0], 0]
if (has_computed_load_file of ast) == 1:
    throw of "AOT: load_file with a computed path cannot be spliced at build time and would run INTERPRETED inside the native program, where the program's compiled functions are not visible by name -- the loaded file transpiles, links, and dies 'undefined variable' at run time (ouroboros#127). Use a literal path (spliced at build time; #147 for the resolution rules) or keep the program on the VM."
gen_c is emit_program of ast
if g_dump == 1:
    # deterministic inference report (#65): header + D records, no C output.
    print of ("# aot-inference v1 " + argv[0])
    print of g_dump_out
else:
    print of gen_c
