    local hasT is (len of tkeys) > 0
    local decls is ""
    if hasT == 1:
        decls is decls + "    long _tmark = aot_tframe_enter();\n"
        for k in range of (len of params):
            if (ptypes[k]) == "tensor":
                decls is decls + "    AotTensor " + (cn of params[k]) + " = aot_treg(aot_tensor_from_value(" + (cn of params[k]) + "_v));\n"
    # Part 2a — observed function: its numeric params are C vars but the body
    # reads them via the env (g_observed routes idents through aot_get). Seed them
    # into the env at entry. Correct while observed functions don't nest/recurse
