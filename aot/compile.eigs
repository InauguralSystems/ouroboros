    # Numeric module-shadow `local` validation (#109). Runs after inference
    # so it can consult lnm (every assignment to the shadow must stay
    # numeric — the seeded fnm keeps the name on the numeric emission path
    # regardless, which would be the silent-wrong class for a boxed RHS).
    g_locshadow is {}
    for k in range of (len of _shcand):
        local shn is _shcand[k]
        local shwhy is ""
        if (g_observed == 1) or (g_traced == 1):
