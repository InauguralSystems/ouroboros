                    if (g_bound_bit[fvar] == 1) or (g_cur_bound_bit[fvar] == 1):
                        fo is fo + ind + "    int " + (cn of fvar) + "_b = 1;   /* block-local shadow bit (round 117/119) */\n"
                else:
                    fo is fo + ind + "    " + (cn of fvar) + " = aot_num_ck_at(aot_iter_get(" + itv + ", " + kv + "), \"" + (c_escape of (G_CUR_FN[0])) + ": for-in " + (c_escape of fvar) + "\");\n"
                if g_traced == 1:
