        local mfirst is 1
        local mi is 0
        loop while mi < (len of mcases):
            local mpair is mcases[mi]
            local mpat is mpair[0]
            local mbody is mpair[1]
            if mpat == null:
                mout is mout + ind + "    else {\n" + (emit_stmts of [mbody, ind + "        ", nm, bt, minits, gf]) + ind + "    }\n"
