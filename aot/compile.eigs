    g_genp is {}
    g_tensor is infer_tensors of body
    for k in range of (len of params):
        if (ptypes[k]) == "buf":
            fbt[params[k]] is 1
            fnm[params[k]] is 0
        elif (ptypes[k]) == "dict":
            g_dict[params[k]] is 1
            fbt[params[k]] is 0
            fnm[params[k]] is 0
        elif (ptypes[k]) == "gen":
            g_genp[params[k]] is 1
            fbt[params[k]] is 0
            fnm[params[k]] is 0
        elif (ptypes[k]) == "tensor":
            g_tensor[params[k]] is 1
            fbt[params[k]] is 0
            fnm[params[k]] is 0
        else:
            fnm[params[k]] is 1
            fbt[params[k]] is 0
