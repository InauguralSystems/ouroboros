                    bfirst is 0
                bk is bk + 1
            bsel is bsel + ind + "    val_decref(" + msub + ");\n"
            local brun is ""
            local rfirst is 1
            bk is 0
            loop while bk < (len of mcases):
                if (mcases[bk])[0] != null:
                    local rkw is "if"
                    if rfirst == 0:
                        rkw is "else if"
                    brun is brun + ind + "    " + rkw + " (" + msub + "c == " + (str of (bk + 1)) + ") {\n" + (emit_stmts of [(mcases[bk])[1], ind + "        ", nm, bt, minits, gf]) + ind + "    }\n"
                    rfirst is 0
                bk is bk + 1
