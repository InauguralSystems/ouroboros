        # produces a list) and walk it by index, binding `var` boxed each step.
        # The loop var lives in the env (aot_set/aot_get), so numeric uses in the
        # body go through the boxed path; byte-exact, break/continue map to C.
        local fvar is node[1]
        local fiter is node[2]
        local fbody is node[3]
        # (round 112) An OBSERVED program's module-level `for` over a
        # PRE-BOUND module name wrote the module env slot (the round-68
        # must-bind exemption encoded "a binder over an existing binding
        # overwrites it"); the pinned VM loop-scopes it in EVERY regime --
        # the binder lives in a loop env, the module binding and its
        # observation history are untouched afterwards (VM `0 /
        # equilibrium`, AOT `2 / moving`, rc 0 both). The traced regime
        # already shadows with a C block-local; observed reads resolve
        # through the env by name, which a C local cannot shadow -- so the
        # binder is RENAMED to a fresh env name per loop, which is exactly
        # what a child env is in a name-keyed world. Two refusals first:
        # an observer read of the binder inside its own loop answers
        # differently per loop-env TIER in the VM (EigenScript#1062), and
        # under trace the tape is process-global and name-keyed, so an
        # interrogated binder would read a different history renamed.
        if (g_observed == 1) and ((G_CUR_FN[0]) == "<module>"):
            if (observes_name of [fbody, fvar]) == 1:
                throw of ("AOT: observer read of the loop binder inside its own loop ('" + fvar + "'): the history a report/observe/predicate sees there depends on the loop-env tier the VM's compiler picks (persist-overwrite skips the per-iteration CLEAR when the name was bound before the loop) -- refused rather than mirror a tier (EigenScript#1062).")
            if (g_traced == 1) and (g_interrogated_names[fvar] == 1):
                throw of ("AOT: interrogated module for binder in an observed program ('" + fvar + "'): the binder is loop-scoped through a renamed env slot, but the tape is process-global and name-keyed, so `prev of`/`what is` would read a different history. Refused rather than answer from the wrong slot.")
            G_FORREN[0] is (G_FORREN[0]) + 1
            local frn is fvar + "__for" + (str of (G_FORREN[0]))
            rename_binder_uses of [fbody, fvar, frn]
            fvar is frn
        local itv is "_it_" + fvar
        local nv is "_n_" + fvar
        local kv is "_k_" + fvar
        # a buffer ident iterable is a C Value* (global/local), borrowed by name;
        # everything else (list/dict literal, range call, ...) is an owned Value.
        local fiu is unwrap of fiter
        local itexpr is ""
        local fowned is 1
        if (fiu[0] == "ident") and (bt[fiu[1]] == 1):
            itexpr is cn of fiu[1]
            fowned is 0
        else:
            itexpr is emit_val of [fiter, nm, bt]
        local fo is ind + "{ Value* " + itv + " = " + itexpr + ";\n"
        if g_forunbox[fvar] == 2:
            # module scope: the VM loop-scopes the binding (post-loop reads
            # raise 'undefined variable'), so the C var lives in this block —
            # a post-loop read is an out-of-scope name, loud at build time
            # (the boxed path silently served the stale last value).
            fo is fo + ind + "  double " + (cn of fvar) + " = 0;\n"
            if (g_bound_bit[fvar] == 1) or (g_cur_bound_bit[fvar] == 1):
                # (round 117/119) the block-local's own bit shadows the outer one's:
                # in-loop reads pass, post-loop reads see the unset static bit
                fo is fo + ind + "  int " + (cn of fvar) + "_b = 1;\n"
        fo is fo + ind + "  long " + nv + " = aot_iter_len(" + itv + ");\n"
        fo is fo + ind + "  for (long " + kv + " = 0; " + kv + " < " + nv + "; " + kv + "++) {\n"
        local lscope is 0
        local lsc_seeded is 0
        local lsc_nm_prev is null
        # (round 116, #187) The lscope table keyed on ONE axis (module-bound
        # or interrogated); the VM's rule keys on the binding KIND. Measured
        # on the a5bc350 pin (EigenScript#1063 made an interrogated
        # parameter a slot like any other):
        #   PARAMETER (interrogated or shadowing a module name) -- the
        #     binder writes the slot and PERSISTS (t116: VM 8|5; t119),
        #     exactly as an uninterrogated param does -> never lscope.
        #   function LOCAL bound outside the loop, interrogated -- REFUSE.
        #     A writing body is the VM's own incoherence (EigenScript#1074).
        #     A read-only body loop-scopes on the VM, and the lscope arm
        #     emits that correctly WHEN the other binding ran before the
        #     loop -- but the bound-set is whole-body containment: a
        #     binding in a not-taken branch or AFTER the loop leaves the C
        #     local live-at-zero, and the post-loop read printed 0 where the
        #     VM dies (round-116 critic: pl1/ib3/ib4). That is the #157/#163
        #     /#185 boundness class; until a boundness bit exists, refuse.
        #   fresh name (bound only as a binder), interrogated -- loop-scoped,
        #     post-loop read dies on both sides -> lscope.
        #   module-bound name, not a param -- loop-scoped shadow -> lscope
        #     (refused when the body writes it: EigenScript#1074).
