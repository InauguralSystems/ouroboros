        for k in range of (len of params):
            local dpk is ptypes[k]
            local dkind is dpk
            if dpk == "buf":
                dkind is "buffer"
            elif dpk == "num":
                dkind is "double"
                if g_observed == 1:
                    dkind is "observed-env"
                elif g_int[params[k]] == 1:
                    dkind is "long"
            dump_rec of [name, "param", params[k], dkind, dl[params[k]]]
        for k in range of (len of banames):
            local dv is banames[k]
            local disp is 0
            for p in range of (len of params):
                if params[p] == dv:
                    disp is 1
            if ((gnm[dv] == 1) or (gbt[dv] == 1)) and (shadowed[dv] != 1):
