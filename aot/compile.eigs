                throw of ("AOT: '" + fvar + "' is a loop-scoped for binder (module-bound or interrogated name in a function) over an iterable that is not provably numeric; the block-local is a C double, and a boxed per-iteration binder is not emitted yet (ouroboros#198).")
            fo is fo + ind + "    double " + (cn of fvar) + " = aot_num_ck_at(aot_iter_get(" + itv + ", " + kv + "), \"" + (c_escape of (G_CUR_FN[0])) + ": for-in " + (c_escape of fvar) + "\");\n"
            if (g_bound_bit[fvar] == 1) or (g_cur_bound_bit[fvar] == 1):
                fo is fo + ind + "    int " + (cn of fvar) + "_b = 1;   /* block-local shadow bit (round 117/119) */\n"
            if g_traced == 1:
                fo is fo + ind + "    aot_trace_assign(\"" + fvar + "\", " + (cn of fvar) + ");\n"
            # (round 65) the BODY READS must take the C block-local too. In a
            # traced program an interrogated non-module binder is in no
            # numeric map, so body reads emitted ENV reads while the write
            # went to the C var -- storage disagreement (invariant 14),
            # executed: the AOT died rc 1 "undefined variable 'q'" on a
            # VM-valid program. Seed nm for the body emission; restored
            # right after emit_stmts below, so post-loop reads stay env
