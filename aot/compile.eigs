        dump_scan of [body, 0 - 1, {}, _efv]
        local _efvn is keys of _efv
        for k in range of (len of _efvn):
            local efv is _efvn[k]
            local efp is 0
            for p in range of (len of params):
                if params[p] == efv:
                    efp is 1
            if (efp == 0) and (g_forunbox[efv] == null) and (gnm[efv] == null) and (gbt[efv] != 1):
