    # numerics -> double (params + globals excluded; an assign to a global
    # updates the global).
    for k in range of (len of banames):
        local v is banames[k]
        local isparam is 0
        for p in range of (len of params):
            if params[p] == v:
                isparam is 1
        local isglobal is 0
        if (gnm[v] == 1) or (gbt[v] == 1):
            isglobal is 1
        # a local that shadows a global buffer is declared locally, not skipped.
        if shadowed[v] == 1:
            isglobal is 0
        if (isparam == 0) and (isglobal == 0) and (g_boxshadow[v] != 1):
            if g_tensor[v] == 1:
                decls is decls + "    AotTensor " + (cn of v) + " = aot_tensor_null();\n"
            elif fbt[v] == 1:
                decls is decls + "    Value* " + (cn of v) + " = NULL;\n"
            elif g_int[v] == 1:
                decls is decls + "    long " + (cn of v) + " = 0;\n"
            else:
                decls is decls + "    double " + (cn of v) + " = 0;\n"
