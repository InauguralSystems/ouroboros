    # BOXED module-shadow `local` validation (#86, F-OURO-35). Unlike the
    # numeric class above (#109: C block-scope decl-at-site, which needs
    # the sh_validate_block occurrence discipline), a boxed shadow is a
    # per-call-env binding whose reads/writes dispatch on __eigs_l binding
    # presence AT RUNTIME (aot_get_sh/aot_set_sh) — the VM's chain walk
    # itself. The dynamic shapes are therefore exact with no occurrence
    # analysis: pre-decl reads/writes hit the module binding, iteration
    # carry serves the previous iteration's shadow, a nested decl outlives
    # its block, re-decls rebind the one frame binding, recursion gets a
    # fresh shadow per call, and a numeric re-assign of the shadow just
    # rebinds it (all oracle-probed at v0.39.0). What stays refused:
    # observed/temporal functions (Part 2a keys env/history state by NAME
    # in __eigs_g), a nested define/lambda reading the name (a lifted C fn
    # cannot see __eigs_l; a capbind capture is a stale snapshot), binder
    # re-binding (#110's rule — the VM loop-scopes a for/catch/listcomp
    # var OVER the shadow, a third semantics), and shadows the inference
    # classified buffer/tensor (their storage is a C variable, not the
    # env — routing them here would silently bypass that storage).
    g_boxshadow is {}
    local _bsh_any is 0
    for k in range of (len of _bshcand):
        local bshn is _bshcand[k]
        local bwhy is ""
        if (g_observed == 1) or (g_traced == 1):
            bwhy is "observed/temporal function — history and env state are keyed by NAME, invisible to a per-call env"
        elif (sh_deferred_ref of [body, bshn]) == 1:
            bwhy is "the name is referenced by a nested define/lambda"
        elif (sh_binds of [body, bshn]) == 1:
            bwhy is "the name is re-bound as a for/catch/comprehension variable"
        elif fbt[bshn] == 1:
            bwhy is "the shadow is buffer-classified (C-variable storage, not the env)"
        elif g_tensor[bshn] == 1:
