    g_locshadow is {}
    for k in range of (len of _shcand):
        local shn is _shcand[k]
        local shwhy is ""
        if (g_observed == 1) or (g_traced == 1):
            # observed/temporal programs key history and env state by NAME —
            # a bare C local is invisible to that machinery.
            shwhy is "observed/temporal function — history and env state are keyed by NAME, invisible to a bare C local"
