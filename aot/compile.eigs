            # read-back in the body. A buffer iterable reads elementwise
            # (aot_buf_get_i); anything else takes the materialized element
            # through the CHECKED extractor (the recognizer proved elements
            # numeric, so this never fires in-envelope).
            if fowned == 0:
                fo is fo + ind + "    " + (cn of fvar) + " = aot_buf_get_i(" + itv + ", " + kv + ");\n"
            else:
                fo is fo + ind + "    " + (cn of fvar) + " = aot_num_ck_at(aot_iter_get(" + itv + ", " + kv + "), \"" + (c_escape of (G_CUR_FN[0])) + ": for-in " + (c_escape of fvar) + "\");\n"
