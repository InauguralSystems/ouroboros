# The bootstrap test program. test/bootstrap.eigs compiles this with both the
# C-hosted and the self-hosted compiler (byte-exact fixed point), then EXECUTES
# the self-compiled bytecode; test/run.sh diffs that execution's output against
# the C evaluator running this same file directly. It lives in its own file so
# the shell harness and the bootstrap share one source of truth (#101).
x is 7
print of (x * 6 - 1)
z is [i * i for i in [1, 2, 3, 4, 5] if i > 1]
print of z
define fib(n) as:
    if n < 2:
        return n
    return (fib of (n - 1)) + (fib of (n - 2))
print of (fib of 10)
d is {}
for k in ["a", "b", "a", "c", "a"]:
    local key is k
    if has_key of [d, key]:
        d[key] is d[key] + 1
    else:
        d[key] is 1
print of (d["a"])
try:
    throw of "x"
catch e:
    print of ("caught " + e)
