# ouroboros#106: `report of <ident>` and `<predicate> of <ident>` are the
# specialized observer opcodes (REPORT_NAME/SLOT, PREDICATE_NAME/SLOT), not
# builtin calls. Self-hosted they were a plain call -- "equilibrium" for every
# module binding (VM: stable / moving), and `converged of x` died "cannot call
# num". Module scope, function-scope slot locals, and a module name read from
# inside a function are the three resolution shapes.
x is 5
x is 5
x is 5
print of (report of x)
y is 1
y is 2
y is 3
print of (report of y)
print of (converged of x)
print of (stable of x)
print of (diverging of y)
print of (equilibrium of y)
define f(n) as:
    local acc is 0
    for i in range of 6:
        acc is acc + n
    print of (report of acc)
    print of (diverging of acc)
    print of (report of y)
    print of (improving of y)
    return acc
print of (f of 3)
z is 2.0
for k in range of 8:
    z is z * 0.5
print of (report of z)
print of (converged of z)
print of (oscillating of z)
