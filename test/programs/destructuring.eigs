# Destructuring assignment `[a, b] is rhs` (C since 0.13.0; ouroboros#57
# item 5). Names only (no index/field targets), exact-length match, rhs
# evaluated once; works at module scope and inside functions (outward-
# mutable like plain assignment).
[a, b] is [1, 2]
print of a
print of b
[x] is [42]
print of x
[u, v, w] is [4, [5, 6], "s"]
print of v[1]
print of w
# rhs is an expression, not just a literal
define pair as:
    return [7, 8]
[p, q] is pair of 0
print of (p + q)
# outward mutation from a function body
a is 0
define reset as:
    [a, b2] is [70, 80]
    return b2
print of (reset of 0)
print of a
# swap idiom
m is 1
n is 2
[m, n] is [n, m]
print of m
print of n
