# `not` now binds below comparisons and arithmetic but above `and`/`or`
# (#307 / EigenScript #1648). These witnesses intentionally retain the old
# unary-first grouping with parentheses, and #1637 still requires operations
# between their boolean results and numbers to raise.
x is 3
try:
    print of ((not x) + 1)
catch e:
    print of e.message
try:
    print of ((not 2) == 1)
catch e:
    print of e.message
try:
    print of ((not 0) * 5)
catch e:
    print of e.message
try:
    print of ((not 0) + (not 1))
catch e:
    print of e.message
try:
    print of (- (not 0))
catch e:
    print of e.message
# This witness intends the former unary-first meaning; spell that grouping now
# that bare `not x == false` means `not (x == false)` (#307).
print of ((not x) == false)
print of (not not x)
print of (not -1)
print of (not len of [1, 2])
y is 0
print of (not x and not y)
print of (not x or not y)
if not y:
    print of "ny"
