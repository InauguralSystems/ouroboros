# Call convention (#405, v0.27.0): a BARE literal list after `of` is ALWAYS
# the argument list, at every element count — `f of []` zero args,
# `f of [x]` ONE arg (the element x, not a 1-element list), `f of [a, b]`
# two args. A parenthesized literal list `f of ([x])` still passes the list
# whole (#355). A non-literal arg (variable) is always one argument.
define wrap(x) as:
    return x
define add(a, b) as:
    return a + b
print of (wrap of [42])
print of (len of (wrap of [["a", "b"]]))
print of (add of [3, 4])
ws is ["x", "y", "z"]
print of (wrap of ws)
print of (len of (wrap of ws))
