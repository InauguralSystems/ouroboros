# Buffer + list + string slicing through the self-hosted compiler.
b is buffer of 6
i is 0
loop while i < 6:
    b[i] is i + 1
    i is i + 1
print of b[2]
print of b[1:4]
print of b[:3]
print of b[3:]
print of b[:]
print of (dot of [b[0:3], b[3:6]])
print of (sum of b[2:5])

xs is [10, 20, 30, 40, 50]
print of xs[1:3]
print of xs[-2:]
print of xs[:2]

s is "hello world"
print of s[0:5]
print of s[6:]

# a name reachable ONLY through a slice (capture/name-collection check)
lo is 1
hi is 5
print of b[lo:hi]
