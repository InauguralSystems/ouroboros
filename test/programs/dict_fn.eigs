define lookup(d, k) as:
    return d[k]
define wordcount as:
    counts is {}
    items is ["x", "y", "x", "z", "x", "y"]
    for w in items:
        if has_key of [counts, w]:
            counts[w] is counts[w] + 1
        else:
            counts[w] is 1
    return counts
